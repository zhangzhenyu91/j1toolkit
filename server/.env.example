# ===== 检修一班工具箱后端 · 环境变量示例 =====
# 复制为 .env 并填写真实值；.env 不入仓、不上传公开位置。

# 服务端口（容器内监听 0.0.0.0:PORT）
PORT=3000

# 反向代理路径前缀：反代保留前缀转发时填写（如 /j1toolkit）；直连或反代已剥前缀则留空
PROXY_PREFIX=/j1toolkit

# JWT 签名密钥与有效期（如 7d / 12h / 30m）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES=7d

# 初始管理员（仅首次启动、账号不存在时创建；密码登录用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_NICKNAME=管理员

# 微信小程序（微信登录用；未配置时微信登录接口返回“未配置”）
WX_APPID=
WX_SECRET=

# MySQL（已建好的空数据库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=j1toolkit

# Redis（JWT 黑名单/会话缓存）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# WeKnora 知识库（Call Me 应用；对接细节见 WeKnora-API对接指南.md）
WEKNORA_API_URL=https://know.j1net.com/api/v1
WEKNORA_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 智能体 ID（agent-chat 必传，在 WeKnora 后台智能体详情中获取）
WEKNORA_AGENT_ID=

# 腾讯云 COS（后续应用使用，本期可留空）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# Dify（后续应用使用，本期可留空）
DIFY_API_URL=
DIFY_API_KEY=
