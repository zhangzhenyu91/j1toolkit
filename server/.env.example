# ===== 检修一班工具箱后端 · 环境变量示例 =====
# 复制为 .env 并填写真实值；.env 不入仓、不上传公开位置。

# 服务端口（容器内监听 0.0.0.0:PORT）
PORT=3000

# 反向代理路径前缀：反代保留前缀转发时填写（如 /j1toolkit）；直连或反代已剥前缀则留空
PROXY_PREFIX=/j1toolkit

# JWT 签名密钥与有效期（如 7d / 12h / 30m）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES=7d

# 初始管理员（仅首次启动、账号不存在时创建；密码登录用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_NICKNAME=管理员

# 微信小程序（微信登录用；未配置时微信登录接口返回“未配置”）
WX_APPID=
WX_SECRET=

# MySQL（已建好的空数据库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=j1toolkit

# Redis（JWT 黑名单/会话缓存）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# WeKnora 知识库（Call Me 应用；对接细节见 开发指南.md 第六章）
WEKNORA_API_URL=https://know.j1net.com/api/v1
WEKNORA_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 智能体 ID（agent-chat 必传，在 WeKnora 后台智能体详情中获取）
WEKNORA_AGENT_ID=

# 腾讯云 COS（出工日志水印照片；WORKLOG_ENABLED=true 时必填）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# Dify（出工日志照片验证工作流；只填域名，/v1 由代码拼接）
DIFY_API_URL=http://10.2.24.13:8082

# ===== 出工日志（子应用）=====
# 后端开关：true 开启（自动建表/种子并挂载 /api/v1/worklog），false 关闭
WORKLOG_ENABLED=false
# 照片在 COS 的独立文件夹前缀
COS_WORKLOG_PREFIX=worklog/
# 照片访问域名（可选；留空按 https://{COS_BUCKET}.cos.{COS_REGION}.myqcloud.com 拼接，自定义域名如 https://j1toolkit.cos.j1net.com）
COS_WORKLOG_BASE_URL=
# 照片验证工作流的 Dify API Key（POST {DIFY_API_URL}/v1/workflows/run，见 开发指南.md 7.2）
DIFY_WORKLOG_API_KEY=

# 腾讯位置服务（出工日志「选择照片并添加水印」预填当前地点/天气用，见 开发指南.md 7.3；
# 未配置时对应字段留空由用户手填。控制台 lbs.qq.com 创建应用，key 类型须勾选 WebServiceAPI）
TENCENT_MAP_KEY=
