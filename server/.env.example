# ===== Shade 壹匣 · 环境变量示例 =====
# 复制为 .env 并填写真实值；.env 不入仓、不上传公开位置。

# 服务端口（容器内监听 0.0.0.0:PORT；网页端与 API 同端口，
# 反代约定：toolkit.j1net.com → 127.0.0.1:PORT 单端口，无需任何路径前缀配置）
PORT=3000

# JWT 签名密钥与有效期（如 7d / 12h / 30m）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES=7d

# 初始管理员（仅首次启动、账号不存在时创建；密码登录用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_NICKNAME=管理员

# 微信小程序（微信登录用；未配置时微信登录接口返回“未配置”）
WX_APPID=
WX_SECRET=

# MySQL（已建好的空数据库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=j1toolkit

# Redis（JWT 黑名单/会话缓存）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# WeKnora 知识库（Call Me 应用；对接细节见 开发指南.md 第六章）
WEKNORA_API_URL=https://know.j1net.com/api/v1
WEKNORA_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 智能体 ID（agent-chat 必传，在 WeKnora 后台智能体详情中获取）
WEKNORA_AGENT_ID=

# 腾讯云 COS（出工日志水印照片；WORKLOG_ENABLED=true 时必填）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# Dify 服务地址（只填域名，/v1 由代码拼接）
# 所有 Dify 工作流共用此地址，不同工作流各有独立 API_KEY（见下方各应用配置）
DIFY_API_URL=http://10.2.24.13:8082
# 微信消息推送工作流的 Dify API Key（通知微信外发；留空则微信推送停用，站内通知照常）
DIFY_WXPUSH_API_KEY=

# ===== 出工日志（子应用）=====
# 后端开关：true 开启（自动建表/种子并挂载 /api/v1/worklog），false 关闭
WORKLOG_ENABLED=false
# 照片在 COS 的独立文件夹前缀
COS_WORKLOG_PREFIX=worklog/
# 照片访问域名（可选；留空按 https://{COS_BUCKET}.cos.{COS_REGION}.myqcloud.com 拼接，自定义域名如 https://j1toolkit.cos.j1net.com）
COS_WORKLOG_BASE_URL=
# 照片验证工作流的 Dify API Key（POST {DIFY_API_URL}/v1/workflows/run，见 开发指南.md 7.2）
DIFY_WORKLOG_API_KEY=

# 高德地图 Web 服务（出工日志「选择照片并添加水印」预填当前地点/天气、商旅打卡定位解析用，见 开发指南.md 7.3/15.5；
# 未配置时对应字段留空由用户手填。高德开放平台 lbs.amap.com 创建应用，key 类型须为「Web 服务」）
AMAP_MAP_KEY=
# 高德接口 base URL（可选，默认 https://restapi.amap.com；因费用问题走中转站时改为中转地址，接口路径 /v3/... 不变）
AMAP_BASE_URL=

# 派车单每日自动同步（出工日志扩展；需先开启出工日志与 KVM，链路见 开发指南.md 出工日志章节）
# 每日 09:10 锁定目标 KVM 设备（远程连接/文件传输对该设备暂不可用）并把 U 盘挂载至被控机（被控机 09:15 起执行导出脚本）；
# 09:20 取回当日「yyyy-mm-dd-派车单.xlsx」自动建卡、删除 U 盘文件并解禁，结果按班组通知超管与对应班组管理员。
# 生效班组以开关表为准：班组管理员/超管在出工日志「派车对齐」页按班组开关；用车人含多个班组人名的记录仅通知不建卡
WORKLOG_DISPATCH_SYNC_ENABLED=false
# 种子开启班组（仅此班组在首次启动时写入开关表，之后以开关表为准、本项改动不再生效；留空不种子）
WORKLOG_DISPATCH_SYNC_TEAM=检修一班
# 目标 KVM 设备（银河麒麟V10 被控机所在设备）：ddns 定位 + MAC 校验（防设备更换后误操作他机）
WORKLOG_DISPATCH_DEVICE_DDNS=your-device-ddns
WORKLOG_DISPATCH_DEVICE_MAC=AA:BB:CC:DD:EE:FF
# 同步任务代登平台所用账号（须在 GLKVM 平台有同名账号且可见该设备组；留空回退 ADMIN_USERNAME）
WORKLOG_DISPATCH_KVM_USER=
# 每日准备时间（锁定设备并挂载 U 盘至被控机）与取件时间（下载建卡并解禁），HH:mm，北京时间
WORKLOG_DISPATCH_PREPARE_TIME=09:10
WORKLOG_DISPATCH_FETCH_TIME=09:20

# ===== 安全日活动记录（子应用）=====
# 后端开关：true 开启（初始化数据目录并挂载 /api/v1/safeday），false 关闭
SAFEDAY_ENABLED=false
# 记录 records.json 与生成产物（docs/）存放目录，相对路径按服务启动目录（server/）解析
SAFEDAY_DATA_DIR=./data/safeday
# 活动记录默认上级参加人员（可选；留空则由用户手填）
SAFEDAY_DEFAULT_SUPERIOR=
# 记录生成工作流的 Dify API Key（POST {DIFY_API_URL}/v1/workflows/run，地址与出工日志工作流共用）
DIFY_SAFEDAY_API_KEY=
# Dify 回调 token（可选；配置后回调接口须带 ?token= 校验，留空则不校验）
SAFEDAY_CALLBACK_TOKEN=
# LibreOffice soffice 路径（可选，默认 PATH 中的 soffice；多文件含非 PDF 时后端转 PDF 合并依赖它，Docker 镜像须安装 LibreOffice）
SAFEDAY_SOFFICE_PATH=soffice

# basemetas 文件预览服务地址（可选，如 https://cloud.j1net.com/view；
# 配置后网页端可在线预览已生成记录，留空则网页端不显示预览）
BASEMETAS_URL=

# ===== KVM 远程管理（子应用）=====
# 后端开关：true 开启（挂载 /api/v1/kvm，设备列表代理自 GLKVM Cloud 平台），false 关闭
KVM_ENABLED=false
# GLKVM Cloud 平台地址（即 glkvm-cloud 部署的 Web 地址，不带尾部 /）
GLKVM_URL=https://master.kvm.j1net.com
# 员工平台账号的统一密码：网页端以「壹匣登录账号 + 此密码」代登平台拉取设备列表
# （员工须在平台有同名账号、未开启 2FA；可见设备范围随各员工平台权限）
GLKVM_PASSWORD=

# ===== 题库刷题（子应用）=====
# 后端开关：true 开启（自动建表/种子并挂载 /api/v1/quiz），false 关闭
QUIZ_ENABLED=false
# 「题目解析」工作流的 Dify API Key（POST {DIFY_API_URL}/v1/workflows/run，地址与其他工作流共用；
# 工作流入参变量：type 题型 / stem 题干 / options 选项（多行文本）/ answer 答案，输出 analysis；
# 留空则 AI 解析停用，导入/刷题等其余功能照常可用）
DIFY_QUIZ_API_KEY=

# ===== 商旅打卡（出工日志扩展，子应用）=====
# 后端开关：true 开启（自动建表/种子并挂载 /api/v1/sgcc），false 关闭；需先开启出工日志
SGCC_CLOCKIN_ENABLED=false
# 商旅平台协议密钥（取自商旅 App 逆向分析，联系维护者获取；密钥即 App 内固定值，各环境通用）
SGCC_JWT_SECRET=
SGCC_SM2_SERVER_PUB=
SGCC_SM2_CLIENT_PRIV=
# jsonx default 通道（打卡/详情/模板）：请求加密公钥 / 响应解密私钥
SGCC_RSA_PUB=
SGCC_RSA_PRIV=
# jsonx slapp 通道（费用保存必走）：请求加密公钥（res/dCu.pem 内容）/ 响应解密私钥（res/wLA.pem 内容）
SGCC_DCU_PUB=
SGCC_WLA_PRIV=
# 商旅 App 版本号（请求头 version；App 升级后优先只改此项验证接口是否仍通，无需重新解包）
SGCC_VERSION=3.3.6
# 商旅 App 构建号（请求头 version-code，3.3.6 实测值；App 升级随 SGCC_VERSION 一并更新）
SGCC_VERSION_CODE=202609101630
# 风控 SDK 版本（请求头 grayversion，3.3.6 实测值）
SGCC_GRAY_VERSION=2.4.7.1
# 每日自动核查时间（HH:mm，默认 23:00）
SGCC_SYNC_TIME=23:00
# 开始打卡未打午间提醒时间（HH:mm，默认 11:00；提醒前先对当日卡上成员做打卡同步再判定，同步失败转人工核查通知；仅发微信 本人+班组群，需配置 DIFY_WXPUSH_API_KEY 并维护 wxid）
SGCC_STARTCLOCK_REMIND_TIME=11:00
# 结束打卡未打傍晚提醒时间（HH:mm，默认 18:00；提醒前先对当日卡上成员做打卡同步再判定，同步失败转人工核查通知；仅发微信 本人+班组群，需配置 DIFY_WXPUSH_API_KEY 并维护 wxid）
SGCC_ENDCLOCK_REMIND_TIME=18:00
# 批量拉取成员间隔（毫秒，防商旅侧风控，默认 1500）
SGCC_SYNC_INTERVAL_MS=1500
# 商旅 API 出口 SOCKS5 代理（留空=直连）：socks5h://用户名:密码@主机:端口（socks5h=远端 DNS 解析，推荐）
# 用途：云服务器机房 IP 易触发商旅风控（图形码 99000 窗口），经目标属地宽带出口对齐打卡人实际位置；
# 仅作用于商旅 API 调用（小 JSON），照片类大流量下载不走代理；代理不可用时商旅调用直接报错，不静默降级直连
SGCC_PROXY_URL=
# 出口代理健康探测间隔（毫秒，默认 300000=5 分钟；仅配置 SGCC_PROXY_URL 时启用）：
# 定时对代理端口做 TCP 建连探测（不向商旅主机发请求），正常↔异常 跳变时通知超管（站内+微信，微信侧需配置 DIFY_WXPUSH_API_KEY 并维护超管 wxid）
SGCC_PROXY_PROBE_INTERVAL_MS=300000
