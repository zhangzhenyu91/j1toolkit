:host {
  display: block;
  flex: 1;
  min-height: 0;
}

.wide-shell {
  display: flex;
  width: 100%;
  min-height: 100vh;
  height: 100%;
  flex-direction: column;
}

.wide-side {
  display: none;
}

.wide-content {
  min-width: 0;
  min-height: 100vh;
  flex: 1;
}

.wide-logo {
  width: 32px;
  height: 32px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 14px;
  font-weight: 700;
}

.wide-brand-text,
.wide-nav-text,
.wide-section,
.wide-user-meta,
.wide-user-arrow,
.wide-compact-text,
.wide-collapse {
  display: none;
}

.wide-nav-icon {
  flex: none;
  color: inherit;
  font-size: 19px;
}

.wide-avatar {
  width: 34px;
  height: 34px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 13px;
  font-weight: 600;
}

@media (min-width: 900px) {
  .wide-shell {
    height: 100vh;
    min-height: 0;
    flex-direction: row;
    overflow: hidden;
  }

  .wide-side {
    position: relative;
    z-index: 30;
    box-sizing: border-box;
    width: 72px;
    height: 100vh;
    flex: none;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--app-border);
    background: var(--app-bg-card);
    transition: width 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wide-brand {
    height: 64px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--app-border);
  }

  .wide-side-scroll {
    flex: 1;
    min-height: 0;
    padding: 10px 8px;
    box-sizing: border-box;
  }

  .wide-nav-item {
    min-height: 54px;
    margin-bottom: 3px;
    padding: 5px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border-radius: 8px;
    color: var(--app-text-secondary);
    transition:
      background-color 0.16s ease,
      color 0.16s ease;
  }

  .wide-nav-item.on {
    background: var(--app-brand-light);
    color: var(--app-brand);
    font-weight: 600;
  }

  .wide-compact-text {
    display: block;
    max-width: 64px;
    overflow: hidden;
    font-size: 9px;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wide-nav-empty {
    padding: 16px 4px;
    color: var(--app-text-tertiary);
    font-size: 10px;
    text-align: center;
  }

  .wide-user {
    min-height: 68px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 0;
    border-top: 1px solid var(--app-border);
  }

  .wide-user.on {
    background: var(--app-brand-light);
    color: var(--app-brand);
  }

  .wide-content {
    height: 100vh;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
}

@media (min-width: 1200px) {
  .wide-side {
    width: 200px;
  }

  .wide-brand {
    justify-content: flex-start;
    gap: 10px;
    padding: 0 16px;
  }

  .wide-brand-text {
    display: block;
    min-width: 0;
  }

  .wide-brand-name {
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }

  .wide-brand-team {
    margin-top: 1px;
    color: var(--app-text-tertiary);
    font-size: 9px;
    letter-spacing: 1px;
  }

  .wide-side-scroll {
    padding: 10px;
  }

  .wide-section {
    display: block;
    margin: 14px 10px 6px;
    color: var(--app-text-tertiary);
    font-size: 10px;
    font-weight: 600;
  }

  .wide-nav-item {
    min-height: 44px;
    padding: 0 11px;
    flex-direction: row;
    justify-content: flex-start;
    gap: 11px;
  }

  .wide-nav-text {
    display: block;
    min-width: 0;
    overflow: hidden;
    font-size: 12.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wide-compact-text {
    display: none;
  }

  .wide-user {
    justify-content: flex-start;
    gap: 10px;
    padding: 10px 14px;
  }

  .wide-user-meta {
    display: block;
    min-width: 0;
    flex: 1;
  }

  .wide-user-name {
    overflow: hidden;
    font-size: 12.5px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wide-user-role {
    margin-top: 2px;
    color: var(--app-text-tertiary);
    font-size: 10px;
  }

  .wide-user-arrow {
    display: block;
    color: var(--app-text-tertiary);
    font-size: 15px;
  }

  .wide-collapse {
    position: absolute;
    top: 76px;
    right: -22px;
    z-index: 34;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--app-text-secondary);
  }

  .wide-collapse::before {
    content: '';
    position: absolute;
    inset: 10px;
    z-index: -1;
    border: 1px solid var(--app-border);
    border-radius: 50%;
    background: var(--app-bg-card);
    box-shadow: var(--app-shadow-card);
  }

  .wide-collapse-icon {
    font-size: 13px;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wide-collapsed .wide-side {
    width: 72px;
  }

  .wide-collapsed .wide-brand {
    justify-content: center;
    padding: 0;
  }

  .wide-collapsed .wide-brand-text,
  .wide-collapsed .wide-section,
  .wide-collapsed .wide-nav-text,
  .wide-collapsed .wide-user-meta,
  .wide-collapsed .wide-user-arrow {
    display: none;
  }

  .wide-collapsed .wide-side-scroll {
    padding: 10px 8px;
  }

  .wide-collapsed .wide-nav-item {
    min-height: 54px;
    padding: 5px 0;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
  }

  .wide-collapsed .wide-compact-text {
    display: block;
  }

  .wide-collapsed .wide-user {
    justify-content: center;
    padding: 10px 0;
  }

  .wide-collapsed .wide-collapse-icon {
    transform: rotate(180deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .wide-side,
  .wide-nav-item,
  .wide-collapse-icon {
    transition: none !important;
    animation: none !important;
  }
}
