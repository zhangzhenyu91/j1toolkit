<!-- 自定义导航栏（navigationStyle: custom 下使用）
     注意：右上角为微信胶囊按钮区域，禁止在此放置任何可点击内容，故不提供右侧插槽
     「政企蓝白」：白/浅底页带 1rpx 发丝底线；品牌深蓝页首（frontColor=#ffffff）取消底线
     navBg/navColor 为按系统主题解析后的计算值（品牌深蓝页首固定） -->
<view
  class="nav-wrap {{isDark ? 'nav-dark' : ''}}"
  style="background: {{navBg}}; padding-top: {{statusBarHeight}}px;"
>
  <view class="nav-row">
    <view class="nav-left" bindtap="onBack">
      <!-- 栈底页（分享进入）显示首页图标，否则按 back 属性显示返回箭头 -->
      <t-icon wx:if="{{isRoot && !isHome}}" t-class="ico-44" name="home" color="{{navColor}}" />
      <t-icon wx:elif="{{back}}" t-class="ico-44" name="chevron-left" color="{{navColor}}" />
    </view>
    <view class="nav-title" style="color: {{navColor}};">
      <text class="nav-title-text">{{title}}</text>
    </view>
  </view>
</view>
