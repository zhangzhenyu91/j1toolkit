/* 自定义导航栏 ·「政企蓝白」：浅底页 1rpx 发丝底线，深色页首取消底线 */
.nav-wrap {
  width: 100%;
  border-bottom: 1rpx solid #E5E6EB;
}

.nav-wrap.nav-dark {
  border-bottom-color: transparent;
}

.nav-row {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.nav-left {
  position: relative;
  z-index: 2;
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  position: absolute;
  left: 160rpx;
  right: 160rpx; /* 右侧避开微信胶囊按钮区域 */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.nav-title-text {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
