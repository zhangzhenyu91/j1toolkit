<!-- 共享组件 · 网盘目录选择器（「保存到网盘」前选「我的空间」目录；接口说明见 nd-dirpicker.js 头注释）
     样式跟随 pkg-netdisk 目标位置选择弹层（抓手 + 面包屑 + 仅文件夹列表 + 主按钮） -->
<t-popup visible="{{innerVisible}}" placement="bottom" bind:visible-change="onVisibleChange">
  <view class="ndp-sheet" style="padding-bottom: {{keyboardHeight ? keyboardHeight + 'px' : 'calc(40rpx + env(safe-area-inset-bottom))'}};">
    <view class="grab"></view>
    <view class="ndp-title">保存到网盘</view>
    <view class="ndp-sub">选择「我的空间」内的保存目录，可就地新建文件夹</view>

    <!-- 面包屑（父级蓝字可点，末级当前加粗） -->
    <view class="ndp-crumb">
      <block wx:for="{{crumbs}}" wx:key="path">
        <text wx:if="{{!item.last}}" class="ndp-link" data-path="{{item.path}}" hover-class="hover-opacity" bindtap="onCrumbTap">{{item.name}}</text>
        <text wx:else class="ndp-cur">{{item.name}}</text>
        <text wx:if="{{!item.last}}" class="ndp-sep">/</text>
      </block>
    </view>

    <!-- 新建文件夹（收起为入口行；展开为行内输入，键盘弹起时动态抬高底部 padding） -->
    <view wx:if="{{!mkOpen}}" class="ndp-mk" hover-class="hover-bg-warm" bindtap="onMkOpen">
      <t-icon name="folder-add" size="34rpx" color="#0E3DA8" />
      <text class="ndp-mk-t">新建文件夹</text>
    </view>
    <view wx:else class="ndp-mkedit">
      <input
        class="ndp-mkinput"
        value="{{mkName}}"
        focus
        bindinput="onMkInput"
        adjust-position="{{false}}"
        bindkeyboardheightchange="onKeyboardHeight"
        hold-keyboard
        maxlength="100"
        placeholder="文件夹名称"
        placeholder-class="ndp-ph"
      />
      <view class="ndp-mkok {{mkSaving ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onMkSave">{{mkSaving ? '…' : '确定'}}</view>
      <view class="ndp-mkno" hover-class="hover-opacity" bindtap="onMkCancel">取消</view>
    </view>

    <scroll-view scroll-y class="ndp-list">
      <view wx:if="{{loading}}" class="ndp-empty">目录加载中…</view>
      <view wx:elif="{{error}}" class="ndp-empty">{{error}}</view>
      <view wx:elif="{{!dirs.length}}" class="ndp-empty">该目录下没有子文件夹</view>
      <block wx:else>
        <view
          wx:for="{{dirs}}"
          wx:key="name"
          class="ndp-dir"
          data-name="{{item.name}}"
          hover-class="hover-bg-warm"
          bindtap="onDirTap"
        >
          <t-icon name="folder" size="38rpx" color="#0A3592" />
          <text class="ndp-name">{{item.name}}</text>
          <t-icon name="chevron-right" size="30rpx" color="#C9CDD4" />
        </view>
      </block>
    </scroll-view>

    <view class="ndp-ops">
      <view class="ndp-cancel {{mkSaving ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onCloseTap">取消</view>
      <view class="ndp-confirm {{(loading || error) ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onConfirm">保存到此目录</view>
    </view>
  </view>
</t-popup>

<t-toast id="t-toast" />
