/* 底部 TabBar ·「政企蓝白」：白底 + 顶部发丝线，激活项品牌蓝（亮暗取值引 --app-*） */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  background: var(--app-bg-card, #ffffff);
  border-top: 1rpx solid var(--app-border, #e5e6eb);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
  color: var(--app-text-tertiary, #86909c);
  letter-spacing: 2rpx;
  transition:
    color 0.18s cubic-bezier(0.22, 1, 0.36, 1),
    background-color 0.18s cubic-bezier(0.22, 1, 0.36, 1);
}

.tab.on {
  color: var(--app-brand, #0e3da8);
  font-weight: 600;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
}

/* 激活项下方蓝圆点 */
.t-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: transparent;
}

.tab.on .t-dot {
  background: var(--app-brand, #0e3da8);
}

.ico-44 {
  font-size: 44rpx;
}

@media (min-width: 600px) {
  .ico-44 {
    font-size: 22px;
  }
}

/* 组件样式隔离下的减弱动态效果（不能只依赖 app.wxss 的原生标签选择器） */
@media (prefers-reduced-motion: reduce) {
  view,
  text,
  t-icon {
    animation: none !important;
    transition: none !important;
  }
}
