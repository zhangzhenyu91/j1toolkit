.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #E8E0CD;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
  color: #A89F8A;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.tab.on {
  color: #F26D21;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
}
