/* 底部 TabBar ·「政企蓝白」：白底 + 顶部发丝线，激活项品牌蓝 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #E5E6EB;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
  color: #86909C;
  letter-spacing: 2rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.tab.on {
  color: #0E3DA8;
  font-weight: 600;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
}

/* 激活项下方蓝圆点 */
.t-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: transparent;
}

.tab.on .t-dot {
  background: #0E3DA8;
}
