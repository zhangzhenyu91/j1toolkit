/* 出工日志 · 派车对齐页（token 同 app.wxss「政企蓝白」；底部弹层 .sheet / .sheet-actions / .btn-ghost / .btn-dark 来自分包公共样式） */
@import '../../style/common.wxss';
@import '../../style/icons.wxss';

/* ---------- 卡片（同 sheet 页族：白卡直角 + 墨边 + 浅色硬影 + 墨黑主按钮） ---------- */
.card {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card + .card,
.sums,
.list,
.allok {
  margin-top: 24rpx;
}

/* ---------- 每日自动同步开关卡（左标题说明 + 右侧开关） ---------- */
.sync-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sync-card .r-l {
  flex: 1;
}

/* ---------- 对齐口径说明卡（虚线描边浅纸底，同网页端 .pa-rule） ---------- */
.rule {
  border: 3rpx dashed var(--app-border);
  background: var(--app-bg-page);
  box-shadow: none;
}

.rule-t {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--app-text-primary);
}

.rule-p {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
  line-height: 1.9;
}

/* ---------- 派车单文件卡 ---------- */
.r-l {
  min-width: 0;
}

.r-t {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.r-s {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  margin-top: 6rpx;
}

/* 已选文件 chips（直角蓝签 + 移除叉） */
.fchips {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.fchip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--app-brand);
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 22rpx;
  font-weight: 700;
}

.fchip-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fchip-x {
  flex: none;
  display: flex;
  align-items: center;
  opacity: 0.65;
}

/* 「从聊天文件选择」虚线占位钮（同 .add-photo 族灰底虚线） */
.pick {
  margin-top: 22rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--app-bg-nested);
  border: 3rpx dashed var(--app-border);
  color: var(--app-text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.pick.disabled {
  opacity: 0.45;
}

/* 「开始对齐」墨黑主按钮（直角 + 墨挤出硬影） */
.go {
  margin-top: 22rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--app-text-primary);
  color: var(--app-bg-card);
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.go.disabled {
  opacity: 0.45;
}

/* ---------- 概览七宫格（三列两行余一格） ---------- */
.sums {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sum {
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}

.sum .n {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.sum .t {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--app-text-secondary);
  letter-spacing: 1rpx;
}

.sum.ok .n {
  color: var(--app-success);
}

.sum.warn .n {
  color: var(--app-brand);
}

.sum.bad .n {
  color: var(--app-danger);
}

.sum.mut .n {
  color: var(--app-text-tertiary);
}

.hint {
  margin-top: 16rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--app-text-secondary);
}

/* ---------- 不一致清单行 ---------- */
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.row + .row {
  margin-top: 16rpx;
}

.row.done {
  opacity: 0.55;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.row-date {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  letter-spacing: 1rpx;
}

/* 差异徽章（直角小签；配色同网页端 .pa-badge） */
.pa-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  letter-spacing: 1rpx;
}

.pa-badge.plate {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.pa-badge.dest {
  background: var(--app-warning-bg);
  color: var(--app-warning-text);
}

.pa-badge.mem {
  background: var(--app-danger-bg);
  color: var(--app-danger);
}

.pa-badge.none-sys {
  background: var(--app-bg-nested);
  color: var(--app-text-tertiary);
}

.pa-badge.none-sheet {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.row-sum {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--app-text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.seg.b {
  color: var(--app-text-primary);
  font-weight: 700;
}

.seg.hl {
  color: var(--app-brand);
  font-weight: 700;
}

.seg.hl-r {
  color: var(--app-danger);
  font-weight: 700;
}

.seg.vs {
  color: var(--app-text-tertiary);
}

.row-act {
  flex: none;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--app-brand);
}

.row-act.yes {
  color: var(--app-success);
}

.allok {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--app-text-tertiary);
}

/* ---------- 对照弹层 ---------- */
.dlg-scroll {
  flex: 1 1 auto;
  min-height: 0;
  margin-top: 24rpx;
  overflow-y: auto;
  overflow-x: hidden;
}

/* 对照列（弹层内上下排：表格只读 / 卡片可改；标题左侧 8rpx 蓝方块同板块标题规范） */
.cmp-col {
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  overflow: hidden;
}

.cmp-col + .cmp-col,
.dlg-tip {
  margin-top: 20rpx;
}

.cmp-h {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--app-text-primary);
  border-bottom: 2rpx solid var(--app-border);
  background: var(--app-bg-page);
}

.cmp-h::before {
  content: '';
  width: 8rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
}

.cmp-h .sub {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  font-weight: 400;
}

.cmp-h .src {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  font-weight: 400;
  max-width: 40%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cmp-rows {
  padding: 6rpx 24rpx 16rpx;
}

.cmp-r {
  display: flex;
  gap: 18rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx dashed var(--app-border);
  font-size: 24rpx;
  align-items: center;
}

.cmp-r.top {
  align-items: flex-start;
}

.cmp-r:last-child {
  border-bottom: none;
}

.cmp-r .k {
  flex: none;
  width: 120rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
  padding-top: 4rpx;
}

.cmp-r .v {
  flex: 1;
  min-width: 0;
  font-weight: 600;
  color: var(--app-text-primary);
  word-break: break-all;
  line-height: 1.6;
}

/* 差异高亮：蓝 = 可改差异（车牌 / 目的地），红 = 用车人差异 */
.cmp-r .v.diff {
  color: var(--app-brand);
  font-weight: 700;
}

.cmp-r .v.diff-bad {
  color: var(--app-danger);
  font-weight: 700;
}

.cmp-r .c {
  flex: 1;
  min-width: 0;
}

/* 下拉选择行（白底墨边直角，同输入框 token） */
.pick-val {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--app-text-primary);
  font-weight: 600;
  box-sizing: border-box;
}

.pick-val.warn {
  border-color: var(--app-brand);
  background: var(--app-warning-bg);
}

/* 派车单号单行输入（与 .pick-val 同款白底墨边直角） */
.ono-in {
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--app-text-primary);
  font-weight: 600;
  box-sizing: border-box;
}

.note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--app-brand);
  font-weight: 600;
  line-height: 1.7;
}

.note.red {
  color: var(--app-danger);
}

/* 警示说明前置红三角感叹号（图标由 wxml 的 t-icon error-triangle 提供） */
.note-red-x {
  margin-right: 6rpx;
  vertical-align: -3rpx;
}

.linkbtn {
  margin-left: 10rpx;
  padding: 2rpx 14rpx;
  border: 2rpx solid var(--app-brand);
  border-radius: 12rpx;
  color: var(--app-brand);
  font-size: 20rpx;
  font-weight: 700;
}

/* 用车人点亮 chips：直角 + 墨边；点亮=蓝底白字 + 墨硬影；extra 红点=卡片多出；add 绿虚框=表格有卡片缺（点亮后绿实底） */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  min-width: 120rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  color: var(--app-text-primary);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.chip.on {
  background: var(--app-brand);
  border-color: var(--app-text-primary);
  color: var(--app-on-brand);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.chip.extra {
  position: relative;
}

.chip.extra::after {
  content: '';
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--app-danger);
}

.chip.extra.on {
  border-color: var(--app-danger);
  background: var(--app-danger-bg);
  color: var(--app-danger);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.chip.add {
  border-style: dashed;
  border-color: var(--app-success);
  color: var(--app-success);
}

.chip.add.on {
  background: var(--app-success);
  border-style: solid;
  color: var(--app-on-brand);
}

/* 巡视内容只读展示 */
.patrol-ro {
  font-size: 22rpx;
  color: var(--app-text-secondary);
  line-height: 1.8;
  padding-top: 6rpx;
}

.patrol-ro .sub {
  display: block;
  font-size: 20rpx;
  color: var(--app-text-tertiary);
}

.dlg-tip {
  font-size: 22rpx;
  color: var(--app-text-secondary);
  line-height: 2;
  padding: 0 8rpx;
}

/* 弹层页脚：上一条 / 跳过本条 一行，主操作组沿用 .sheet-actions（脚部整体 flex:none + 背景顶线） */
.dlg-foot {
  flex: none;
  margin-top: 8rpx;
  padding-top: 8rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
}

/* 脚部内的操作行不再重复画顶线 */
.dlg-foot .sheet-actions {
  border-top: none;
  padding-top: 0;
}

.foot-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.btn-mini {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  box-sizing: border-box;
}

.btn-mini.disabled {
  color: var(--app-text-tertiary);
  border-color: var(--app-border);
}

.skip {
  font-size: 24rpx;
  color: var(--app-text-secondary);
  font-weight: 700;
  padding: 8rpx 12rpx;
}
