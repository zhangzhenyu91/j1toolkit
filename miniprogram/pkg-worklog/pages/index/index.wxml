<!-- 出工日志 · 主页（默认当天，一卡片 = 一次派车；新建/编辑收进底部表单弹层） -->
<navbar back title="出工日志" />

<view class="page-body" wx:if="{{gate}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <!-- 日期条：±1 天 + 日历入口 -->
  <view class="datebar">
    <view class="arrow" hover-class="hover-scale" bindtap="onPrevDay">
      <t-icon name="chevron-left" size="32rpx" color="#6B7690" />
    </view>
    <view class="dtxt">{{dateText}} {{weekText}}<text class="today" wx:if="{{isToday}}">今天</text></view>
    <view class="arrow" hover-class="hover-scale" bindtap="onNextDay">
      <t-icon name="chevron-right" size="32rpx" color="#6B7690" />
    </view>
    <view class="cal" hover-class="hover-scale" bindtap="onOpenCalendar">
      <t-icon name="calendar" size="36rpx" color="#F26D21" />
    </view>
  </view>

  <!-- 视图开关：全部 / 仅看我（mine 由后端按 sys_user.nickname 匹配成员） -->
  <view class="scopebar">
    <view class="scope-pill {{scope === 'all' ? 'on' : ''}}" hover-class="hover-opacity" bindtap="onScopeChange" data-scope="all">全部</view>
    <view class="scope-pill {{scope === 'mine' ? 'on' : ''}}" hover-class="hover-opacity" bindtap="onScopeChange" data-scope="mine">仅看我</view>
  </view>

  <!-- 日期切换动效容器：随方向从新侧滑入 -->
  <view class="day-pane {{dayAnim}}">
  <!-- 空列表虚线占位（文案随视图口径适配） -->
  <view class="empty-box" wx:if="{{!loading && list.length === 0}}">{{scope === 'mine' ? '当日无包含你的日志' : '当日暂无日志，点击下方新建'}}</view>

  <!-- 日志卡片：巡视内容（主内容块）→ 打卡情况 → 水印照片（id 供报告定位滚动；flash=报告跳转后的短暂高亮） -->
  <view class="card hazard-top logcard {{flashId === item.id ? 'flash' : ''}}" id="logcard-{{item.id}}" wx:for="{{list}}" wx:key="id">
    <view class="lc-body">
      <!-- 车牌头部可点击：打开改派车面板并回填该卡（派车情况/用车人，保存前弹内网派车单同步警告） -->
      <view class="lc-head" hover-class="hover-bg-warm" bindtap="onOpenForm" data-id="{{item.id}}">
        <view class="ci {{item.hasVehicle ? '' : 'ci-gray'}}">
          <t-icon name="vehicle" size="36rpx" color="{{item.hasVehicle ? '#F26D21' : '#A89F8A'}}" />
        </view>
        <view class="plate">{{item.plateText}}</view>
        <view class="badge {{item.badge.cls}}">{{item.badge.text}}</view>
      </view>

      <!-- 未通过明细：角标为「未通过」时逐行列出全部不满足项（后端 verify_reasons，与角标同源） -->
      <view class="lc-fail" wx:if="{{item.failReasons.length}}">
        <view class="lc-fail-line" wx:for="{{item.failReasons}}" wx:key="*this">{{item}}</view>
      </view>

      <!-- 巡视内容：车牌号下方主内容块（橙条浅底，与其他信息区分；点击弹出巡视内容修改层） -->
      <view class="lc-patrol" hover-class="hover-bg-warm" bindtap="onOpenPatrol" data-id="{{item.id}}">
        <view class="lc-patrol-head">
          <view class="lc-patrol-label">巡视内容</view>
          <t-icon class="row-edit" name="edit-1" size="24rpx" color="#C9C0AB" />
        </view>
        <view class="lc-patrol-text">{{item.patrolText}}</view>
      </view>

      <view class="lc-rows">
        <view class="lc-row" wx:if="{{item.checks.length}}">
          <text class="k">打卡情况</text>
          <view class="cks">
            <view
              class="ck-chip {{m.checked ? 'yes' : 'no'}}"
              wx:for="{{item.checks}}"
              wx:for-item="m"
              wx:key="name"
              hover-class="hover-opacity"
              bindtap="onCheckToggle"
              data-entry-id="{{item.id}}"
              data-mid="{{m.mid}}"
              data-index="{{index}}"
            >
              {{m.name}}
              <t-icon name="{{m.checked ? 'check' : 'close'}}" size="20rpx" color="{{m.checked ? '#2BA471' : '#CF4444'}}" />
            </view>
          </view>
        </view>
      </view>

      <!-- 水印照片（无照片且无派车时不显示该区；派车卡无照片时直接显示添加栏） -->
      <view class="lc-photos" wx:if="{{item.showPhotos}}">
        <view class="photo-item" wx:for="{{item.photos}}" wx:for-item="p" wx:key="id">
          <image
            class="ph-img"
            src="{{p.url}}"
            mode="aspectFill"
            bindtap="onPreview"
            data-url="{{p.url}}"
            data-urls="{{item.photoUrls}}"
          />
          <view class="ph-right">
            <!-- ① 照片验证情况（核验通过 / 逐项列出未通过项；验证失败可重新验证） -->
            <view class="ph-status">
              <text class="vtag {{p.verify.cls}}">{{p.verify.text}}</text>
              <text
                class="v-retry"
                wx:if="{{p.statusKey === 'failed'}}"
                hover-class="hover-opacity"
                catchtap="onRetryVerify"
                data-pid="{{p.id}}"
              >重新验证</text>
            </view>
            <!-- ② 照片所属人员（点击弹人名点亮层修改） -->
            <view class="ph-names">
              <t-tag
                wx:for="{{p.members}}"
                wx:for-item="n"
                wx:key="*this"
                theme="primary"
                variant="outline"
                size="small"
                icon="edit-1"
                data-entry-id="{{item.id}}"
                data-pid="{{p.id}}"
                data-names="{{p.members}}"
                bind:click="onPhotoMembers"
              >{{n}}</t-tag>
            </view>
            <!-- ③ 施工内容（行尾复制按钮，点击复制） -->
            <view class="ph-wc {{p.workContent ? '' : 'empty'}}">
              <text class="wc-text">{{p.workContent || '验证后回填'}}</text>
              <t-icon
                wx:if="{{p.workContent}}"
                class="wc-copy"
                name="copy"
                size="26rpx"
                color="#A89F8A"
                catchtap="onCopyWc"
                data-text="{{p.workContent}}"
              />
            </view>
            <!-- ④~⑧ 拍摄时间 / 天气 / 地点 / 经度 / 纬度 -->
            <view class="ph-meta">
              <view class="meta-line"><text class="meta-label">拍摄时间</text><text class="meta-val">{{p.shotTime || '验证后回填'}}</text></view>
              <view class="meta-line"><text class="meta-label">天气</text><text class="meta-val">{{p.weather || '—'}}</text></view>
              <view class="meta-line"><text class="meta-label">地点</text><text class="meta-val">{{p.location || '—'}}</text></view>
              <view class="meta-line"><text class="meta-label">经度</text><text class="meta-val">{{p.lng || '—'}}</text></view>
              <view class="meta-line"><text class="meta-label">纬度</text><text class="meta-val">{{p.lat || '—'}}</text></view>
            </view>
          </view>
          <!-- 删除照片 -->
          <view class="ph-del" hover-class="hover-scale" catchtap="onDeletePhoto" data-pid="{{p.id}}">
            <t-icon name="delete" size="32rpx" color="#CF4444" />
          </view>
        </view>
        <!-- 添加水印照片（仅派车卡；无用车人时点击提示） -->
        <view
          class="add-photo"
          wx:if="{{item.hasVehicle}}"
          hover-class="hover-opacity"
          bindtap="onAddPhoto"
          data-entry-id="{{item.id}}"
        >
          <t-icon name="add" size="40rpx" color="#A89F8A" />
          添加水印照片
        </view>
      </view>

      <view class="lc-actions">
        <view class="act act-del" hover-class="hover-opacity" bindtap="onDelete" data-id="{{item.id}}">删 除</view>
      </view>
    </view>
  </view>
  </view>
</view>

<!-- 底部固定区：管理员入口 + 批量下载/查看报告/新建日志（1:1:1.5） -->
<view class="bottombar" wx:if="{{gate}}">
  <view class="admin-link" wx:if="{{isAdmin}}" hover-class="hover-opacity" bindtap="onManage">
    <text class="admin-link-b">常用数据管理</text>
  </view>
  <view class="btns">
    <view class="btn-download" hover-class="hover-opacity" bindtap="onOpenDownload">
      <t-icon name="download" size="32rpx" color="#22314E" />
      批量下载
    </view>
    <view class="btn-download btn-report" hover-class="hover-opacity" bindtap="onOpenReport">
      <t-icon name="chart-bar" size="32rpx" color="#22314E" />
      查看报告
    </view>
    <view class="btn-primary btn-create" hover-class="hover-opacity" bindtap="onCreate">
      <t-icon name="add" size="36rpx" color="#FFFFFF" />
      新建日志
    </view>
  </view>
</view>

<!-- 日历选日（按日验证状态着色；单选无确认按钮，点日期即选中并自动关闭） -->
<t-calendar
  id="wl-calendar"
  visible="{{calVisible}}"
  value="{{calValue}}"
  type="single"
  switch-mode="month"
  min-date="{{minDate}}"
  max-date="{{maxDate}}"
  confirm-btn="{{null}}"
  bind:change="onCalChange"
  bind:close="onCalClose"
  bind:panel-change="onCalPanelChange"
>
  <view slot="title" class="cal-title">
    选择日期
    <view class="cal-legend">
      <text><text class="lg lg-g"></text>全部通过</text>
      <text><text class="lg lg-b"></text>有未通过</text>
      <text>无底色＝无记录 / 仅免验证</text>
    </view>
  </view>
</t-calendar>

<!-- 新建/改派车表单底部弹层（无实时保存，「保 存」提交；键盘弹起时动态抬高底部 padding） -->
<t-popup visible="{{formVisible}}" placement="bottom" bind:visible-change="onFormVisibleChange">
  <view class="form-sheet" style="padding-bottom: {{keyboardHeight ? keyboardHeight + 'px' : 'calc(24rpx + env(safe-area-inset-bottom))'}};">
    <view class="sheet-title">{{formId ? '修改派车' : '新建日志'}}</view>
    <scroll-view scroll-y class="form-scroll" enhanced show-scrollbar="{{false}}">
      <!-- 日期 chip -->
      <view class="date-chip">
        <t-icon name="calendar" size="28rpx" color="#F26D21" />
        {{formDateStr}}
      </view>

      <!-- 派车情况（车牌/目的地行内联展开筛选下拉，手风琴互斥） -->
      <view class="sec-row">
        <view class="section-title">派车情况</view>
      </view>
      <view class="form-card">
        <view class="frow" hover-class="hover-bg-warm" bindtap="onToggleVehicleDrop">
          <text class="fk">车牌号</text>
          <view class="fv {{vehicleId === 0 ? 'placeholder' : ''}}">
            {{vehicleId === 0 ? '请选择车牌号' : vehicleText}}
            <text class="badge-mini" wx:if="{{isNoVehicle}}">无派车</text>
          </view>
          <t-icon name="{{dropType === 'vehicle' ? 'chevron-up' : 'chevron-down'}}" size="32rpx" color="#C9C0AB" />
        </view>
        <!-- 内联展开：车牌筛选面板（末位固定「未出车」带灰徽章） -->
        <view class="drop-panel" wx:if="{{dropType === 'vehicle'}}">
          <view class="drop-search">
            <t-icon name="search" size="30rpx" color="#A89F8A" />
            <input class="drop-input" value="{{dropKeyword}}" bindinput="onDropInput" placeholder="输入关键字筛选" placeholder-class="ph" />
          </view>
          <scroll-view scroll-y class="drop-list" wx:if="{{dropList.length}}">
            <view
              class="drop-item {{item.selected ? 'on' : ''}} {{item.none ? 'none' : ''}}"
              wx:for="{{dropList}}"
              wx:key="id"
              hover-class="hover-bg-warm"
              bindtap="onDropSelect"
              data-id="{{item.id}}"
            >
              <text>{{item.name}}</text>
              <text class="badge-mini" wx:if="{{item.none}}">无派车</text>
              <t-icon wx:if="{{item.selected && !item.none}}" name="check" size="28rpx" color="#F26D21" />
            </view>
          </scroll-view>
          <view class="drop-empty" wx:else>无匹配项</view>
        </view>
        <view class="frow {{isNoVehicle ? 'disabled' : ''}}" hover-class="{{isNoVehicle ? '' : 'hover-bg-warm'}}" bindtap="onToggleDestDrop">
          <text class="fk">目的地</text>
          <view class="fv {{destId === 0 || isNoVehicle ? 'placeholder' : ''}}">
            {{isNoVehicle ? '未出车不可选' : destId === 0 ? '请选择目的地' : destText}}
          </view>
          <t-icon wx:if="{{!isNoVehicle}}" name="{{dropType === 'dest' ? 'chevron-up' : 'chevron-down'}}" size="32rpx" color="#C9C0AB" />
        </view>
        <!-- 内联展开：目的地筛选面板 -->
        <view class="drop-panel" wx:if="{{dropType === 'dest'}}">
          <view class="drop-search">
            <t-icon name="search" size="30rpx" color="#A89F8A" />
            <input class="drop-input" value="{{dropKeyword}}" bindinput="onDropInput" placeholder="输入关键字筛选" placeholder-class="ph" />
          </view>
          <scroll-view scroll-y class="drop-list" wx:if="{{dropList.length}}">
            <view
              class="drop-item {{item.selected ? 'on' : ''}}"
              wx:for="{{dropList}}"
              wx:key="id"
              hover-class="hover-bg-warm"
              bindtap="onDropSelect"
              data-id="{{item.id}}"
            >
              <text>{{item.name}}</text>
              <t-icon wx:if="{{item.selected}}" name="check" size="28rpx" color="#F26D21" />
            </view>
          </scroll-view>
          <view class="drop-empty" wx:else>无匹配项</view>
        </view>
      </view>

      <!-- 未出车联动提示条 -->
      <view class="tip" wx:if="{{isNoVehicle}}">
        <view class="ti">
          <t-icon name="info-circle" size="36rpx" color="#F26D21" />
        </view>
        <view>
          <text class="tip-t">已选择「未出车」</text>
          <view class="tip-p">人员选择已隐藏；未出车卡片不参与记录验证（免验证）。派车卡改未出车前需先删除水印照片。</view>
        </view>
      </view>

      <!-- 人员选择（点亮即用车人） -->
      <block wx:if="{{!isNoVehicle}}">
        <view class="sec-row">
          <view class="section-title">人员选择</view>
          <view class="sec-note">点亮即用车人</view>
        </view>
        <view class="tags">
          <t-check-tag
            wx:for="{{members}}"
            wx:key="id"
            checked="{{item.checked}}"
            content=""
            data-index="{{index}}"
            bind:change="onMemberTagChange"
            shape="round"
            variant="outline"
            size="medium"
          >{{item.name}}</t-check-tag>
        </view>
      </block>
    </scroll-view>

    <!-- 底部「保 存」（遮罩关闭 = 放弃修改） -->
    <view class="form-foot">
      <view class="btn-primary" hover-class="hover-opacity" bindtap="onFormSave">{{formSaving ? '正在保存…' : '保 存'}}</view>
    </view>
  </view>
</t-popup>

<!-- 巡视内容修改弹层（点卡片巡视内容主块弹出；快捷输入同水印施工内容；「保 存」提交，无实时保存） -->
<t-popup visible="{{patrolVisible}}" placement="bottom" bind:visible-change="onPatrolVisibleChange">
  <view class="sheet" style="padding-bottom: {{keyboardHeight ? keyboardHeight + 'px' : 'calc(40rpx + env(safe-area-inset-bottom))'}};">
    <view class="sheet-title">修改巡视内容</view>
    <view class="sec-row">
      <view class="section-title">巡视内容</view>
      <view class="wm-quick">
        <text
          wx:for="{{quickInputs}}"
          wx:key="*this"
          class="wm-quick-chip"
          hover-class="hover-opacity"
          data-text="{{item}}"
          bindtap="onPatrolQuickInput"
        >{{item}}</text>
      </view>
    </view>
    <view class="textarea-wrap">
      <textarea
        class="textarea"
        value="{{patrolDraft}}"
        bindinput="onPatrolInput"
        placeholder="请输入巡视内容（可空）"
        placeholder-class="ph"
        adjust-position="{{false}}"
        bindkeyboardheightchange="onKeyboardHeight"
        auto-height
        maxlength="-1"
      />
    </view>
    <view class="sheet-actions">
      <view class="btn-ghost" hover-class="hover-opacity" bindtap="onPatrolCancel">取 消</view>
      <view class="btn-dark" hover-class="hover-opacity" bindtap="onPatrolSave">
        <t-icon name="check" size="34rpx" color="#FFFFFF" />
        {{patrolSaving ? '正在保存…' : '保 存'}}
      </view>
    </view>
  </view>
</t-popup>

<!-- 批量下载面板（高度同日历展开，圆角顶；照片按月份分卡、3 列网格） -->
<t-popup visible="{{dlVisible}}" placement="bottom" bind:visible-change="onDlVisibleChange">
  <view class="dl-sheet">
    <view class="dl-head">
      <view class="dl-title">批量下载水印照片</view>
      <view class="dl-close" hover-class="hover-opacity" bindtap="onCloseDownload">
        <t-icon name="close" size="36rpx" color="#6B7690" />
      </view>
    </view>
    <!-- 日期范围行（改日期：先关本面板再开 range 日历，规避叠层 z-index 冲突） -->
    <view class="dl-range">
      <text class="dl-range-text">{{dlRangeText}}</text>
      <view class="dl-mine {{dlOnlyMine ? 'on' : ''}}" hover-class="hover-opacity" bindtap="onDlToggleMine">仅看我</view>
      <view class="dl-change" hover-class="hover-opacity" bindtap="onDlChangeDate">改日期</view>
    </view>

    <scroll-view scroll-y class="dl-body" enhanced show-scrollbar="{{false}}">
      <view class="dl-empty" wx:if="{{!dlLoading && dlTotal === 0}}">{{dlOnlyMine ? '该范围内暂无含你名字的水印照片' : '该范围内暂无水印照片'}}</view>
      <!-- 一个月份一个卡片 -->
      <view class="dl-month-card" wx:for="{{dlGroups}}" wx:for-item="g" wx:for-index="gi" wx:key="month">
        <view class="dl-month-title">{{g.title}}</view>
        <view class="dl-grid">
          <view class="dl-cell" wx:for="{{g.photos}}" wx:for-item="p" wx:for-index="pi" wx:key="id">
            <image class="dl-thumb" src="{{p.url}}" mode="aspectFill" bindtap="onDlPreview" data-url="{{p.url}}" />
            <view class="dl-day">{{p.day}}日</view>
            <view class="dl-ring {{p.selected ? 'on' : ''}}" catchtap="onDlToggle" data-gi="{{gi}}" data-pi="{{pi}}">
              <t-icon wx:if="{{p.selected}}" name="check" size="22rpx" color="#FFFFFF" />
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部固定栏：全选 + 已选计数 / 下载主按钮 -->
    <view class="dl-foot">
      <view class="dl-all" hover-class="hover-opacity" bindtap="onDlToggleAll">
        <view class="dl-ring dl-ring-static {{dlAllChecked ? 'on' : ''}}">
          <t-icon wx:if="{{dlAllChecked}}" name="check" size="22rpx" color="#FFFFFF" />
        </view>
        <text>全选</text>
        <text class="dl-count">已选 {{dlSelected}} 张</text>
      </view>
      <view class="dl-btn {{dlSelected === 0 ? 'disabled' : ''}}" hover-class="{{dlSelected === 0 ? '' : 'hover-opacity'}}" bindtap="onDlDownload">下 载</view>
    </view>
  </view>
</t-popup>

<!-- 验证不通过报告面板（高度同日历展开，骨架复用 dl-* 类；按日期分组列出不通过记录及全部原因） -->
<t-popup visible="{{rpVisible}}" placement="bottom" bind:visible-change="onRpVisibleChange">
  <view class="dl-sheet">
    <view class="dl-head">
      <view class="dl-title">验证不通过报告</view>
      <view class="dl-close" hover-class="hover-opacity" bindtap="onCloseReport">
        <t-icon name="close" size="36rpx" color="#6B7690" />
      </view>
    </view>
    <!-- 日期范围行（仅看我=个人口径；改日期：先关本面板再开 range 日历，规避叠层 z-index 冲突） -->
    <view class="dl-range">
      <text class="dl-range-text">{{rpRangeText}}</text>
      <view class="dl-mine {{rpOnlyMine ? 'on' : ''}}" hover-class="hover-opacity" bindtap="onRpToggleMine">仅看我</view>
      <view class="dl-change" hover-class="hover-opacity" bindtap="onRpChangeDate">改日期</view>
    </view>

    <scroll-view scroll-y class="dl-body" enhanced show-scrollbar="{{false}}">
      <view class="dl-empty" wx:if="{{!rpLoading && rpTotal === 0}}">{{rpOnlyMine ? '该范围内暂无与你相关的不通过记录' : '该范围内暂无验证不通过记录'}}</view>
      <!-- 一个日期一个卡片 -->
      <view class="dl-month-card" wx:for="{{rpGroups}}" wx:key="date">
        <view class="dl-month-title">{{item.title}}</view>
        <!-- 记录可点击：关闭报告并跳到该日对应卡片（滚动定位 + 高亮） -->
        <view class="rp-item" wx:for="{{item.items}}" wx:for-item="r" wx:key="id" hover-class="hover-opacity" bindtap="onRpItemTap" data-id="{{r.id}}" data-date="{{r.date}}">
          <view class="rp-plate">{{r.plateText}}<text class="rp-members">用车人：{{r.membersText}}</text><t-icon class="rp-go" name="chevron-right" size="28rpx" color="#C9C0AB" /></view>
          <view class="rp-reason" wx:for="{{r.reasons}}" wx:for-item="reason" wx:key="*this">{{reason}}</view>
        </view>
      </view>
    </scroll-view>
  </view>
</t-popup>

<!-- 下载/报告面板改日期：range 日历（与两面板互斥开合，_rangeCalFor 标记回开对象；confirm 取 e.detail.value 两个时间戳） -->
<t-calendar
  visible="{{dlCalVisible}}"
  value="{{dlCalValue}}"
  type="range"
  allow-same-day
  switch-mode="month"
  min-date="{{minDate}}"
  max-date="{{maxDate}}"
  title="选择日期范围"
  confirm-btn="确定选择"
  bind:confirm="onDlCalConfirm"
  bind:close="onDlCalClose"
/>

<!-- 照片人名点亮弹层（添加 / 修改复用） -->
<t-popup visible="{{memberVisible}}" placement="bottom" bind:visible-change="onMemberVisibleChange">
  <view class="sheet">
    <view class="sheet-title">选择照片所属人名</view>
    <view class="sheet-note">点亮即本张水印照片中包含的人名（可多选）</view>
    <view class="tags">
      <t-check-tag
        wx:for="{{candidates}}"
        wx:key="name"
        checked="{{item.checked}}"
        disabled="{{item.disabled}}"
        content=""
        data-index="{{index}}"
        bind:change="onCandidateChange"
        shape="round"
        variant="outline"
        size="medium"
      >
        {{item.name}}<text class="ctag-note" wx:if="{{item.disabled}}">已上传</text>
      </t-check-tag>
    </view>
    <view class="sheet-actions">
      <view class="btn-ghost" hover-class="hover-opacity" bindtap="onMemberCancel">取 消</view>
      <!-- 加水印流程多出「拍摄」：点亮人名后直接调相机 -->
      <view
        class="btn-dark flex-even"
        wx:if="{{memberMode === 'add' && memberAction === 'wm'}}"
        hover-class="hover-opacity"
        bindtap="onMemberShoot"
      >
        <t-icon name="camera" size="34rpx" color="#FFFFFF" />
        拍 摄
      </view>
      <view class="btn-dark" hover-class="hover-opacity" bindtap="onMemberConfirm">
        <t-icon name="{{memberMode === 'add' ? 'image' : 'check'}}" size="34rpx" color="#FFFFFF" />
        {{memberMode === 'add' ? '选择照片' : '确认修改'}}
      </view>
    </view>
  </view>
</t-popup>

<!-- 水印字段编辑弹层（「选择照片并添加水印」选片后弹出；确认后由服务端加水印再走原上传/验证流程） -->
<t-popup visible="{{wmVisible}}" placement="bottom" bind:visible-change="onWmVisibleChange">
  <view class="sheet">
    <view class="sheet-title">编辑水印信息</view>
    <view class="sheet-note">确认后由服务端将水印叠加到所选照片，并上传进入验证</view>
    <scroll-view scroll-y class="wm-scroll" enhanced show-scrollbar="{{false}}">
      <!-- 所选原图 + 所属人名 -->
      <view class="wm-head">
        <image class="wm-thumb" src="{{wmPhotoPath}}" mode="aspectFill" />
        <view class="wm-head-r">
          <view class="wm-names">
            <t-tag wx:for="{{wmNames}}" wx:key="*this" theme="primary" variant="outline" size="small">{{item}}</t-tag>
          </view>
          <view class="wm-names-tip">照片所属人名</view>
        </view>
      </view>
      <view class="form-card wm-card">
        <view class="wm-row-col">
          <view class="wm-wc-head">
            <text class="fk">施工内容</text>
            <view class="wm-quick">
              <text
                wx:for="{{quickInputs}}"
                wx:key="*this"
                class="wm-quick-chip"
                hover-class="hover-opacity"
                data-text="{{item}}"
                bindtap="onWmQuickInput"
              >{{item}}</text>
            </view>
          </view>
          <view class="textarea-wrap wm-textarea">
            <textarea
              class="textarea"
              value="{{wmForm.content}}"
              data-field="content"
              bindinput="onWmInput"
              placeholder="请输入施工内容"
              placeholder-class="ph"
              auto-height
              maxlength="500"
            />
          </view>
        </view>
        <view class="frow">
          <text class="fk">拍摄时间</text>
          <input class="wm-input" value="{{wmForm.time}}" data-field="time" bindinput="onWmInput" placeholder="请输入拍摄时间" placeholder-class="ph" maxlength="16" />
        </view>
        <view class="frow">
          <text class="fk">天气</text>
          <input class="wm-input" value="{{wmForm.weather}}" data-field="weather" bindinput="onWmInput" placeholder="请输入天气" placeholder-class="ph" maxlength="64" />
        </view>
        <view class="frow">
          <text class="fk">地点</text>
          <input class="wm-input" value="{{wmForm.location}}" data-field="location" bindinput="onWmInput" placeholder="请输入地点" placeholder-class="ph" maxlength="250" />
        </view>
        <view class="frow">
          <text class="fk">经度</text>
          <input class="wm-input" value="{{wmForm.lng}}" data-field="lng" bindinput="onWmInput" type="digit" placeholder="请输入经度" placeholder-class="ph" maxlength="16" />
        </view>
        <view class="frow">
          <text class="fk">纬度</text>
          <input class="wm-input" value="{{wmForm.lat}}" data-field="lat" bindinput="onWmInput" type="digit" placeholder="请输入纬度" placeholder-class="ph" maxlength="16" />
        </view>
        <!-- 防伪码：自动生成，不可编辑 -->
        <view class="frow">
          <text class="fk">防伪码</text>
          <view class="fv wm-code">{{wmCode}}</view>
          <view class="wm-refresh" hover-class="hover-opacity" bindtap="onWmCodeRefresh">
            <t-icon name="refresh" size="30rpx" color="#F26D21" />
            <text>换一换</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="sheet-actions">
      <view class="btn-ghost" hover-class="hover-opacity" bindtap="onWmCancel">取 消</view>
      <view class="btn-dark" hover-class="hover-opacity" bindtap="onWmConfirm">
        <t-icon name="image" size="34rpx" color="#FFFFFF" />
        {{wmUploading ? '正在加水印上传…' : '确认，加水印上传'}}
      </view>
    </view>
  </view>
</t-popup>

<!-- 添加照片二选一（自绘弹层；不用 t-action-sheet——其仅分包使用会触发主包冗余 JS 审计警告） -->
<t-popup visible="{{addSheetVisible}}" placement="bottom" bind:visible-change="onAddSheetVisibleChange">
  <view class="sheet">
    <view class="sheet-title">添加水印照片</view>
    <view class="sheet-note">请选择上传方式</view>
    <view class="addsheet-btns">
      <view class="addsheet-opt" hover-class="hover-bg-warm" bindtap="onAddSheetRaw">
        <view class="ao-title">选择水印照片上传</view>
        <view class="ao-note">照片已带水印，直接上传进入验证</view>
      </view>
      <view class="addsheet-opt" hover-class="hover-bg-warm" bindtap="onAddSheetWm">
        <view class="ao-title">拍摄/选择照片并添加水印</view>
        <view class="ao-note">拍照或选原图并编辑字段，由服务端添加水印后上传</view>
      </view>
      <view class="btn-ghost addsheet-cancel" hover-class="hover-opacity" bindtap="onAddSheetCancel">取 消</view>
    </view>
  </view>
</t-popup>

<!-- 4:3 裁剪层（加水印流程：拍摄必裁；相册非 4:3 才裁。横拍锁横向 4:3、纵拍锁纵向 3:4；拖拽/双指缩放调整取景） -->
<t-popup visible="{{cropVisible}}" placement="bottom" bind:visible-change="onCropVisibleChange">
  <view class="crop-sheet">
    <view class="crop-title">调整裁剪区域</view>
    <view class="crop-note">{{cropLandscape ? '已锁定横向 4:3' : '已锁定纵向 4:3'}}，拖动或双指缩放调整取景</view>
    <view class="crop-stage" style="width: {{cropFrameW}}px; height: {{cropFrameH}}px;">
      <movable-area class="crop-area" style="width: {{cropFrameW}}px; height: {{cropFrameH}}px;" scale-area>
        <movable-view
          class="crop-view"
          style="width: {{cropViewW}}px; height: {{cropViewH}}px;"
          x="{{cropX}}"
          y="{{cropY}}"
          scale
          scale-min="1"
          scale-max="5"
          scale-value="{{cropScale}}"
          direction="all"
          bindchange="onCropMove"
          bindscale="onCropScale"
        >
          <image class="crop-img" src="{{cropSrc}}" mode="scaleToFill" />
        </movable-view>
      </movable-area>
      <!-- 四角取景框（橙色描边，特征元素） -->
      <view class="crop-corner tl" />
      <view class="crop-corner tr" />
      <view class="crop-corner bl" />
      <view class="crop-corner br" />
    </view>
    <view class="sheet-actions">
      <view class="btn-ghost" hover-class="hover-opacity" bindtap="onCropCancel">取 消</view>
      <view class="btn-dark" hover-class="hover-opacity" bindtap="onCropConfirm">
        <t-icon name="check" size="34rpx" color="#FFFFFF" />
        {{cropExporting ? '正在处理…' : '确认裁剪'}}
      </view>
    </view>
  </view>
</t-popup>

<!-- 裁剪导出用离屏 canvas（type=2d；导出尺寸在 JS 中按裁剪结果设置） -->
<canvas type="2d" id="wmCropCanvas" class="crop-canvas" />

<t-dialog id="t-dialog" />
<t-toast id="t-toast" />
