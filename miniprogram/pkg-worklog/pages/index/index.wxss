@import '../../style/common.wxss';

/* 整页 flex 纵列：导航/班组切换/日期条/视图开关固定，「仅看我」按钮以下为通高切日 swiper 区；
   底部为右下悬浮主钮（≈108rpx + 底部偏移），窗格内容底部预留 220rpx 避免最后一张卡片被遮挡 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-bottom: 0; /* 全局 .page-body 的底部留白改到 .day-pane（滚区内部） */
}

/* ---------- 切日 swiper（三窗格预渲染 前/今/后一天；通高 flex:1，每格独立纵向滚动） ---------- */
.day-swiper {
  flex: 1;
  min-height: 0;
  /* 与视图开关上方留白一致；左右各 -28rpx 恰好抵消 page-body 侧 padding 吃到屏边（不再向屏外多伸）——
     配合窗格左右各 28rpx 内边距：静止时卡片与上方日期条/开关对齐留白（28rpx），
     滑动时相邻两天卡片之间露出 56rpx 间隙（左右内边距之和） */
  margin: 28rpx -28rpx 0 -28rpx;
}

.day-pane .mt-0 {
  margin-top: 0; /* 窗格首元素（首卡/空态）去上 margin，与视图开关的间距统一由 .day-swiper 掌管 */
}

.day-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 0 28rpx; /* 卡片静止时左右留白与页面对齐；滑动时邻卡间隙 = 左右内边距之和（56rpx） */
}

.day-pane {
  box-sizing: border-box;
  padding-bottom: 220rpx; /* 悬浮主钮避让（原 page-body 底部留白移入滚区） */
}

/* ---------- 班组切换器（屏五：超管可点 chip 下拉切换；其余角色静态班组名标签） ---------- */
.tswitch {
  position: relative;
  z-index: 20;
  margin-bottom: 20rpx;
}

.ts-cur {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 2rpx solid #e3dccb;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #22314e;
}

.ts-cur .arr {
  color: #f26d21;
  font-size: 18rpx;
}

/* 下拉入场：chip 下方轻微上浮 + 淡入（克制，同全局 fadeUp/fadeIn 风格）；收起直消不加动画 */
@keyframes ts-drop-in {
  from {
    opacity: 0;
    transform: translateY(-6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ts-drop {
  position: absolute;
  top: 76rpx;
  left: 0;
  z-index: 21;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 24rpx 64rpx rgba(34, 49, 78, 0.18);
  padding: 12rpx;
  min-width: 300rpx;
  animation: ts-drop-in 0.2s ease-out;
}

.ts-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.ts-opt.on {
  background: #fdeee2;
  color: #f26d21;
}

.ts-opt .ck {
  margin-left: auto;
  font-size: 22rpx;
}

/* 点空白处收起下拉（层级低于切换器本体）；遮罩淡入 */
@keyframes ts-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.ts-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  animation: ts-mask-in 0.15s ease-out;
}

/* ---------- 未分配班组空态（屏十） ---------- */
.team-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.team-empty .te-ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: #fdeee2;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-empty .te-t {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.team-empty .te-p {
  font-size: 23rpx;
  color: #6b7690;
  line-height: 1.8;
  text-align: center;
}

/* ---------- 日期条 ---------- */
.datebar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(34, 49, 78, 0.06);
}

.datebar .arrow {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border-radius: 16rpx;
  background: #f4f1ea;
  display: flex;
  align-items: center;
  justify-content: center;
}

.datebar .dtxt {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.datebar .dtxt .today {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6b7690;
}

.datebar .cal {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 16rpx;
  background: #fdeee2;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 空列表虚线占位 ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed #d9cfba;
  border-radius: 20rpx;
  padding: 64rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}

/* ---------- 日志卡片 ---------- */
.logcard {
  margin-top: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(34, 49, 78, 0.06);
}

/* 报告跳转定位：目标卡片短暂高亮（橙色描边呼吸，1.6s 后由 JS 移除 flash 类） */
.logcard.flash {
  animation: wl-flash 0.8s ease-in-out 2;
}

@keyframes wl-flash {
  0%,
  100% {
    box-shadow: 0 16rpx 40rpx rgba(34, 49, 78, 0.06);
  }
  50% {
    box-shadow: 0 0 0 6rpx rgba(242, 109, 33, 0.45);
  }
}

.lc-body {
  padding: 38rpx 32rpx 20rpx; /* 顶部留白给警示斜纹条 */
}

.lc-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.lc-head .ci {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 18rpx;
  background: #fdeee2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lc-head .ci.ci-gray {
  background: #f4f1ea;
}

.lc-head .plate {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

/* 跨班日志徽章：橙色描边小签（紧跟车牌，同网页端 .tag-cross 与身份标签规范） */
.tag-cross {
  flex: none;
  border: 2rpx solid #f26d21;
  color: #f26d21;
  border-radius: 8rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  white-space: nowrap;
}

/* 记录验证状态角标（描边徽章） */
.badge {
  margin-left: auto;
  border: 2rpx solid #f26d21;
  color: #f26d21;
  border-radius: 8rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  white-space: nowrap;
}

.badge.green {
  border-color: #2ba471;
  color: #2ba471;
}

.badge.red {
  border-color: #cf4444;
  color: #cf4444;
}

.badge.gray {
  border-color: #d9cfba;
  color: #a89f8a;
}

/* 未通过明细：红底块逐行列出全部不满足项（与右上角角标同源，后端 verify_reasons） */
.lc-fail {
  margin-top: 16rpx;
  background: #fbe9e9;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}

.lc-fail-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #cf4444;
  line-height: 1.7;
}

/* 红点：按首行文字中线对齐（行高 24*1.7=40.8rpx，(40.8-8)/2≈16rpx），避免 baseline 对齐导致偏低 */
.lc-fail-line::before {
  content: '';
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: #cf4444;
}

/* 巡视内容：车牌号下方主内容块（橙条浅底，与其他信息区分） */
.lc-patrol {
  margin-top: 20rpx;
  background: #faf8f1;
  border-left: 8rpx solid #f26d21;
  border-radius: 16rpx;
  padding: 18rpx 24rpx 20rpx;
}

.lc-patrol-head {
  display: flex;
  align-items: center;
}

.lc-patrol-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #a89f8a;
  letter-spacing: 6rpx;
}

.lc-patrol-head .row-edit {
  margin-left: auto;
}

.lc-patrol-text {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #22314e;
  line-height: 1.6;
}

/* 卡片内水印照片区（覆盖共享 .photo-item 的内边距与分隔线） */
.lc-photos {
  margin-top: 16rpx;
  border-top: 2rpx solid #f1ebdc;
}

.lc-photos .photo-item {
  padding: 18rpx 0;
}

.lc-photos .photo-item + .photo-item {
  border-top: 2rpx dashed #ede6d4;
}

/* 无照片时添加栏是区块首个子元素，与顶部分隔线拉开距离；
   有照片时保持原间距（photo-item 的 18rpx 下内边距已够） */
.lc-photos .add-photo:first-child {
  margin-top: 20rpx;
}

/* 卡片底部操作 */
.lc-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f1ebdc;
}

.lc-actions .act {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

/* 从商旅同步入口（与备注/删除同族幽灵钮，安全橙描边） */
.act-sync {
  background: #ffffff;
  color: #f26d21;
  border: 2rpx solid #f5c9a3;
  box-sizing: border-box;
}

.act-del {
  background: #ffffff;
  color: #cf4444;
  border: 2rpx solid #efc9c9;
  box-sizing: border-box;
}

/* 备注入口按钮（与删除同族幽灵钮，藏青描边） */
.act-note {
  background: #ffffff;
  color: #22314e;
  border: 2rpx solid #c7cfdd;
  box-sizing: border-box;
}

/* ---------- 备注块（「添加水印照片」虚线框下方；黄条浅底与巡视内容橙条同族，无备注不渲染） ---------- */
.lc-rmk {
  margin-top: 20rpx;
  background: #fdf6e3;
  border-left: 8rpx solid #eab308;
  border-radius: 16rpx;
  padding: 16rpx 24rpx 20rpx;
}

.lc-rmk-label {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #eab308;
  letter-spacing: 6rpx;
}

.lc-rmk-label .row-edit {
  margin-left: auto;
}

/* 备注文字：与照片右侧施工内容同字号（26rpx），明黄（与验证报告备注同色，加重字重保证浅底可读） */
.lc-rmk-text {
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #eab308;
  line-height: 1.6;
}

/* 附件：图片 / 视频缩略图（视频无封面，深色底 + 播放标） */
.rmk-files {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rf-thumb {
  width: 92rpx;
  height: 92rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid #efe3bc;
  background: #22314e;
}

.rf-img {
  width: 92rpx;
  height: 92rpx;
  display: block;
}

.rf-video {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 附件：Office 文档仅可点击文件名（下划线 + 安全橙） */
.rmk-docs {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.rf-doc {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  min-width: 0;
}

.rf-doc .fn {
  color: #f26d21;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 日历弹层标题与图例 ---------- */
/* 使用 title 插槽自定义「标题+图例」，隐藏组件默认标题文案避免重复 */
.t-calendar__title > text {
  display: none;
}

.cal-title {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #22314e;
}

.cal-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #6b7690;
  letter-spacing: 2rpx;
}

.cal-legend .lg {
  display: inline-block;
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  vertical-align: -3rpx;
}

.cal-legend .lg-g {
  background: #e3f2ec;
  border: 2rpx solid #bfe3d6;
}

.cal-legend .lg-b {
  background: #fbe9e9;
  border: 2rpx solid #efc9c9;
}

.cal-legend .lg-y {
  background: #fdf3cf;
  border: 2rpx solid #f0dfa8;
}

/* ---------- t-calendar 按日着色 ----------
   format 注入的 className 落在 .t-calendar__dates-item 上；
   组件 styleIsolation 为 apply-shared，页面样式可生效。
   优先级需高于组件自身的 --selected 选中态，着色后选中以橙色描边区分。 */
.t-calendar__dates-item.wl-cal-passed {
  background: #e3f2ec;
  color: #2ba471;
  font-weight: 700;
}

.t-calendar__dates-item.wl-cal-failed {
  background: #fbe9e9;
  color: #cf4444;
  font-weight: 700;
}

/* 黄 = 验证通过但有备注（深黄文字保证浅黄底上可读） */
.t-calendar__dates-item.wl-cal-remark {
  background: #fdf3cf;
  color: #8a6d00;
  font-weight: 700;
}

.t-calendar__dates-item--selected.wl-cal-passed,
.t-calendar__dates-item--selected.wl-cal-failed,
.t-calendar__dates-item--selected.wl-cal-remark {
  outline: 4rpx solid #f26d21;
  outline-offset: -4rpx;
}

/* 「今天」醒目标记：加粗 + 橙色小圆点（与着色类可叠加） */
.t-calendar__dates-item.wl-cal-today {
  position: relative;
  font-weight: 800;
}

.t-calendar__dates-item.wl-cal-today:not(.wl-cal-passed):not(.wl-cal-failed):not(.wl-cal-remark) {
  color: #f26d21;
}

.t-calendar__dates-item.wl-cal-today::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #f26d21;
}

/* 选中日同为「今天」且无验证底色时：橙底上文字与圆点改白（避免橙橙相消看不见数字）；
   有验证底色（passed/failed/remark）时保持绿/红/黄状态色，否则浅底上白字不可见 */
.t-calendar .t-calendar__dates-item.t-calendar__dates-item--selected.wl-cal-today:not(.wl-cal-passed):not(.wl-cal-failed):not(.wl-cal-remark) {
  color: #ffffff;
}

.t-calendar .t-calendar__dates-item--selected.wl-cal-today:not(.wl-cal-passed):not(.wl-cal-failed):not(.wl-cal-remark)::after {
  background: #ffffff;
}

/* ---------- 日历左右滑动切换月份动画 ----------
   类名经 t-class 落在组件根上（styleIsolation apply-shared，页面样式可达内部）；
   新月份网格按滑动方向平移进入（先清空再 nextTick 重放，连切同向也重新触发） */
.wl-cal-from-right .t-calendar__dates {
  animation: wl-cal-in-right 0.28s ease-out;
}

.wl-cal-from-left .t-calendar__dates {
  animation: wl-cal-in-left 0.28s ease-out;
}

@keyframes wl-cal-in-right {
  from {
    transform: translateX(120rpx);
    opacity: 0.2;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes wl-cal-in-left {
  from {
    transform: translateX(-120rpx);
    opacity: 0.2;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

/* ============================================================
   视图开关 / 可点行提示 / 底部双按钮 / 表单弹层 / 批量下载面板
   ============================================================ */

/* ---------- 视图开关（全部 / 仅看我）：胶囊按钮，激活=橙底橙边 ---------- */
.scopebar {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.scope-pill {
  padding: 10rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 2rpx solid #e3dccb;
  color: #6b7690;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.scope-pill.on {
  background: #f26d21;
  border-color: #f26d21;
  color: #ffffff;
}

/* ---------- 右下悬浮按钮（speed dial：主钮＋/× 点按展开，遮罩淡出关闭；原底部固定区已删除） ---------- */
.fab-mask {
  position: fixed;
  inset: 0;
  z-index: 110;
  background: rgba(27, 39, 64, 0.3);
  animation: fabFade 0.25s ease both;
}

.fabs {
  position: fixed;
  right: 28rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 120;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 24rpx;
}

/* 展开项：wx:if 挂载即播入场动画，自上而下错峰 */
.fab-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  animation: fabUp 0.26s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.fab-item:nth-child(2) { animation-delay: 0.04s; }
.fab-item:nth-child(3) { animation-delay: 0.08s; }
.fab-item:nth-child(4) { animation-delay: 0.12s; }

.fab-lab {
  font-size: 22rpx;
  font-weight: 700;
  color: #22314e;
  letter-spacing: 2rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(34, 49, 78, 0.14);
}

.fab-lab.accent { color: #f26d21; }

.fab {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(34, 49, 78, 0.2);
}

.fab-main {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #f26d21;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 36rpx rgba(242, 109, 33, 0.4);
}

@keyframes fabUp {
  from { opacity: 0; transform: translateY(24rpx) scale(0.9); }
  to { opacity: 1; transform: none; }
}

@keyframes fabFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ---------- 新建/编辑表单底部弹层 ---------- */
.form-sheet {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  box-sizing: border-box;
}

.form-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 12rpx;
}

.form-foot {
  flex: none;
  padding-top: 20rpx;
}

/* ---------- 批量下载面板（高度对齐 range 日历展开 ≈1152rpx：标题116+月份切换88+星期92+月份区712+底部按钮144，圆角顶） ---------- */
.dl-sheet {
  background: #f4f1ea;
  border-radius: 32rpx 32rpx 0 0;
  height: 1152rpx;
  display: flex;
  flex-direction: column;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.dl-head {
  position: relative;
  flex: none;
}

.dl-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #22314e;
}

.dl-close {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dl-range {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.dl-range-text {
  font-size: 24rpx;
  color: #6b7690;
  letter-spacing: 1rpx;
}

/* 「改日期」明显按钮：实心安全橙药丸（任务单 / 费用汇总页同款口径） */
.dl-change {
  font-size: 24rpx;
  color: #ffffff;
  background: #f26d21;
  font-weight: 700;
  border-radius: 14rpx;
  padding: 10rpx 28rpx;
}

.dl-body {
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
}

.dl-empty {
  padding: 96rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}

/* 一个月份一个卡片 */
.dl-month-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(34, 49, 78, 0.06);
}

.dl-month-card + .dl-month-card {
  margin-top: 20rpx;
}

.dl-month-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #22314e;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

/* 3 列网格：缩略图 + 日标签 + 角上选择圈 */
.dl-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dl-cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
}

.dl-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #e9e2d2;
  display: block;
}

.dl-day {
  margin-top: 6rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6b7690;
}

/* 选择圈：未选=灰圈，选中=橙底白勾 */
.dl-ring {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #d9cfba;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  z-index: 2;
}

.dl-ring.on {
  background: #f26d21;
  border-color: #f26d21;
}

/* 底部栏里的静态选择圈（覆盖网格内的绝对定位） */
.dl-ring-static {
  position: static;
  background: #ffffff;
}

.dl-ring-static.on {
  background: #f26d21;
}

/* ---------- 下载面板底部固定栏 ---------- */
.dl-foot {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  margin-top: 12rpx;
  border-top: 2rpx solid #e8e0cd;
}

.dl-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #22314e;
}

.dl-count {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #a89f8a;
}

.dl-btn {
  min-width: 240rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #22314e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.dl-btn.disabled {
  opacity: 0.4;
}

/* ============================================================
   水印字段编辑弹层（「选择照片并添加水印」）
   ============================================================ */

.wm-scroll {
  max-height: 62vh;
  margin-top: 28rpx;
}

/* 原图缩略 + 所属人名 */
.wm-head {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.wm-thumb {
  flex: none;
  width: 144rpx;
  height: 144rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e3dccb;
