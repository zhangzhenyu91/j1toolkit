}

.wm-refresh {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #f26d21;
}

/* ---------- 经纬度区：无历史场景右侧跨两行「选择杆塔坐标」按钮 ---------- */
.geo-zone {
  display: flex;
  align-items: stretch;
  border-top: 2rpx solid #f1ebdc;
}

.geo-zone + .frow {
  border-top: 2rpx solid #f1ebdc;
}

.geo-rows {
  flex: 1;
  min-width: 0;
}

.geo-rows .frow {
  padding-right: 0;
}

.tower-btn {
  flex: none;
  width: 184rpx;
  margin: 16rpx 32rpx 16rpx 20rpx;
  border: 2rpx solid #f26d21;
  border-radius: 16rpx;
  background: #fdeee2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: background-color 0.2s ease-out;
}

.tower-btn .tb-text {
  width: 96rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #f26d21;
  letter-spacing: 2rpx;
  line-height: 1.4;
  text-align: center;
}

.tower-btn.picked {
  background: #ffffff;
}

.tower-btn .tb-no {
  max-width: 152rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #22314e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tower-btn .tb-re {
  font-size: 20rpx;
  font-weight: 600;
  color: #f26d21;
  text-decoration: underline;
  text-underline-offset: 4rpx;
  letter-spacing: 4rpx;
}

/* 天气/地点行「已按杆塔坐标更新」角标 */
.upd-tag {
  flex: none;
  font-size: 20rpx;
  font-weight: 700;
  color: #f26d21;
  background: #fdeee2;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  letter-spacing: 2rpx;
}

/* ---------- 选择杆塔坐标弹层（电压等级 → 线路名称 → 杆塔号 三级级联） ---------- */
.tower-scroll {
  max-height: 62vh;
  margin-top: 28rpx;
}

.tower-loading {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}

.sel-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.sel-fk {
  flex: none;
  width: 128rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.sel-box {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border: 2rpx solid #e3dccb;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #22314e;
  transition: border-color 0.2s ease-out, background-color 0.2s ease-out;
}

.sel-box .ph {
  color: #a89f8a;
  font-weight: 400;
}

/* 线路名称行：输入搜索筛选 + 右侧箭头展开完整列表 */
.sel-box .sel-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #22314e;
}

.sel-box.disabled .sel-input {
  color: #a89f8a;
}

.sel-box.open {
  border-color: #f26d21;
}

.sel-box.disabled {
  background: #f4f1ea;
}

/* 选项列表：内嵌展开于对应行下方，超高滚动；展开/收起带 max-height + 透明度动效（wx:if 无过渡，改 class 开关） */
.opt-list {
  margin: 0 0 0 148rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  background: #ffffff;
  max-height: 0;
  opacity: 0;
  transition: max-height 0.25s ease-out, opacity 0.2s ease-out, border-color 0.2s ease-out, margin 0.25s ease-out;
}

.opt-list.show {
  margin: 4rpx 0 8rpx 148rpx;
  border-color: #e3dccb;
  max-height: 336rpx;
  opacity: 1;
}

/* 下拉箭头随展开/收起旋转 */
.chev {
  display: flex;
  transition: transform 0.2s ease-out;
}

.chev.up {
  transform: rotate(180deg);
}

.opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  height: 76rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #22314e;
  transition: background-color 0.15s ease-out, color 0.15s ease-out;
}

.opt + .opt {
  border-top: 2rpx dashed #ede6d4;
}

.opt.on {
  color: #f26d21;
  font-weight: 700;
  background: #fdeee2;
}

/* 三级选齐后的坐标预览卡（淡入上移） */
.coord-card {
  margin: 16rpx 0 8rpx;
  background: #fdeee2;
  border-left: 8rpx solid #f26d21;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  animation: coord-in 0.25s ease-out;
}

@keyframes coord-in {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cc-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #f26d21;
  letter-spacing: 2rpx;
}

.cc-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #22314e;
}

.btn-dark.disabled {
  background: #c9c0ab;
}

/* ---------- 添加照片二选一弹层（自绘选项卡） ---------- */

.addsheet-btns {
  margin-top: 32rpx;
}

.addsheet-opt {
  border: 2rpx solid #e3dccb;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}

.addsheet-opt + .addsheet-opt {
  margin-top: 20rpx;
}

.ao-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #22314e;
}

.ao-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a89f8a;
  letter-spacing: 1rpx;
}

.addsheet-cancel {
  margin-top: 24rpx;
}

/* 人名层三按钮并排时「拍摄」的宽度配比（取消1 / 拍摄1.4 / 确认2） */
.btn-dark.flex-even {
  flex: 1.4;
}

/* ---------- 汇总前核验面板（原「验证报告」条目样式已随面板整体替换移除；新样式见文件末尾「商旅打卡」分区） ---------- */

/* ---------- 4:3 裁剪层（深色底衬照片；取景框尺寸由 JS 按横 4:3 / 纵 3:4 计算） ---------- */
.crop-sheet {
  background: #15181d;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.crop-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #ffffff;
}

.crop-note {
  margin: 12rpx 0 24rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 1rpx;
}

.crop-stage {
  position: relative;
}

/* movable-area 默认裁剪溢出内容，此处显式声明兜底 */
.crop-area {
  overflow: hidden;
  background: #000000;
}

.crop-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 四角取景框：橙色 L 形描边（不遮挡拖动，仅装饰） */
.crop-corner {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid #f26d21;
  pointer-events: none;
}

.crop-corner.tl {
  top: 0;
  left: 0;
  border-right: none;
  border-bottom: none;
}

.crop-corner.tr {
  top: 0;
  right: 0;
  border-left: none;
  border-bottom: none;
}

.crop-corner.bl {
  bottom: 0;
  left: 0;
  border-right: none;
  border-top: none;
}

.crop-corner.br {
  right: 0;
  bottom: 0;
  border-left: none;
  border-top: none;
}

.crop-sheet .sheet-actions {
  width: 100%;
  margin-top: 32rpx;
}

/* 裁剪导出用离屏 canvas：移出视口但保持参与布局（display:none 会导致无法导出） */
.crop-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 300px;
  height: 150px;
}

/* ---------- 备注编辑弹层（附件管理：缩略图 × 移除 + 虚线添加钮；文档文件条） ---------- */
.re-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 4rpx;
}

.re-cell {
  position: relative;
  width: 108rpx;
  height: 108rpx;
}

.re-thumb {
  width: 108rpx;
  height: 108rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid #e3dccb;
  background: #22314e;
  display: flex;
  align-items: center;
  justify-content: center;
}

.re-thumb image {
  width: 108rpx;
  height: 108rpx;
  display: block;
}

.re-x {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #22314e;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.re-add {
  width: 108rpx;
  height: 108rpx;
  border-radius: 16rpx;
  border: 3rpx dashed #d9cfba;
  color: #a89f8a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 20rpx;
}

.re-docs {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.re-doc {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e3dccb;
  border-radius: 12rpx;
  background: #faf8f1;
  font-size: 24rpx;
  font-weight: 600;
  color: #22314e;
}

.re-doc .nm {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.re-doc .x {
  flex: none;
  display: flex;
  align-items: center;
  padding: 6rpx;
}

.rmk-hint {
  margin-top: 20rpx;
  font-size: 20rpx;
  color: #a89f8a;
  line-height: 1.7;
}

/* ============================================================
   商旅打卡（设计稿 design/sgcc-clockin.html ④⑤⑥⑦⑧⑨⑩；token 同方案五；⑪ 同步核查面板已下线，改为卡片操作区「从商旅同步」）
   ============================================================ */

/* ---------- ④ 卡片「商旅打卡」区：每个用车人一行（姓名 + 状态小字 + 开始/结束两枚 chip 三态） ---------- */
.lc-clock {
  margin-top: 16rpx;
}

/* 区块小标题（沿用 .lc-patrol-label 灰字加宽字距口径） */
.lc-clock-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #a89f8a;
  letter-spacing: 6rpx;
}

.ck-person {
  padding: 14rpx 0;
}

.ck-person + .ck-person {
  border-top: 2rpx dashed #f1ebdc;
}

.ck-person-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ck-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #22314e;
}

/* 行右「费用」入口：描边胶囊小按钮（橙框橙字 + 图标，最小高度 48rpx；费用弹层；仅已绑定者显示；margin-left:auto 固定最右端） */
.ck-fee {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-height: 48rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #f26d21;
  border: 2rpx solid #f26d21;
  border-radius: 999rpx;
  box-sizing: border-box;
}

/* 状态小字：工时（绿勾）/ 还差结束打卡（灰）/ 未绑定商旅（红锁）（紧随姓名，与费用胶囊垂直居中） */
.ck-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #a89f8a;
}

.ck-stat.ok {
  color: #1e7e54;
}

.ck-stat.red {
  color: #cf4444;
}

.ck-row2 {
  display: flex;
  gap: 14rpx;
}

/* chip 三态：todo=未打卡（橙虚线）/ done=已打卡（绿底勾）/ lock=未绑定（灰锁禁用） */
.ck-slot {
  flex: 1;
  min-width: 0;
  border-radius: 14rpx;
  padding: 12rpx 14rpx;
  position: relative;
  box-sizing: border-box;
}

.ck-t1 {
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 已打卡时标题避开右上角「更新」小标 */
.ck-slot.done .ck-t1 {
  padding-right: 56rpx;
}

.ck-t2 {
  margin-top: 4rpx;
  font-size: 19rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ck-slot.todo {
  border: 2rpx dashed #f26d21;
  color: #f26d21;
}

.ck-slot.todo .ck-t2 {
  color: #c99a6c;
}

.ck-slot.done {
  border: 2rpx solid #ddf0e7;
  background: #f2fbf7;
  color: #1e7e54;
}

.ck-slot.done .ck-t2 {
  color: #5c8a76;
}

.ck-slot.lock {
  border: 2rpx solid #efe9da;
  background: #faf7f0;
  color: #b4aa90;
}

.ck-slot.lock .ck-t2 {
  color: #c6bca3;
  white-space: normal; /* 引导文案较长，允许折行 */
}

/* 右上角「更新」小标（整枚 chip 点击即进更新弹层，此为视觉标记） */
.ck-upd {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #2ba471;
  display: flex;
  align-items: center;
  gap: 2rpx;
}

/* ---------- ⑨ 照片区：商旅同步标（水印/非水印同款式渲染，非水印仅无验证信息） ---------- */

/* 「已同步商旅」蓝标 */
.sync-tag {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #e7f0fd;
  color: #1d5dbf;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 「同步失败 · 重试」红标小按钮（同 .v-retry 尺寸） */
.sync-retry {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cf4444;
  color: #cf4444;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ---------- ⑧ 人名点亮层：商旅登录过期红框虚线（t-class 落在 check-tag 根上） ---------- */
.tags .t-tag--disabled.ctag-expired {
  background: #fdecec;
  border: 2rpx dashed #cf4444;
  color: #cf4444;
}

/* 过期提醒条（复用 .tip 结构，红色变体） */
.tip.warn {
  background: #fdecec;
}

.tip.warn .tip-t {
  color: #cf4444;
}

/* ---------- ⑤ 打卡确认弹层 ---------- */
.ck-loc {
  margin-top: 24rpx;
  border: 2rpx solid #e3dccb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.ck-loc-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
}

.ck-loc-line .t-icon {
  flex: none;
  margin-top: 4rpx;
}

.ck-loc-text {
  flex: 1;
  min-width: 0;
}

.ck-loc-text.ph {
  color: #a89f8a;
  font-weight: 400;
}

/* 地址串可手动输入（input 形态复用 .ck-loc-text 排版；placeholder 走全局 .ph） */
.ck-loc-input {
  flex: 1;
  min-width: 0;
  padding: 0;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #22314e;
}

/* 副行：经纬度 + 来源标注（同记录已打卡人定位 / 当前定位 / 杆塔带入）或失败提示 */
.ck-loc-sub {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #6b7690;
  line-height: 1.7;
}

.ck-loc-acts {
  margin-top: 14rpx;
  display: flex;
  gap: 16rpx;
}

.ck-mini {
  font-size: 20rpx;
  font-weight: 700;
  color: #f26d21;
  border: 2rpx solid #f26d21;
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.ck-remark {
  margin-top: 20rpx;
}

.ck-remark-lab {
  font-size: 22rpx;
  color: #a89f8a;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}

.ck-remark-lab text {
  margin-left: auto;
  font-size: 20rpx;
}

.ck-remark-input {
  min-height: 64rpx;
}

/* 打卡确认主按钮（安全橙，同 btn-dark 尺寸） */
.btn-orange {
  flex: 2;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f26d21;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

/* ---------- ⑥ 费用信息弹层 ---------- */
.fee-scroll {
  max-height: 60vh;
  margin-top: 20rpx;
}

.fee-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 4rpx;
}

.fee-row + .fee-row {
  border-top: 2rpx solid #f1ebdc;
}

.fee-k {
  flex: none;
  width: 140rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #22314e;
}

.fee-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border: 2rpx solid #e3dccb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #22314e;
  font-weight: 600;
  box-sizing: border-box;
}

/* 成本分配只读展示值（无输入框，右对齐与输入值视觉同列） */
.fee-v {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #22314e;
  text-align: right;
}

/* ---------- ⑩ 汇总前核验面板 ---------- */

/* 月份切换条：左右翻月圆钮 + 居中月份文案（不看未来月，到当月置灰） */
.rp-mbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-top: 12rpx;
}

.rp-mbtn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f4f1ea;
}

.rp-mbtn.disabled {
  opacity: 0.45;
}

.rp-mtext {
  min-width: 180rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #22314e;
  letter-spacing: 2rpx;
}

.rp-scroll {
  max-height: 60vh;
  margin-top: 20rpx;
}

/* 问题记录卡：浅红底 + 红叉逐条（点卡定位回列表） */
.issue-card {
  border: 2rpx solid #f1d2d2;
  background: #fffbfb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.issue-card + .issue-card {
  margin-top: 16rpx;
}

.issue-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.issue-plate {
  font-size: 28rpx;
  font-weight: 800;
  color: #22314e;
}

/* 徽章紧跟车牌（覆盖 .badge 的 margin-left:auto），箭头靠右 */
.issue-head .badge {
  margin-left: 0;
}

.issue-head .t-icon {
  margin-left: auto;
  flex: none;
}

.issue-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.issue-x {
  width: 32rpx;
  height: 32rpx;
  flex: none;
  border-radius: 50%;
  background: #fdecec;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 3rpx;
}

.issue-txt {
  flex: 1;
  min-width: 0;
  color: #22314e;
  font-weight: 600;
}

/* 绿色通过态（全部通过时面板仅此态） */
.rp-ok {
  margin-top: 20rpx;
  background: #f2fbf7;
  border: 2rpx solid #ddf0e7;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 24rpx;
}

.rp-ok-ic {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rp-ok-t {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e7e54;
}

.rp-ok-p {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #5c8a76;
}

/* ---------- 批量从商旅同步面板（悬浮钮独立面板） ---------- */

/* 区段行 + 实心橙「改日期」钮（同任务单页 range 族） */
.bs-range {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.bs-range-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #22314e;
  letter-spacing: 1rpx;
}

.bs-range-open {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: #f26d21;
  border-radius: 14rpx;
  padding: 14rpx 32rpx;
}

/* 「发起同步」主按钮（通栏，带刷新图标） */
.bs-go {
  margin-top: 22rpx;
  flex: none;
  width: 100%;
  box-sizing: border-box;
}

/* 同步日志区头：标题 + 管理员「清除全部记录」 */
.bs-log-h {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bs-log-t {
  font-size: 26rpx;
  font-weight: 800;
  color: #22314e;
  letter-spacing: 2rpx;
  border-left: 8rpx solid #f26d21;
  padding-left: 14rpx;
}

.bs-log-clear {
  font-size: 22rpx;
  font-weight: 700;
  color: #cf4444;
  padding: 6rpx 12rpx;
}

.bs-log-scroll {
  margin-top: 16rpx;
  max-height: 44vh;
}

/* 成功汇总行（绿）；失败明细卡（浅红底逐条） */
.bs-ok {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #f2fbf7;
  border: 2rpx solid #ddf0e7;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1e7e54;
}

.bs-fail {
  margin-top: 14rpx;
  border: 2rpx solid #f1d2d2;
  background: #fffbfb;
  border-radius: 14rpx;
  padding: 16rpx 22rpx;
}

.bs-fail-h {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #22314e;
}

.bs-fail-h .d {
  flex: none;
}

.bs-fail-h .m {
  min-width: 0;
}

.bs-fail-h .t {
  margin-left: auto;
  flex: none;
  font-size: 20rpx;
  font-weight: 700;
  color: #cf4444;
  background: #fdecec;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.bs-fail-d {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7690;
  line-height: 1.6;
  word-break: break-all;
}

/* ---------- 水印信息修正弹层 ---------- */

.we-scroll {
  max-height: 52vh;
  margin-top: 8rpx;
}

.we-lab {
  margin-top: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #22314e;
  letter-spacing: 1rpx;
}

.we-in {
  margin-top: 12rpx;
  height: 80rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 2rpx solid #e3dccb;
  border-radius: 16rpx;
  font-size: 27rpx;
  color: #22314e;
}

.we-2col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}


/* ---------- 从商旅同步进度（卡片级进度条 + 批量同步全页遮罩；进度轮询 /sgcc/sync/progress） ---------- */

/* 卡片级：同步中整卡锁定（遮罩覆盖全卡阻断操作；居中进度块 + 百分比小字；卡片根 .hazard-top 自带 relative+overflow:hidden） */
.card-lock {
  position: absolute;
  inset: 0;
  z-index: 5;
  background: rgba(255, 255, 255, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.cs-box {
  width: 62%;
  background: #ffffff;
  border: 2rpx solid #e8e0cd;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(34, 49, 78, 0.12);
}

.cs-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 6rpx;
  background: #f0ebdd;
  overflow: hidden;
}

.cs-fill {
  height: 100%;
  border-radius: 6rpx;
  background: #f26d21;
  transition: width 0.4s ease;
}

.cs-t {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #f26d21;
  letter-spacing: 1rpx;
}

/* 批量同步：全页遮罩（z-index 压过 t-popup 弹层），居中白卡 + 进度条 */
.sync-mask {
  position: fixed;
  inset: 0;
  z-index: 16000;
  background: rgba(34, 49, 78, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-card {
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 32rpx 80rpx rgba(34, 49, 78, 0.25);
}

.sync-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #fdeee2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-t {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #22314e;
}

.sync-bar {
  margin-top: 28rpx;
  width: 100%;
  height: 14rpx;
  border-radius: 8rpx;
  background: #f0ebdd;
  overflow: hidden;
}

.sync-fill {
  height: 100%;
  border-radius: 8rpx;
  background: #f26d21;
  transition: width 0.4s ease;
}

.sync-p {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #6b7690;
  letter-spacing: 1rpx;
}
