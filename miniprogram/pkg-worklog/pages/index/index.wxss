@import '../../style/common.wxss';

/* 底部固定区较高（管理员入口 + 主按钮），预留空间；
   min-height 撑满屏高：无日志的空白区域也能响应左右滑动切日 */
.page-body {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 260rpx;
}

/* ---------- 日期条 ---------- */
.datebar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(34, 49, 78, 0.06);
}

.datebar .arrow {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border-radius: 16rpx;
  background: #f4f1ea;
  display: flex;
  align-items: center;
  justify-content: center;
}

.datebar .dtxt {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.datebar .dtxt .today {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6b7690;
}

.datebar .cal {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 16rpx;
  background: #fdeee2;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 空列表虚线占位 ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed #d9cfba;
  border-radius: 20rpx;
  padding: 64rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}

/* ---------- 日期切换平移动效（两段式：先沿滑动方向移出，再从对侧滑入） ---------- */
@keyframes wl-out-left {
  from {
    transform: translateX(0);
    opacity: 1;
  }
  to {
    transform: translateX(-48rpx);
    opacity: 0;
  }
}

@keyframes wl-out-right {
  from {
    transform: translateX(0);
    opacity: 1;
  }
  to {
    transform: translateX(48rpx);
    opacity: 0;
  }
}

@keyframes wl-from-right {
  from {
    transform: translateX(48rpx);
    opacity: 0.2;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes wl-from-left {
  from {
    transform: translateX(-48rpx);
    opacity: 0.2;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.day-pane.out-left {
  animation: wl-out-left 0.08s ease-in forwards;
}

.day-pane.out-right {
  animation: wl-out-right 0.08s ease-in forwards;
}

.day-pane.from-right {
  animation: wl-from-right 0.12s ease-out;
}

.day-pane.from-left {
  animation: wl-from-left 0.12s ease-out;
}

/* ---------- 日志卡片 ---------- */
.logcard {
  margin-top: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(34, 49, 78, 0.06);
}

.lc-body {
  padding: 38rpx 32rpx 20rpx; /* 顶部留白给警示斜纹条 */
}

.lc-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.lc-head .ci {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 18rpx;
  background: #fdeee2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lc-head .ci.ci-gray {
  background: #f4f1ea;
}

.lc-head .plate {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

/* 记录验证状态角标（描边徽章） */
.badge {
  margin-left: auto;
  border: 2rpx solid #f26d21;
  color: #f26d21;
  border-radius: 8rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  white-space: nowrap;
}

.badge.green {
  border-color: #2ba471;
  color: #2ba471;
}

.badge.red {
  border-color: #cf4444;
  color: #cf4444;
}

.badge.gray {
  border-color: #d9cfba;
  color: #a89f8a;
}

/* 巡视内容：车牌号下方主内容块（橙条浅底，与其他信息区分） */
.lc-patrol {
  margin-top: 20rpx;
  background: #faf8f1;
  border-left: 8rpx solid #f26d21;
  border-radius: 16rpx;
  padding: 18rpx 24rpx 20rpx;
}

.lc-patrol-head {
  display: flex;
  align-items: center;
}

.lc-patrol-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #a89f8a;
  letter-spacing: 6rpx;
}

.lc-patrol-head .row-edit {
  margin-left: auto;
}

.lc-patrol-text {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #22314e;
  line-height: 1.6;
}

.lc-rows {
  margin-top: 16rpx;
}

.lc-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 8rpx 0;
  font-size: 30rpx;
}

.lc-row .k {
  flex: none;
  color: #a89f8a;
  font-size: 26rpx;
  width: 112rpx;
}

.lc-row .v {
  color: #22314e;
  font-weight: 600;
}

.lc-row .v.dim {
  color: #6b7690;
  font-weight: 400;
}

/* 打卡 chips：绿勾 / 红叉 */
.cks {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ck-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  font-weight: 700;
  border: 2rpx solid;
  box-sizing: border-box;
}

.ck-chip.yes {
  color: #2ba471;
  border-color: #bfe3d6;
  background: #e3f2ec;
}

.ck-chip.no {
  color: #cf4444;
  border-color: #efc9c9;
  background: #fbe9e9;
}

/* 卡片内水印照片区（覆盖共享 .photo-item 的内边距与分隔线） */
.lc-photos {
  margin-top: 16rpx;
  border-top: 2rpx solid #f1ebdc;
}

.lc-photos .photo-item {
  padding: 18rpx 0;
}

.lc-photos .photo-item + .photo-item {
  border-top: 2rpx dashed #ede6d4;
}

/* 无照片时添加栏是区块首个子元素，与顶部分隔线拉开距离；
   有照片时保持原间距（photo-item 的 18rpx 下内边距已够） */
.lc-photos .add-photo:first-child {
  margin-top: 20rpx;
}

/* 卡片底部操作 */
.lc-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f1ebdc;
}

.lc-actions .act {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.act-del {
  background: #ffffff;
  color: #cf4444;
  border: 2rpx solid #efc9c9;
  box-sizing: border-box;
}

/* ---------- 底部固定区 ---------- */
.admin-link {
  text-align: center;
  font-size: 22rpx;
  color: #6b7690;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.admin-link .admin-link-b {
  color: #f26d21;
  font-weight: 700;
}

/* ---------- 日历弹层标题与图例 ---------- */
/* 使用 title 插槽自定义「标题+图例」，隐藏组件默认标题文案避免重复 */
.t-calendar__title > text {
  display: none;
}

.cal-title {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #22314e;
}

.cal-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #6b7690;
  letter-spacing: 2rpx;
}

.cal-legend .lg {
  display: inline-block;
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  vertical-align: -3rpx;
}

.cal-legend .lg-g {
  background: #e3f2ec;
  border: 2rpx solid #bfe3d6;
}

.cal-legend .lg-b {
  background: #fbe9e9;
  border: 2rpx solid #efc9c9;
}

/* ---------- t-calendar 按日着色 ----------
   format 注入的 className 落在 .t-calendar__dates-item 上；
   组件 styleIsolation 为 apply-shared，页面样式可生效。
   优先级需高于组件自身的 --selected 选中态，着色后选中以橙色描边区分。 */
.t-calendar__dates-item.wl-cal-passed {
  background: #e3f2ec;
  color: #2ba471;
  font-weight: 700;
}

.t-calendar__dates-item.wl-cal-failed {
  background: #fbe9e9;
  color: #cf4444;
  font-weight: 700;
}

.t-calendar__dates-item--selected.wl-cal-passed,
.t-calendar__dates-item--selected.wl-cal-failed {
  outline: 4rpx solid #f26d21;
  outline-offset: -4rpx;
}

/* 「今天」醒目标记：加粗 + 橙色小圆点（与着色类可叠加） */
.t-calendar__dates-item.wl-cal-today {
  position: relative;
  font-weight: 800;
}

.t-calendar__dates-item.wl-cal-today:not(.wl-cal-passed):not(.wl-cal-failed) {
  color: #f26d21;
}

.t-calendar__dates-item.wl-cal-today::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #f26d21;
}

/* 选中日同为「今天」且无验证底色时：橙底上文字与圆点改白（避免橙橙相消看不见数字）；
   有验证底色（passed/failed）时保持绿/红状态色，否则浅底上白字不可见 */
.t-calendar .t-calendar__dates-item.t-calendar__dates-item--selected.wl-cal-today:not(.wl-cal-passed):not(.wl-cal-failed) {
  color: #ffffff;
}

.t-calendar .t-calendar__dates-item--selected.wl-cal-today:not(.wl-cal-passed):not(.wl-cal-failed)::after {
  background: #ffffff;
}

/* ============================================================
   视图开关 / 可点行提示 / 底部双按钮 / 表单弹层 / 批量下载面板
   ============================================================ */

/* ---------- 视图开关（全部 / 仅看我）：胶囊按钮，激活=橙底橙边 ---------- */
.scopebar {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.scope-pill {
  padding: 10rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 2rpx solid #e3dccb;
  color: #6b7690;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.scope-pill.on {
  background: #f26d21;
  border-color: #f26d21;
  color: #ffffff;
}

/* ---------- 卡片可点行：行尾 edit-1 小图标（配合 hover-bg-warm 反馈） ---------- */
.lc-row .row-edit {
  margin-left: auto;
  flex: none;
}

/* ---------- 底部固定区：批量下载（白底描边 ghost）+ 新建日志（藏青），1:2 ---------- */
.btns {
  display: flex;
  gap: 20rpx;
}

.btn-download {
  flex: 1;
  height: 96rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid #22314e;
  box-sizing: border-box;
  color: #22314e;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.btn-create {
  flex: 2;
}

/* ---------- 新建/编辑表单底部弹层 ---------- */
.form-sheet {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  box-sizing: border-box;
}

.form-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 12rpx;
}

.form-foot {
  flex: none;
  padding-top: 20rpx;
}

/* ---------- 批量下载面板（近全屏 92% 高，圆角顶） ---------- */
.dl-sheet {
  background: #f4f1ea;
  border-radius: 32rpx 32rpx 0 0;
  height: 92vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.dl-head {
  position: relative;
  flex: none;
}

.dl-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #22314e;
}

.dl-close {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dl-range {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.dl-range-text {
  font-size: 24rpx;
  color: #6b7690;
  letter-spacing: 1rpx;
}

.dl-change {
  font-size: 24rpx;
  color: #f26d21;
  font-weight: 700;
  padding: 4rpx 12rpx;
}

/* 「仅看我」开关（筛选仅含自己名字的水印照片） */
.dl-mine {
  font-size: 22rpx;
  font-weight: 700;
  color: #6b7690;
  border: 2rpx solid #e3dccb;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
  background: #ffffff;
}

.dl-mine.on {
  color: #f26d21;
  border-color: #f26d21;
  background: #fdeee2;
}

.dl-body {
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
}

.dl-empty {
  padding: 96rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}

/* 一个月份一个卡片 */
.dl-month-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(34, 49, 78, 0.06);
}

.dl-month-card + .dl-month-card {
  margin-top: 20rpx;
}

.dl-month-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #22314e;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

/* 3 列网格：缩略图 + 日标签 + 角上选择圈 */
.dl-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dl-cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
}

.dl-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #e9e2d2;
  display: block;
}

.dl-day {
  margin-top: 6rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6b7690;
}

/* 选择圈：未选=灰圈，选中=橙底白勾 */
.dl-ring {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #d9cfba;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  z-index: 2;
}

.dl-ring.on {
  background: #f26d21;
  border-color: #f26d21;
}

/* 底部栏里的静态选择圈（覆盖网格内的绝对定位） */
.dl-ring-static {
  position: static;
  background: #ffffff;
}

.dl-ring-static.on {
  background: #f26d21;
}

/* ---------- 下载面板底部固定栏 ---------- */
.dl-foot {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  margin-top: 12rpx;
  border-top: 2rpx solid #e8e0cd;
}

.dl-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #22314e;
}

.dl-count {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #a89f8a;
}

.dl-btn {
  min-width: 240rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #22314e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.dl-btn.disabled {
  opacity: 0.4;
}

/* ============================================================
   水印字段编辑弹层（「选择照片并添加水印」）
   ============================================================ */

.wm-scroll {
  max-height: 62vh;
  margin-top: 28rpx;
}

/* 原图缩略 + 所属人名 */
.wm-head {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.wm-thumb {
  flex: none;
  width: 144rpx;
  height: 144rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e3dccb;
  background: #f4f1ea;
}

.wm-head-r {
  flex: 1;
  min-width: 0;
}

.wm-names {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wm-names-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}

.wm-card {
  margin-top: 24rpx;
}

/* 施工内容独占一行（标签在上、输入在下） */
.wm-row-col {
  padding: 24rpx 32rpx;
}

.wm-row-col .fk {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.wm-row-col + .frow {
  border-top: 2rpx solid #f1ebdc;
}

.wm-textarea {
  padding: 16rpx 20rpx;
}

.wm-textarea .textarea {
  min-height: 96rpx;
}

/* 单行输入：与 .fv 同占剩余空间、右对齐视觉 */
.wm-input {
  flex: 1;
  font-size: 28rpx;
  color: #22314e;
  font-weight: 600;
}

/* 防伪码：等宽观感 + 橙色换一换 */
.wm-code {
  letter-spacing: 2rpx;
}

.wm-refresh {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #f26d21;
}

/* ---------- 添加照片二选一弹层（自绘选项卡） ---------- */

.addsheet-btns {
  margin-top: 32rpx;
}

.addsheet-opt {
  border: 2rpx solid #e3dccb;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}

.addsheet-opt + .addsheet-opt {
  margin-top: 20rpx;
}

.ao-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #22314e;
}

.ao-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a89f8a;
  letter-spacing: 1rpx;
}

.addsheet-cancel {
  margin-top: 24rpx;
}

/* 人名层三按钮并排时「拍摄」的宽度配比（取消1 / 拍摄1.4 / 确认2） */
.btn-dark.flex-even {
  flex: 1.4;
}
