@import '../../style/common.wxss';

/* 整页 flex 纵列：导航/班组切换/日期条/视图开关固定，「仅看我」按钮以下为通高切日 swiper 区；
   底部为右下悬浮主钮（≈108rpx + 底部偏移），窗格内容底部预留 220rpx 避免最后一张卡片被遮挡 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-bottom: 0; /* 全局 .page-body 的底部留白改到 .day-pane（滚区内部） */
}

/* ---------- 切日 swiper（三窗格预渲染 前/今/后一天；通高 flex:1，每格独立纵向滚动） ---------- */
.day-swiper {
  flex: 1;
  min-height: 0;
  /* 与视图开关上方留白一致；左右各 -28rpx 恰好抵消 page-body 侧 padding 吃到屏边（不再向屏外多伸）——
     配合窗格左右各 28rpx 内边距：静止时卡片与上方日期条/开关对齐留白（28rpx），
     滑动时相邻两天卡片之间露出 56rpx 间隙（左右内边距之和） */
  margin: 28rpx -28rpx 0 -28rpx;
}

.day-pane .mt-0 {
  margin-top: 0; /* 窗格首元素（首卡/空态）去上 margin，与视图开关的间距统一由 .day-swiper 掌管 */
}

.day-scroll {
  height: 100%;
  box-sizing: border-box;
  /* 左右留白不下放在 scroll-view 上：真机 scroll-view 的水平 padding 可能被忽略（同 padding-bottom 旧坑），
     一律移入内层 .day-pane，确保卡片右侧 12rpx 黄硬影有 ≥28rpx 落影空间、不被屏边裁切 */
}

.day-pane {
  box-sizing: border-box;
  padding: 0 28rpx 220rpx; /* 卡片静止时左右留白与页面对齐（滑动时邻卡间隙 = 左右内边距之和 56rpx）；底部为悬浮主钮避让 */
}

/* ---------- 班组切换器（白底胶囊签：1 发丝边 + 前置蓝色小方块；超管可点下拉，其余角色静态标签） ---------- */
.tswitch {
  position: relative;
  z-index: 20;
  margin-bottom: 20rpx;
  animation: wl-a-rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.02s both;
}

.ts-cur {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  height: 64rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 16rpx;
  padding: 0 24rpx 0 22rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #1D2129;
}

/* 前置品牌蓝小方块（静态） */
.ts-sq {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  border-radius: 4rpx;
  background: #0E3DA8;
}

.ts-cur .arr {
  color: #86909C;
  font-size: 18rpx;
}

/* 下拉入场：chip 下方轻微上浮 + 淡入（克制，同全局 fadeUp/fadeIn 风格）；收起直消不加动画 */
@keyframes ts-drop-in {
  from {
    opacity: 0;
    transform: translateY(-6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ts-drop {
  position: absolute;
  top: 76rpx;
  left: 0;
  z-index: 21;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.1);
  padding: 12rpx;
  min-width: 300rpx;
  max-width: 600rpx; /* 上限兜底：超长班组名由 .ts-opt 内文案省略，浮层不撑出屏外 */
  animation: ts-drop-in 0.2s ease-out;
}

.ts-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
}

/* 主文案左对齐 + 超长省略（.ck 勾选由 margin-left:auto 右置） */
.ts-opt > text:first-of-type {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

/* 选中项：浅蓝底蓝字 */
.ts-opt.on {
  background: #E8F0FF;
  color: #0E3DA8;
  font-weight: 600;
}

.ts-opt .ck {
  margin-left: auto;
  font-size: 22rpx;
}

/* 点空白处收起下拉（层级低于切换器本体）；遮罩淡入 */
@keyframes ts-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.ts-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  animation: ts-mask-in 0.15s ease-out;
}

/* ---------- 未分配班组空态（屏十） ---------- */
.team-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.team-empty .te-ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
  background: #E8F0FF;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-empty .te-t {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.team-empty .te-p {
  font-size: 23rpx;
  color: #4E5969;
  line-height: 1.8;
  text-align: center;
}

/* ---------- 日期条（去卡片化：元素直落页面底；‹ › 圆角白底钮；「今天」浅蓝底蓝字小签） ---------- */
.datebar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  animation: wl-a-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
}

.datebar .arrow {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  display: flex;
  align-items: center;
  justify-content: center;
}

.datebar .dtxt {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

/* 日期前置红方块已取消（政企蓝白不做几何记号） */

.datebar .dtxt .today {
  display: inline-flex;
  align-items: center;
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  background: #E8F0FF;
  color: #0E3DA8;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.datebar .cal {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 空列表虚线占位 ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed #C9CDD4;
  border-radius: 16rpx;
  padding: 64rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #86909C;
  letter-spacing: 2rpx;
}

/* ---------- 日志卡片（白卡：24rpx 圆角 + 轻阴影、无描边；
   入场编排：a-rise 上移归位，fill-mode both，按卡片次序时延链） ---------- */
.logcard {
  margin-top: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  animation: wl-a-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
}

.day-pane .logcard:nth-of-type(2) { animation-delay: 0.26s; }
.day-pane .logcard:nth-of-type(3) { animation-delay: 0.34s; }
.day-pane .logcard:nth-of-type(n + 4) { animation-delay: 0.42s; }

/* 报告跳转定位：目标卡片短暂高亮（黄色描边呼吸环，1.6s 后由 JS 移除 flash 类；
   落在 ::after 上，避免与卡片入场 animation 互相重播） */
.logcard.flash::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 6;
  border: 6rpx solid #FF7D00;
  border-radius: 24rpx;
  pointer-events: none;
  animation: wl-flash 0.8s ease-in-out 2;
}

@keyframes wl-flash {
  0%,
  100% {
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
}

.lc-body {
  padding: 30rpx 28rpx 16rpx;
}

.lc-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lc-head .ci {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 16rpx;
  background: #E8F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lc-head .ci.ci-gray {
  background: #F7F8FA;
}

/* 车牌：墨深色大字锚点（44rpx/700），数字等宽对齐 */
.lc-head .plate {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* 跨班日志徽章：浅蓝底蓝字小胶囊 */
.tag-cross {
  flex: none;
  align-self: center;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: #E8F0FF;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #0E3DA8;
  white-space: nowrap;
}

/* 记录验证状态角标（状态小标签：浅底 + 同色深字；通过绿 / 未通过红 / 免验证灰） */
.badge {
  margin-left: auto;
  border-radius: 8rpx;
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  white-space: nowrap;
  animation: wl-a-spin 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both;
}

.badge.green {
  background: #E8FFEA;
  color: #0B8A37;
}

.badge.green::before {
  content: '✓';
  margin-right: 6rpx;
}

.badge.red {
  background: #FFECE8;
  color: #F53F3F;
}

.badge.gray {
  background: #F7F8FA;
  color: #86909C;
}

/* 未通过明细：浅红底 + 红左边条，逐行列出全部不满足项（与右上角角标同源，后端 verify_reasons） */
.lc-fail {
  margin-top: 16rpx;
  background: #FFECE8;
  border-left: 6rpx solid #F53F3F;
  border-radius: 0;
  padding: 14rpx 20rpx;
}

.lc-fail-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #F53F3F;
  line-height: 1.7;
}

/* 红三角感叹号：失败/警示语义（图标由 wxml 的 t-icon error-triangle 提供，按首行文字中线对齐：(40.8-22)/2≈10rpx） */
.lc-fail-x {
  flex: none;
  margin-top: 10rpx;
}

/* 巡视内容：车牌号下方主内容块（浅蓝底圆角块，与其他信息区分） */
.lc-patrol {
  margin-top: 20rpx;
  background: #E8F0FF;
  border-radius: 12rpx;
  padding: 18rpx 24rpx 20rpx;
}

.lc-patrol-head {
  display: flex;
  align-items: center;
}

.lc-patrol-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #0E3DA8;
  letter-spacing: 1rpx;
}

.lc-patrol-head .row-edit {
  margin-left: auto;
}

.lc-patrol-text {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
  line-height: 1.6;
}

/* 卡片内水印照片区（覆盖共享 .photo-item 的内边距与分隔线） */
.lc-photos {
  margin-top: 16rpx;
  border-top: 2rpx solid #E5E6EB;
}

.lc-photos .photo-item {
  padding: 18rpx 0;
}

.lc-photos .photo-item + .photo-item {
  border-top: 2rpx dashed #E5E6EB;
}

/* 无照片时添加栏是区块首个子元素，与顶部分隔线拉开距离；
   有照片时保持原间距（photo-item 的 18rpx 下内边距已够） */
.lc-photos .add-photo:first-child {
  margin-top: 20rpx;
}

/* 卡片底部操作行（全宽底条：顶发丝线贯通卡边，项间发丝分隔；文字链——同步=蓝 / 备注=深灰 / 删除=红） */
.lc-actions {
  display: flex;
  margin: 22rpx -28rpx -16rpx;
  border-top: 2rpx solid #E5E6EB;
}

.lc-actions .act {
  flex: 1;
  padding: 20rpx 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #4E5969;
}

.lc-actions .act + .act {
  border-left: 2rpx solid #E5E6EB;
}

/* 从商旅同步入口（文字链，品牌蓝） */
.act-sync {
  color: #0E3DA8;
}

.act-del {
  color: #F53F3F;
}

/* 备注入口（文字链，深灰） */
.act-note {
  color: #4E5969;
}

/* ---------- 备注块（「添加水印照片」虚线框下方；浅橙底 + 橙左边条，无备注不渲染） ---------- */
.lc-rmk {
  margin-top: 20rpx;
  background: #FFF7E8;
  border-left: 6rpx solid #FF7D00;
  border-radius: 0;
  padding: 16rpx 24rpx 20rpx;
}

.lc-rmk-label {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #1D2129;
  letter-spacing: 1rpx;
}

.lc-rmk-label .row-edit {
  margin-left: auto;
}

/* 备注文字：与照片右侧施工内容同字号（26rpx） */
.lc-rmk-text {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.6;
}

/* 附件：图片 / 视频缩略图（视频无封面，深色底 + 播放标） */
.rmk-files {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rf-thumb {
  width: 92rpx;
  height: 92rpx;
  border-radius: 8rpx;
  overflow: hidden;
  border: 2rpx solid #E5E6EB;
  background: #F7F8FA;
}

.rf-img {
  width: 92rpx;
  height: 92rpx;
  display: block;
}

.rf-video {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 附件：Office 文档仅可点击文件名（下划线 + 品牌蓝） */
.rmk-docs {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.rf-doc {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  min-width: 0;
}

.rf-doc .fn {
  color: #0E3DA8;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 日历弹层标题与图例 ---------- */
/* 使用 title 插槽自定义「标题+图例」，隐藏组件默认标题文案避免重复 */
.t-calendar__title > text {
  display: none;
}

.cal-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #1D2129;
}

.cal-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #4E5969;
  letter-spacing: 2rpx;
}

/* 图例 = 实心色点（与格内状态点同形同色，不再用空心方块），同 Web 端月历图例口径 */
.cal-legend .lg {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  vertical-align: -1rpx;
}

.cal-legend .lg-g {
  background: #00B42A;
}

.cal-legend .lg-b {
  background: #F53F3F;
}

.cal-legend .lg-y {
  background: #FF7D00;
}

/* ---------- t-calendar 政企蓝白化 ----------
   弹层容器：顶部 24rpx 圆角 + 轻阴影，与 .sheet 族弹层一致 */
.t-calendar--popup {
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
}

/* 翻月箭头：圆角发丝边小钮 */
.t-calendar .t-calendar-header__icon {
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0 6rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #1D2129;
}

.t-calendar .t-calendar-header__icon--disabled {
  border-color: #E5E6EB;
  color: #C9CDD4;
}

/* 按日验证状态：日期格一律白底，状态以格内下方 10rpx 色点表达
   （绿=全部通过 / 黄=有备注 / 红=有未通过），与 Web 端月历图例同口径；
   format 注入的 className 落在 .t-calendar__dates-item 上；
   组件 styleIsolation 为 apply-shared，页面样式可生效。
   色点用 ::before（::after 留给今日红圆） */
.t-calendar__dates-item.wl-cal-passed::before,
.t-calendar__dates-item.wl-cal-failed::before,
.t-calendar__dates-item.wl-cal-remark::before {
  content: '';
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.t-calendar__dates-item.wl-cal-passed::before {
  background: #00B42A;
}

.t-calendar__dates-item.wl-cal-failed::before {
  background: #F53F3F;
}

/* 黄点 = 验证通过但有备注 */
.t-calendar__dates-item.wl-cal-remark::before {
  background: #FF7D00;
}

/* 选中日：品牌蓝底白字圆角格（覆盖组件默认品牌蓝底，色点仍可叠加于格内下方） */
.t-calendar .t-calendar__dates-item.t-calendar__dates-item--selected {
  background: #0E3DA8;
  color: #ffffff;
  border-radius: 12rpx;
}

/* 「今天」：蓝底白字圆（::after 画蓝圆垫于数字之下；与状态色点可叠加，色点在圆外下方） */
.t-calendar__dates-item.wl-cal-today {
  position: relative;
  font-weight: 700;
  color: #ffffff;
}

.t-calendar__dates-item.wl-cal-today::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #0E3DA8;
  z-index: -1;
}

/* ---------- 日历左右滑动切换月份动画 ----------
   类名经 t-class 落在组件根上（styleIsolation apply-shared，页面样式可达内部）；
   新月份网格按滑动方向平移进入（先清空再 nextTick 重放，连切同向也重新触发） */
.wl-cal-from-right .t-calendar__dates {
  animation: wl-cal-in-right 0.28s ease-out;
}

.wl-cal-from-left .t-calendar__dates {
  animation: wl-cal-in-left 0.28s ease-out;
}

@keyframes wl-cal-in-right {
  from {
    transform: translateX(120rpx);
    opacity: 0.2;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes wl-cal-in-left {
  from {
    transform: translateX(-120rpx);
    opacity: 0.2;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

/* ============================================================
   视图开关 / 可点行提示 / 底部双按钮 / 表单弹层 / 批量下载面板
   ============================================================ */

/* ---------- 视图开关（全部 / 仅看我）：灰槽分段控件；激活=白底蓝字带轻影 ---------- */
.scopebar {
  display: flex;
  align-self: flex-start;
  margin-top: 16rpx;
  padding: 4rpx;
  border-radius: 16rpx;
  background: #E5E6EB;
  animation: wl-a-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both;
}

.scope-pill {
  height: 56rpx;
  box-sizing: border-box;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  border-radius: 12rpx;
  color: #4E5969;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.scope-pill.on {
  background: #ffffff;
  color: #0E3DA8;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

/* ---------- 右下悬浮按钮（speed dial：主钮＋/× 点按展开，遮罩淡出关闭；原底部固定区已删除） ---------- */
.fab-mask {
  position: fixed;
  inset: 0;
  z-index: 110;
  background: rgba(29, 33, 41, 0.3);
  animation: fabFade 0.25s ease both;
}

.fabs {
  position: fixed;
  right: 28rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 120;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 24rpx;
}

/* 展开项：wx:if 挂载即播入场动画，自上而下错峰 */
.fab-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  animation: fabUp 0.26s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.fab-item:nth-child(2) { animation-delay: 0.04s; }
.fab-item:nth-child(3) { animation-delay: 0.08s; }
.fab-item:nth-child(4) { animation-delay: 0.12s; }

.fab-lab {
  font-size: 22rpx;
  font-weight: 600;
  color: #1D2129;
  letter-spacing: 1rpx;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
}

.fab-lab.accent { color: #0E3DA8; }

/* 展开菜单项：白圆 + 发丝边 + 轻影 */
.fab {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  box-sizing: border-box;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 主钮：品牌蓝圆 + 蓝色轻投影；入场弹性旋入 */
.fab-main {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: #0E3DA8;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(14, 61, 168, 0.35);
  animation: wl-a-fab 0.7s cubic-bezier(0.34, 1.4, 0.64, 1) 0.5s both;
}

@keyframes fabUp {
  from { opacity: 0; transform: translateY(24rpx) scale(0.9); }
  to { opacity: 1; transform: none; }
}

@keyframes fabFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ---------- 新建/编辑表单底部弹层（顶部 24rpx 圆角 + 轻阴影，与 .sheet 族弹层一致） ---------- */
.form-sheet {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  box-sizing: border-box;
}

.form-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 12rpx;
}

.form-foot {
  flex: none;
  padding-top: 20rpx;
}

/* ---------- 批量下载面板（高度对齐 range 日历展开 ≈1152rpx：标题116+月份切换88+星期92+月份区712+底部按钮144；
   顶部 24rpx 圆角 + 轻阴影） ---------- */
.dl-sheet {
  position: relative;
  background: #F5F7FA;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  height: 1152rpx;
  display: flex;
  flex-direction: column;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.dl-head {
  position: relative;
  flex: none;
}

.dl-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #1D2129;
}

.dl-close {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dl-range {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.dl-range-text {
  font-size: 24rpx;
  color: #4E5969;
  letter-spacing: 1rpx;
}

/* 「改日期」明显按钮：品牌蓝实心圆角块（任务单 / 费用汇总页同款口径） */
.dl-change {
  font-size: 24rpx;
  color: #ffffff;
  background: #0E3DA8;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 10rpx 28rpx;
}

.dl-body {
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
}

.dl-empty {
  padding: 96rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #86909C;
  letter-spacing: 2rpx;
}

/* 一个月份一个卡片（白卡 + 发丝边 + 圆角，纸底面板内以描边定义边界，不用柔影） */
.dl-month-card {
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 16rpx;
  padding: 24rpx;
}

.dl-month-card + .dl-month-card {
  margin-top: 20rpx;
}

.dl-month-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1D2129;
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
}

/* 3 列网格：缩略图 + 日标签 + 角上选择圈 */
.dl-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dl-cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
}

.dl-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
  background: #F7F8FA;
  display: block;
}

.dl-day {
  margin-top: 6rpx;
  text-align: center;
  font-size: 22rpx;
  color: #4E5969;
}

/* 选择圈：未选=灰圈，选中=蓝底白勾 */
.dl-ring {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #E5E6EB;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  z-index: 2;
}

.dl-ring.on {
  background: #0E3DA8;
  border-color: #0E3DA8;
}

/* 底部栏里的静态选择圈（覆盖网格内的绝对定位） */
.dl-ring-static {
  position: static;
  background: #ffffff;
}

.dl-ring-static.on {
  background: #0E3DA8;
}

/* ---------- 下载面板底部固定栏 ---------- */
/* PDF 行（下载为 PDF / PDF 存网盘；浅蓝底蓝字次按钮） */
.dl-pdf {
  flex: none;
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.dl-pdf-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  background: #E8F0FF;
  color: #0E3DA8;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.dl-pdf-btn.disabled {
  opacity: 0.5;
}

.dl-foot {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  margin-top: 12rpx;
  border-top: 2rpx solid #E5E6EB;
}

.dl-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1D2129;
}

.dl-count {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #86909C;
}

.dl-btn {
  min-width: 240rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #0E3DA8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.dl-btn.disabled {
  opacity: 0.4;
}

/* ============================================================
   水印字段编辑弹层（「选择照片并添加水印」）
   ============================================================ */

.wm-scroll {
  max-height: 62vh;
  margin-top: 28rpx;
}

/* 原图缩略 + 所属人名 */
.wm-head {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.wm-thumb {
  flex: none;
  width: 144rpx;
  height: 144rpx;
  border-radius: 12rpx;
  border: 2rpx solid #E5E6EB;
  background: #F5F7FA;
}

.wm-head-r {
  flex: 1;
  min-width: 0;
}

.wm-names {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wm-names-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #86909C;
  letter-spacing: 2rpx;
}

.wm-card {
  margin-top: 24rpx;
}

/* 施工内容独占一行（标签在上、输入在下） */
.wm-row-col {
  padding: 24rpx 32rpx;
}

.wm-row-col .fk {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* 施工内容标题行：左侧标题 + 右侧快捷输入（空间不足时 chips 自动折行） */
.wm-wc-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.wm-wc-head .fk {
  margin-bottom: 0;
}

.wm-quick {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.wm-quick-chip {
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #0E3DA8;
  background: #E8F0FF;
  border-radius: 8rpx;
}

.wm-row-col + .frow {
  border-top: 2rpx solid #E5E6EB;
}

.wm-textarea {
  padding: 16rpx 20rpx;
}

.wm-textarea .textarea {
  min-height: 96rpx;
}

/* 单行输入：与 .fv 同占剩余空间、右对齐视觉 */
.wm-input {
  flex: 1;
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 600;
}

/* 防伪码：等宽观感 + 蓝色换一换 */
.wm-code {
  letter-spacing: 2rpx;
}

.wm-refresh {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0E3DA8;
}

/* ---------- 经纬度区：无历史场景右侧跨两行「选择杆塔坐标」按钮 ---------- */
.geo-zone {
  display: flex;
  align-items: stretch;
  border-top: 2rpx solid #E5E6EB;
}

.geo-zone + .frow {
  border-top: 2rpx solid #E5E6EB;
}

.geo-rows {
  flex: 1;
  min-width: 0;
}

.geo-rows .frow {
  padding-right: 0;
}

.tower-btn {
  flex: none;
  width: 184rpx;
  margin: 16rpx 32rpx 16rpx 20rpx;
  border: 2rpx solid #0E3DA8;
  border-radius: 12rpx;
  background: #E8F0FF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: background-color 0.2s ease-out;
}

.tower-btn .tb-text {
  width: 96rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #0E3DA8;
  letter-spacing: 2rpx;
  line-height: 1.4;
  text-align: center;
}

.tower-btn.picked {
  background: #ffffff;
}

.tower-btn .tb-no {
  max-width: 152rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #1D2129;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tower-btn .tb-re {
  font-size: 20rpx;
  font-weight: 600;
  color: #0E3DA8;
  text-decoration: underline;
  text-underline-offset: 4rpx;
  letter-spacing: 4rpx;
}

/* 天气/地点行「已按杆塔坐标更新」角标 */
.upd-tag {
  flex: none;
  font-size: 20rpx;
  font-weight: 600;
  color: #0E3DA8;
  background: #E8F0FF;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  letter-spacing: 1rpx;
}

/* ---------- 选择杆塔坐标弹层（电压等级 → 线路名称 → 杆塔号 三级级联） ---------- */
.tower-scroll {
  max-height: 62vh;
  margin-top: 28rpx;
}

.tower-loading {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #86909C;
  letter-spacing: 2rpx;
}

.sel-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.sel-fk {
  flex: none;
  width: 128rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.sel-box {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  background: #ffffff;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  box-sizing: border-box;
  transition: border-color 0.2s ease-out, background-color 0.2s ease-out;
}

.sel-box .ph {
  color: #86909C;
  font-weight: 400;
}

/* 线路名称行：输入搜索筛选 + 右侧箭头展开完整列表 */
.sel-box .sel-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
}

.sel-box.disabled .sel-input {
  color: #86909C;
}

.sel-box.open {
  border-color: #0E3DA8;
}

.sel-box.disabled {
  background: #F5F7FA;
}

/* 选项列表：内嵌展开于对应行下方，超高滚动；展开/收起带 max-height + 透明度动效（wx:if 无过渡，改 class 开关） */
.opt-list {
  margin: 0 0 0 148rpx;
  border: 3rpx solid transparent;
  border-radius: 12rpx;
  background: #ffffff;
  max-height: 0;
  opacity: 0;
  transition: max-height 0.25s ease-out, opacity 0.2s ease-out, border-color 0.2s ease-out, margin 0.25s ease-out;
}

.opt-list.show {
  margin: 4rpx 0 8rpx 148rpx;
  border-color: #1D2129;
  max-height: 336rpx;
  opacity: 1;
}

/* 下拉箭头随展开/收起旋转 */
.chev {
  display: flex;
  transition: transform 0.2s ease-out;
}

.chev.up {
  transform: rotate(180deg);
}

.opt {
  display: flex;
  align-items: center;
  justify-content: flex-start; /* 曾用 space-between：未选中行仅 ::before 占位 + 文案两项，文案被顶到右缘裁断 */
  gap: 16rpx;
  height: 76rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1D2129;
  transition: background-color 0.15s ease-out, color 0.15s ease-out;
}

/* 主文案左对齐 + 占满中槽，超长省略不溢出右缘；选中勾（t-icon）随后自然右置 */
.opt > text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

/* 选中标记前置方块槽位（未选中留空占位，各行文字对齐） */
.opt::before {
  content: '';
  flex: none;
  width: 14rpx;
  height: 14rpx;
}

.opt + .opt {
  border-top: 2rpx dashed #E5E6EB;
}

/* 选中项：白底蓝字 + 前置蓝方块（不用浅蓝高亮） */
.opt.on {
  color: #0E3DA8;
  font-weight: 700;
}

.opt.on::before {
  background: #0E3DA8;
}

/* 三级选齐后的坐标预览卡（淡入上移） */
.coord-card {
  margin: 16rpx 0 8rpx;
  background: #E8F0FF;
  border-left: 8rpx solid #0E3DA8;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  animation: coord-in 0.25s ease-out;
}

@keyframes coord-in {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cc-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0E3DA8;
  letter-spacing: 2rpx;
}

.cc-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1D2129;
}

.btn-dark.disabled {
  background: #E5E6EB;
}

/* ---------- 添加照片二选一弹层（自绘选项卡） ---------- */

.addsheet-btns {
  margin-top: 32rpx;
}

.addsheet-opt {
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 28rpx 32rpx;
}

.addsheet-opt + .addsheet-opt {
  margin-top: 20rpx;
}

.ao-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D2129;
}

.ao-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #86909C;
  letter-spacing: 1rpx;
}

.addsheet-cancel {
  margin-top: 24rpx;
}

/* 人名层三按钮并排时「拍摄」的宽度配比（取消1 / 拍摄1.4 / 确认2） */
.btn-dark.flex-even {
  flex: 1.4;
}

/* ---------- 汇总前核验面板（原「验证报告」条目样式已随面板整体替换移除；新样式见文件末尾「商旅打卡」分区） ---------- */

/* ---------- 4:3 裁剪层（深色底衬照片；直角；取景框尺寸由 JS 按横 4:3 / 纵 3:4 计算） ---------- */
.crop-sheet {
  position: relative;
  background: #15181d;
  border-radius: 12rpx;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.crop-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #ffffff;
}

.crop-note {
  margin: 12rpx 0 24rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 1rpx;
}

.crop-stage {
  position: relative;
}

/* movable-area 默认裁剪溢出内容，此处显式声明兜底 */
.crop-area {
  overflow: hidden;
  background: #000000;
}

.crop-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 四角取景框：蓝色 L 形描边（不遮挡拖动，仅装饰） */
.crop-corner {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid #0E3DA8;
  pointer-events: none;
}

.crop-corner.tl {
  top: 0;
  left: 0;
  border-right: none;
  border-bottom: none;
}

.crop-corner.tr {
  top: 0;
  right: 0;
  border-left: none;
  border-bottom: none;
}

.crop-corner.bl {
  bottom: 0;
  left: 0;
  border-right: none;
  border-top: none;
}

.crop-corner.br {
  right: 0;
  bottom: 0;
  border-left: none;
  border-top: none;
}

.crop-sheet .sheet-actions {
  width: 100%;
  margin-top: 32rpx;
}

/* 裁剪导出用离屏 canvas：移出视口但保持参与布局（display:none 会导致无法导出） */
.crop-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 300px;
  height: 150px;
}

/* ---------- 备注编辑弹层（附件管理：缩略图 × 移除 + 虚线添加钮；文档文件条） ---------- */
.re-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 4rpx;
}

.re-cell {
  position: relative;
  width: 108rpx;
  height: 108rpx;
}

.re-thumb {
  width: 108rpx;
  height: 108rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid #E5E6EB;
  background: #1D2129;
  display: flex;
  align-items: center;
  justify-content: center;
}

.re-thumb image {
  width: 108rpx;
  height: 108rpx;
  display: block;
}

.re-x {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(29, 33, 41, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.re-add {
  width: 108rpx;
  height: 108rpx;
  border-radius: 12rpx;
  border: 3rpx dashed #E5E6EB;
  color: #86909C;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 20rpx;
}

.re-docs {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.re-doc {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  background: #F7F8FA;
  font-size: 24rpx;
  font-weight: 600;
  color: #1D2129;
}

.re-doc .nm {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.re-doc .x {
  flex: none;
  display: flex;
  align-items: center;
  padding: 6rpx;
}

.rmk-hint {
  margin-top: 20rpx;
  font-size: 20rpx;
  color: #86909C;
  line-height: 1.7;
}

/* ============================================================
   商旅打卡（见《开发指南》第十五节；token 同「政企蓝白」；旧同步核查面板已下线，改为卡片操作区「从商旅同步」）
   ============================================================ */

/* ---------- 卡片「商旅打卡」区：每个用车人一行（姓名 + 状态小字 + 开始/结束两枚 chip 三态） ---------- */
.lc-clock {
  margin-top: 16rpx;
}

/* 区块小标题（次要色） */
.lc-clock-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #4E5969;
  letter-spacing: 1rpx;
}

.ck-person {
  padding: 14rpx 0;
}

.ck-person + .ck-person {
  border-top: 2rpx dashed #E5E6EB;
}

.ck-person-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ck-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1D2129;
}

/* 行右「费用」入口：描边直角小按钮（蓝框蓝字 + 图标，最小高度 48rpx；费用弹层；仅已绑定者显示；margin-left:auto 固定最右端） */
.ck-fee {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-height: 48rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #0E3DA8;
  border: 2rpx solid #0E3DA8;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* 状态小字：工时（黄底墨边小签）/ 还差结束打卡（灰）/ 未绑定商旅（红锁）（紧随姓名，与费用按钮垂直居中） */
.ck-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #86909C;
}

/* 工时小签：浅蓝底蓝字（图标由 JS 给色且无法覆盖，隐藏只留文字） */
.ck-stat.ok {
  color: #0E3DA8;
  background: #E8F0FF;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.ck-stat.ok .t-icon {
  display: none;
}

.ck-stat.red {
  color: #F53F3F;
}

.ck-row2 {
  display: flex;
  gap: 14rpx;
}

/* chip 三态：todo=缺卡（虚线墨边 + 浅黄底，前置墨方块）/ done=已打卡（白底墨边，前置蓝圆白勾）/ lock=未绑定（灰锁禁用） */
.ck-slot {
  flex: 1;
  min-width: 0;
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  position: relative;
  box-sizing: border-box;
}

.ck-t1 {
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 已打卡时标题避开右上角「更新」小标 */
.ck-slot.done .ck-t1 {
  padding-right: 56rpx;
}

.ck-t2 {
  margin-top: 4rpx;
  font-size: 19rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 缺卡态：虚线橙边 + 浅橙底；JS 给色的图标隐藏，以前置橙圆点示意「待打卡」 */
.ck-slot.todo {
  border: 3rpx dashed #FF7D00;
  background: #FFF7E8;
  color: #1D2129;
}

.ck-slot.todo .ck-t1 .t-icon {
  display: none;
}

.ck-slot.todo .ck-t1::before {
  content: '';
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF7D00;
}

.ck-slot.todo .ck-t2 {
  color: #D25F00;
}

/* 已打卡：白底墨边；JS 给色的图标隐藏，改以前置绿圆白勾（.ck-done-dot，wxml 装饰 view） */
.ck-slot.done {
  border: 2rpx solid #E5E6EB;
  background: #ffffff;
  color: #1D2129;
}

.ck-slot.done .ck-t1 .t-icon {
  display: none;
}

.ck-done-dot {
  width: 26rpx;
  height: 26rpx;
  flex: none;
  border-radius: 50%;
  background: #00B42A;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ck-done-dot::before {
  content: '✓';
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

.ck-slot.done .ck-t2 {
  color: #4E5969;
}

.ck-slot.lock {
  border: 3rpx solid #E5E6EB;
  background: #F7F8FA;
  color: #86909C;
}

.ck-slot.lock .ck-t2 {
  color: #C9CDD4;
  white-space: normal; /* 引导文案较长，允许折行 */
}

/* 右上角「更新」小标（整枚 chip 点击即进更新弹层，此为视觉标记） */
.ck-upd {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #0E3DA8;
  display: flex;
  align-items: center;
  gap: 2rpx;
}

/* ---------- 照片区：商旅同步标（水印/非水印同款式渲染，非水印仅无验证信息） ---------- */

/* 「已同步商旅」标（浅橙底橙字小胶囊） */
.sync-tag {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  background: #FFF7E8;
  color: #D25F00;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 「同步失败 · 重试」红标小按钮（同 .v-retry 尺寸） */
.sync-retry {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid #F53F3F;
  color: #F53F3F;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ---------- 人名点亮层：商旅登录过期红框虚线（t-class 落在 check-tag 根上） ---------- */
.tags .t-tag--disabled.ctag-expired {
  background: #FFECE8;
  border: 2rpx dashed #F53F3F;
  color: #F53F3F;
}

/* 过期提醒条（复用 .tip 结构，红色变体） */
.tip.warn {
  background: #FFECE8;
}

.tip.warn .tip-t {
  color: #F53F3F;
}

/* ---------- 打卡确认弹层 ---------- */
.ck-loc {
  margin-top: 24rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.ck-loc-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
}

.ck-loc-line .t-icon {
  flex: none;
  margin-top: 4rpx;
}

.ck-loc-text {
  flex: 1;
  min-width: 0;
}

.ck-loc-text.ph {
  color: #86909C;
  font-weight: 400;
}

/* 地址串可手动输入（input 形态复用 .ck-loc-text 排版；placeholder 走全局 .ph） */
.ck-loc-input {
  flex: 1;
  min-width: 0;
  padding: 0;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #1D2129;
}

/* 副行：经纬度 + 来源标注（同记录已打卡人定位 / 当前定位 / 杆塔带入）或失败提示 */
.ck-loc-sub {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #4E5969;
  line-height: 1.7;
}

.ck-loc-acts {
  margin-top: 14rpx;
  display: flex;
  gap: 16rpx;
}

.ck-mini {
  font-size: 20rpx;
  font-weight: 700;
  color: #0E3DA8;
  border: 2rpx solid #0E3DA8;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.ck-remark {
  margin-top: 20rpx;
}

.ck-remark-lab {
  font-size: 22rpx;
  color: #86909C;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}

.ck-remark-lab text {
  margin-left: auto;
  font-size: 20rpx;
}

.ck-remark-input {
  min-height: 64rpx;
}

/* 打卡确认主按钮（品牌蓝实心圆角块，同 btn-dark 尺寸） */
.btn-orange {
  flex: 2;
  height: 88rpx;
  border-radius: 16rpx;
  background: #0E3DA8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ---------- 费用信息弹层 ---------- */
.fee-scroll {
  max-height: 60vh;
  margin-top: 20rpx;
}

/* 当日适用标准行（浅蓝信息条底 + 右侧「按标准填入」品牌蓝链接） */
.fee-std {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #E8F0FF;
  border-radius: 8rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 8rpx;
}

.fee-std-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #4E5969;
}

.fee-std-fill {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: #0E3DA8;
}

.fee-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 4rpx;
}

.fee-row + .fee-row {
  border-top: 2rpx solid #E5E6EB;
}

.fee-k {
  flex: none;
  width: 140rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1D2129;
}

.fee-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 600;
  box-sizing: border-box;
}

/* 成本分配只读展示值（无输入框，右对齐与输入值视觉同列） */
.fee-v {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  text-align: right;
}

/* ---------- 汇总前核验面板 ---------- */

/* 月份切换条：左右翻月直角墨边钮（同日期条箭头口径）+ 居中月份文案（不看未来月，到当月置灰） */
.rp-mbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-top: 12rpx;
}

.rp-mbtn {
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  border: 2rpx solid #E5E6EB;
  background: #ffffff;
}

.rp-mbtn.disabled {
  opacity: 0.45;
}

.rp-mtext {
  min-width: 180rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #1D2129;
  letter-spacing: 2rpx;
}

.rp-scroll {
  max-height: 60vh;
  margin-top: 20rpx;
}

/* 问题记录卡：浅红底 + 红叉逐条（点卡定位回列表） */
.issue-card {
  background: #FFECE8;
  border-radius: 0;
  padding: 20rpx 24rpx;
}

.issue-card + .issue-card {
  margin-top: 16rpx;
}

.issue-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.issue-plate {
  font-size: 28rpx;
  font-weight: 700;
  color: #1D2129;
}

/* 徽章紧跟车牌（覆盖 .badge 的 margin-left:auto），箭头靠右 */
.issue-head .badge {
  margin-left: 0;
}

.issue-head .t-icon {
  margin-left: auto;
  flex: none;
}

.issue-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.issue-x {
  width: 32rpx;
  height: 32rpx;
  flex: none;
  border-radius: 50%;
  background: #FFECE8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 3rpx;
}

.issue-txt {
  flex: 1;
  min-width: 0;
  color: #1D2129;
  font-weight: 600;
}

/* 绿色通过态（全部通过时面板仅此态） */
.rp-ok {
  margin-top: 20rpx;
  background: #E8FFEA;
  border-radius: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 24rpx;
}

.rp-ok-ic {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rp-ok-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #0B8A37;
}

.rp-ok-p {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #4E5969;
}

/* ---------- 批量从商旅同步面板（悬浮钮独立面板） ---------- */

/* 区段行 + 实心品牌蓝「改日期」钮（同任务单页 range 族） */
.bs-range {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.bs-range-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #1D2129;
  letter-spacing: 1rpx;
}

.bs-range-open {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: #0E3DA8;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 14rpx 32rpx;
}

/* 「发起同步」主按钮（通栏，带刷新图标） */
.bs-go {
  margin-top: 22rpx;
  flex: none;
  width: 100%;
  box-sizing: border-box;
}

/* 同步日志区头：标题 + 管理员「清除全部记录」 */
.bs-log-h {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bs-log-t {
  font-size: 26rpx;
  font-weight: 700;
  color: #1D2129;
  letter-spacing: 2rpx;
  border-left: 8rpx solid #0E3DA8;
  padding-left: 14rpx;
}

.bs-log-clear {
  font-size: 22rpx;
  font-weight: 700;
  color: #F53F3F;
  padding: 6rpx 12rpx;
}

.bs-log-scroll {
  margin-top: 16rpx;
  max-height: 44vh;
}

/* 成功汇总行（绿）；失败明细卡（浅红底逐条） */
.bs-ok {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #f2fbf7;
  border: 2rpx solid #E8FFEA;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #00B42A;
}

.bs-fail {
  margin-top: 14rpx;
  border: 2rpx solid #FFECE8;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 22rpx;
}

.bs-fail-h {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1D2129;
}

/* 失败行前置红三角感叹号（图标由 wxml 的 t-icon error-triangle 提供，与 .lc-fail-x 同款口径） */
.bs-fail-x {
  flex: none;
  margin-top: 2rpx;
}

.bs-fail-h .d {
  flex: none;
}

.bs-fail-h .m {
  min-width: 0;
}

.bs-fail-h .t {
  margin-left: auto;
  flex: none;
  font-size: 20rpx;
  font-weight: 700;
  color: #F53F3F;
  background: #FFECE8;
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
}

.bs-fail-d {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #4E5969;
  line-height: 1.6;
  word-break: break-all;
}

/* ---------- 水印信息修正弹层 ---------- */

.we-scroll {
  max-height: 52vh;
  margin-top: 8rpx;
}

.we-lab {
  margin-top: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1D2129;
  letter-spacing: 1rpx;
}

.we-in {
  margin-top: 12rpx;
  height: 80rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  font-size: 27rpx;
  color: #1D2129;
}

.we-2col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}


/* ---------- 从商旅同步进度（卡片级进度条 + 批量同步全页遮罩；进度轮询 /sgcc/sync/progress） ---------- */

/* 卡片级：同步中整卡锁定（遮罩覆盖全卡阻断操作；居中进度块 + 百分比小字；卡片根 .hazard-top 自带 relative+overflow:hidden） */
.card-lock {
  position: absolute;
  inset: 0;
  z-index: 5;
  background: rgba(255, 255, 255, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
}

.cs-box {
  width: 62%;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.cs-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
  overflow: hidden;
}

.cs-fill {
  height: 100%;
  border-radius: 12rpx;
  background: #0E3DA8;
  transition: width 0.4s ease;
}

.cs-t {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #0E3DA8;
  letter-spacing: 1rpx;
}

/* 批量同步：全页遮罩（z-index 压过 t-popup 弹层），居中白卡 + 进度条 */
.sync-mask {
  position: fixed;
  inset: 0;
  z-index: 16000;
  background: rgba(29, 33, 41, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-card {
  width: 560rpx;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 48rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.sync-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #E8F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-t {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #1D2129;
}

.sync-bar {
  margin-top: 28rpx;
  width: 100%;
  height: 14rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
  overflow: hidden;
}

.sync-fill {
  height: 100%;
  border-radius: 12rpx;
  background: #0E3DA8;
  transition: width 0.4s ease;
}

.sync-p {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #4E5969;
  letter-spacing: 1rpx;
}

/* ============================================================
   入场编排关键帧（旋转 + 平移归位，fill-mode both，时延链；
   引用处：.tswitch/.datebar/.scopebar/.logcard=a-rise，.badge=a-spin，.fab-main=a-fab；
   氛围动效仅 2 处：.ts-sq 与 .datebar .dtxt::before 的 wl-rot360 慢转。
   prefers-reduced-motion 降级由 app.wxss 全局枚举统一关闭）
   ============================================================ */
@keyframes wl-a-rise {
  from {
    opacity: 0;
    transform: translateY(26rpx) rotate(2.5deg) scale(0.97);
  }
  60% {
    opacity: 1;
  }
  to {
    opacity: 1;
    transform: translateY(0) rotate(0) scale(1);
  }
}

@keyframes wl-a-spin {
  from {
    opacity: 0;
    transform: rotate(-160deg) scale(0.3);
  }
  55% {
    opacity: 1;
  }
  to {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
}

@keyframes wl-a-fab {
  0% {
    opacity: 0;
    transform: scale(0.2) rotate(-200deg);
  }
  55% {
    opacity: 1;
  }
  78% {
    transform: scale(1.1) rotate(8deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
}

@keyframes wl-rot360 {
  to {
    transform: rotate(360deg);
  }
}
