/* tdesign 组件变量（本页未引用分包 common.wxss，变量块自留） */
page {
  --td-calendar-radius: 24rpx;
  --td-calendar-selected-border-radius: 12rpx;
  --td-dialog-border-radius: 24rpx;
  --td-toast-radius: 8rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* 按压反馈：轻度变暗 */
.hover-opacity {
  opacity: 0.75 !important;
}

/* ---------- 生成卡片（同 manage 页 tower-bar 族：白卡直角 + 墨边浅色硬影 + 墨黑主按钮） ---------- */
.card {
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.r-l {
  flex: 1;
  min-width: 0;
}

.r-t {
  font-size: 27rpx;
  font-weight: 700;
  color: #1D2129;
}

.r-s {
  font-size: 20rpx;
  color: rgba(29,33,41,.4);
  margin-top: 6rpx;
}

.range {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.range-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #1D2129;
  letter-spacing: 1rpx;
}

/* 「改日期」明显按钮：实心蓝直角块 + 墨边硬影（批量下载面板同款口径） */
.range-open {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: #0E3DA8;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 14rpx 32rpx;
}

.gen {
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #1D2129;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.gen.disabled {
  opacity: 0.45;
}

.hint {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: #4E5969;
}
