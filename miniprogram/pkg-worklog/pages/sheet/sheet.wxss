/* tdesign 组件变量（本页未引用分包 common.wxss，变量块自留） */
page {
  --td-calendar-radius: 24rpx;
  --td-calendar-selected-border-radius: 12rpx;
  --td-dialog-border-radius: 24rpx;
  --td-toast-radius: 8rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* 按压反馈：轻度变暗 */
.hover-opacity {
  opacity: 0.75 !important;
}

/* ---------- 生成卡片（同 manage 页 tower-bar 族：白卡直角 + 墨边浅色硬影 + 墨黑主按钮） ---------- */
.card {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.r-l {
  flex: 1;
  min-width: 0;
}

.r-t {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.r-s {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  margin-top: 6rpx;
}

.range {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.range-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  letter-spacing: 1rpx;
}

/* 「改日期」明显按钮：实心蓝直角块 + 墨边硬影（批量下载面板同款口径） */
.range-open {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--app-on-brand);
  background: var(--app-brand);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 14rpx 32rpx;
}

.gen {
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--app-text-primary);
  color: var(--app-bg-card);
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.gen.disabled {
  opacity: 0.45;
}

/* 存网盘（次按钮：浅蓝底蓝字，与主按钮同形） */
.gen.nd {
  margin-top: 20rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  box-shadow: none;
}

.hint {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--app-text-secondary);
}

/* ---------- iPad / 宽屏适配（600px 起限宽并约束关键字阶/控件；手机不受影响） ---------- */
@media (min-width: 600px) {
  .page-body {
    box-sizing: border-box;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .sheet {
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box;
  }

  .sheet-title {
    font-size: 16px;
  }

  .gen {
    height: 44px;
    font-size: 14px;
  }
}

@media (min-width: 900px) {
  .page-body {
    max-width: 960px;
  }

  .sheet {
    max-width: 720px;
  }
}

@media (min-width: 1200px) {
  .page-body {
    max-width: 1120px;
  }
}
