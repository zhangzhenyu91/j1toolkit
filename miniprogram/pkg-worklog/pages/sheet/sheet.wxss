/* tdesign 组件包豪斯化（本页未引用分包 common.wxss，变量块自留）：日历/对话框/toast 一律直角 */
page {
  --td-calendar-radius: 0;
  --td-calendar-selected-border-radius: 0;
  --td-dialog-border-radius: 0;
  --td-toast-radius: 0;
  --td-tag-square-border-radius: 0;
}

/* 按压反馈：包豪斯硬影元素下沉吃影（覆盖全局 .hover-opacity 的纯变暗） */
.hover-opacity {
  opacity: 0.8 !important;
  transform: translate(3rpx, 3rpx) !important;
}

/* ---------- 生成卡片（同 manage 页 tower-bar 族：白卡直角 + 墨边浅色硬影 + 墨黑主按钮） ---------- */
.card {
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 0;
  padding: 28rpx;
  box-shadow: 6rpx 6rpx 0 rgba(17, 17, 17, 0.12);
}

.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.r-l {
  flex: 1;
  min-width: 0;
}

.r-t {
  font-size: 27rpx;
  font-weight: 700;
  color: #111111;
}

.r-s {
  font-size: 20rpx;
  color: rgba(17,17,17,.4);
  margin-top: 6rpx;
}

.range {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.range-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #111111;
  letter-spacing: 1rpx;
}

/* 「改日期」明显按钮：实心蓝直角块 + 墨边硬影（批量下载面板同款口径） */
.range-open {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: #1d4ed8;
  border: 3rpx solid #111111;
  border-radius: 0;
  box-shadow: 4rpx 4rpx 0 rgba(17, 17, 17, 0.9);
  padding: 14rpx 32rpx;
}

.gen {
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 0;
  background: #111111;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 6rpx 6rpx 0 rgba(17, 17, 17, 0.9);
}

.gen.disabled {
  opacity: 0.45;
}

.hint {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: #5c5748;
}
