<!-- 出工日志 · 汇总单生成（超管 / 班组管理员）：?type=task|fee|dispatch 三合一，选日期范围 → 生成文档并打开 -->
<navbar back title="{{cfg.title}}" />

<view class="page-body" wx:if="{{isAdmin}}">
  <view class="card">
    <view class="r-l">
      <view class="r-t">{{cfg.rangeTitle}}</view>
      <view class="r-s">{{cfg.rangeSub}}</view>
    </view>
    <view class="range">
      <text class="range-text">{{from}} ~ {{to}}</text>
      <view class="range-open" hover-class="hover-opacity" bindtap="onOpenRange">改日期</view>
    </view>
    <view class="gen {{!from || !to || generating ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onGenerate">
      {{generating ? '正在生成…' : '生成并打开'}}
    </view>
  </view>

  <view class="hint">
    {{cfg.hint}}
  </view>
</view>

<!-- 改日期：range 日历（同主页批量下载面板口径；confirm 取 e.detail.value 两个时间戳；min/max 不设置则默认今天起选不了历史日期） -->
<t-calendar
  visible="{{calVisible}}"
  value="{{calValue}}"
  type="range"
  allow-same-day
  switch-mode="month"
  min-date="{{minDate}}"
  max-date="{{maxDate}}"
  title="选择日期范围"
  confirm-btn="确定选择"
  bind:confirm="onCalConfirm"
  bind:close="onCalClose"
/>

<t-toast id="t-toast" />
