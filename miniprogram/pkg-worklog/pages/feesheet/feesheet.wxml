<!-- 出工日志 · 费用汇总（超管 / 班组管理员）：选日期范围 → 生成「人 × 日」费用矩阵 Word 并打开 -->
<navbar back title="费用汇总" />

<view class="page-body" wx:if="{{isAdmin}}">
  <view class="card">
    <view class="r-l">
      <view class="r-t">汇总范围</view>
      <view class="r-s">范围内出车卡片一卡一行、用车人一人一列，末尾合计（单次最多 31 天）</view>
    </view>
    <view class="range">
      <text class="range-text">{{from}} ~ {{to}}</text>
      <view class="range-open" hover-class="hover-opacity" bindtap="onOpenRange">改日期</view>
    </view>
    <view class="gen {{!from || !to || generating ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onGenerate">
      {{generating ? '正在生成…' : '生成并打开'}}
    </view>
  </view>

  <view class="hint">
    字段口径：列＝范围内当过用车人的成员（按「常用数据管理 → 人员」点亮顺序排列，未出现者不列）；行＝每张出车卡片一行（日期升序）；单元格＝（当日伙食补助＋交通费）×1＝计算值，非用车人列留空；末尾合计行为各列之和。费用数据来自商旅同步，有未通过核验的记录需先在「汇总前核验」处理后再生成。
  </view>
</view>

<!-- 改日期：range 日历（同主页批量下载面板口径；confirm 取 e.detail.value 两个时间戳；min/max 不设置则默认今天起选不了历史日期） -->
<t-calendar
  visible="{{calVisible}}"
  value="{{calValue}}"
  type="range"
  allow-same-day
  switch-mode="month"
  min-date="{{minDate}}"
  max-date="{{maxDate}}"
  title="选择日期范围"
  confirm-btn="确定选择"
  bind:confirm="onCalConfirm"
  bind:close="onCalClose"
/>

<t-toast id="t-toast" />
