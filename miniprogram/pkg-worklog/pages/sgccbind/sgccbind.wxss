/* 绑定商旅 · 账号绑定页（转写自设计稿 design/sgcc-clockin.html ②③屏，token 同 app.wxss 方案五） */
@import '../../style/common.wxss';

/* 首个提示卡贴导航下沿（common .tip 自带 margin-top，此处收紧） */
.sg-tip-first {
  margin-top: 8rpx;
}

/* 内容卡（白卡 + 轻投影，对齐设计稿 .card） */
.sg-card {
  padding: 12rpx 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(34, 49, 78, 0.06);
}

/* ---------- 短信登录表单（设计稿 .field：左图标 + 右缀件） ---------- */
.field {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  border: 2rpx solid #e3dccb;
  border-radius: 16rpx;
  background: #ffffff;
  height: 100rpx;
  padding: 0 24rpx 0 88rpx;
  box-sizing: border-box;
}

.field .t-icon {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}

.fi {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 28rpx;
  color: #22314e;
}

/* 图形验证码图（点击刷新）；未获取时为文字占位 */
.captcha {
  flex: none;
  width: 152rpx;
  height: 68rpx;
  margin-left: 16rpx;
  border-radius: 12rpx;
  background: #22314e;
}

.captcha-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

/* 短信验证码右侧「获取验证码 / 倒计时」 */
.suffix {
  flex: none;
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #f26d21;
}

.suffix.off {
  color: #a89f8a;
  font-weight: 400;
}

/* 「登录并绑定」主按钮（.btn-primary 来自分包公共样式） */
.sg-bind-btn {
  margin: 24rpx 0 12rpx;
}

.sg-bind-btn.off {
  opacity: 0.6;
}

/* ---------- 键值行（设计稿 .kv：左标签 + 值 + 右端「可修改」徽章） ---------- */
.kv {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
}

.kv + .kv {
  border-top: 2rpx solid #f1ebdc;
}

.kv .k {
  flex: none;
  width: 160rpx;
  font-size: 24rpx;
  color: #a89f8a;
}

.kv .v {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #22314e;
  word-break: break-all;
}

.kv .v.ok {
  color: #2ba471;
}

.kv .v.bad {
  color: #cf4444;
}

.kv .v-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #6b7690;
  line-height: 1.6;
}

.kv .rt {
  flex: none;
  margin-left: auto;
  padding-left: 16rpx;
}

/* 「已绑定」绿徽章（全局 .badge-outline 的色变体） */
.badge-outline.green {
  border-color: #2ba471;
  color: #2ba471;
}

/* ---------- 已绑定态头部斜纹卡 ---------- */
.sg-head-card {
  margin-top: 8rpx;
}

.sg-head {
  display: flex;
  align-items: center;
  padding: 48rpx 28rpx 28rpx; /* 顶部预留警示斜纹高度 */
}

.sg-avatar {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  border-radius: 24rpx;
  background: #22314e;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sg-head-info {
  margin-left: 24rpx;
  min-width: 0;
}

.sg-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #22314e;
}

.sg-badges {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sg-team {
  font-size: 22rpx;
  color: #6b7690;
}

/* 底部操作区（.sheet-actions / .btn-ghost / .btn-dark 来自分包公共样式） */
.sg-actions {
  margin-top: 32rpx;
}

.btn-ghost.danger {
  color: #cf4444;
  border-color: #eccfcf;
}
