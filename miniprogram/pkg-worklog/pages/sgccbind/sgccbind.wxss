/* 绑定商旅 · 账号绑定页（转写自设计稿 design/sgcc-clockin.html ②③屏，token 同 app.wxss「政企蓝白」） */
@import '../../style/common.wxss';

/* 首个提示卡贴导航下沿（common .tip 自带 margin-top，此处收紧） */
.sg-tip-first {
  margin-top: 8rpx;
}

/* 内容卡（白卡直角；全局 .card 已带墨边 + 蓝硬影，不再叠柔影） */
.sg-card {
  padding: 12rpx 28rpx;
}

/* ---------- 短信登录表单（设计稿 .field：左图标 + 右缀件） ---------- */
.field {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  background: #ffffff;
  height: 100rpx;
  padding: 0 24rpx 0 88rpx;
  box-sizing: border-box;
}

.field .t-icon {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}

.fi {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 28rpx;
  color: #1D2129;
}

/* 登录方式切换（短信/密码分段控件：墨边直角条，激活=墨底白字，同主页 .scopebar 口径） */
.sg-tabs {
  display: flex;
  margin-top: 12rpx;
  padding: 6rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  background: #ffffff;
}

.sg-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4E5969;
}

.sg-tab.on {
  background: #1D2129;
  color: #ffffff;
  font-weight: 700;
}

/* 图形验证码图（点击刷新） */
.captcha {
  flex: none;
  width: 152rpx;
  height: 68rpx;
  margin-left: 16rpx;
  border-radius: 12rpx;
  background: #1D2129;
}

/* 「改用滑块验证」小字链接（图形码不可用时降级入口） */
.sg-alt {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  color: #0E3DA8;
}

/* 短信验证码右侧「获取验证码 / 倒计时」 */
.suffix {
  flex: none;
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #0E3DA8;
}

.suffix.off {
  color: rgba(29,33,41,.4);
  font-weight: 400;
}

/* 「登录并绑定」主按钮（.btn-primary 来自分包公共样式） */
.sg-bind-btn {
  margin: 24rpx 0 12rpx;
}

.sg-bind-btn.off {
  opacity: 0.6;
}

/* ---------- 键值行（设计稿 .kv：左标签 + 值 + 右端「可修改」徽章） ---------- */
.kv {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
}

.kv + .kv {
  border-top: 2rpx solid #E5E6EB;
}

.kv .k {
  flex: none;
  width: 160rpx;
  font-size: 24rpx;
  color: rgba(29,33,41,.4);
}

.kv .v {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1D2129;
  word-break: break-all;
}

.kv .v.ok {
  color: #00B42A;
}

.kv .v.bad {
  color: #F53F3F;
}

.kv .v-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #4E5969;
  line-height: 1.6;
}

.kv .rt {
  flex: none;
  margin-left: auto;
  padding-left: 16rpx;
}

/* 「已绑定」绿徽章（全局 .badge-outline 的色变体） */
.badge-outline.green {
  border-color: #00B42A;
  color: #00B42A;
}

/* ---------- 已绑定态头部卡 ---------- */
.sg-head-card {
  margin-top: 8rpx;
}

.sg-head {
  display: flex;
  align-items: center;
  padding: 48rpx 28rpx 28rpx;
}

.sg-avatar {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  border-radius: 12rpx;
  background: #1D2129;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sg-head-info {
  margin-left: 24rpx;
  min-width: 0;
}

.sg-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D2129;
}

.sg-badges {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sg-team {
  font-size: 22rpx;
  color: #4E5969;
}

/* 底部操作区（.sheet-actions / .btn-ghost / .btn-dark 来自分包公共样式） */
.sg-actions {
  margin-top: 32rpx;
}

.btn-ghost.danger {
  color: #F53F3F;
  border-color: #F53F3F;
}
