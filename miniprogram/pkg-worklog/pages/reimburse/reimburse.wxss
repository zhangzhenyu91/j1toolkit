@import '../../style/common.wxss';
@import '../../style/icons.wxss';

/* 快捷报销：三张汇总表同页分区，每张独立日期范围 */
.qb-page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.qb-sec {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
}

.qb-sheet-t {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.qb-sheet-s {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--app-text-tertiary);
  word-break: break-all;
}

.qb-range {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--app-border);
}

.qb-range-text {
  min-width: 0;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  font-variant-numeric: tabular-nums;
}

.qb-change {
  flex: none;
  padding: 10rpx 22rpx;
  border: 2rpx solid var(--app-border);
  border-radius: 8rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 22rpx;
  font-weight: 600;
}

.qb-sheet-ops {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.qb-gen,
.qb-save {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.qb-gen {
  background: var(--app-text-primary);
  color: var(--app-bg-card);
}

.qb-save {
  border: 2rpx solid var(--app-brand);
  background: var(--app-bg-card);
  color: var(--app-brand);
}

.qb-note {
  margin-top: 22rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  line-height: 1.7;
  color: var(--app-text-tertiary);
}

.disabled {
  opacity: 0.5;
}
