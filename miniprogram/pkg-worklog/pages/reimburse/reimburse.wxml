<!-- 出工日志 · 快捷报销（超管 / 班组管理员）：工作任务单 / 费用汇总 / 派车汇总同页分区；每张表独立日期范围 -->
<navbar back title="快捷报销" />

<view class="page-body qb-page">
  <view class="card qb-sec" wx:for="{{sheetSections}}" wx:key="kind">
    <view class="qb-sheet-t">{{item.title}}</view>
    <view class="qb-sheet-s">{{item.desc}}</view>

    <!-- 每张汇总表独立日期范围（不共用） -->
    <view class="qb-range">
      <text class="qb-range-text">{{item.from}} ~ {{item.to}}</text>
      <view class="qb-change" hover-class="hover-opacity" bindtap="onOpenRange" data-target="{{item.kind}}"
        >改日期</view
      >
    </view>

    <view class="qb-sheet-ops">
      <view
        class="qb-gen {{sheetBusyKind ? 'disabled' : ''}}"
        hover-class="hover-opacity"
        bindtap="onSheetGenerate"
        data-kind="{{item.kind}}"
        >{{sheetBusyKind === item.kind ? '正在生成…' : '生成并打开'}}</view
      >
      <view
        class="qb-save {{sheetSavingKind ? 'disabled' : ''}}"
        hover-class="hover-opacity"
        bindtap="onSheetSave"
        data-kind="{{item.kind}}"
        >{{sheetSavingKind === item.kind ? '正在保存…' : '存网盘'}}</view
      >
    </view>
  </view>

  <view class="qb-note">三张汇总表仅超管 / 本班班组管理员可用；生成前如存在未通过核验，会先提示处理。</view>
</view>

<!-- 分区日期范围日历 -->
<t-calendar
  visible="{{calVisible}}"
  value="{{calValue}}"
  type="range"
  allow-same-day
  switch-mode="month"
  min-date="{{minDate}}"
  max-date="{{maxDate}}"
  title="选择日期范围"
  confirm-btn="确定选择"
  bind:confirm="onCalConfirm"
  bind:close="onCalClose"
/>

<!-- 汇总存网盘目录选择 -->
<nd-dirpicker
  visible="{{ndSaveVisible}}"
  default-path="出工日志"
  bind:confirm="onNdDirConfirm"
  bind:close="onNdDirClose"
/>

<t-toast id="t-toast" />
