@import '../../style/icons.wxss';

/* ---------- 分段（激活态白底蓝字，政企蓝白分段控件口径） ---------- */
/* tdesign 组件变量（本页未引用分包 common.wxss，变量块自留） */
page {
  --td-popup-border-radius: 24rpx;
  --td-dialog-border-radius: 24rpx;
  --td-toast-radius: 8rpx;
  --td-tag-round-border-radius: 12rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* 按压反馈：轻度变暗 */
.hover-opacity {
  opacity: 0.75 !important;
}

.seg-wrap {
  /* CSS 变量穿透组件（apply-shared），覆盖 t-segmented 主题 */
  --td-segmented-bg-color: var(--app-border);
  --td-segmented-item-active-bg: var(--app-bg-card);
  --td-segmented-item-active-color: var(--app-brand);
  --td-segmented-item-color: var(--app-text-secondary);
}

.seg-wrap .t-segmented {
  border: none;
  border-radius: 16rpx;
  box-shadow: none;
}

.seg-wrap .t-segmented__thumb {
  border-radius: 12rpx;
}

/* ---------- 添加栏 ---------- */
.addbar {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.inp {
  flex: 1;
  height: 84rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.inp-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--app-text-primary);
}

.ph {
  color: var(--app-text-tertiary);
}

.btn-add {
  width: 172rpx;
  height: 84rpx;
  flex: none;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* ---------- 字典列表 ---------- */
.mlist {
  margin-top: 28rpx;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.mrow + .mrow {
  border-top: 2rpx solid var(--app-border);
}

.mrow .mi {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mrow .mt {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.mrow.off .mt {
  color: var(--app-text-tertiary);
  font-weight: 400;
}

.moff-tip {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 0 10rpx;
  line-height: 30rpx;
}

.mrow .ops {
  margin-left: auto;
  display: flex;
  gap: 28rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.mrow .ops .edit {
  color: var(--app-brand);
}

.mrow .ops .off {
  color: var(--app-text-tertiary);
}

.mempty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--app-text-tertiary);
}

/* ---------- 人员来源标（屏六 .sync-pill/.hand-pill，直角小签） ---------- */
.sync-pill {
  font-size: 19rpx;
  color: var(--app-success);
  background: var(--app-success-bg);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

.hand-pill {
  font-size: 19rpx;
  color: var(--app-text-secondary);
  background: var(--app-brand-light);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

/* ---------- 杆塔坐标板块（屏六 .tower-bar） ---------- */
.tower-sec {
  margin: 36rpx 8rpx 18rpx;
}

.tower-bar {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.tower-bar .tb-n {
  font-size: 25rpx;
  font-weight: 700;
}

.tower-bar .tb-s {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  margin-top: 4rpx;
}

.tb-btn {
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}

.tb-btn.tpl {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  color: var(--app-text-primary);
}

.tb-btn.imp {
  background: var(--app-brand-light);
  border: 3rpx solid var(--app-brand);
  color: var(--app-brand);
}

.tower-bar .tb-btns {
  margin-left: auto;
  display: flex;
  gap: 16rpx;
  flex: none;
}

/* ---------- 导入弹层（屏七：底部弹层 + 三步） ----------
   .sheet 族同分包 common.wxss「政企蓝白」口径：顶部 24rpx 圆角 + 软影，无几何记号；
   头/体/脚三段 flex，整体 max-height 封顶 + overflow:hidden，内容体 flex:1 1 auto 独立滚动 */
.sheet {
  position: relative;
  background: var(--app-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

.sheet-title {
  flex: none;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--app-text-primary);
}

/* 弹层内容体（flex-basis 用 auto：0 基准会把自适应高度弹层内容压没） */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角隐形关闭热区（closeBtn 未启用仍可点）：置空防误关 */
.t-popup__close {
  display: none;
}

.imp-steps {
  margin-top: 32rpx;
}

.imp-step {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.imp-step .no {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  border-radius: 50%;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
}

.imp-step .st-body {
  flex: 1;
  min-width: 0;
}

.imp-step .st-t {
  font-size: 25rpx;
  font-weight: 700;
}

.imp-step .st-d {
  font-size: 21rpx;
  color: var(--app-text-tertiary);
  margin-top: 4rpx;
  line-height: 1.6;
}

.dl-line {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--app-brand);
  background: var(--app-brand-light);
  border: 2rpx solid var(--app-brand);
  border-radius: 12rpx;
  padding: 12rpx 22rpx;
}

.pick-file {
  margin-top: 14rpx;
  border: 3rpx dashed var(--app-border);
  border-radius: 12rpx;
  padding: 22rpx;
  text-align: center;
}

.pick-file .pfn {
  font-size: 24rpx;
  font-weight: 700;
  word-break: break-all;
}

.pick-file .pfn .pfx {
  margin-left: 12rpx;
  color: var(--app-text-tertiary);
  font-weight: 400;
}

.pick-file .pfd {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  margin-top: 6rpx;
}

.imp-sum {
  margin-top: 14rpx;
  background: var(--app-bg-nested);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
  line-height: 1.8;
}

.imp-sum b {
  color: var(--app-brand);
}

.sheet-actions {
  flex: none;
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text-secondary);
  letter-spacing: 6rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-ghost.disabled,
.btn-dark.disabled {
  opacity: 0.5;
}
