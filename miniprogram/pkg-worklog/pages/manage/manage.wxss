/* ---------- 分段（激活态墨黑底白字，对齐设计稿 .seg） ---------- */
/* tdesign 组件包豪斯化（本页未引用分包 common.wxss，变量块自留）：弹层/对话框/toast 一律直角 */
page {
  --td-popup-border-radius: 0;
  --td-dialog-border-radius: 0;
  --td-toast-radius: 0;
  --td-tag-round-border-radius: 0;
  --td-tag-square-border-radius: 0;
}

/* 按压反馈：包豪斯硬影元素下沉吃影（覆盖全局 .hover-opacity 的纯变暗） */
.hover-opacity {
  opacity: 0.8 !important;
  transform: translate(3rpx, 3rpx) !important;
}

.seg-wrap {
  /* CSS 变量穿透组件（apply-shared），覆盖 t-segmented 主题 */
  --td-segmented-bg-color: #ffffff;
  --td-segmented-item-active-bg: #111111;
  --td-segmented-item-active-color: #ffffff;
  --td-segmented-item-color: #5c5748;
}

.seg-wrap .t-segmented {
  border: 4rpx solid #111111;
  border-radius: 0;
  box-shadow: none;
}

.seg-wrap .t-segmented__thumb {
  border-radius: 0;
}

/* ---------- 添加栏 ---------- */
.addbar {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.inp {
  flex: 1;
  height: 84rpx;
  background: #ffffff;
  border: 3rpx solid #111111;
  border-radius: 0;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.inp-input {
  flex: 1;
  font-size: 26rpx;
  color: #111111;
}

.ph {
  color: rgba(17,17,17,.4);
}

.btn-add {
  width: 172rpx;
  height: 84rpx;
  flex: none;
  border-radius: 0;
  border: 4rpx solid #111111;
  background: #1d4ed8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 6rpx 6rpx 0 rgba(17, 17, 17, 0.9);
}

/* ---------- 字典列表 ---------- */
.mlist {
  margin-top: 28rpx;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.mrow + .mrow {
  border-top: 2rpx solid #e7e1d2;
}

.mrow .mi {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  border-radius: 0;
  background: #edf2fe;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mrow .mt {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.mrow.off .mt {
  color: rgba(17,17,17,.4);
  font-weight: 400;
}

.moff-tip {
  font-size: 20rpx;
  color: rgba(17,17,17,.4);
  border: 2rpx solid rgba(17,17,17,.35);
  border-radius: 0;
  padding: 0 10rpx;
  line-height: 30rpx;
}

.mrow .ops {
  margin-left: auto;
  display: flex;
  gap: 28rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.mrow .ops .edit {
  color: #1d4ed8;
}

.mrow .ops .off {
  color: rgba(17,17,17,.4);
}

.mempty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(17,17,17,.4);
}

/* ---------- 人员来源标（屏六 .sync-pill/.hand-pill，直角小签） ---------- */
.sync-pill {
  font-size: 19rpx;
  color: #1e9e50;
  background: #eaf6ee;
  border-radius: 0;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

.hand-pill {
  font-size: 19rpx;
  color: #5c5748;
  background: #edf2fe;
  border-radius: 0;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

/* ---------- 杆塔坐标板块（屏六 .tower-bar） ---------- */
.tower-sec {
  margin: 36rpx 8rpx 18rpx;
}

.tower-bar {
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 0;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 6rpx 6rpx 0 rgba(17, 17, 17, 0.12);
}

.tower-bar .tb-n {
  font-size: 25rpx;
  font-weight: 700;
}

.tower-bar .tb-s {
  font-size: 20rpx;
  color: rgba(17,17,17,.4);
  margin-top: 4rpx;
}

.tb-btn {
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 0;
  padding: 12rpx 20rpx;
}

.tb-btn.tpl {
  background: #ffffff;
  border: 3rpx solid #111111;
  color: #111111;
}

.tb-btn.imp {
  background: #edf2fe;
  border: 3rpx solid #1d4ed8;
  color: #1d4ed8;
}

.tower-bar .tb-btns {
  margin-left: auto;
  display: flex;
  gap: 16rpx;
  flex: none;
}

/* ---------- 导入弹层（屏七：底部弹层 + 三步） ----------
   包豪斯化同分包 .sheet 族：直角 + 顶部 6rpx 墨线 + 向上硬影 */
.sheet {
  position: relative;
  background: #ffffff;
  border-radius: 0;
  border-top: 6rpx solid #111111;
  box-shadow: 0 -8rpx 0 rgba(17, 17, 17, 0.15);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #111111;
}

/* 标题前置红方块（inline-block 保持整体居中） */
.sheet-title::before {
  content: '';
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  background: #d22730;
  margin-right: 12rpx;
}

.imp-steps {
  margin-top: 32rpx;
}

.imp-step {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.imp-step .no {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
}

.imp-step .st-body {
  flex: 1;
  min-width: 0;
}

.imp-step .st-t {
  font-size: 25rpx;
  font-weight: 700;
}

.imp-step .st-d {
  font-size: 21rpx;
  color: rgba(17,17,17,.4);
  margin-top: 4rpx;
  line-height: 1.6;
}

.dl-line {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: #1d4ed8;
  background: #edf2fe;
  border: 2rpx solid #1d4ed8;
  border-radius: 0;
  padding: 12rpx 22rpx;
}

.pick-file {
  margin-top: 14rpx;
  border: 3rpx dashed rgba(17,17,17,.35);
  border-radius: 0;
  padding: 22rpx;
  text-align: center;
}

.pick-file .pfn {
  font-size: 24rpx;
  font-weight: 700;
  word-break: break-all;
}

.pick-file .pfn .pfx {
  margin-left: 12rpx;
  color: rgba(17,17,17,.4);
  font-weight: 400;
}

.pick-file .pfd {
  font-size: 20rpx;
  color: rgba(17,17,17,.4);
  margin-top: 6rpx;
}

.imp-sum {
  margin-top: 14rpx;
  background: #fbf9f2;
  border: 2rpx solid #e7e1d2;
  border-radius: 0;
  padding: 18rpx 24rpx;
  font-size: 22rpx;
  color: #5c5748;
  line-height: 1.8;
}

.imp-sum b {
  color: #1d4ed8;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 0;
  border: 4rpx solid #111111;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #5c5748;
  letter-spacing: 6rpx;
  box-sizing: border-box;
  box-shadow: 4rpx 4rpx 0 rgba(17, 17, 17, 0.9);
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 0;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 6rpx 6rpx 0 rgba(17, 17, 17, 0.9);
}

.btn-ghost.disabled,
.btn-dark.disabled {
  opacity: 0.5;
}
