/* ---------- 分段（激活态白底蓝字，政企蓝白分段控件口径） ---------- */
/* tdesign 组件变量（本页未引用分包 common.wxss，变量块自留） */
page {
  --td-popup-border-radius: 24rpx;
  --td-dialog-border-radius: 24rpx;
  --td-toast-radius: 8rpx;
  --td-tag-round-border-radius: 12rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* 按压反馈：轻度变暗 */
.hover-opacity {
  opacity: 0.75 !important;
}

.seg-wrap {
  /* CSS 变量穿透组件（apply-shared），覆盖 t-segmented 主题 */
  --td-segmented-bg-color: #E5E6EB;
  --td-segmented-item-active-bg: #ffffff;
  --td-segmented-item-active-color: #0E3DA8;
  --td-segmented-item-color: #4E5969;
}

.seg-wrap .t-segmented {
  border: none;
  border-radius: 16rpx;
  box-shadow: none;
}

.seg-wrap .t-segmented__thumb {
  border-radius: 12rpx;
}

/* ---------- 添加栏 ---------- */
.addbar {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.inp {
  flex: 1;
  height: 84rpx;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.inp-input {
  flex: 1;
  font-size: 26rpx;
  color: #1D2129;
}

.ph {
  color: rgba(29,33,41,.4);
}

.btn-add {
  width: 172rpx;
  height: 84rpx;
  flex: none;
  border-radius: 12rpx;
  border: 2rpx solid #E5E6EB;
  background: #0E3DA8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* ---------- 字典列表 ---------- */
.mlist {
  margin-top: 28rpx;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.mrow + .mrow {
  border-top: 2rpx solid #E5E6EB;
}

.mrow .mi {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  border-radius: 12rpx;
  background: #E8F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mrow .mt {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.mrow.off .mt {
  color: rgba(29,33,41,.4);
  font-weight: 400;
}

.moff-tip {
  font-size: 20rpx;
  color: rgba(29,33,41,.4);
  border: 2rpx solid rgba(29,33,41,.35);
  border-radius: 12rpx;
  padding: 0 10rpx;
  line-height: 30rpx;
}

.mrow .ops {
  margin-left: auto;
  display: flex;
  gap: 28rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.mrow .ops .edit {
  color: #0E3DA8;
}

.mrow .ops .off {
  color: rgba(29,33,41,.4);
}

.mempty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(29,33,41,.4);
}

/* ---------- 人员来源标（屏六 .sync-pill/.hand-pill，直角小签） ---------- */
.sync-pill {
  font-size: 19rpx;
  color: #00B42A;
  background: #eaf6ee;
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

.hand-pill {
  font-size: 19rpx;
  color: #4E5969;
  background: #E8F0FF;
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

/* ---------- 杆塔坐标板块（屏六 .tower-bar） ---------- */
.tower-sec {
  margin: 36rpx 8rpx 18rpx;
}

.tower-bar {
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.tower-bar .tb-n {
  font-size: 25rpx;
  font-weight: 700;
}

.tower-bar .tb-s {
  font-size: 20rpx;
  color: rgba(29,33,41,.4);
  margin-top: 4rpx;
}

.tb-btn {
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}

.tb-btn.tpl {
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  color: #1D2129;
}

.tb-btn.imp {
  background: #E8F0FF;
  border: 3rpx solid #0E3DA8;
  color: #0E3DA8;
}

.tower-bar .tb-btns {
  margin-left: auto;
  display: flex;
  gap: 16rpx;
  flex: none;
}

/* ---------- 导入弹层（屏七：底部弹层 + 三步） ----------
   .sheet 族同分包 common.wxss「政企蓝白」口径：顶部 24rpx 圆角 + 软影，无几何记号 */
.sheet {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #1D2129;
}

.imp-steps {
  margin-top: 32rpx;
}

.imp-step {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.imp-step .no {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  border-radius: 50%;
  background: #E8F0FF;
  color: #0E3DA8;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
}

.imp-step .st-body {
  flex: 1;
  min-width: 0;
}

.imp-step .st-t {
  font-size: 25rpx;
  font-weight: 700;
}

.imp-step .st-d {
  font-size: 21rpx;
  color: rgba(29,33,41,.4);
  margin-top: 4rpx;
  line-height: 1.6;
}

.dl-line {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: #0E3DA8;
  background: #E8F0FF;
  border: 2rpx solid #0E3DA8;
  border-radius: 12rpx;
  padding: 12rpx 22rpx;
}

.pick-file {
  margin-top: 14rpx;
  border: 3rpx dashed rgba(29,33,41,.35);
  border-radius: 12rpx;
  padding: 22rpx;
  text-align: center;
}

.pick-file .pfn {
  font-size: 24rpx;
  font-weight: 700;
  word-break: break-all;
}

.pick-file .pfn .pfx {
  margin-left: 12rpx;
  color: rgba(29,33,41,.4);
  font-weight: 400;
}

.pick-file .pfd {
  font-size: 20rpx;
  color: rgba(29,33,41,.4);
  margin-top: 6rpx;
}

.imp-sum {
  margin-top: 14rpx;
  background: #F7F8FA;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 22rpx;
  color: #4E5969;
  line-height: 1.8;
}

.imp-sum b {
  color: #0E3DA8;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid #E5E6EB;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #4E5969;
  letter-spacing: 6rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 12rpx;
  background: #0E3DA8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-ghost.disabled,
.btn-dark.disabled {
  opacity: 0.5;
}
