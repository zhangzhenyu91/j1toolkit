<!-- 出工日志 · 工作任务单（超管 / 班组管理员）：选日期 → 生成合并 Word 并打开 -->
<navbar back title="工作任务单" />

<view class="page-body" wx:if="{{isAdmin}}">
  <view class="card">
    <view class="row">
      <view class="r-l">
        <view class="r-t">生成日期</view>
        <view class="r-s">当天全部出车卡片，一卡一页合并为一个 Word</view>
      </view>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="date-pill" hover-class="hover-opacity">{{date}}</view>
      </picker>
    </view>
    <view class="gen {{!date || generating ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onGenerate">
      {{generating ? '正在生成…' : '生成并打开'}}
    </view>
  </view>

  <view class="hint">
    字段口径：线路杆塔号＝本卡水印照片的施工内容；工作负责人＝排序最前的用车人（排序在「常用数据管理 → 人员」维护）；工作地点＝派车目的地；工作班成员＝用车人（空格间隔）；派车情况＝车牌号。未出车卡片不生成。
  </view>
</view>

<t-toast id="t-toast" />
