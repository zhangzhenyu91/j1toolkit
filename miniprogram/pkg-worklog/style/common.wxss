/* ============================================================
   出工日志分包共享样式（主页 index 与商旅绑定页 sgccbind 共用；
   新建/编辑表单为主页底部弹层，样式同源于此）
   转写自设计稿 design/worklog.html，token 同 app.wxss（方案十二·包豪斯几何）
   ============================================================ */

/* ---------- tdesign 组件包豪斯化（CSS 变量穿透 apply-shared：弹层/日历/对话框/toast/tag 一律直角） ---------- */
page {
  --td-popup-border-radius: 0; /* 半屏层直角（容器圆角由 .sheet 族掌管） */
  --td-calendar-radius: 0;
  --td-calendar-selected-border-radius: 0; /* 选中日直角块 */
  --td-dialog-border-radius: 0;
  --td-toast-radius: 0;
  --td-tag-round-border-radius: 0; /* tag/check-tag 胶囊直角化（人员点亮 chip 见 .tags 覆盖） */
  --td-tag-square-border-radius: 0; /* 方形 tag 默认 8rpx 圆角一并清零 */
}

/* 按压反馈：包豪斯硬影元素下沉吃影（覆盖全局 .hover-opacity 的纯变暗，translate 配合硬影读作按压） */
.hover-opacity {
  opacity: 0.8 !important;
  transform: translate(3rpx, 3rpx) !important;
}

/* ---------- 板块标题行（标题本体用全局 .section-title） ---------- */
.sec-row {
  display: flex;
  align-items: center;
  margin: 28rpx 8rpx 18rpx;
}

.sec-note {
  margin-left: auto;
  font-size: 22rpx;
  color: rgba(17,17,17,.4);
}

/* 底部固定操作区（.bottombar 纸底色条）已随主页悬浮按钮化删除；表单弹层主按钮沿用 .btn-primary */
.btn-primary {
  height: 96rpx;
  border-radius: 0;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  box-shadow: 6rpx 6rpx 0 rgba(17, 17, 17, 0.9); /* 墨底挤出硬影，按压下沉见 .hover-opacity */
}

/* ---------- 日期 chip（编辑页展示当前日志日期） ---------- */
.date-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin: 4rpx 8rpx 0;
  background: #edf2fe;
  color: #1d4ed8;
  border-radius: 0;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ---------- 提示条（「未出车」联动说明） ---------- */
.tip {
  margin-top: 28rpx;
  background: #edf2fe;
  border-radius: 0;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 30rpx;
}

.tip .ti {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip .tip-t {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #111111;
}

.tip .tip-p {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #5c5748;
  line-height: 1.6;
}

/* ---------- 人员点亮区（t-check-tag） ---------- */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding: 4rpx 4rpx 0;
}

/* check-tag 外观包豪斯化：直角 + 4rpx 墨边；未点亮=白底墨字，点亮=蓝底白字 + 墨色硬影（非浅蓝胶囊） */
.tags .t-tag {
  min-width: 144rpx;
  height: 68rpx;
  border-radius: 0;
  border-width: 4rpx;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.tags .t-tag--outline.t-tag--default {
  background: #ffffff;
  border-color: #111111;
  color: #111111;
}

/* 点亮态：蓝底白字 + 墨边 + 墨硬影（特异性压过组件 .t-tag--outline.t-tag--primary） */
.tags .t-tag--outline.t-tag--primary,
.tags .t-tag--checked {
  background: #1d4ed8;
  border-color: #111111;
  color: #ffffff;
  box-shadow: 4rpx 4rpx 0 #111111;
}

.tags .t-tag--disabled {
  background: #f8f6f1;
  border-color: #c9c0ab;
  color: #c6ba9c;
  box-shadow: none;
}

.ctag-note {
  font-size: 20rpx;
  margin-left: 6rpx;
}

/* ---------- 水印照片项：左缩略图 + 右侧四块（与缩略图等高，不溢出） ---------- */
.photo-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 28rpx;
  position: relative;
  align-items: stretch;
}

.photo-item + .photo-item {
  border-top: 2rpx solid #e7e1d2;
}

/* 缩略图：对角圆角几何裁切（左上/右下微角、右上/左下圆角；设计稿 3px 16px 3px 16px，1px=2rpx） */
.ph-img {
  width: 168rpx;
  height: 340rpx;
  flex: none;
  border-radius: 6rpx 32rpx 6rpx 32rpx;
  border: 4rpx solid #111111;
  box-sizing: border-box;
  background: #e9e2d2;
}

.ph-right {
  flex: 1;
  min-width: 0;
  height: 340rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ① 验证情况（顶部） */
.ph-status {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* ② 人名标签（t-tag 描边） */
.ph-names {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.ph-names .t-tag {
  font-size: 24rpx;
}

/* ③ 施工内容（行尾复制按钮） */
.ph-wc {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
  line-height: 1.5;
}

.ph-wc .wc-text {
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ph-wc .wc-copy {
  flex: none;
}

.ph-wc.empty {
  color: rgba(17,17,17,.4);
  font-weight: 400;
}

/* ④~⑧ 拍摄时间 / 天气 / 地点 / 经度 / 纬度（标签与内容字号统一） */
.ph-meta {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 2rpx dashed #e7e1d2;
}

.meta-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 3rpx 0;
  font-size: 22rpx;
  color: #5c5748;
  line-height: 1.4;
}

.meta-line .meta-label {
  flex: none;
  width: 96rpx;
  font-size: 22rpx;
  color: rgba(17,17,17,.4);
}

.meta-line .meta-val {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

/* 验证角标签：包豪斯直角小签（墨线描边；通过=绿底白字 / 失败=红底白字 / 识别中=浅蓝底蓝字） */
.vtag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 0;
  border: 3rpx solid #111111;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 验证失败后的「重新验证」小按钮 */
.v-retry {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 0;
  border: 3rpx solid #1d4ed8;
  color: #1d4ed8;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.vtag.ing {
  background: #edf2fe;
  color: #1d4ed8;
}

.vtag.ok {
  background: #1e9e50;
  color: #ffffff;
}

.vtag.bad {
  background: #d22730;
  color: #ffffff;
}

/* 照片右上角删除小图标 */
.ph-del {
  position: absolute;
  top: 14rpx;
  right: 18rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 添加水印照片（灰底虚线，通栏铺满卡片） */
.add-photo {
  margin: 4rpx 0 0;
  height: 104rpx;
  border-radius: 0;
  background: #efebe0;
  border: 3rpx dashed rgba(17,17,17,.35);
  color: rgba(17,17,17,.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

/* ---------- 底部弹层（筛选下拉 / 人名点亮共用） ----------
   包豪斯化：直角 + 顶部 6rpx 墨线 + 向上硬影；
   标题前置红方块（.sheet-title::before） */
.sheet {
  position: relative;
  background: #ffffff;
  border-radius: 0;
  border-top: 6rpx solid #111111;
  box-shadow: 0 -8rpx 0 rgba(17, 17, 17, 0.15);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #111111;
}

/* 标题前置红方块（inline-block 保持整体居中） */
.sheet-title::before {
  content: '';
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  background: #d22730;
  margin-right: 12rpx;
}

.sheet-note {
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(17,17,17,.4);
  letter-spacing: 2rpx;
}

.sheet .tags {
  margin-top: 32rpx;
  padding: 0 4rpx;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 0;
  border: 4rpx solid #111111;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #5c5748;
  letter-spacing: 6rpx;
  box-sizing: border-box;
  box-shadow: 4rpx 4rpx 0 rgba(17, 17, 17, 0.9);
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 0;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 6rpx 6rpx 0 rgba(17, 17, 17, 0.9);
}

/* ============================================================
   表单底部弹层（新建/编辑合一，移植自已取缔的 edit 页）
   ============================================================ */

/* ---------- 巡视内容输入框 ---------- */
.textarea-wrap {
  background: #ffffff;
  border: 3rpx solid #111111;
  border-radius: 0;
  padding: 20rpx 28rpx;
}

.textarea {
  width: 100%;
  min-height: 132rpx;
  font-size: 28rpx;
  color: #111111;
  line-height: 1.7;
  box-sizing: border-box;
}

.ph {
  color: rgba(17,17,17,.4);
}

/* ---------- 派车情况表单卡（直角 + 墨边，弹层白底上以描边定义边界，不用柔影） ---------- */
.form-card {
  background: #ffffff;
  border-radius: 0;
  border: 4rpx solid #111111;
  overflow: hidden;
}

.frow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.frow + .frow {
  border-top: 2rpx solid #e7e1d2;
}

.frow .fk {
  flex: none;
  width: 128rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.frow .fv {
  flex: 1;
  font-size: 28rpx;
  color: #111111;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.frow .fv.placeholder {
  color: rgba(17,17,17,.4);
  font-weight: 400;
}

.frow.disabled {
  background: #faf8f1;
}

.frow.disabled .fk,
.frow.disabled .fv {
  color: rgba(17,17,17,.4);
}

.frow.disabled .fv {
  font-weight: 400;
}

/* 「无派车」灰徽章 */
.badge-mini {
  flex: none;
  border: 2rpx solid rgba(17,17,17,.35);
  color: rgba(17,17,17,.4);
  border-radius: 0;
  padding: 0 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
}

/* ---------- 内联筛选下拉（手风琴展开于表单行下方，结构参照设计稿屏④ .drop-panel） ---------- */
.drop-panel {
  border-top: 2rpx solid #e7e1d2;
  background: #faf8f1;
  padding: 16rpx 24rpx 20rpx;
}

.drop-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border: 3rpx solid #111111;
  border-radius: 0;
  padding: 16rpx 24rpx;
}

.drop-input {
  flex: 1;
  font-size: 26rpx;
  color: #111111;
}

.drop-list {
  margin-top: 16rpx;
  max-height: 480rpx;
  background: #ffffff;
  border: 3rpx solid #111111;
  border-radius: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.drop-item {
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 选中标记前置方块槽位（未选中留空占位，各行文字对齐） */
.drop-item::before {
  content: '';
  flex: none;
  width: 14rpx;
  height: 14rpx;
}

.drop-item + .drop-item {
  border-top: 2rpx solid #e7e1d2;
}

.drop-item .t-icon {
  margin-left: auto;
}

/* 选中项：白底蓝字 + 前置蓝方块（不用浅蓝高亮） */
.drop-item.on {
  color: #1d4ed8;
  font-weight: 700;
}

.drop-item.on::before {
  background: #1d4ed8;
}

.drop-item.none {
  color: #5c5748;
}

.drop-item.none .badge-mini {
  margin-left: auto;
}

.drop-empty {
  margin-top: 16rpx;
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(17,17,17,.4);
}
