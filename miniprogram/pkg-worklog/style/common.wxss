/* ============================================================
   出工日志分包共享样式（主页 index / 商旅绑定页 sgccbind / 派车对齐 dispatch 共用；
   新建/编辑表单为主页底部弹层，样式同源于此）
   「政企蓝白」，token 同 app.wxss
   ============================================================ */

/* ---------- tdesign 组件圆角与 token（CSS 变量穿透 apply-shared） ---------- */
page {
  --td-popup-border-radius: 24rpx;
  --td-calendar-radius: 24rpx;
  --td-calendar-selected-border-radius: 12rpx;
  --td-dialog-border-radius: 24rpx;
  --td-toast-radius: 8rpx;
  --td-tag-round-border-radius: 12rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* 按压反馈：轻度变暗 + 微缩（政企蓝白不做下沉吃影） */
.hover-opacity {
  opacity: 0.75 !important;
}

/* 短状态过渡（≤0.2s，仅状态切换反馈；无循环氛围动效；prefers-reduced-motion 由 app.wxss 统一关闭） */
.btn-primary,
.btn-ghost,
.btn-dark,
.hover-opacity,
.hover-scale {
  transition:
    opacity 0.15s ease-out,
    background-color 0.15s ease-out,
    color 0.15s ease-out,
    border-color 0.15s ease-out,
    transform 0.15s ease-out;
}

/* ---------- 板块标题行（标题本体用全局 .section-title） ---------- */
.sec-row {
  display: flex;
  align-items: center;
  margin: 28rpx 8rpx 18rpx;
}

.sec-note {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

/* 底部固定操作区（.bottombar 纸底色条）已随主页悬浮按钮化删除；表单弹层主按钮沿用 .btn-primary */
.btn-primary {
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ---------- 日期 chip（编辑页展示当前日志日期） ---------- */
.date-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin: 4rpx 8rpx 0;
  background: var(--app-brand-light);
  color: var(--app-brand);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ---------- 提示条（「未出车」联动说明） ---------- */
.tip {
  margin-top: 28rpx;
  background: var(--app-brand-light);
  border-radius: 0;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 30rpx;
}

.tip .ti {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 0;
  background: var(--app-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip .tip-t {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.tip .tip-p {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
  line-height: 1.6;
}

/* ---------- 人员点亮区（t-check-tag） ---------- */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding: 4rpx 4rpx 0;
}

/* check-tag 外观：1 发丝边圆角；未点亮=白底深灰字，点亮=蓝底白字 */
.tags .t-tag {
  min-width: 144rpx;
  height: 68rpx;
  border-radius: 12rpx;
  border-width: 2rpx;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.tags .t-tag--outline.t-tag--default {
  background: var(--app-bg-card);
  border-color: var(--app-border);
  color: var(--app-text-primary);
}

/* 点亮态：蓝底白字（特异性压过组件 .t-tag--outline.t-tag--primary） */
.tags .t-tag--outline.t-tag--primary,
.tags .t-tag--checked {
  background: var(--app-brand);
  border-color: var(--app-brand);
  color: var(--app-on-brand);
  box-shadow: none;
}

.tags .t-tag--disabled {
  background: var(--app-bg-nested);
  border-color: var(--app-border);
  color: var(--app-text-tertiary);
  box-shadow: none;
}

.ctag-note {
  font-size: 20rpx;
  margin-left: 6rpx;
}

/* ---------- 水印照片项：左缩略图 + 右侧四块（与缩略图等高，不溢出） ---------- */
.photo-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 28rpx;
  position: relative;
  align-items: stretch;
}

.photo-item + .photo-item {
  border-top: 2rpx solid var(--app-border);
}

/* 缩略图：12rpx 统一圆角（外层 box 固定尺寸，内含 image 或加载失败占位） */
.ph-img-box {
  width: 168rpx;
  height: 340rpx;
  flex: none;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  box-sizing: border-box;
  background: var(--app-bg-nested);
  overflow: hidden;
}

.ph-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* 图片加载失败占位（点按重试；尺寸由所在槽位决定；display 覆盖 image 槽位的 block） */
.img-fallback {
  width: 100%;
  height: 100%;
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--app-bg-nested);
  color: var(--app-text-tertiary);
  animation: imgFallbackIn 0.18s ease-out both;
}

@keyframes imgFallbackIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* t-icon 外部样式类：字号经 t-class 控制（size 内联 rpx 会随屏宽膨胀），图标色经 t-class/父级继承
   随 --app-* 深浅（不向 color 属性传 var()）；白字图标在品牌/墨黑实底上由父级 color 继承，
   照片/导出绘制处保留具体值 */
.ico-brand {
  color: var(--app-brand);
}

.ico-main {
  color: var(--app-text-primary);
}

.ico-sec {
  color: var(--app-text-secondary);
}

.ico-weak {
  color: var(--app-text-tertiary);
}

.ico-danger {
  color: var(--app-danger);
}

.ico-ok {
  color: var(--app-success);
}

.ico-faint {
  color: var(--app-border);
}

.img-fallback-t {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
}

.ph-right {
  flex: 1;
  min-width: 0;
  height: 340rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ① 验证情况（顶部） */
.ph-status {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* ② 人名标签（t-tag 描边） */
.ph-names {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.ph-names .t-tag {
  font-size: 24rpx;
}

/* ③ 施工内容（行尾复制按钮） */
.ph-wc {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  line-height: 1.5;
}

.ph-wc .wc-text {
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ph-wc .wc-copy {
  flex: none;
}

.ph-wc.empty {
  color: var(--app-text-tertiary);
  font-weight: 400;
}

/* ④~⑧ 拍摄时间 / 天气 / 地点 / 经度 / 纬度（标签与内容字号统一） */
.ph-meta {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 2rpx dashed var(--app-border);
}

.meta-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 3rpx 0;
  font-size: 22rpx;
  color: var(--app-text-secondary);
  line-height: 1.4;
}

.meta-line .meta-label {
  flex: none;
  width: 96rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

.meta-line .meta-val {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

/* 验证角标签：状态小胶囊（浅底 + 同色深字；通过绿 / 失败红 / 识别中蓝） */
.vtag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 验证失败后的「重新验证」小按钮 */
.v-retry {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--app-brand);
  color: var(--app-brand);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.vtag.ing {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.vtag.ok {
  background: var(--app-success-bg);
  color: var(--app-success-text);
}

.vtag.bad {
  background: var(--app-danger-bg);
  color: var(--app-danger);
}

/* 照片右上角删除小图标 */
.ph-del {
  position: absolute;
  top: 14rpx;
  right: 18rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 添加水印照片（灰底虚线，通栏铺满卡片） */
.add-photo {
  margin: 4rpx 0 0;
  height: 104rpx;
  border-radius: 12rpx;
  background: var(--app-bg-nested);
  border: 3rpx dashed var(--app-border);
  color: var(--app-text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ---------- 底部弹层（筛选下拉 / 人名点亮共用） ----------
   顶部 24rpx 圆角 + 轻阴影；头/体/脚三段 flex 纵列：
   整体 max-height 封顶 + overflow:hidden，内容区 flex:1;min-height:0 独立滚动，
   头脚 flex:none 不参与收缩，避免头/说明/脚/安全区叠加溢出 */
.sheet {
  position: relative;
  background: var(--app-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

.sheet-title {
  flex: none;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--app-text-primary);
}

.sheet-note {
  flex: none;
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 1rpx;
}

/* 弹层内容体：flex-basis 必须 auto（flex:1 简写为 0 基准，在 max-height 自适应弹层里会把内容压成 0 高）；
   min-height:0 允许收缩到剩余空间，超出部分由 scroll-view / overflow-y 自行滚动，头脚始终可见 */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角关闭热区：closeBtn/close-btn 插槽均未启用时仍是可点隐形块（padding 20rpx），
   会吞掉弹层右上角点击甚至误关层；各页统一置空（apply-shared 下页面样式可覆盖组件内部） */
.t-popup__close {
  display: none;
}

/* 弹层头行（标题居中 + 右上角显式关闭钮，88rpx 触达区始终可见可点） */
.sheet-head {
  position: relative;
  flex: none;
}

.sheet-close {
  position: absolute;
  right: -8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 弹层内非体块默认不参与收缩（头/说明/控件/脚），体块（scroll-view 或 .sheet-body）独占剩余空间并滚动 */
.sheet > view {
  flex: none;
}

.sheet > scroll-view,
.sheet > .sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.sheet .tags {
  margin-top: 32rpx;
  padding: 0 4rpx;
}

.sheet-actions {
  flex: none;
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--app-text-secondary);
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ============================================================
   表单底部弹层（新建/编辑合一，移植自已取缔的 edit 页）
   ============================================================ */

/* ---------- 巡视内容输入框 ---------- */
.textarea-wrap {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 20rpx 28rpx;
}

.textarea {
  width: 100%;
  min-height: 132rpx;
  font-size: 28rpx;
  color: var(--app-text-primary);
  line-height: 1.7;
  box-sizing: border-box;
}

.ph {
  color: var(--app-text-tertiary);
}

/* ---------- 派车情况表单卡（直角 + 墨边，弹层白底上以描边定义边界，不用柔影） ---------- */
.form-card {
  background: var(--app-bg-card);
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  overflow: hidden;
}

.frow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.frow + .frow {
  border-top: 2rpx solid var(--app-border);
}

.frow .fk {
  flex: none;
  width: 128rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.frow .fv {
  flex: 1;
  font-size: 28rpx;
  color: var(--app-text-primary);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.frow .fv.placeholder {
  color: var(--app-text-tertiary);
  font-weight: 400;
}

.frow.disabled {
  background: var(--app-bg-nested);
}

.frow.disabled .fk,
.frow.disabled .fv {
  color: var(--app-text-tertiary);
}

.frow.disabled .fv {
  font-weight: 400;
}

/* 「无派车」灰徽章 */
.badge-mini {
  flex: none;
  border: 2rpx solid var(--app-border);
  color: var(--app-text-tertiary);
  border-radius: 12rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
}

/* ---------- 内联筛选下拉（手风琴展开于表单行下方） ---------- */
.drop-panel {
  border-top: 2rpx solid var(--app-border);
  background: var(--app-bg-nested);
  padding: 16rpx 24rpx 20rpx;
}

.drop-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

.drop-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--app-text-primary);
}

.drop-list {
  margin-top: 16rpx;
  max-height: 480rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.drop-item {
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 主文案左对齐 + 占满中槽，超长省略兜底（「无派车」徽章 flex:none 不受压，勾选图标 margin-left:auto 右置） */
.drop-item > text:first-of-type {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

/* 选中标记前置方块槽位（未选中留空占位，各行文字对齐） */
.drop-item::before {
  content: '';
  flex: none;
  width: 14rpx;
  height: 14rpx;
}

.drop-item + .drop-item {
  border-top: 2rpx solid var(--app-border);
}

.drop-item .t-icon {
  margin-left: auto;
}

/* 选中项：白底蓝字 + 前置蓝方块（不用浅蓝高亮） */
.drop-item.on {
  color: var(--app-brand);
  font-weight: 700;
}

.drop-item.on::before {
  background: var(--app-brand);
}

.drop-item.none {
  color: var(--app-text-secondary);
}

.drop-item.none .badge-mini {
  margin-left: auto;
}

.drop-empty {
  margin-top: 16rpx;
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--app-text-tertiary);
}
