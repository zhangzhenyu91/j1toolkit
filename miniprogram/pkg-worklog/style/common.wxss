/* ============================================================
   出工日志分包共享样式（主页 index 与商旅绑定页 sgccbind 共用；
   新建/编辑表单为主页底部弹层，样式同源于此）
   「政企蓝白」，token 同 app.wxss
   ============================================================ */

/* ---------- tdesign 组件圆角与 token（CSS 变量穿透 apply-shared） ---------- */
page {
  --td-popup-border-radius: 24rpx;
  --td-calendar-radius: 24rpx;
  --td-calendar-selected-border-radius: 12rpx;
  --td-dialog-border-radius: 24rpx;
  --td-toast-radius: 8rpx;
  --td-tag-round-border-radius: 12rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* 按压反馈：轻度变暗 + 微缩（政企蓝白不做下沉吃影） */
.hover-opacity {
  opacity: 0.75 !important;
}

/* ---------- 板块标题行（标题本体用全局 .section-title） ---------- */
.sec-row {
  display: flex;
  align-items: center;
  margin: 28rpx 8rpx 18rpx;
}

.sec-note {
  margin-left: auto;
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
}

/* 底部固定操作区（.bottombar 纸底色条）已随主页悬浮按钮化删除；表单弹层主按钮沿用 .btn-primary */
.btn-primary {
  height: 96rpx;
  border-radius: 16rpx;
  background: #0E3DA8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ---------- 日期 chip（编辑页展示当前日志日期） ---------- */
.date-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin: 4rpx 8rpx 0;
  background: #E8F0FF;
  color: #0E3DA8;
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ---------- 提示条（「未出车」联动说明） ---------- */
.tip {
  margin-top: 28rpx;
  background: #E8F0FF;
  border-radius: 0;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 30rpx;
}

.tip .ti {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip .tip-t {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #1D2129;
}

.tip .tip-p {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #4E5969;
  line-height: 1.6;
}

/* ---------- 人员点亮区（t-check-tag） ---------- */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding: 4rpx 4rpx 0;
}

/* check-tag 外观：1 发丝边圆角；未点亮=白底深灰字，点亮=蓝底白字 */
.tags .t-tag {
  min-width: 144rpx;
  height: 68rpx;
  border-radius: 12rpx;
  border-width: 2rpx;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.tags .t-tag--outline.t-tag--default {
  background: #ffffff;
  border-color: #E5E6EB;
  color: #1D2129;
}

/* 点亮态：蓝底白字（特异性压过组件 .t-tag--outline.t-tag--primary） */
.tags .t-tag--outline.t-tag--primary,
.tags .t-tag--checked {
  background: #0E3DA8;
  border-color: #0E3DA8;
  color: #ffffff;
  box-shadow: none;
}

.tags .t-tag--disabled {
  background: #F7F8FA;
  border-color: #E5E6EB;
  color: #C9CDD4;
  box-shadow: none;
}

.ctag-note {
  font-size: 20rpx;
  margin-left: 6rpx;
}

/* ---------- 水印照片项：左缩略图 + 右侧四块（与缩略图等高，不溢出） ---------- */
.photo-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx 28rpx;
  position: relative;
  align-items: stretch;
}

.photo-item + .photo-item {
  border-top: 2rpx solid #E5E6EB;
}

/* 缩略图：12rpx 统一圆角 */
.ph-img {
  width: 168rpx;
  height: 340rpx;
  flex: none;
  border-radius: 12rpx;
  border: 2rpx solid #E5E6EB;
  box-sizing: border-box;
  background: #F7F8FA;
}

.ph-right {
  flex: 1;
  min-width: 0;
  height: 340rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ① 验证情况（顶部） */
.ph-status {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* ② 人名标签（t-tag 描边） */
.ph-names {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.ph-names .t-tag {
  font-size: 24rpx;
}

/* ③ 施工内容（行尾复制按钮） */
.ph-wc {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1D2129;
  line-height: 1.5;
}

.ph-wc .wc-text {
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ph-wc .wc-copy {
  flex: none;
}

.ph-wc.empty {
  color: rgba(29,33,41,.4);
  font-weight: 400;
}

/* ④~⑧ 拍摄时间 / 天气 / 地点 / 经度 / 纬度（标签与内容字号统一） */
.ph-meta {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 2rpx dashed #E5E6EB;
}

.meta-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 3rpx 0;
  font-size: 22rpx;
  color: #4E5969;
  line-height: 1.4;
}

.meta-line .meta-label {
  flex: none;
  width: 96rpx;
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
}

.meta-line .meta-val {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

/* 验证角标签：状态小胶囊（浅底 + 同色深字；通过绿 / 失败红 / 识别中蓝） */
.vtag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 验证失败后的「重新验证」小按钮 */
.v-retry {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid #0E3DA8;
  color: #0E3DA8;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.vtag.ing {
  background: #E8F0FF;
  color: #0E3DA8;
}

.vtag.ok {
  background: #E8FFEA;
  color: #0B8A37;
}

.vtag.bad {
  background: #FFECE8;
  color: #F53F3F;
}

/* 照片右上角删除小图标 */
.ph-del {
  position: absolute;
  top: 14rpx;
  right: 18rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 添加水印照片（灰底虚线，通栏铺满卡片） */
.add-photo {
  margin: 4rpx 0 0;
  height: 104rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
  border: 3rpx dashed #C9CDD4;
  color: #86909C;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ---------- 底部弹层（筛选下拉 / 人名点亮共用） ----------
   顶部 24rpx 圆角 + 轻阴影 */
.sheet {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #1D2129;
}

.sheet-note {
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #86909C;
  letter-spacing: 1rpx;
}

.sheet .tags {
  margin-top: 32rpx;
  padding: 0 4rpx;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E5E6EB;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #4E5969;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 16rpx;
  background: #0E3DA8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ============================================================
   表单底部弹层（新建/编辑合一，移植自已取缔的 edit 页）
   ============================================================ */

/* ---------- 巡视内容输入框 ---------- */
.textarea-wrap {
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 20rpx 28rpx;
}

.textarea {
  width: 100%;
  min-height: 132rpx;
  font-size: 28rpx;
  color: #1D2129;
  line-height: 1.7;
  box-sizing: border-box;
}

.ph {
  color: rgba(29,33,41,.4);
}

/* ---------- 派车情况表单卡（直角 + 墨边，弹层白底上以描边定义边界，不用柔影） ---------- */
.form-card {
  background: #ffffff;
  border-radius: 12rpx;
  border: 2rpx solid #E5E6EB;
  overflow: hidden;
}

.frow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.frow + .frow {
  border-top: 2rpx solid #E5E6EB;
}

.frow .fk {
  flex: none;
  width: 128rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.frow .fv {
  flex: 1;
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.frow .fv.placeholder {
  color: rgba(29,33,41,.4);
  font-weight: 400;
}

.frow.disabled {
  background: #F7F8FA;
}

.frow.disabled .fk,
.frow.disabled .fv {
  color: rgba(29,33,41,.4);
}

.frow.disabled .fv {
  font-weight: 400;
}

/* 「无派车」灰徽章 */
.badge-mini {
  flex: none;
  border: 2rpx solid rgba(29,33,41,.35);
  color: rgba(29,33,41,.4);
  border-radius: 12rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
}

/* ---------- 内联筛选下拉（手风琴展开于表单行下方，结构参照设计稿屏④ .drop-panel） ---------- */
.drop-panel {
  border-top: 2rpx solid #E5E6EB;
  background: #F7F8FA;
  padding: 16rpx 24rpx 20rpx;
}

.drop-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

.drop-input {
  flex: 1;
  font-size: 26rpx;
  color: #1D2129;
}

.drop-list {
  margin-top: 16rpx;
  max-height: 480rpx;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.drop-item {
  padding: 18rpx 28rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 主文案左对齐 + 占满中槽，超长省略兜底（「无派车」徽章 flex:none 不受压，勾选图标 margin-left:auto 右置） */
.drop-item > text:first-of-type {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

/* 选中标记前置方块槽位（未选中留空占位，各行文字对齐） */
.drop-item::before {
  content: '';
  flex: none;
  width: 14rpx;
  height: 14rpx;
}

.drop-item + .drop-item {
  border-top: 2rpx solid #E5E6EB;
}

.drop-item .t-icon {
  margin-left: auto;
}

/* 选中项：白底蓝字 + 前置蓝方块（不用浅蓝高亮） */
.drop-item.on {
  color: #0E3DA8;
  font-weight: 700;
}

.drop-item.on::before {
  background: #0E3DA8;
}

.drop-item.none {
  color: #4E5969;
}

.drop-item.none .badge-mini {
  margin-left: auto;
}

.drop-empty {
  margin-top: 16rpx;
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(29,33,41,.4);
}
