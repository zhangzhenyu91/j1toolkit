<!-- 水印添加 · 移动端独立子应用（app_key wm-add，设计稿 design/wm-add.html）
     流程：拍摄/相册选片 →（按需 4:3/3:4 裁剪）→ 编辑水印信息（无历史口径：定位带出 + 选择杆塔坐标）
           → 服务端渲染仅回图（不传 COS、不入库、不验证）→ 自动存相册 + wx.previewImage 全屏展示 -->
<navbar back title="水印添加" />

<view class="page-body">
  <!-- 流程说明卡 -->
  <view class="card hazard-top flow-card">
    <view class="flow-title">使用流程</view>
    <view class="flow-steps">
      <view class="fstep"><text class="no">1</text><text>拍摄 / 从相册选择<text class="b">一张原图</text></text></view>
      <view class="fstep"><text class="no">2</text><text>非 4:3 / 3:4 时<text class="b">裁剪取景</text>（已是则免裁）</text></view>
      <view class="fstep"><text class="no">3</text><text><text class="b">编辑水印信息</text>，确认后由服务端渲染水印</text></view>
      <view class="fstep"><text class="no">4</text><text><text class="b">自动存入相册</text>并全屏展示，仅本人持有</text></view>
    </view>
  </view>

  <!-- 选片方式 -->
  <view class="pick-btns">
    <view class="pick-opt" hover-class="hover-bg-warm" data-src="camera" bindtap="onPickPhoto">
      <view class="pi"><t-icon name="camera" size="44rpx" color="#F26D21" /></view>
      <view class="pr">
        <view class="pt">拍 摄</view>
        <view class="pn">调相机取原图，必裁 4:3 / 3:4</view>
      </view>
    </view>
    <view class="pick-opt" hover-class="hover-bg-warm" data-src="album" bindtap="onPickPhoto">
      <view class="pi"><t-icon name="image" size="44rpx" color="#F26D21" /></view>
      <view class="pr">
        <view class="pt">从相册选择</view>
        <view class="pn">已是 4:3 / 3:4 免裁剪直进编辑</view>
      </view>
    </view>
  </view>
</view>

<!-- 水印字段编辑弹层（字段口径与出工日志「无历史照片」一致；差异：无所属人名，确认后仅回图） -->
<t-popup visible="{{wmVisible}}" placement="bottom" bind:visible-change="onWmVisibleChange">
  <view class="sheet">
    <view class="sheet-title">编辑水印信息</view>
    <view class="sheet-note">确认后由服务端渲染水印并返回图片，不上传、不存档</view>
    <scroll-view scroll-y class="wm-scroll" enhanced show-scrollbar="{{false}}">
      <view class="form-card wm-card">
        <view class="wm-row-col">
          <view class="wm-wc-head">
            <text class="fk">施工内容</text>
            <view class="wm-quick">
              <text
                wx:for="{{quickInputs}}"
                wx:key="*this"
                class="wm-quick-chip"
                hover-class="hover-opacity"
                data-text="{{item}}"
                bindtap="onWmQuickInput"
              >{{item}}</text>
            </view>
          </view>
          <view class="textarea-wrap wm-textarea">
            <textarea
              class="textarea"
              value="{{wmForm.content}}"
              data-field="content"
              bindinput="onWmInput"
              placeholder="请输入施工内容"
              placeholder-class="ph"
              hold-keyboard
              auto-height
              maxlength="500"
            />
          </view>
        </view>
        <view class="frow">
          <text class="fk">拍摄时间</text>
          <input class="wm-input" value="{{wmForm.time}}" data-field="time" bindinput="onWmInput" placeholder="请输入拍摄时间" placeholder-class="ph" maxlength="16" />
        </view>
        <view class="frow">
          <text class="fk">天气</text>
          <input class="wm-input" value="{{wmForm.weather}}" data-field="weather" bindinput="onWmInput" placeholder="请输入天气" placeholder-class="ph" maxlength="64" />
          <text class="upd-tag" wx:if="{{wmTowerPicked}}">已更新</text>
        </view>
        <view class="frow">
          <text class="fk">地点</text>
          <input class="wm-input" value="{{wmForm.location}}" data-field="location" bindinput="onWmInput" placeholder="请输入地点" placeholder-class="ph" maxlength="250" />
          <text class="upd-tag" wx:if="{{wmTowerPicked}}">已更新</text>
        </view>
        <!-- 经纬度区：右侧跨两行「选择杆塔坐标」按钮（已选则显示杆塔号 + 重选） -->
        <view class="geo-zone">
          <view class="geo-rows">
            <view class="frow">
              <text class="fk">经度</text>
              <input class="wm-input" value="{{wmForm.lng}}" data-field="lng" bindinput="onWmInput" type="digit" placeholder="请输入经度" placeholder-class="ph" maxlength="16" />
            </view>
            <view class="frow">
              <text class="fk">纬度</text>
              <input class="wm-input" value="{{wmForm.lat}}" data-field="lat" bindinput="onWmInput" type="digit" placeholder="请输入纬度" placeholder-class="ph" maxlength="16" />
            </view>
          </view>
          <view
            class="tower-btn {{wmTowerPicked ? 'picked' : ''}}"
            hover-class="hover-opacity"
            bindtap="onOpenTower"
          >
            <block wx:if="{{!wmTowerPicked}}">
              <t-icon name="location" size="36rpx" color="#F26D21" />
              <text class="tb-text">选择杆塔坐标</text>
            </block>
            <block wx:else>
              <t-icon name="check" size="32rpx" color="#F26D21" />
              <text class="tb-no">{{wmTowerPicked.no}}</text>
              <text class="tb-re">重选</text>
            </block>
          </view>
        </view>
        <!-- 防伪码：自动生成，不可编辑 -->
        <view class="frow">
          <text class="fk">防伪码</text>
          <view class="fv wm-code">{{wmCode}}</view>
          <view class="wm-refresh" hover-class="hover-opacity" bindtap="onWmCodeRefresh">
            <t-icon name="refresh" size="30rpx" color="#F26D21" />
            <text>换一换</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="sheet-actions">
      <view class="btn-ghost" hover-class="hover-opacity" bindtap="onWmCancel">取 消</view>
      <view class="btn-dark" hover-class="hover-opacity" bindtap="onWmConfirm">
        <t-icon name="image" size="34rpx" color="#FFFFFF" />
        {{wmUploading ? '正在生成水印…' : '确认，生成水印照片'}}
      </view>
    </view>
  </view>
</t-popup>

<!-- 选择杆塔坐标弹层（与出工日志同实现同口径：电压等级→线路名称→杆塔号三级级联，线路名称可输入关键字过滤；
     确定将所选坐标按 ≤50m 随机波动后填入水印表单，并按波动后坐标再次调 /geo 刷新地点、天气） -->
<t-popup visible="{{towerVisible}}" placement="bottom" bind:visible-change="onTowerVisibleChange">
  <view class="sheet">
    <view class="sheet-title">选择杆塔坐标</view>
    <view class="sheet-note">依次选择电压等级 → 线路名称 → 杆塔号，确定后带出经纬度</view>
    <scroll-view scroll-y class="tower-scroll" enhanced show-scrollbar="{{false}}">
      <view class="tower-loading" wx:if="{{towerLoading}}">杆塔坐标加载中…</view>
      <block wx:if="{{!towerLoading}}">
        <!-- 电压等级 -->
        <view class="sel-row">
          <text class="sel-fk">电压等级</text>
          <view class="sel-box {{towerOpen === 'level' ? 'open' : ''}}" hover-class="hover-opacity" data-key="level" bindtap="onTowerToggle">
            <text class="{{towerLevel ? '' : 'ph'}}">{{towerLevel || '请选择电压等级'}}</text>
            <t-icon name="chevron-down" size="28rpx" color="#A89F8A" />
          </view>
        </view>
        <scroll-view scroll-y class="opt-list" wx:if="{{towerOpen === 'level'}}" enhanced show-scrollbar="{{false}}">
          <view
            class="opt {{towerLevel === item ? 'on' : ''}}"
            wx:for="{{towerLevels}}"
            wx:key="*this"
            hover-class="hover-bg-warm"
            data-v="{{item}}"
            bindtap="onPickLevel"
          >
            <text>{{item}}</text>
            <t-icon wx:if="{{towerLevel === item}}" name="check" size="28rpx" color="#F26D21" />
          </view>
        </scroll-view>
        <!-- 线路名称（未选电压等级时禁用；支持输入关键字筛选后再下拉选择） -->
        <view class="sel-row">
          <text class="sel-fk">线路名称</text>
          <view class="sel-box {{towerOpen === 'line' ? 'open' : ''}} {{towerLevel ? '' : 'disabled'}}">
            <input
              class="sel-input"
              value="{{towerLineKw}}"
              disabled="{{!towerLevel}}"
              bindinput="onTowerLineInput"
              bindfocus="onTowerLineFocus"
              placeholder="{{towerLevel ? '输入关键字搜索或下拉选择' : '请先选择电压等级'}}"
              placeholder-class="ph"
              maxlength="32"
            />
            <t-icon name="chevron-down" size="28rpx" color="{{towerLevel ? '#A89F8A' : '#D9CFBA'}}" data-key="line" bindtap="onTowerToggle" />
          </view>
        </view>
        <scroll-view scroll-y class="opt-list" wx:if="{{towerOpen === 'line'}}" enhanced show-scrollbar="{{false}}">
          <view
            class="opt {{towerLine === item ? 'on' : ''}}"
            wx:for="{{towerLines}}"
            wx:key="*this"
            hover-class="hover-bg-warm"
            data-v="{{item}}"
            bindtap="onPickLine"
          >
            <text>{{item}}</text>
            <t-icon wx:if="{{towerLine === item}}" name="check" size="28rpx" color="#F26D21" />
          </view>
        </scroll-view>
        <!-- 杆塔号（未选线路名称时禁用） -->
        <view class="sel-row">
          <text class="sel-fk">杆塔号</text>
          <view
            class="sel-box {{towerOpen === 'tower' ? 'open' : ''}} {{towerLine ? '' : 'disabled'}}"
            hover-class="{{towerLine ? 'hover-opacity' : ''}}"
            data-key="tower"
            bindtap="onTowerToggle"
          >
            <text class="{{towerTower ? '' : 'ph'}}">{{towerTower ? towerTower.no : (towerLine ? '请选择杆塔号' : '请先选择线路名称')}}</text>
            <t-icon name="chevron-down" size="28rpx" color="{{towerLine ? '#A89F8A' : '#D9CFBA'}}" />
          </view>
        </view>
        <scroll-view scroll-y class="opt-list" wx:if="{{towerOpen === 'tower'}}" enhanced show-scrollbar="{{false}}">
          <view
            class="opt {{towerTower && towerTower.no === item.no ? 'on' : ''}}"
            wx:for="{{towerTowers}}"
            wx:key="no"
            hover-class="hover-bg-warm"
            data-i="{{index}}"
            bindtap="onPickTower"
          >
            <text>{{item.no}}</text>
            <t-icon wx:if="{{towerTower && towerTower.no === item.no}}" name="check" size="28rpx" color="#F26D21" />
          </view>
        </scroll-view>
        <!-- 三级选齐后坐标预览 -->
        <view class="coord-card" wx:if="{{towerTower}}">
          <view class="cc-title">{{towerTower.no}} · 坐标预览</view>
          <view class="cc-line">经度 {{towerTower.lngText}}　纬度 {{towerTower.latText}}</view>
        </view>
      </block>
    </scroll-view>
    <view class="sheet-actions">
      <view class="btn-ghost" hover-class="hover-opacity" bindtap="onTowerCancel">取 消</view>
      <view class="btn-dark {{towerTower ? '' : 'disabled'}}" hover-class="hover-opacity" bindtap="onTowerConfirm">确 定</view>
    </view>
  </view>
</t-popup>

<!-- 4:3 裁剪层（同出工日志：拍摄必裁；相册非 4:3 才裁。横拍锁横向 4:3、纵拍锁纵向 3:4；拖拽/双指缩放调整取景） -->
<t-popup visible="{{cropVisible}}" placement="bottom" bind:visible-change="onCropVisibleChange">
  <view class="crop-sheet">
    <view class="crop-title">调整裁剪区域</view>
    <view class="crop-note">{{cropLandscape ? '已锁定横向 4:3' : '已锁定纵向 3:4'}}，拖动或双指缩放调整取景</view>
    <view class="crop-stage" style="width: {{cropFrameW}}px; height: {{cropFrameH}}px;">
      <movable-area class="crop-area" style="width: {{cropFrameW}}px; height: {{cropFrameH}}px;" scale-area>
        <movable-view
          class="crop-view"
          style="width: {{cropViewW}}px; height: {{cropViewH}}px;"
          x="{{cropX}}"
          y="{{cropY}}"
          scale
          scale-min="1"
          scale-max="5"
          scale-value="{{cropScale}}"
          direction="all"
          bindchange="onCropMove"
          bindscale="onCropScale"
        >
          <image class="crop-img" src="{{cropSrc}}" mode="scaleToFill" />
        </movable-view>
      </movable-area>
      <!-- 四角取景框（橙色描边，特征元素） -->
      <view class="crop-corner tl" />
      <view class="crop-corner tr" />
      <view class="crop-corner bl" />
      <view class="crop-corner br" />
    </view>
    <view class="sheet-actions">
      <view class="btn-ghost" hover-class="hover-opacity" bindtap="onCropCancel">取 消</view>
      <view class="btn-dark" hover-class="hover-opacity" bindtap="onCropConfirm">
        <t-icon name="check" size="34rpx" color="#FFFFFF" />
        {{cropExporting ? '正在处理…' : '确认裁剪'}}
      </view>
    </view>
  </view>
</t-popup>

<!-- 裁剪导出用离屏 canvas（type=2d；导出尺寸在 JS 中按裁剪结果设置） -->
<canvas type="2d" id="wmCropCanvas" class="crop-canvas" />

<t-toast id="t-toast" />
