/* 水印添加 · 单页（起始页 + 水印编辑/杆塔选择/裁剪三个弹层）
   弹层/表单样式与出工日志 pkg-worklog 同口径（复制自其 common.wxss 与页面 wxss，保持分包独立）；
   裁剪层黑底/取景框/离屏导出 canvas 为照片绘制域，双主题固定不随系统深色变化 */

/* ---------- 起始页：流程说明卡 ---------- */
.flow-card {
  padding: 28rpx 32rpx;
}

.flow-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--app-text-primary);
}

.flow-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
}

.flow-steps {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fstep {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--app-text-secondary);
}

.fstep .no {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fstep .b {
  color: var(--app-text-primary);
  font-weight: 700;
}

/* ---------- 起始页：选片方式两个大选项 ---------- */
.pick-btns {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pick-opt {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-shadow: var(--app-shadow-card); /* 次卡：轻影 */
  transition: opacity 0.15s ease;
}

.pick-opt .pi {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pick-opt .pt {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--app-text-primary);
}

.pick-opt .pn {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 1rpx;
}

/* ---------- 底部弹层通用（同出工日志 common.wxss；头/体/脚三段 flex，整体限高 + overflow:hidden，
   内容体 flex:1 1 auto 独立滚动，头脚 flex:none 不收缩） ---------- */
.sheet {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-bottom: none;
  border-radius: 12rpx;
  box-shadow: 0 -8rpx 32rpx var(--app-mask);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

.sheet-title {
  flex: none;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--app-text-primary);
}

.sheet-note {
  flex: none;
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

/* 弹层内容体（flex-basis 用 auto：0 基准会把自适应高度弹层内容压没） */
.sheet-body {
  flex: 1 1 auto;
  min-height: 64rpx;
  overflow-y: auto;
  overflow-x: hidden;
}

/* 弹层内非体块默认不参与收缩（头/说明/控件/脚），体块（scroll-view 或 .sheet-body）独占剩余空间并滚动 */
.sheet > view {
  flex: none;
}

.sheet > scroll-view,
.sheet > .sheet-body {
  flex: 1 1 auto;
  min-height: 64rpx;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角隐形关闭热区（closeBtn 未启用仍可点）：置空防误关 */
.t-popup__close {
  display: none;
}

.sheet-actions {
  flex: none;
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text-secondary);
  letter-spacing: 6rpx;
  box-sizing: border-box;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.btn-dark.disabled {
  background: var(--app-border);
}

/* ---------- 表单卡 / 行 ---------- */
.form-card {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: var(--app-shadow-card); /* 次卡：轻影 */
}

.frow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.frow + .frow {
  border-top: 2rpx solid var(--app-bg-nested);
}

.frow .fk {
  flex: none;
  width: 128rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.frow .fv {
  flex: 1;
  font-size: 28rpx;
  color: var(--app-text-primary);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.textarea-wrap {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 20rpx 28rpx;
}

.textarea {
  width: 100%;
  min-height: 132rpx;
  font-size: 28rpx;
  color: var(--app-text-primary);
  line-height: 1.7;
  box-sizing: border-box;
}

.ph {
  color: var(--app-text-tertiary);
}

/* ---------- 水印字段编辑弹层 ---------- */
.wm-scroll {
  flex: 1 1 auto;
  min-height: 64rpx;
  margin-top: 28rpx;
  overflow-y: auto;
  overflow-x: hidden;
}

.wm-card {
  margin-top: 0;
}

/* 施工内容独占一行（标签在上、输入在下） */
.wm-row-col {
  padding: 24rpx 32rpx;
}

.wm-row-col .fk {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* 施工内容标题行：左侧标题 + 右侧快捷输入（空间不足时 chips 自动折行） */
.wm-wc-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.wm-wc-head .fk {
  margin-bottom: 0;
}

.wm-quick {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.wm-quick-chip {
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--app-brand);
  background: var(--app-brand-light);
  border: 4rpx solid var(--app-brand);
  border-radius: 12rpx;
  transition: opacity 0.15s ease;
}

.wm-row-col + .frow {
  border-top: 2rpx solid var(--app-bg-nested);
}

.wm-textarea {
  padding: 16rpx 20rpx;
}

.wm-textarea .textarea {
  min-height: 96rpx;
}

/* 单行输入：与 .fv 同占剩余空间；min-height 稳定有效行高与触达高度（键盘弹起重排时不塌陷） */
.wm-input {
  flex: 1;
  min-height: 72rpx;
  font-size: 28rpx;
  color: var(--app-text-primary);
  font-weight: 600;
}

/* 防伪码：等宽观感 + 蓝色换一换 */
.wm-code {
  letter-spacing: 2rpx;
}

.wm-refresh {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--app-brand);
  transition: opacity 0.15s ease;
}

/* ---------- 经纬度区：右侧跨两行「选择杆塔坐标」按钮 ---------- */
.geo-zone {
  display: flex;
  align-items: stretch;
  border-top: 2rpx solid var(--app-bg-nested);
}

.geo-zone + .frow {
  border-top: 2rpx solid var(--app-bg-nested);
}

.geo-rows {
  flex: 1;
  min-width: 0;
}

.geo-rows .frow {
  padding-right: 0;
}

.tower-btn {
  flex: none;
  width: 184rpx;
  margin: 16rpx 32rpx 16rpx 20rpx;
  border: 4rpx solid var(--app-brand);
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: background-color 0.2s ease-out;
}

.tower-btn .tb-text {
  width: 96rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--app-brand);
  letter-spacing: 2rpx;
  line-height: 1.4;
  text-align: center;
}

.tower-btn.picked {
  background: var(--app-bg-card);
}

.tower-btn .tb-no {
  max-width: 152rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tower-btn .tb-re {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--app-brand);
  text-decoration: underline;
  text-underline-offset: 4rpx;
  letter-spacing: 4rpx;
}

/* 天气/地点行「已按杆塔坐标更新」角标 */
.upd-tag {
  flex: none;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--app-brand);
  background: var(--app-brand-light);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  letter-spacing: 2rpx;
}

/* ---------- 选择杆塔坐标弹层（电压等级 → 线路名称 → 杆塔号 三级级联） ---------- */
.tower-scroll {
  flex: 1 1 auto;
  min-height: 64rpx;
  margin-top: 28rpx;
  overflow-y: auto;
  overflow-x: hidden;
}

.tower-loading {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

.sel-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}

.sel-fk {
  flex: none;
  width: 128rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.sel-box {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  background: var(--app-bg-card);
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  box-shadow: var(--app-shadow-card);
  transition:
    border-color 0.2s ease-out,
    background-color 0.2s ease-out;
}

.sel-box .ph {
  color: var(--app-text-tertiary);
  font-weight: 400;
}

/* 线路名称行：输入搜索筛选 + 右侧箭头展开完整列表 */
.sel-box .sel-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--app-text-primary);
}

.sel-box.disabled .sel-input {
  color: var(--app-text-tertiary);
}

.sel-box.open {
  border-color: var(--app-brand);
}

.sel-box.disabled {
  background: var(--app-bg-page);
}

/* 选项列表：内嵌展开于对应行下方，超高滚动；展开/收起带 max-height + 透明度动效（wx:if 无过渡，改 class 开关） */
.opt-list {
  margin: 0 0 0 148rpx;
  border: 4rpx solid transparent;
  border-radius: 12rpx;
  background: var(--app-bg-card);
  max-height: 0;
  opacity: 0;
  transition:
    max-height 0.25s ease-out,
    opacity 0.2s ease-out,
    border-color 0.2s ease-out,
    margin 0.25s ease-out;
}

.opt-list.show {
  margin: 4rpx 0 8rpx 148rpx;
  border-color: var(--app-text-primary);
  max-height: 336rpx;
  opacity: 1;
}

/* 下拉箭头随展开/收起旋转 */
.chev {
  display: flex;
  color: var(--app-text-tertiary);
  transition: transform 0.2s ease-out;
}

.chev.up {
  transform: rotate(180deg);
}

.opt {
  display: flex;
  align-items: center;
  justify-content: flex-start; /* 与出工日志主页同款下拉口径一致：左对齐，不用 space-between */
  gap: 16rpx;
  height: 76rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--app-text-primary);
  transition:
    background-color 0.15s ease-out,
    color 0.15s ease-out;
}

/* 主文案左对齐 + 占满中槽，超长省略不溢出右缘；选中勾（t-icon）随后自然右置 */
.opt > text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

.opt + .opt {
  border-top: 2rpx dashed var(--app-border);
}

.opt.on {
  color: var(--app-brand);
  font-weight: 700;
  background: var(--app-brand-light);
}

/* 三级选齐后的坐标预览卡（淡入上移） */
.coord-card {
  margin: 16rpx 0 8rpx;
  background: var(--app-brand-light);
  border-left: 8rpx solid var(--app-brand);
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  animation: coord-in 0.25s ease-out;
}

@keyframes coord-in {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cc-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--app-brand);
  letter-spacing: 2rpx;
}

.cc-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--app-text-primary);
}

/* ---------- 4:3 裁剪层（黑底照片绘制域，双主题固定；同出工日志；整体限高防小屏溢出） ---------- */
.crop-sheet {
  background: #15181d;
  border: 2rpx solid #e5e6eb;
  border-bottom: none;
  border-radius: 12rpx;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

.crop-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #ffffff;
}

.crop-note {
  margin: 12rpx 0 24rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 1rpx;
}

.crop-stage {
  position: relative;
}

/* movable-area 默认裁剪溢出内容，此处显式声明兜底 */
.crop-area {
  overflow: hidden;
  background: #000000;
}

.crop-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 四角取景框：蓝色 L 形描边（不遮挡拖动，仅装饰；浮于照片上，固定色） */
.crop-corner {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid #0e3da8;
  pointer-events: none;
}

.crop-corner.tl {
  top: 0;
  left: 0;
  border-right: none;
  border-bottom: none;
}

.crop-corner.tr {
  top: 0;
  right: 0;
  border-left: none;
  border-bottom: none;
}

.crop-corner.bl {
  bottom: 0;
  left: 0;
  border-right: none;
  border-top: none;
}

.crop-corner.br {
  right: 0;
  bottom: 0;
  border-left: none;
  border-top: none;
}

.crop-sheet .sheet-actions {
  width: 100%;
  /* 深色裁剪层内取消白底脚条 */
  background: transparent;
  border-top: none;
  padding-top: 0;
}

/* 离屏导出 canvas 移出视口（display:none 会导致节点取不到） */
.crop-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 300px;
  height: 150px;
}

/* 图标状态色（t-icon 不传 color，经宿主 CSS color 继承） */
.ico-brand {
  color: var(--app-brand);
}

.chev-off {
  color: var(--app-text-tertiary);
  opacity: 0.75;
}

/* ---------- t-icon 数值字阶（t-class 外部类） ---------- */
.ico-28 {
  font-size: 28rpx;
}
.ico-30 {
  font-size: 30rpx;
}
.ico-32 {
  font-size: 32rpx;
}
.ico-34 {
  font-size: 34rpx;
}
.ico-36 {
  font-size: 36rpx;
}
.ico-44 {
  font-size: 44rpx;
}
