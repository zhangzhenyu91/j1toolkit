/* 题库刷题 · 题库列表（功能口径见《开发指南》第十四节；设计 token 见 AGENTS.md 第四节，
   班组切换器/空态等写法同 pkg-filetransfer、pkg-safeday） */

/* ---------- 班组切换器（超管可点 chip 下拉切换；其余角色静态班组名标签） ---------- */
.tswitch {
  position: relative;
  z-index: 20;
  margin-bottom: 20rpx;
}

.ts-cur {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  box-shadow: var(--app-shadow-card);
}

.ts-cur .arr {
  color: var(--app-brand);
  font-size: 18rpx;
}

/* 下拉入场：chip 下方轻微上浮 + 淡入（克制，同全局 fadeUp/fadeIn 风格）；收起直消不加动画 */
.ts-drop {
  position: absolute;
  top: 76rpx;
  left: 0;
  z-index: 21;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  box-shadow: var(--app-shadow-card);
  padding: 12rpx;
  min-width: 300rpx;
  max-width: 600rpx; /* 上限兜底：超长班组名由 .ts-opt 内文案省略，浮层不撑出屏外 */
  animation: ts-drop-in 0.2s ease-out;
}

.ts-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
}

/* 主文案左对齐 + 超长省略（.ck 勾选由 margin-left:auto 右置） */
.ts-opt > text:first-of-type {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

.ts-opt.on {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.ts-opt .ck {
  margin-left: auto;
  font-size: 22rpx;
}

/* 点空白处收起下拉（层级低于切换器本体）；遮罩淡入 */
.ts-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  animation: ts-mask-in 0.15s ease-out;
}

/* ---------- 未分配班组空态 ---------- */
.team-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.team-empty .te-ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-empty .te-t {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.team-empty .te-p {
  font-size: 23rpx;
  color: var(--app-text-secondary);
  line-height: 1.8;
  text-align: center;
}

/* ---------- 统计卡（三格等分，正确率蓝色） ---------- */
.stat-card {
  padding: 44rpx 24rpx 28rpx;
  display: flex;
}

.stat-card .cell {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-card .cell + .cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 2rpx;
  background: var(--app-border);
}

.stat-card b {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.stat-card b em {
  font-style: normal;
  color: var(--app-brand);
}

.stat-card span {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--app-text-secondary);
  letter-spacing: 2rpx;
}

/* ---------- 通用：浅蓝底图标盒 / 进度条 / 标签 ---------- */
.icon-box {
  width: 84rpx;
  height: 84rpx;
  flex: none;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress {
  height: 12rpx;
  border-radius: 12rpx;
  background: var(--app-bg-nested);
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 12rpx;
  background: var(--app-brand);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.tag-navy {
  background: var(--app-brand-light);
  color: var(--app-text-primary);
}

/* ---------- 「我的题库」板块行（右侧管理入口） ---------- */
.sec-row {
  margin-top: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.sec-row .more {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 23rpx;
  color: var(--app-text-tertiary);
}

.chev-mute {
  color: var(--app-text-tertiary);
}

/* ---------- 题库卡 ---------- */
.bank-item {
  padding: 26rpx 28rpx;
  display: flex;
  gap: 22rpx;
  align-items: center;
  /* 列表入场 fadeUp，逐项 stagger 由行内 animation-delay 控制（40ms/项，上限 5 项） */
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.bank-item + .bank-item {
  margin-top: 20rpx;
}

.bank-item .tx {
  flex: 1;
  min-width: 0;
}

.bank-item .tx b {
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bank-item .meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
  display: flex;
  gap: 20rpx;
}

.bank-item .pg {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.bank-item .pg .progress {
  flex: 1;
}

.bank-item .pg span {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  white-space: nowrap;
}

/* ---------- 题库池入口卡（二级页入口） ---------- */
.pool-entry {
  margin-top: 32rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.pool-entry .tx {
  flex: 1;
  min-width: 0;
}

.pool-entry .tx b {
  font-size: 28rpx;
  font-weight: 700;
}

/* ---------- 空态/加载（同出工日志 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed var(--app-text-tertiary);
  border-radius: 12rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

/* ---------- 底部主按钮（仅管理角色） ---------- */
.page-body.has-bar {
  padding-bottom: 220rpx; /* 给底部固定主按钮留位 */
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  padding: 20rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, transparent, var(--app-bg-page) 30%);
}

.btn-navy {
  height: 92rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  box-shadow: var(--app-shadow-card);
}

/* ---------- t-icon 数值字阶（t-class 外部类；600px 起折半 px） ---------- */
.ico-26 {
  font-size: 26rpx;
}
.ico-34 {
  font-size: 34rpx;
}
.ico-36 {
  font-size: 36rpx;
}
.ico-40 {
  font-size: 40rpx;
}

/* ---------- iPad / 宽屏适配（CSS 媒体查询；普通手机竖屏不受影响） ----------
   600px 起限宽居中、关键字阶/控件改固定 px；900px 起题库卡网格增列；1200px 再增列 */
@media (min-width: 600px) {
  .page-body {
    box-sizing: border-box;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .bottom-bar {
    left: 50%;
    right: auto;
    width: 100%;
    max-width: 680px;
    box-sizing: border-box;
    transform: translateX(-50%);
    background: var(--app-bg-page);
    border-top: 1rpx solid var(--app-border);
  }

  .ts-cur {
    font-size: 12.5px;
    padding: 6px 14px;
    border-radius: 6px;
    border-width: 1px;
  }

  .ts-drop {
    top: 38px;
    border-width: 1px;
    border-radius: 6px;
    padding: 6px;
  }

  .ts-opt {
    font-size: 12.5px;
    padding: 9px 12px;
    border-radius: 6px;
  }

  .team-empty .te-t {
    font-size: 15px;
  }

  .team-empty .te-p {
    font-size: 11.5px;
  }

  .stat-card b {
    font-size: 20px;
  }

  .stat-card span {
    font-size: 10.5px;
  }

  .bank-item .tx b,
  .pool-entry .tx b {
    font-size: 14px;
  }

  .bank-item .meta {
    font-size: 11px;
  }

  .bank-item .pg span {
    font-size: 10px;
  }

  .sec-row .more {
    font-size: 11.5px;
  }

  .empty-box {
    font-size: 13px;
    border-width: 1.5px;
    border-radius: 6px;
  }

  .btn-navy {
    height: 44px;
    font-size: 14.5px;
    border-radius: 8px;
    box-shadow: var(--app-shadow-card);
  }
  .ico-26 {
    font-size: 13px;
  }
  .ico-34 {
    font-size: 17px;
  }
  .ico-36 {
    font-size: 18px;
  }
  .ico-40 {
    font-size: 20px;
  }
}

@media (min-width: 900px) {
  .page-body,
  .bottom-bar {
    max-width: 960px;
  }

  /* 题库卡两列网格（卡片间距由 grid gap 承担） */
  .bank-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20rpx;
  }

  .bank-item + .bank-item {
    margin-top: 0;
  }
}

@media (min-width: 1200px) {
  .page-body,
  .bottom-bar {
    max-width: 1120px;
  }

  /* 题库卡三列 */
  .bank-list {
    grid-template-columns: 1fr 1fr 1fr;
  }
}
