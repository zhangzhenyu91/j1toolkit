/* 题库刷题 · 题库列表（设计稿 design/quiz.html 屏 01；设计 token 见 AGENTS.md 第四节，
   班组切换器/空态等写法同 pkg-filetransfer、pkg-safeday） */

/* ---------- 班组切换器（超管可点 chip 下拉切换；其余角色静态班组名标签） ---------- */
.tswitch {
  position: relative;
  z-index: 20;
  margin-bottom: 20rpx;
}

.ts-cur {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 0;
  padding: 12rpx 28rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #111111;
  box-shadow: 6rpx 6rpx 0 #111111;
}

.ts-cur .arr {
  color: #1d4ed8;
  font-size: 18rpx;
}

/* 下拉入场：chip 下方轻微上浮 + 淡入（克制，同全局 fadeUp/fadeIn 风格）；收起直消不加动画 */
@keyframes ts-drop-in {
  from {
    opacity: 0;
    transform: translateY(-6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ts-drop {
  position: absolute;
  top: 76rpx;
  left: 0;
  z-index: 21;
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 0;
  box-shadow: 8rpx 8rpx 0 rgba(17, 17, 17, 0.9);
  padding: 12rpx;
  min-width: 300rpx;
  animation: ts-drop-in 0.2s ease-out;
}

.ts-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 0;
  font-size: 25rpx;
  font-weight: 600;
}

.ts-opt.on {
  background: #edf2fe;
  color: #1d4ed8;
}

.ts-opt .ck {
  margin-left: auto;
  font-size: 22rpx;
}

/* 点空白处收起下拉（层级低于切换器本体）；遮罩淡入 */
@keyframes ts-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.ts-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  animation: ts-mask-in 0.15s ease-out;
}

/* ---------- 未分配班组空态 ---------- */
.team-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.team-empty .te-ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 0;
  background: #edf2fe;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-empty .te-t {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.team-empty .te-p {
  font-size: 23rpx;
  color: #5c5748;
  line-height: 1.8;
  text-align: center;
}

/* ---------- 统计卡（屏 01 .stat-card：三格等分，正确率蓝色） ---------- */
.stat-card {
  padding: 44rpx 24rpx 28rpx;
  display: flex;
}

.stat-card .cell {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-card .cell + .cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 2rpx;
  background: #e7e1d2;
}

.stat-card b {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.stat-card b em {
  font-style: normal;
  color: #1d4ed8;
}

.stat-card span {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #5c5748;
  letter-spacing: 2rpx;
}

/* ---------- 通用：浅蓝底图标盒 / 进度条 / 标签 ---------- */
.icon-box {
  width: 84rpx;
  height: 84rpx;
  flex: none;
  border-radius: 0;
  background: #edf2fe;
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress {
  height: 12rpx;
  border-radius: 0;
  background: #efe9da;
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 0;
  background: #1d4ed8;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 0;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.tag-navy {
  background: #edf2fe;
  color: #111111;
}

/* ---------- 「我的题库」板块行（右侧管理入口） ---------- */
.sec-row {
  margin-top: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.sec-row .more {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 23rpx;
  color: rgba(17,17,17,.4);
}

/* ---------- 题库卡（屏 01 .bank-item） ---------- */
.bank-item {
  padding: 26rpx 28rpx;
  display: flex;
  gap: 22rpx;
  align-items: center;
  /* 列表入场 fadeUp，逐项 stagger 由行内 animation-delay 控制（40ms/项，上限 5 项） */
  animation: fadeUp 0.25s ease both;
}

.bank-item + .bank-item {
  margin-top: 20rpx;
}

.bank-item .tx {
  flex: 1;
  min-width: 0;
}

.bank-item .tx b {
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bank-item .meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5c5748;
  display: flex;
  gap: 20rpx;
}

.bank-item .pg {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.bank-item .pg .progress {
  flex: 1;
}

.bank-item .pg span {
  font-size: 20rpx;
  color: rgba(17,17,17,.4);
  white-space: nowrap;
}

/* ---------- 题库池入口卡（二级页入口） ---------- */
.pool-entry {
  margin-top: 32rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.pool-entry .tx {
  flex: 1;
  min-width: 0;
}

.pool-entry .tx b {
  font-size: 28rpx;
  font-weight: 800;
}

/* ---------- 空态/加载（同出工日志 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed rgba(17,17,17,.35);
  border-radius: 0;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(17,17,17,.4);
  letter-spacing: 2rpx;
}

/* ---------- 底部主按钮（仅管理角色；屏 01 .bottom-bar + .btn-navy） ---------- */
.page-body.has-bar {
  padding-bottom: 220rpx; /* 给底部固定主按钮留位 */
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  padding: 20rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(244, 241, 234, 0), #f8f6f1 30%);
}

.btn-navy {
  height: 92rpx;
  border-radius: 0;
  background: #111111;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  box-shadow: 6rpx 6rpx 0 #1d4ed8;
}
