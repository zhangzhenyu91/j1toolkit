/* 题库刷题 · 错题本（设计稿 design/quiz.html 屏 04；设计 token 见 AGENTS.md 第四节） */

/* ---------- 汇总卡（屏 04 .wrong-sum：N 道错题 + 专项练习主按钮） ---------- */
.wrong-sum {
  padding: 44rpx 32rpx 32rpx;
  text-align: center;
}

.wrong-sum b {
  font-size: 44rpx;
  font-weight: 800;
}

.wrong-sum b em {
  font-style: normal;
  color: #d22730;
}

.wrong-sum p {
  margin: 10rpx 0 26rpx;
  font-size: 22rpx;
  color: #5c5748;
  letter-spacing: 2rpx;
}

.btn-orange {
  height: 84rpx;
  border-radius: 0;
  background: #1d4ed8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  box-shadow: 6rpx 6rpx 0 #111111;
}

/* ---------- 错题分组（组头：题库名 + 题数 + 练这组；组内 .wrong-item 不变） ---------- */
.g-hd {
  margin: 32rpx 4rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.g-hd b {
  font-size: 28rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.g-hd .g-cnt {
  flex: none;
  font-size: 22rpx;
  color: rgba(17,17,17,.4);
}

/* 「练这组」蓝色文字按钮 */
.g-hd .g-go {
  margin-left: auto;
  flex: none;
  padding: 6rpx 4rpx 6rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.wrong-item {
  padding: 26rpx 28rpx;
  /* 列表入场 fadeUp，组内逐项 stagger 由行内 animation-delay 控制（40ms/项，上限 5 项） */
  animation: fadeUp 0.25s ease both;
}

.wrong-item + .wrong-item {
  margin-top: 20rpx;
}

.wrong-item .q {
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.65;
  /* 题干两行截断 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.wrong-item .ft {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: #5c5748;
}

.wrong-item .ft .rm {
  margin-left: auto;
  flex: none;
  color: rgba(17,17,17,.4);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 0;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.wrong-item .q .tag {
  margin-right: 12rpx;
  vertical-align: 3rpx;
}

.tag-orange {
  background: #edf2fe;
  color: #1d4ed8;
}

.tag-navy {
  background: #edf2fe;
  color: #111111;
}

.tag-red {
  background: #fae9e9;
  color: #d22730;
}

/* ---------- 规则说明（屏 04 .rule-note） ---------- */
.rule-note {
  margin-top: 26rpx;
  padding: 0 8rpx;
  font-size: 21rpx;
  color: rgba(17,17,17,.4);
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* ---------- 加载中 / 空态 ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed rgba(17,17,17,.35);
  border-radius: 0;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(17,17,17,.4);
  letter-spacing: 2rpx;
}

.wrong-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.wrong-empty .we-t {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.wrong-empty .we-p {
  font-size: 23rpx;
  color: #5c5748;
  letter-spacing: 1rpx;
}
