/* 题库刷题 · 错题本（功能口径见《开发指南》第十四节；设计 token 见 AGENTS.md 第四节） */

/* ---------- 汇总卡（N 道错题 + 专项练习主按钮） ---------- */
.wrong-sum {
  padding: 44rpx 32rpx 32rpx;
  text-align: center;
}

.wrong-sum b {
  font-size: 44rpx;
  font-weight: 700;
}

.wrong-sum b em {
  font-style: normal;
  color: var(--app-danger-text);
}

.wrong-sum p {
  margin: 10rpx 0 26rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
  letter-spacing: 2rpx;
}

.btn-orange {
  height: 84rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  box-shadow: var(--app-shadow-card);
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

/* ---------- 错题分组（组头：题库名 + 题数 + 练这组；组内 .wrong-item 不变） ---------- */
.g-hd {
  margin: 32rpx 4rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.g-hd b {
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.g-hd .g-cnt {
  flex: none;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

/* 「练这组」蓝色文字按钮 */
.g-hd .g-go {
  margin-left: auto;
  flex: none;
  padding: 6rpx 4rpx 6rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--app-brand);
  transition: opacity 0.15s ease;
}

.wrong-item {
  padding: 26rpx 28rpx;
  /* 列表入场 fadeUp，组内逐项 stagger 由行内 animation-delay 控制（40ms/项，上限 5 项） */
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.wrong-item + .wrong-item {
  margin-top: 20rpx;
}

.wrong-item .q {
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.65;
  /* 题干两行截断 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.wrong-item .ft {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
}

.wrong-item .ft .rm {
  margin-left: auto;
  flex: none;
  color: var(--app-text-tertiary);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
  transition: opacity 0.15s ease;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.wrong-item .q .tag {
  margin-right: 12rpx;
  vertical-align: 3rpx;
}

.tag-orange {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.tag-navy {
  background: var(--app-brand-light);
  color: var(--app-text-primary);
}

.tag-red {
  background: var(--app-danger-bg);
  color: var(--app-danger-text);
}

/* ---------- 规则说明 ---------- */
.rule-note {
  margin-top: 26rpx;
  padding: 0 8rpx;
  font-size: 21rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* ---------- 加载中 / 空态 ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed var(--app-text-tertiary);
  border-radius: 12rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

.wrong-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.wrong-empty .we-t {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.wrong-empty .we-p {
  font-size: 23rpx;
  color: var(--app-text-secondary);
  letter-spacing: 1rpx;
}

/* 图标状态色（t-icon 不传 color，经宿主 CSS color 继承） */
.ico-ok {
  color: var(--app-success);
}

/* ---------- t-icon 数值字阶（t-class 外部类；600px 起折半 px） ---------- */
.ico-26 {
  font-size: 26rpx;
}
.ico-32 {
  font-size: 32rpx;
}
.ico-110 {
  font-size: 110rpx;
}

/* ---------- iPad / 宽屏适配（CSS 媒体查询；普通手机竖屏不受影响） ----------
   600px 起限宽居中、关键字阶改固定 px；900px 起错题卡两列网格 */
@media (min-width: 600px) {
  .page-body {
    box-sizing: border-box;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .wrong-sum {
    border-radius: 6px;
  }

  .wrong-sum b {
    font-size: 22px;
  }

  .wrong-sum p {
    font-size: 11px;
  }

  .btn-orange {
    height: 42px;
    font-size: 14px;
    border-radius: 6px;
  }

  .g-hd b {
    font-size: 14px;
  }

  .g-hd .g-cnt {
    font-size: 11px;
  }

  .g-hd .g-go {
    font-size: 12px;
  }

  .wrong-item .q {
    font-size: 13.5px;
  }

  .wrong-item .ft {
    font-size: 11px;
  }

  .rule-note {
    font-size: 10.5px;
  }

  .empty-box {
    font-size: 13px;
    border-width: 1.5px;
    border-radius: 6px;
  }

  .wrong-empty .we-t {
    font-size: 15px;
  }

  .wrong-empty .we-p {
    font-size: 11.5px;
  }
  .ico-26 {
    font-size: 13px;
  }
  .ico-32 {
    font-size: 16px;
  }
  .ico-110 {
    font-size: 55px;
  }
}

@media (min-width: 900px) {
  .page-body {
    max-width: 960px;
  }

  /* 错题卡两列网格（每组内） */
  .group .items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20rpx;
  }

  .wrong-item + .wrong-item {
    margin-top: 0;
  }
}

@media (min-width: 1200px) {
  .page-body {
    max-width: 1120px;
  }

  .group .items {
    grid-template-columns: 1fr 1fr 1fr;
  }
}
