/* 题库刷题 · 错题本（设计稿 design/quiz.html 屏 04；设计 token 见 AGENTS.md 第四节） */

/* ---------- 汇总卡（屏 04 .wrong-sum：N 道错题 + 专项练习主按钮） ---------- */
.wrong-sum {
  padding: 44rpx 32rpx 32rpx; /* 顶部留出警示斜纹条高度 */
  text-align: center;
}

.wrong-sum b {
  font-size: 44rpx;
  font-weight: 800;
}

.wrong-sum b em {
  font-style: normal;
  color: #cf4444;
}

.wrong-sum p {
  margin: 10rpx 0 26rpx;
  font-size: 22rpx;
  color: #6b7690;
  letter-spacing: 2rpx;
}

.btn-orange {
  height: 84rpx;
  border-radius: 16rpx;
  background: #f26d21;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  box-shadow: 0 12rpx 28rpx rgba(242, 109, 33, 0.3);
}

/* ---------- 错题分组（组头：题库名 + 题数 + 练这组；组内 .wrong-item 不变） ---------- */
.g-hd {
  margin: 32rpx 4rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.g-hd b {
  font-size: 28rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.g-hd .g-cnt {
  flex: none;
  font-size: 22rpx;
  color: #a89f8a;
}

/* 「练这组」橙色文字按钮 */
.g-hd .g-go {
  margin-left: auto;
  flex: none;
  padding: 6rpx 4rpx 6rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #f26d21;
}

.wrong-item {
  padding: 26rpx 28rpx;
}

.wrong-item + .wrong-item {
  margin-top: 20rpx;
}

.wrong-item .q {
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.65;
  /* 题干两行截断 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.wrong-item .ft {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: #6b7690;
}

.wrong-item .ft .rm {
  margin-left: auto;
  flex: none;
  color: #a89f8a;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.wrong-item .q .tag {
  margin-right: 12rpx;
  vertical-align: 3rpx;
}

.tag-orange {
  background: #fdeee2;
  color: #f26d21;
}

.tag-navy {
  background: #edf0f6;
  color: #22314e;
}

.tag-red {
  background: #fae9e9;
  color: #cf4444;
}

/* ---------- 规则说明（屏 04 .rule-note） ---------- */
.rule-note {
  margin-top: 26rpx;
  padding: 0 8rpx;
  font-size: 21rpx;
  color: #a89f8a;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* ---------- 加载中 / 空态 ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed #d9cfba;
  border-radius: 20rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}

.wrong-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.wrong-empty .we-t {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.wrong-empty .we-p {
  font-size: 23rpx;
  color: #6b7690;
  letter-spacing: 1rpx;
}
