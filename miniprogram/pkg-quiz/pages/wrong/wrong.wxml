<!-- 题库刷题 · 错题本（设计稿 design/quiz.html 屏 04）
     汇总卡 + 专项练习橙色主按钮置顶；错题卡含题型 tag / 错 N 次 / 来源题库 / 相对时间 / 手动移除；
     规则说明显性化；空态 check-circle +「暂无错题，继续保持」 -->
<navbar back title="错题本" />

<view class="page-body" wx:if="{{list.length}}">
  <!-- 汇总卡（卡顶警示斜纹条为全局 hazard-top） -->
  <view class="card hazard-top wrong-sum">
    <b><em>{{list.length}}</em> 道错题</b>
    <p>覆盖 {{bankCount}} 个题库 · 按最近答错排序</p>
    <view class="btn-orange" hover-class="hover-opacity" bindtap="onPractice">
      <t-icon name="refresh" size="32rpx" color="#FFFFFF" />
      开始错题专项练习
    </view>
  </view>

  <!-- 错题列表 -->
  <view class="section-title sec-t">错题列表</view>
  <view class="card wrong-item" wx:for="{{list}}" wx:key="questionId">
    <view class="q"><span class="tag {{item.typeCls}}">{{item.typeText}}</span>{{item.content}}</view>
    <view class="ft">
      <span class="tag tag-red">错 {{item.wrongCount}} 次</span>
      <span class="src">{{item.bankName}}</span>
      <span>{{item.relTime}}</span>
      <span class="rm" hover-class="hover-opacity" catchtap="onRemove" data-id="{{item.questionId}}">
        <t-icon name="delete" size="26rpx" color="#A89F8A" />移除
      </span>
    </view>
  </view>

  <!-- 规则说明 -->
  <view class="rule-note">
    <t-icon name="info-circle" size="26rpx" color="#A89F8A" />
    规则：刷题答错自动收录；同一题连续答对 3 次自动移出，也可手动移除。
  </view>
</view>

<!-- 加载中 / 空态 -->
<view class="page-body" wx:else>
  <view class="empty-box" wx:if="{{loading}}">错题加载中…</view>
  <view class="wrong-empty" wx:else>
    <t-icon name="check-circle" size="110rpx" color="#2BA471" />
    <view class="we-t">暂无错题，继续保持</view>
    <view class="we-p">刷题答错的题目会自动收录到这里</view>
  </view>
</view>

<t-dialog id="t-dialog" />
<t-toast id="t-toast" />
