/* 题库刷题 · 刷题页（设计稿 design/quiz.html 屏 02/03；设计 token 见 AGENTS.md 第四节，
   固定底栏布局同 pkg-callme chat 页：flex 列 + scroll-view 自适应 + 底部操作栏） */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f4f1ea;
}

.q-scroll {
  flex: 1;
  min-height: 0;
}

.q-body {
  padding: 16rpx 32rpx 32rpx;
}

.q-loading {
  padding: 96rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}

/* ---------- 顶部进度行（屏 02 .pg-line：模式切换 + 细进度条 + 答题卡入口） ---------- */
.pg-line {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 4rpx 4rpx 22rpx;
}

/* 答题 / 背题 双 pill 切换 */
.vm-switch {
  flex: none;
  display: flex;
  padding: 4rpx;
  background: #efe9da;
  border-radius: 999rpx;
}

.vm-opt {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #6b7690;
}

.vm-opt.on {
  background: #22314e;
  color: #ffffff;
}

/* 答题卡入口（图标 + 文字） */
.sheet-entry {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #22314e;
}

.progress {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: #efe9da;
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 6rpx;
  background: #f26d21;
  transition: width 0.3s ease;
}

.pg-line b {
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.pg-line b em {
  font-style: normal;
  color: #f26d21;
}

/* ---------- 结果 banner（屏 03 .result-banner） ---------- */
.result-banner {
  margin-bottom: 20rpx;
  padding: 20rpx 26rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.result-banner.good {
  background: #e8f5ef;
  color: #2ba471;
}

.result-banner.bad {
  background: #fae9e9;
  color: #cf4444;
}

.result-banner small {
  margin-left: auto;
  font-size: 21rpx;
  font-weight: 600;
  color: #b0746f;
}

.result-banner.good small {
  color: #5f9e83;
}

/* ---------- 题干卡（屏 02 .stem-card） ---------- */
.stem-card {
  padding: 30rpx 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.75;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
  margin-right: 14rpx;
  vertical-align: 4rpx;
}

.tag-orange {
  background: #fdeee2;
  color: #f26d21;
}

.tag-navy {
  background: #edf0f6;
  color: #22314e;
}

/* ---------- 选项卡（屏 02/03 .opt：白卡描边，选中浅橙底） ---------- */
.opt {
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  background: #ffffff;
  border: 2rpx solid #e3dccb;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.opt .ab {
  width: 52rpx;
  height: 52rpx;
  flex: none;
  border-radius: 50%;
  border: 3rpx solid #d9cfba;
  color: #6b7690;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
  box-sizing: border-box;
}

/* 多选：方形字母块 */
.opt.sq .ab {
  border-radius: 14rpx;
}

.opt .opt-tx {
  flex: 1;
  min-width: 0;
}

.opt.sel {
  border-color: #f26d21;
  background: #fdeee2;
}

.opt.sel .ab {
  border-color: #f26d21;
  background: #f26d21;
  color: #ffffff;
}

/* 解析态三态：正确绿 / 你的错选红 / 漏选绿虚线 */
.opt.right {
  border-color: #2ba471;
  background: #e8f5ef;
}

.opt.right .ab {
  border-color: #2ba471;
  background: #2ba471;
  color: #ffffff;
}

.opt.wrong {
  border-color: #cf4444;
  background: #fae9e9;
}

.opt.wrong .ab {
  border-color: #cf4444;
  background: #cf4444;
  color: #ffffff;
}

.opt.miss {
  border: 3rpx dashed #2ba471;
}

.opt.miss .ab {
  border-color: #2ba471;
  color: #2ba471;
}

.opt .st {
  margin-left: auto;
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.opt .st-green {
  color: #2ba471;
}

.opt .st-red {
  color: #cf4444;
}

/* ---------- 判断题大选项卡（屏 02 注：「正确 / 错误」双大卡，同网页端 .judge-btn） ---------- */
.judge-row {
  margin-top: 20rpx;
  display: flex;
  gap: 24rpx;
}

.judge-btn {
  flex: 1;
  height: 176rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e3dccb;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 31rpx;
  font-weight: 800;
}

.judge-btn.sel {
  border-color: #f26d21;
  background: #fdeee2;
  color: #f26d21;
}

.judge-btn.right {
  border-color: #2ba471;
  background: #e8f5ef;
  color: #2ba471;
}

.judge-btn.wrong {
  border-color: #cf4444;
  background: #fae9e9;
  color: #cf4444;
}

/* ---------- 多选提示 ---------- */
.multi-hint {
  margin-top: 18rpx;
  padding: 0 6rpx;
  font-size: 21rpx;
  color: #a89f8a;
  letter-spacing: 1rpx;
}

/* ---------- 答案行（解析态） ---------- */
.answer-row {
  margin-top: 22rpx;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.answer-row b {
  color: #2ba471;
  font-weight: 800;
  letter-spacing: 2rpx;
}

/* ---------- AI 解析卡（屏 03 .analysis-card：浅橙底 + 灯泡图标） ---------- */
.analysis-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  background: #fdeee2;
  border-radius: 20rpx;
}

.analysis-card .hd {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #f26d21;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.analysis-card .bd {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #4a5670;
}

.analysis-card .bd.ph {
  color: #c29b7e;
}

.analysis-card .ft {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #c29b7e;
  letter-spacing: 1rpx;
}

/* ---------- 底部操作栏（屏 02/03 .practice-bar） ---------- */
.practice-bar {
  flex: none;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.practice-bar .btn-ghost {
  flex: 1;
}

.practice-bar .btn-navy {
  flex: 2;
}

.btn-ghost {
  height: 88rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e3dccb;
  background: #ffffff;
  color: #22314e;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn-navy {
  height: 88rpx;
  border-radius: 16rpx;
  background: #22314e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  box-shadow: 0 16rpx 36rpx rgba(34, 49, 78, 0.26);
}

.btn-ghost.disabled,
.btn-navy.disabled {
  opacity: 0.4;
}

/* ---------- 空态 ---------- */
.q-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding-bottom: 120rpx;
}

.q-empty-t {
  font-size: 28rpx;
  font-weight: 700;
  color: #6b7690;
  letter-spacing: 2rpx;
}

.q-empty-btn {
  width: 320rpx;
}

/* ---------- 答题卡弹层（底部弹层圆角卡片，约 70vh） ---------- */
.sheet-pop {
  height: 70vh;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx 0;
  display: flex;
  flex-direction: column;
}

.sheet-hd {
  flex: none;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 28rpx;
}

.sheet-sec + .sheet-sec {
  margin-top: 28rpx;
}

.sec-hd {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #6b7690;
  letter-spacing: 1rpx;
}

/* 题号 chips：未答灰底 / 答对绿底白字 / 答错红底白字 / 当前橙描边 */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  width: 80rpx;
  height: 80rpx;
  border-radius: 18rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  background: #f4f1ea;
  color: #6b7690;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
}

.chip.cur {
  border-color: #f26d21;
  color: #f26d21;
}

.chip.right {
  background: #2ba471;
  color: #ffffff;
}

.chip.wrong {
  background: #cf4444;
  color: #ffffff;
}

/* 底部「清空做题记录」红色文字按钮 */
.sheet-ft {
  flex: none;
  display: flex;
  justify-content: center;
  padding: 20rpx 0 calc(28rpx + env(safe-area-inset-bottom));
}

.reset-link {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #cf4444;
  letter-spacing: 2rpx;
}

.reset-link.disabled {
  color: #d9cfba;
}
