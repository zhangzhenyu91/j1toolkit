/* 题库刷题 · 刷题页（交互参考考试宝：swiper 跟手翻页 + 考试宝式底栏；设计 token 见 AGENTS.md 第四节，
   固定底栏布局同 pkg-callme chat 页：flex 列 + 内容区自适应 + 底部操作栏） */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--app-bg-page);
}

/* ---------- 跟手翻页 swiper（一题一页；每格内独立纵向滚动） ---------- */
.q-swiper {
  flex: 1;
  min-height: 0;
}

.q-item {
  height: 100%;
  box-sizing: border-box;
}

.q-item-in {
  padding: 4rpx 32rpx 40rpx;
}

.q-loading {
  padding: 96rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

/* ---------- 顶部进度行（模式切换 + 细进度条 + x/total） ---------- */
.pg-line {
  flex: none;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 32rpx 20rpx;
}

/* 答题 / 背题 双 pill 切换 */
.vm-switch {
  flex: none;
  display: flex;
  padding: 4rpx;
  background: var(--app-bg-nested);
  border-radius: 12rpx;
}

.vm-opt {
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--app-text-secondary);
  transition:
    background-color 0.18s ease,
    color 0.18s ease;
}

.vm-opt.on {
  background: var(--app-brand);
  color: var(--app-on-brand);
}

.progress {
  flex: 1;
  height: 12rpx;
  border-radius: 12rpx;
  background: var(--app-bg-nested);
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 12rpx;
  background: var(--app-brand);
  transition: width 0.3s ease;
}

.pg-line b {
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.pg-line b em {
  font-style: normal;
  color: var(--app-brand);
}

/* ---------- 题干卡 ---------- */
.stem-card {
  padding: 30rpx 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.75;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
  margin-right: 14rpx;
  vertical-align: 4rpx;
}

.tag-orange {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.tag-navy {
  background: var(--app-brand-light);
  color: var(--app-text-primary);
}

/* ---------- 选项卡（白卡描边，选中浅蓝底；解析态字母块变对勾/红叉，文字同着色；180ms 过渡） ---------- */
.opt {
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  transition:
    background-color 0.18s ease,
    border-color 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

/* 点按未提交选项的轻微反馈（hover-class）：轻微内缩 + 浅蓝底 */
.opt-hover {
  transform: scale(0.99);
  background-color: var(--app-brand-light) !important;
}

.opt .ab {
  width: 52rpx;
  height: 52rpx;
  flex: none;
  border-radius: 50%;
  border: 3rpx solid var(--app-text-tertiary);
  color: var(--app-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
  box-sizing: border-box;
  transition:
    background-color 0.18s ease,
    border-color 0.18s ease,
    color 0.18s ease;
}

/* 多选：方形字母块 */
.opt.sq .ab {
  border-radius: 12rpx;
}

.opt .opt-tx {
  flex: 1;
  min-width: 0;
}

.opt.sel {
  border-color: var(--app-brand);
  background: var(--app-brand-light);
}

.opt.sel .ab {
  border-color: var(--app-brand);
  background: var(--app-brand);
  color: var(--app-on-brand);
}

/* 解析态（考试宝式）：正确项绿底绿勾 / 错选项红底红叉，文字同步着色 */
.opt.right {
  border-color: var(--app-success);
  background: var(--app-success-bg);
}

.opt.right .ab {
  border-color: var(--app-success);
  background: var(--app-success);
  color: var(--app-on-brand);
}

.opt.right .opt-tx {
  color: var(--app-success-text);
}

.opt.wrong {
  border-color: var(--app-danger);
  background: var(--app-danger-bg);
}

.opt.wrong .ab {
  border-color: var(--app-danger);
  background: var(--app-danger);
  color: var(--app-on-brand);
}

.opt.wrong .opt-tx {
  color: var(--app-danger-text);
}

/* ---------- 判断题大选项卡（「正确 / 错误」双大卡） ---------- */
.judge-row {
  margin-top: 20rpx;
  display: flex;
  gap: 24rpx;
}

.judge-btn {
  flex: 1;
  height: 176rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 31rpx;
  font-weight: 700;
  transition:
    background-color 0.18s ease,
    border-color 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

.judge-btn.sel {
  border-color: var(--app-brand);
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.judge-btn.right {
  border-color: var(--app-success);
  background: var(--app-success-bg);
  color: var(--app-success-text);
}

.judge-btn.wrong {
  border-color: var(--app-danger);
  background: var(--app-danger-bg);
  color: var(--app-danger-text);
}

/* ---------- 多选提示 ---------- */
.multi-hint {
  margin-top: 18rpx;
  padding: 0 6rpx;
  font-size: 21rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 1rpx;
}

/* ---------- 结果区（考试宝式：正确答案/您的选择 + 本人/全员作答统计 + 错题本动态） ---------- */
.result-block {
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
  background: var(--app-bg-card);
  border-radius: 12rpx;
  animation: fadeIn 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.result-block .r-main {
  display: flex;
  align-items: baseline;
  gap: 32rpx;
  flex-wrap: wrap;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.result-block .r-main .v {
  font-weight: 700;
  letter-spacing: 2rpx;
}

.result-block .ok {
  color: var(--app-success-text);
}

.result-block .bad {
  color: var(--app-danger-text);
}

.result-block .r-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
  letter-spacing: 1rpx;
}

.result-block .r-sub.orange {
  color: var(--app-brand);
  font-weight: 600;
}

/* ---------- 解析卡（浅蓝底 + 灯泡图标；fadeUp 入场） ---------- */
.analysis-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  background: var(--app-brand-light);
  border-radius: 12rpx;
  animation: fadeUp 0.5s 0.07s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.analysis-card .hd {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: var(--app-brand);
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.analysis-card .bd {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: var(--app-text-secondary);
}

.analysis-card .bd.ph {
  color: var(--app-text-tertiary);
}

.analysis-card .ft {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 1rpx;
}

/* ---------- 底栏（考试宝式：白底 + 发丝顶边；收藏 / 对错计数 / 已做题 / 主按钮） ---------- */
.practice-bar {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
}

/* 底栏图标位（考试宝式单行：无小字，统一 76rpx 高居中，天然对齐） */
.b-item {
  height: 76rpx;
  min-width: 76rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-text-secondary);
  transition: opacity 0.15s ease;
}

.b-item.faved {
  color: var(--app-brand);
}

/* 本 session 对错计数（绿勾 / 红叉 + 数字） */
.b-item.counts {
  gap: 18rpx;
}

.b-item.counts .cnt {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.b-item.counts .cnt text {
  font-size: 26rpx;
  font-weight: 700;
}

.b-item.counts .ok text {
  color: var(--app-success-text);
}

.b-item.counts .bad text {
  color: var(--app-danger-text);
}

/* 已做题（答题卡入口：图标 + x/total 同行） */
.b-item.sheet {
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.bar-main {
  flex: 1;
  margin-left: 12rpx;
}

/* 单选/判断未答时的操作提示（点选即判分，无主按钮；两行居中） */
.bar-hint {
  flex: 1;
  margin-left: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--app-text-tertiary);
  letter-spacing: 1rpx;
}

/* ---------- 刷题设置弹层（底部弹层圆角卡片；自绘开关；骨架同弹层族：限高 + 独立滚动） ---------- */
.set-pop {
  box-sizing: border-box;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-bottom: none;
  border-radius: 12rpx;
  box-shadow: 0 -8rpx 32rpx var(--app-mask);
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
}

/* 弹层头（flex:none 不收缩；标题 + 右上显式关闭） */
.set-hd {
  flex: none;
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 显式关闭钮（克制：仅图标；遮罩关闭仍可用） */
.pop-close {
  margin-left: auto;
  padding: 6rpx;
  color: var(--app-text-tertiary);
  display: flex;
  align-items: center;
  transition: opacity 0.15s ease;
}

/* 弹层体区（flex-basis auto 保自适应；限高后独立滚动） */
.set-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.set-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0;
}

.set-row + .set-row {
  border-top: 2rpx solid var(--app-bg-nested);
}

.set-tx {
  flex: 1;
  min-width: 0;
}

.set-tx b {
  font-size: 28rpx;
  font-weight: 700;
}

/* 开关（蓝色轨道 + 白色方块，180ms 过渡） */
.set-sw {
  flex: none;
  width: 88rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: var(--app-border);
  padding: 4rpx;
  box-sizing: border-box;
  transition: background-color 0.18s ease;
}

.set-sw .dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: var(--app-bg-card);
  box-shadow: var(--app-shadow-card);
  transition: transform 0.18s ease;
}

.set-sw.on {
  background: var(--app-brand);
}

.set-sw.on .dot {
  transform: translateX(36rpx);
}

/* 解析卡铅笔入口（解析态/背题均可改，全员口径） */
.analysis-card .hd .ana-edit {
  margin-left: auto;
  padding: 6rpx;
  border-radius: 12rpx;
  display: flex;
}

/* 解析编辑弹层（骨架同弹层族：限高 + overflow hidden，头/脚 flex:none，体区独立滚动；
   键盘弹起时底部 padding 由行内 style 单次补偿，体区随剩余空间收缩，不再扣减 max-height） */
.ana-pop {
  box-sizing: border-box;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-bottom: none;
  border-radius: 12rpx;
  box-shadow: 0 -8rpx 32rpx var(--app-mask);
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
}
.ana-tip {
  flex: none;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
  line-height: 1.6;
}
.ana-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}
.ana-input {
  margin-top: 20rpx;
  width: 100%;
  min-height: 300rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  background: var(--app-bg-nested);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--app-text-primary);
}
.ana-foot {
  flex: none;
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}
.ana-btn {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.btn-navy {
  height: 84rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  box-shadow: var(--app-shadow-card);
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.btn-navy.disabled {
  opacity: 0.4;
}

.btn-ghost {
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  color: var(--app-text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  box-sizing: border-box;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

/* ---------- 空态 ---------- */
.q-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding-bottom: 120rpx;
}

.q-empty-t {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text-secondary);
  letter-spacing: 2rpx;
}

.q-empty-btn {
  width: 320rpx;
}

/* ---------- 答题卡弹层（底部弹层圆角卡片，约 70vh；头/脚 flex:none，体区独立滚动） ---------- */
.sheet-pop {
  height: 70vh;
  box-sizing: border-box;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-bottom: none;
  border-radius: 12rpx;
  box-shadow: 0 -8rpx 32rpx var(--app-mask);
  padding: 36rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-hd {
  flex: none;
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 图例行（未作答灰 / 答对绿 / 答错红） */
.sheet-legend {
  flex: none;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
}

.sheet-legend .dot {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--app-bg-page);
  border: 2rpx solid var(--app-border);
  margin-right: 8rpx;
  vertical-align: -4rpx;
}

.sheet-legend .dot.green {
  background: var(--app-success);
  border-color: var(--app-success);
}

.sheet-legend .dot.red {
  background: var(--app-danger);
  border-color: var(--app-danger);
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 24rpx;
  /* 弹层每次打开内容重挂载，chips 区块整体轻微 fadeUp 一次（不逐项） */
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

/* 隐藏滚动条（show-scrollbar=false 之外的 WXSS 双保险） */
.sheet-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.sheet-sec + .sheet-sec {
  margin-top: 28rpx;
}

.sec-hd {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--app-text-secondary);
  letter-spacing: 1rpx;
}

/* 题号 chips：每行居中排布（中心对称）；未答灰底 / 答对绿底白字 / 答错红底白字 / 当前蓝描边 */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.chip {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  background: var(--app-bg-page);
  color: var(--app-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
}

.chip.cur {
  border-color: var(--app-brand);
  color: var(--app-brand);
}

.chip.right {
  background: var(--app-success);
  color: var(--app-on-brand);
}

.chip.wrong {
  background: var(--app-danger);
  color: var(--app-on-brand);
}

/* 底部「清空做题记录」红色文字按钮 */
.sheet-ft {
  flex: none;
  display: flex;
  justify-content: center;
  padding: 20rpx 0 calc(28rpx + env(safe-area-inset-bottom));
}

.reset-link {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--app-danger-text);
  letter-spacing: 2rpx;
}

.reset-link.disabled {
  color: var(--app-text-tertiary);
}

/* 图标状态色（t-icon 不传 color，经宿主 CSS color 继承） */
.ico-brand {
  color: var(--app-brand);
}

.ico-ok {
  color: var(--app-success);
}

.ico-err {
  color: var(--app-danger-text);
}

.ico-mute {
  color: var(--app-text-tertiary);
}

.ico-strong {
  color: var(--app-text-primary);
}

/* ---------- t-icon 数值字阶（t-class 外部类） ---------- */
.ico-30 {
  font-size: 30rpx;
}
.ico-32 {
  font-size: 32rpx;
}
.ico-34 {
  font-size: 34rpx;
}
.ico-36 {
  font-size: 36rpx;
}
.ico-40 {
  font-size: 40rpx;
}
.ico-52 {
  font-size: 52rpx;
}
.ico-96 {
  font-size: 96rpx;
}
