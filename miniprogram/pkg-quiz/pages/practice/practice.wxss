/* 题库刷题 · 刷题页（交互参考考试宝：swiper 跟手翻页 + 考试宝式底栏；设计 token 见 AGENTS.md 第四节，
   固定底栏布局同 pkg-callme chat 页：flex 列 + 内容区自适应 + 底部操作栏） */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f4f1ea;
}

/* ---------- 跟手翻页 swiper（一题一页；每格内独立纵向滚动） ---------- */
.q-swiper {
  flex: 1;
  min-height: 0;
}

.q-item {
  height: 100%;
  box-sizing: border-box;
}

.q-item-in {
  padding: 4rpx 32rpx 40rpx;
}

.q-loading {
  padding: 96rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}

/* ---------- 顶部进度行（模式切换 + 细进度条 + x/total） ---------- */
.pg-line {
  flex: none;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 32rpx 20rpx;
}

/* 答题 / 背题 双 pill 切换 */
.vm-switch {
  flex: none;
  display: flex;
  padding: 4rpx;
  background: #efe9da;
  border-radius: 999rpx;
}

.vm-opt {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #6b7690;
}

.vm-opt.on {
  background: #22314e;
  color: #ffffff;
}

.progress {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: #efe9da;
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 6rpx;
  background: #f26d21;
  transition: width 0.3s ease;
}

.pg-line b {
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.pg-line b em {
  font-style: normal;
  color: #f26d21;
}

/* ---------- 题干卡 ---------- */
.stem-card {
  padding: 30rpx 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.75;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
  margin-right: 14rpx;
  vertical-align: 4rpx;
}

.tag-orange {
  background: #fdeee2;
  color: #f26d21;
}

.tag-navy {
  background: #edf0f6;
  color: #22314e;
}

/* ---------- 选项卡（白卡描边，选中浅橙底；解析态字母块变对勾/红叉，文字同着色；180ms 过渡） ---------- */
.opt {
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  background: #ffffff;
  border: 2rpx solid #e3dccb;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
}

/* 点按未提交选项的轻微反馈（hover-class）：轻微内缩 + 浅橙底 */
.opt-hover {
  transform: scale(0.99);
  background-color: #fdeee2 !important;
}

.opt .ab {
  width: 52rpx;
  height: 52rpx;
  flex: none;
  border-radius: 50%;
  border: 3rpx solid #d9cfba;
  color: #6b7690;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
  box-sizing: border-box;
  transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
}

/* 多选：方形字母块 */
.opt.sq .ab {
  border-radius: 14rpx;
}

.opt .opt-tx {
  flex: 1;
  min-width: 0;
}

.opt.sel {
  border-color: #f26d21;
  background: #fdeee2;
}

.opt.sel .ab {
  border-color: #f26d21;
  background: #f26d21;
  color: #ffffff;
}

/* 解析态（考试宝式）：正确项绿底绿勾 / 错选项红底红叉，文字同步着色 */
.opt.right {
  border-color: #2ba471;
  background: #e8f5ef;
}

.opt.right .ab {
  border-color: #2ba471;
  background: #2ba471;
  color: #ffffff;
}

.opt.right .opt-tx {
  color: #2ba471;
}

.opt.wrong {
  border-color: #cf4444;
  background: #fae9e9;
}

.opt.wrong .ab {
  border-color: #cf4444;
  background: #cf4444;
  color: #ffffff;
}

.opt.wrong .opt-tx {
  color: #cf4444;
}

/* ---------- 判断题大选项卡（「正确 / 错误」双大卡） ---------- */
.judge-row {
  margin-top: 20rpx;
  display: flex;
  gap: 24rpx;
}

.judge-btn {
  flex: 1;
  height: 176rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e3dccb;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 31rpx;
  font-weight: 800;
  transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
}

.judge-btn.sel {
  border-color: #f26d21;
  background: #fdeee2;
  color: #f26d21;
}

.judge-btn.right {
  border-color: #2ba471;
  background: #e8f5ef;
  color: #2ba471;
}

.judge-btn.wrong {
  border-color: #cf4444;
  background: #fae9e9;
  color: #cf4444;
}

/* ---------- 多选提示 ---------- */
.multi-hint {
  margin-top: 18rpx;
  padding: 0 6rpx;
  font-size: 21rpx;
  color: #a89f8a;
  letter-spacing: 1rpx;
}

/* ---------- 结果区（考试宝式：正确答案/您的选择 + 本人/全员作答统计 + 错题本动态） ---------- */
.result-block {
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  animation: fadeIn 0.2s ease both;
}

.result-block .r-main {
  display: flex;
  align-items: baseline;
  gap: 32rpx;
  flex-wrap: wrap;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.result-block .r-main b {
  font-weight: 800;
  letter-spacing: 2rpx;
}

.result-block .ok {
  color: #2ba471;
}

.result-block .bad {
  color: #cf4444;
}

.result-block .r-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b7690;
  letter-spacing: 1rpx;
}

.result-block .r-sub.orange {
  color: #f26d21;
  font-weight: 600;
}

/* ---------- 解析卡（浅橙底 + 灯泡图标；fadeUp 入场） ---------- */
.analysis-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  background: #fdeee2;
  border-radius: 20rpx;
  animation: fadeUp 0.22s 0.07s ease both;
}

.analysis-card .hd {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #f26d21;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.analysis-card .bd {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #4a5670;
}

.analysis-card .bd.ph {
  color: #c29b7e;
}

.analysis-card .ft {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #c29b7e;
  letter-spacing: 1rpx;
}

/* ---------- 底栏（考试宝式：白底 + 发丝顶边；收藏 / 对错计数 / 已做题 / 主按钮） ---------- */
.practice-bar {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 2rpx solid #e8e0cd;
}

/* 底栏图标位（考试宝式单行：无小字，统一 76rpx 高居中，天然对齐） */
.b-item {
  height: 76rpx;
  min-width: 76rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7690;
}

.b-item.faved {
  color: #f26d21;
}

/* 本 session 对错计数（绿勾 / 红叉 + 数字） */
.b-item.counts {
  gap: 18rpx;
}

.b-item.counts .cnt {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.b-item.counts .cnt text {
  font-size: 26rpx;
  font-weight: 800;
}

.b-item.counts .ok text {
  color: #2ba471;
}

.b-item.counts .bad text {
  color: #cf4444;
}

/* 已做题（答题卡入口：图标 + x/total 同行） */
.b-item.sheet {
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #22314e;
}

.bar-main {
  flex: 1;
  margin-left: 12rpx;
}

/* 单选/判断未答时的操作提示（点选即判分，无主按钮；两行居中） */
.bar-hint {
  flex: 1;
  margin-left: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: #a89f8a;
  letter-spacing: 1rpx;
}

/* ---------- 刷题设置弹层（底部弹层圆角卡片；自绘开关） ---------- */
.set-pop {
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.set-hd {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.set-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0;
}

.set-row + .set-row {
  border-top: 2rpx solid #f0ebdd;
}

.set-tx {
  flex: 1;
  min-width: 0;
}

.set-tx b {
  font-size: 28rpx;
  font-weight: 700;
}

/* 开关（橙色轨道 + 白色圆点，180ms 过渡） */
.set-sw {
  flex: none;
  width: 88rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #e3dccb;
  padding: 4rpx;
  box-sizing: border-box;
  transition: background-color 0.18s ease;
}

.set-sw .dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(34, 49, 78, 0.18);
  transition: transform 0.18s ease;
}

.set-sw.on {
  background: #f26d21;
}

.set-sw.on .dot {
  transform: translateX(36rpx);
}

.btn-navy {
  height: 84rpx;
  border-radius: 16rpx;
  background: #22314e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  box-shadow: 0 16rpx 36rpx rgba(34, 49, 78, 0.26);
}

.btn-navy.disabled {
  opacity: 0.4;
}

.btn-ghost {
  height: 88rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e3dccb;
  background: #ffffff;
  color: #22314e;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  box-sizing: border-box;
}

/* ---------- 空态 ---------- */
.q-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding-bottom: 120rpx;
}

.q-empty-t {
  font-size: 28rpx;
  font-weight: 700;
  color: #6b7690;
  letter-spacing: 2rpx;
}

.q-empty-btn {
  width: 320rpx;
}

/* ---------- 答题卡弹层（底部弹层圆角卡片，约 70vh） ---------- */
.sheet-pop {
  height: 70vh;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx 0;
  display: flex;
  flex-direction: column;
}

.sheet-hd {
  flex: none;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

/* 图例行（未作答灰 / 答对绿 / 答错红） */
.sheet-legend {
  flex: none;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  font-size: 22rpx;
  color: #6b7690;
}

.sheet-legend .dot {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #f4f1ea;
  border: 2rpx solid #e3dccb;
  margin-right: 8rpx;
  vertical-align: -4rpx;
}

.sheet-legend .dot.green {
  background: #2ba471;
  border-color: #2ba471;
}

.sheet-legend .dot.red {
  background: #cf4444;
  border-color: #cf4444;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 24rpx;
  /* 弹层每次打开内容重挂载，chips 区块整体轻微 fadeUp 一次（不逐项） */
  animation: fadeUp 0.25s ease both;
}

/* 隐藏滚动条（show-scrollbar=false 之外的 WXSS 双保险） */
.sheet-scroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.sheet-sec + .sheet-sec {
  margin-top: 28rpx;
}

.sec-hd {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #6b7690;
  letter-spacing: 1rpx;
}

/* 题号 chips：每行居中排布（中心对称）；未答灰底 / 答对绿底白字 / 答错红底白字 / 当前橙描边 */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.chip {
  width: 80rpx;
  height: 80rpx;
  border-radius: 18rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  background: #f4f1ea;
  color: #6b7690;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
}

.chip.cur {
  border-color: #f26d21;
  color: #f26d21;
}

.chip.right {
  background: #2ba471;
  color: #ffffff;
}

.chip.wrong {
  background: #cf4444;
  color: #ffffff;
}

/* 底部「清空做题记录」红色文字按钮 */
.sheet-ft {
  flex: none;
  display: flex;
  justify-content: center;
  padding: 20rpx 0 calc(28rpx + env(safe-area-inset-bottom));
}

.reset-link {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #cf4444;
  letter-spacing: 2rpx;
}

.reset-link.disabled {
  color: #d9cfba;
}
