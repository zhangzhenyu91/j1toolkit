<!-- 题库刷题 · 刷题页（设计稿 design/quiz.html 屏 02 答题态 / 屏 03 解析态）
     顶部进度行：答题/背题双 pill 切换 + 细进度条 + 答题卡入口；选项白卡描边、选中浅橙底，
     解析态对=绿/错选=红/漏选=绿虚线；背题模式直接标出正确答案并常显答案行 + AI 解析卡；
     答题卡弹层按题型分区块导航，底部可清空做题记录（错题本保留） -->
<view class="page">
  <navbar back title="{{navTitle}}" />

  <scroll-view
    class="q-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-into-view="{{intoView}}"
    scroll-with-animation="{{false}}"
    wx:if="{{!emptyText}}"
  >
    <view class="q-body" wx:if="{{cur}}">
      <!-- 进度行：模式切换 + 细进度条 + x/total + 答题卡入口 -->
      <view class="pg-line" id="qtop">
        <view class="vm-switch">
          <view class="vm-opt {{viewMode === 'answer' ? 'on' : ''}}" hover-class="hover-opacity"
                bindtap="onViewTap" data-v="answer">答题</view>
          <view class="vm-opt {{viewMode === 'recite' ? 'on' : ''}}" hover-class="hover-opacity"
                bindtap="onViewTap" data-v="recite">背题</view>
        </view>
        <view class="progress"><view class="progress-in" style="width: {{pct}}%;"></view></view>
        <b><em>{{posText}}</em> / {{total}}</b>
        <view class="sheet-entry" hover-class="hover-opacity" bindtap="onSheetOpen">
          <t-icon name="view-module" size="30rpx" color="#22314E" />答题卡
        </view>
      </view>

      <!-- 结果 banner（答题模式解析态） -->
      <view class="result-banner {{result.right ? 'good' : 'bad'}}" wx:if="{{viewMode === 'answer' && submitted && result}}">
        <t-icon name="{{result.right ? 'check-circle' : 'close-circle'}}" size="34rpx"
                color="{{result.right ? '#2BA471' : '#CF4444'}}" />
        {{result.right ? '回答正确' : '回答错误'}}
        <small wx:if="{{result.bannerSub}}">{{result.bannerSub}}</small>
      </view>

      <!-- 题干卡 -->
      <view class="card stem-card"><span class="tag {{cur.type === 'judge' ? 'tag-navy' : 'tag-orange'}}">{{cur.typeText}}</span>{{cur.content}}</view>

      <!-- 判断题：「正确 / 错误」两个大选项卡 -->
      <view class="judge-row" wx:if="{{cur.type === 'judge'}}">
        <view
          class="judge-btn {{item.cls}}"
          wx:for="{{cur.options}}"
          wx:key="letter"
          hover-class="{{submitted ? '' : 'hover-opacity'}}"
          bindtap="onOptTap"
          data-letter="{{item.letter}}"
        >
          <t-icon name="{{item.letter === 'A' ? 'check-circle' : 'close-circle'}}" size="52rpx"
                  color="{{item.cls === 'sel' ? '#F26D21' : item.cls === 'right' || item.cls === 'miss' ? '#2BA471' : item.cls === 'wrong' ? '#CF4444' : '#A89F8A'}}" />
          {{item.text}}
        </view>
      </view>

      <!-- 单选/多选：字母块选项卡（多选为方形字母块） -->
      <block wx:else>
        <view
          class="opt {{cur.type === 'multiple' ? 'sq' : ''}} {{item.cls}}"
          wx:for="{{cur.options}}"
          wx:key="letter"
          hover-class="{{submitted ? '' : 'hover-opacity'}}"
          bindtap="onOptTap"
          data-letter="{{item.letter}}"
        >
          <span class="ab">{{item.letter}}</span>
          <view class="opt-tx">{{item.text}}</view>
          <span class="st {{item.cls === 'wrong' ? 'st-red' : 'st-green'}}" wx:if="{{item.st}}">
            <t-icon wx:if="{{item.stIcon}}" name="{{item.stIcon}}" size="26rpx"
                    color="{{item.cls === 'wrong' ? '#CF4444' : '#2BA471'}}" />{{item.st}}
          </span>
        </view>
        <!-- 多选底部提示 -->
        <view class="multi-hint" wx:if="{{multiple}}">多选题：可选择多个选项，全部选对才算答对</view>
      </block>

      <!-- 答案行（解析态；背题模式常显） -->
      <view class="answer-row" wx:if="{{submitted && result}}">
        正确答案：<b>{{result.answerText}}</b>
      </view>

      <!-- AI 解析卡（解析态；背题模式常显；解析未生成时占位文案） -->
      <view class="analysis-card" wx:if="{{submitted && result}}">
        <view class="hd"><t-icon name="lightbulb" size="34rpx" color="#F26D21" />AI 解析</view>
        <view class="bd" wx:if="{{result.analysis}}">{{result.analysis}}</view>
        <view class="bd ph" wx:else>解析生成中，稍后可查看</view>
        <view class="ft" wx:if="{{result.analysis}}">解析由 AI 生成，仅供参考</view>
      </view>
    </view>

    <!-- 首屏加载中 -->
    <view class="q-loading" wx:if="{{loading}}">题目加载中…</view>
  </scroll-view>

  <!-- 空态（无题目 / 无错题） -->
  <view class="q-empty" wx:if="{{emptyText}}">
    <t-icon name="check-circle" size="96rpx" color="#2BA471" wx:if="{{mode === 'wrong'}}" />
    <view class="q-empty-t">{{emptyText}}</view>
    <view class="btn-ghost q-empty-btn" hover-class="hover-opacity" bindtap="onFinish">返回题库</view>
  </view>

  <!-- 底部操作栏：答题态 提交答案；解析态/背题 下一题（藏青主按钮）/ 完成返回 -->
  <view class="practice-bar" wx:if="{{cur && !emptyText}}">
    <view class="btn-ghost {{isFirst ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onPrev">
      <t-icon name="chevron-left" size="30rpx" color="#6B7690" />上一题
    </view>
    <block wx:if="{{!submitted}}">
      <view class="btn-navy {{canSubmit ? '' : 'disabled'}}" hover-class="hover-opacity" bindtap="onSubmit">提交答案</view>
      <view class="btn-ghost {{isLast ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onNext">
        下一题<t-icon name="chevron-right" size="30rpx" color="#6B7690" />
      </view>
    </block>
    <view wx:else class="btn-navy" hover-class="hover-opacity" bindtap="onNextOrFinish">
      {{isLast ? '已完成本批 · 返回题库' : '下一题'}}
    </view>
  </view>

  <!-- 答题卡弹层（按题型分区块；背题模式仅导航，chips 全灰 + 当前橙框） -->
  <t-popup visible="{{sheetOpen}}" placement="bottom" bind:visible-change="onSheetVisibleChange">
    <view class="sheet-pop">
      <view class="sheet-hd">答题卡（已答 {{sheetAnswered}}/{{total}}）</view>
      <scroll-view scroll-y class="sheet-scroll">
        <view class="sheet-sec" wx:for="{{sheetGroups}}" wx:key="type" wx:for-item="sec">
          <view class="sec-hd">{{sec.typeText}}（{{sec.count}} 题）</view>
          <view class="chip-grid">
            <view
              class="chip {{item.st}} {{item.cur ? 'cur' : ''}}"
              wx:for="{{sec.items}}"
              wx:key="idx"
              hover-class="hover-opacity"
              bindtap="onSheetJump"
              data-idx="{{item.idx}}"
            >{{item.num}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="sheet-ft">
        <view class="reset-link {{canReset ? '' : 'disabled'}}" hover-class="{{canReset ? 'hover-opacity' : ''}}"
              bindtap="onResetRecords">清空做题记录</view>
      </view>
    </view>
  </t-popup>

  <t-dialog id="t-dialog" />
  <t-toast id="t-toast" />
</view>
