<!-- 题库刷题 · 刷题页（交互参考考试宝：一题一页，swiper 跟手左右滑动翻页；单选/判断点选即判分）
     顶部进度行：答题/背题双 pill 切换 + 细进度条 + x/total；swiper 三窗格窗口化渲染（当前题 ±1），
     翻页落定后窗口平移并复位中间格；解析态：正确答案/您的选择 + 作答统计 + 解析卡；
     底栏（考试宝式）：收藏星标 / 对错计数 / 已做题（点开答题卡）/ 主按钮（多选提交、解析态下一题）；
     答题卡弹层按题型分区块导航 + 图例，底部可清空做题记录（错题本保留） -->
<view class="page">
  <navbar back title="{{navTitle}}" />

  <block wx:if="{{!emptyText}}">
    <!-- 进度行：模式切换 + 细进度条 + x/total -->
    <view class="pg-line">
      <view class="vm-switch">
        <view class="vm-opt {{viewMode === 'answer' ? 'on' : ''}}" hover-class="hover-opacity"
              bindtap="onViewTap" data-v="answer">答题</view>
        <view class="vm-opt {{viewMode === 'recite' ? 'on' : ''}}" hover-class="hover-opacity"
              bindtap="onViewTap" data-v="recite">背题</view>
      </view>
      <view class="progress"><view class="progress-in" style="width: {{pct}}%;"></view></view>
      <b><em>{{posText}}</em> / {{total}}</b>
    </view>

    <!-- 跟手翻页 swiper（窗口化：仅渲染当前题 ±1；落定后复位中间格，内容一致无感切换） -->
    <swiper
      class="q-swiper"
      wx:if="{{win.length}}"
      current="{{swiperCurrent}}"
      duration="{{260}}"
      bindanimationfinish="onSwiperFinish"
    >
      <swiper-item wx:for="{{win}}" wx:key="idx">
        <scroll-view class="q-item" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="q-item-in" wx:if="{{!item.empty}}">
            <!-- 题干卡 -->
            <view class="card stem-card"><span class="tag {{item.type === 'judge' ? 'tag-navy' : 'tag-orange'}}">{{item.typeText}}</span>{{item.content}}</view>

            <!-- 判断题：「正确 / 错误」两个大选项卡 -->
            <view class="judge-row" wx:if="{{item.type === 'judge'}}">
              <view
                class="judge-btn {{o.cls}}"
                wx:for="{{item.options}}"
                wx:key="letter"
                wx:for-item="o"
                hover-class="{{item.submitted ? '' : 'opt-hover'}}"
                catchtap="onOptTap"
                data-letter="{{o.letter}}"
              >
                <t-icon name="{{o.letter === 'A' ? 'check-circle' : 'close-circle'}}" size="52rpx"
                        color="{{o.cls === 'sel' ? '#1D4ED8' : o.cls === 'right' ? '#1E9E50' : o.cls === 'wrong' ? '#D22730' : 'rgba(17,17,17,.4)'}}" />
                {{o.text}}
              </view>
            </view>

            <!-- 单选/多选：字母块选项卡（解析态字母块变对勾/红叉；多选为方形字母块） -->
            <block wx:else>
              <view
                class="opt {{item.type === 'multiple' ? 'sq' : ''}} {{o.cls}}"
                wx:for="{{item.options}}"
                wx:key="letter"
                wx:for-item="o"
                hover-class="{{item.submitted ? '' : 'opt-hover'}}"
                catchtap="onOptTap"
                data-letter="{{o.letter}}"
              >
                <span class="ab">
                  <t-icon wx:if="{{o.icon}}" name="{{o.icon}}" size="30rpx" color="#FFFFFF" />
                  <block wx:else>{{o.letter}}</block>
                </span>
                <view class="opt-tx">{{o.text}}</view>
              </view>
              <!-- 多选底部提示 -->
              <view class="multi-hint" wx:if="{{item.type === 'multiple' && !item.submitted && viewMode === 'answer'}}">多选题：勾选后点底部「提交答案」，全部选对才算答对</view>
            </block>

            <!-- 结果区（考试宝式：正确答案/您的选择 + 本人/全员作答统计 + 错题本动态） -->
            <view class="result-block" wx:if="{{item.submitted && item.result}}">
              <view class="r-main">
                <text>正确答案 <text class="ok v">{{item.result.answerText}}</text></text>
                <text wx:if="{{item.result.yourText}}">您的选择 <text class="v {{item.result.right ? 'ok' : 'bad'}}">{{item.result.yourText}}</text></text>
              </view>
              <view class="r-sub" wx:if="{{item.result.myStatsText}}">{{item.result.myStatsText}}</view>
              <view class="r-sub" wx:if="{{item.result.allStatsText}}">{{item.result.allStatsText}}</view>
              <view class="r-sub orange" wx:if="{{item.result.bannerSub}}">{{item.result.bannerSub}}</view>
            </view>

            <!-- 解析卡（解析态；背题模式常显；解析未生成时占位文案）；铅笔入口全员可改解析 -->
            <view class="analysis-card" wx:if="{{item.submitted && item.result}}">
              <view class="hd"><t-icon name="lightbulb" size="34rpx" color="#1D4ED8" />试题详解
                <view class="ana-edit" hover-class="hover-opacity" catchtap="onAnaEditTap">
                  <t-icon name="edit" size="30rpx" color="#C29B7E" />
                </view>
              </view>
              <view class="bd" wx:if="{{item.result.analysis}}">{{item.result.analysis}}</view>
              <view class="bd ph" wx:else>解析生成中，稍后可查看</view>
              <view class="ft" wx:if="{{item.result.analysis}}">解析内容仅供参考</view>
            </view>
          </view>

          <!-- 批次未拉到的占位格（静默预拉兜底，极少出现） -->
          <view class="q-loading" wx:else>题目加载中…</view>
        </scroll-view>
      </swiper-item>
    </swiper>

    <!-- 首屏加载中 -->
    <view class="q-loading" wx:if="{{loading && !win.length}}">题目加载中…</view>
  </block>

  <!-- 空态（无题目 / 无错题 / 无收藏） -->
  <view class="q-empty" wx:if="{{emptyText}}">
    <t-icon name="check-circle" size="96rpx" color="#1E9E50" wx:if="{{mode === 'wrong'}}" />
    <view class="q-empty-t">{{emptyText}}</view>
    <view class="btn-ghost q-empty-btn" hover-class="hover-opacity" bindtap="onFinish">返回题库</view>
  </view>

  <!-- 底栏（考试宝式单行图标位，无小字）：收藏 / 对错计数 / 已做题（点开答题卡）/ 设置 / 主按钮 -->
  <view class="practice-bar" wx:if="{{win.length && !emptyText}}">
    <view class="b-item {{curFav ? 'faved' : ''}}" hover-class="hover-opacity" bindtap="onFavTap">
      <t-icon name="{{curFav ? 'star-filled' : 'star'}}" size="40rpx" color="{{curFav ? '#1D4ED8' : '#5C5748'}}" />
    </view>
    <view class="b-item counts">
      <view class="cnt ok"><t-icon name="check" size="32rpx" color="#1E9E50" /><text>{{rightCount}}</text></view>
      <view class="cnt bad"><t-icon name="error-triangle" size="32rpx" color="#D22730" /><text>{{wrongCount}}</text></view>
    </view>
    <view class="b-item sheet" hover-class="hover-opacity" bindtap="onSheetOpen">
      <t-icon name="view-module" size="34rpx" color="#111111" />
      <text>{{answeredCount}}/{{total}}</text>
    </view>
    <view class="b-item" hover-class="hover-opacity" bindtap="onSetTap">
      <t-icon name="setting" size="36rpx" color="#111111" />
    </view>
    <view class="btn-navy bar-main {{canSubmit ? '' : 'disabled'}}" wx:if="{{showSubmit}}"
          hover-class="hover-opacity" bindtap="onSubmit">提交答案</view>
    <view class="btn-navy bar-main" wx:elif="{{showNext}}" hover-class="hover-opacity" bindtap="onNextOrFinish">
      {{isLast ? '完成' : '下一题'}}
    </view>
    <view class="bar-hint" wx:else>
      <view>左右滑动切题</view>
      <view>点选即判分</view>
    </view>
  </view>

  <!-- 刷题设置弹层（答对自动下一题 / 选项乱序；本地 storage 持久化） -->
  <t-popup visible="{{setOpen}}" placement="bottom" bind:visible-change="onSetVisibleChange">
    <view class="set-pop">
      <view class="set-hd">刷题设置</view>
      <view class="set-row">
        <view class="set-tx">
          <b>答对自动下一题</b>
        </view>
        <view class="set-sw {{autoNext ? 'on' : ''}}" hover-class="hover-opacity" bindtap="onToggleAutoNext">
          <view class="dot"></view>
        </view>
      </view>
      <view class="set-row">
        <view class="set-tx">
          <b>选项乱序</b>
        </view>
        <view class="set-sw {{shuffleOpt ? 'on' : ''}}" hover-class="hover-opacity" bindtap="onToggleShuffle">
          <view class="dot"></view>
        </view>
      </view>
    </view>
  </t-popup>

  <!-- 答题卡弹层（按题型分区块 + 图例；背题模式仅导航，chips 全灰 + 当前蓝框） -->
  <t-popup visible="{{sheetOpen}}" placement="bottom" bind:visible-change="onSheetVisibleChange">
    <view class="sheet-pop">
      <view class="sheet-hd">答题卡（已答 {{answeredCount}}/{{total}}）</view>
      <view class="sheet-legend">
        <span><i class="dot"></i>未作答</span>
        <span><i class="dot green"></i>答对</span>
        <span><i class="dot red"></i>答错</span>
      </view>
      <scroll-view scroll-y class="sheet-scroll" show-scrollbar="{{false}}">
        <view class="sheet-sec" wx:for="{{sheetGroups}}" wx:key="type" wx:for-item="sec">
          <view class="sec-hd">{{sec.typeText}}（{{sec.count}} 题）</view>
          <view class="chip-grid">
            <view
              class="chip {{item.st}} {{item.cur ? 'cur' : ''}}"
              wx:for="{{sec.items}}"
              wx:key="idx"
              hover-class="hover-opacity"
              bindtap="onSheetJump"
              data-idx="{{item.idx}}"
            >{{item.num}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="sheet-ft">
        <view class="reset-link {{canReset ? '' : 'disabled'}}" hover-class="{{canReset ? 'hover-opacity' : ''}}"
              bindtap="onResetRecords">清空做题记录</view>
      </view>
    </view>
  </t-popup>

  <!-- 解析编辑弹层（全员可改：保存后对题库内全员生效，留空则由 AI 重新生成） -->
  <t-popup visible="{{anaOpen}}" placement="bottom" bind:visible-change="onAnaVisibleChange">
    <view class="ana-pop">
      <view class="set-hd">修改解析</view>
      <view class="ana-tip">解析对题库内全员可见，保存后即刻生效；留空则由 AI 重新生成</view>
      <textarea class="ana-input" maxlength="2000" placeholder="填写本题解析" value="{{anaText}}" bindinput="onAnaInput" />
      <view class="ana-foot">
        <view class="btn-ghost ana-btn" hover-class="hover-opacity" bindtap="onAnaCancel">取消</view>
        <view class="btn-navy ana-btn" hover-class="hover-opacity" bindtap="onAnaSave">保存</view>
      </view>
    </view>
  </t-popup>

  <t-dialog id="t-dialog" />
  <t-toast id="t-toast" />
</view>
