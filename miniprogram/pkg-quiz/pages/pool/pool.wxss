/* 题库刷题 · 题库池（二级页；样式自题库列表页题库池板块迁入；设计 token 见 AGENTS.md 第四节） */

/* ---------- 通用：浅橙底图标盒 / 标签 ---------- */
.icon-box {
  width: 84rpx;
  height: 84rpx;
  flex: none;
  border-radius: 20rpx;
  background: #fdeee2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.tag-navy {
  background: #edf0f6;
  color: #22314e;
}

.tag-orange {
  background: #fdeee2;
  color: #f26d21;
}

/* ---------- 题库池列表项（范围 tag + 添加/已加入） ---------- */
.pool-item {
  padding: 26rpx 28rpx;
  display: flex;
  gap: 22rpx;
  align-items: center;
}

.pool-item + .pool-item {
  margin-top: 20rpx;
}

.pool-item .tx {
  flex: 1;
  min-width: 0;
}

.pool-item .tx b {
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pool-item .meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7690;
  display: flex;
  gap: 20rpx;
}

/* 「添加」橙描边小按钮 */
.btn-join {
  height: 56rpx;
  border-radius: 999rpx;
  border: 2rpx solid #f26d21;
  color: #f26d21;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0 28rpx;
  letter-spacing: 2rpx;
  flex: none;
  box-sizing: border-box;
}

/* 「已加入」灰文字（点击弹确认移出） */
.pool-item .joined {
  flex: none;
  padding: 10rpx 4rpx 10rpx 16rpx;
  font-size: 24rpx;
  color: #a89f8a;
  font-weight: 600;
}

/* ---------- 空态/加载（同出工日志 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed #d9cfba;
  border-radius: 20rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}

/* 未分配班组空态 */
.empty-box.no-team {
  margin-top: 96rpx;
  line-height: 1.8;
}
