/* 题库刷题 · 题库池（二级页；样式自题库列表页题库池板块迁入；设计 token 见 AGENTS.md 第四节） */

/* ---------- 通用：浅蓝底图标盒 / 标签 ---------- */
.icon-box {
  width: 84rpx;
  height: 84rpx;
  flex: none;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.tag-navy {
  background: var(--app-brand-light);
  color: var(--app-text-primary);
}

.tag-orange {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

/* ---------- 题库池列表项（范围 tag + 添加/已加入） ---------- */
.pool-item {
  padding: 26rpx 28rpx;
  display: flex;
  gap: 22rpx;
  align-items: center;
  /* 列表入场 fadeUp，逐项 stagger 由行内 animation-delay 控制（40ms/项，上限 5 项） */
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.pool-item + .pool-item {
  margin-top: 20rpx;
}

.pool-item .tx {
  flex: 1;
  min-width: 0;
}

.pool-item .tx b {
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pool-item .meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
  display: flex;
  gap: 20rpx;
}

/* 「添加」蓝描边小按钮 */
.btn-join {
  height: 56rpx;
  border-radius: 12rpx;
  border: 4rpx solid var(--app-brand);
  color: var(--app-brand);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0 28rpx;
  letter-spacing: 2rpx;
  flex: none;
  box-sizing: border-box;
  transition:
    opacity 0.15s ease,
    background-color 0.15s ease;
}

/* 「已加入」灰文字（点击弹确认移出） */
.pool-item .joined {
  flex: none;
  padding: 10rpx 4rpx 10rpx 16rpx;
  font-size: 24rpx;
  color: var(--app-text-tertiary);
  font-weight: 600;
}

/* ---------- 空态/加载（同出工日志 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed var(--app-text-tertiary);
  border-radius: 12rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

/* 未分配班组空态 */
.empty-box.no-team {
  margin-top: 96rpx;
  line-height: 1.8;
}

/* ---------- t-icon 数值字阶（t-class 外部类；600px 起折半 px） ---------- */
.ico-40 {
  font-size: 40rpx;
}

/* ---------- iPad / 宽屏适配（CSS 媒体查询；普通手机竖屏不受影响） ----------
   600px 起限宽居中、关键字阶改固定 px；900px 起列表两列网格 */
@media (min-width: 600px) {
  .page-body {
    box-sizing: border-box;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .pool-item .tx b {
    font-size: 14px;
  }

  .pool-item .meta {
    font-size: 11px;
  }

  .btn-join {
    height: 28px;
    font-size: 12px;
    border-width: 2px;
    border-radius: 6px;
    padding: 0 14px;
  }

  .pool-item .joined {
    font-size: 12px;
  }

  .empty-box {
    font-size: 13px;
    border-width: 1.5px;
    border-radius: 6px;
  }
  .ico-40 {
    font-size: 20px;
  }
}

@media (min-width: 900px) {
  .page-body {
    max-width: 960px;
  }

  /* 题库池列表两列网格 */
  .pool-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20rpx;
  }

  .pool-item + .pool-item {
    margin-top: 0;
  }
}

@media (min-width: 1200px) {
  .page-body {
    max-width: 1120px;
  }

  .pool-list {
    grid-template-columns: 1fr 1fr 1fr;
  }
}
