<!-- 题库刷题 · 题库管理（超管 / 班组管理员；设计稿 design/quiz.html 屏 05）
     新建题库 + 题库管理列表（编辑/删除 + 解析状态三态：解析完成 / 解析中进度 / 失败重试）；
     Excel 批量导入已移至网页端（页底小字提示） -->
<navbar back title="题库管理" />

<view class="page-body" wx:if="{{isManager}}">
  <!-- 新建题库（虚线占位按钮，弹层输入名称 + 描述） -->
  <view class="new-bank" hover-class="hover-opacity" bindtap="onOpenCreate">
    <t-icon name="add" size="32rpx" color="#0E3DA8" />新建题库
  </view>

  <!-- 题库管理列表 -->
  <view class="sec-row">
    <view class="section-title">题库列表</view>
    <view class="cnt">{{banks.length ? banks.length + ' 个题库' : ''}}</view>
  </view>

  <block wx:if="{{banks.length}}">
    <view class="card mg-item" wx:for="{{banks}}" wx:key="id">
      <view class="hd">
        <b>{{item.name}}</b>
        <span class="tag tag-orange" wx:if="{{item.scope === 'all'}}">全部池</span>
        <span class="tag tag-navy" wx:else>{{item.teamName || '班组池'}}</span>
        <span class="ops">
          <text class="op" hover-class="hover-opacity" catchtap="onOpenEdit"
                data-id="{{item.id}}" data-name="{{item.name}}" data-description="{{item.description}}"
                data-scope="{{item.scope}}">
            <t-icon name="edit" size="32rpx" color="rgba(29,33,41,.4)" />
          </text>
          <text class="op" hover-class="hover-opacity" catchtap="onDeleteBank"
                data-id="{{item.id}}" data-name="{{item.name}}">
            <t-icon name="delete" size="32rpx" color="rgba(29,33,41,.4)" />
          </text>
        </span>
      </view>
      <view class="sub">
        <span>{{item.questionCount}} 题</span>
        <span class="tag tag-green" wx:if="{{item.anFinished}}">解析完成</span>
        <span class="tag tag-red" wx:if="{{item.anFailed > 0}}">{{item.anFailed}} 题解析失败</span>
      </view>
      <!-- 解析中：蓝色进度条 -->
      <view class="an-line" wx:if="{{item.analyzing}}">
        <t-icon name="lightbulb" size="26rpx" color="#0E3DA8" />
        <text>解析中</text>
        <view class="progress"><view class="progress-in" style="width: {{item.anPct}}%;"></view></view>
        <text>{{item.anDone}} / {{item.anTotal}}</text>
      </view>
      <!-- 失败重试 / 中断续跑（有待解析或失败题且不在解析中时显示） -->
      <view class="an-line" wx:if="{{item.anRetryable}}">
        <span class="retry" hover-class="hover-opacity" catchtap="onRetryAnalyze"
              data-id="{{item.id}}" data-name="{{item.name}}">
          <t-icon name="refresh" size="26rpx" color="#0E3DA8" />{{item.anFailed > 0 ? '重试失败解析' : '继续解析'}}
        </span>
      </view>
    </view>
  </block>
  <view wx:elif="{{loading}}" class="empty-box">题库加载中…</view>
  <view wx:else class="empty-box">暂无题库，点上方「新建题库」创建</view>

  <!-- 页底提示：Excel 批量导入在网页端 -->
  <view class="web-hint">Excel 批量导入请前往网页端</view>
</view>

<!-- 新建 / 编辑题库弹层（底部弹层，同 safeday 名称弹层族；键盘弹起时动态抬高底部 padding） -->
<t-popup visible="{{bankOpen}}" placement="bottom" bind:visible-change="onBankVisibleChange">
  <view class="sheet" style="padding-bottom: {{keyboardHeight ? keyboardHeight + 'px' : 'calc(40rpx + env(safe-area-inset-bottom))'}};">
    <view class="sheet-title">{{bankMode === 'edit' ? '编辑题库' : '新建题库'}}</view>
    <view class="sheet-sub">{{bankMode === 'edit' ? '修改题库名称与简介' : '新建后请前往网页端 Excel 导入题目'}}</view>
    <input
      class="name-input"
      value="{{bankName}}"
      bindinput="onBankNameInput"
      adjust-position="{{false}}"
      bindkeyboardheightchange="onKeyboardHeight"
      hold-keyboard
      maxlength="50"
      placeholder="题库名称（必填）"
      placeholder-class="ph"
    />
    <input
      class="name-input"
      value="{{bankDesc}}"
      bindinput="onBankDescInput"
      adjust-position="{{false}}"
      bindkeyboardheightchange="onKeyboardHeight"
      hold-keyboard
      maxlength="200"
      placeholder="题库简介（选填）"
      placeholder-class="ph"
    />
    <!-- 上传至（仅超管可见；team_admin 固定班组池不传 scope） -->
    <block wx:if="{{isAdmin}}">
      <view class="scope-label">上传至</view>
      <view class="scope-row">
        <view class="scope-opt {{bankScope === 'team' ? 'on' : ''}}" hover-class="hover-opacity"
              bindtap="onScopePick" data-scope="team">班组池（{{teamName || '当前班组'}}）</view>
        <view class="scope-opt {{bankScope === 'all' ? 'on' : ''}}" hover-class="hover-opacity"
              bindtap="onScopePick" data-scope="all">全部池（所有班组可拉取）</view>
      </view>
    </block>
    <view class="sheet-ops">
      <view class="btn-ghost {{bankSaving ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onBankCancel">取消</view>
      <view class="btn-accent {{bankSaving ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onBankSave">
        {{bankSaving ? '保存中…' : '保存'}}
      </view>
    </view>
  </view>
</t-popup>

<t-dialog id="t-dialog" />
<t-toast id="t-toast" />
