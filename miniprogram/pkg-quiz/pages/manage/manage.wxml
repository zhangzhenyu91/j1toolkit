<!-- 题库刷题 · 题库管理（超管 / 班组管理员；设计稿 design/quiz.html 屏 05）
     「Excel 导入」三步卡（下载模板 → 选 .xlsx → 选题库导入）+ 新建题库 +
     题库管理列表（编辑/删除 + 解析状态三态：解析完成 / 解析中进度 / 失败重试） -->
<navbar back title="题库管理" />

<view class="page-body" wx:if="{{isManager}}">
  <!-- Excel 导入三步卡 -->
  <view class="section-title">Excel 导入</view>
  <view class="card import-card">
    <view class="step">
      <span class="no">1</span>
      <view class="tx">
        <b>下载导入模板</b>
        <p>模板列：题型 / 题干 / 选项 A~F / 答案 / 解析（留空则由 AI 自动生成）</p>
      </view>
      <view class="btn-ghost-sm" hover-class="hover-opacity" bindtap="onTplDownload">
        <t-icon name="download" size="26rpx" color="#22314E" />模板
      </view>
    </view>
    <view class="step">
      <span class="no">2</span>
      <view class="tx">
        <b>选择 Excel 文件</b>
        <view class="upload-zone" hover-class="hover-opacity" bindtap="onImpPick">
          <block wx:if="{{impFile}}">
            <t-icon name="file-excel" size="30rpx" color="#F26D21" />
            <text class="up-name">{{impFile.name}}</text>
            <text class="up-x" catchtap="onImpRemove">✕</text>
          </block>
          <block wx:else>
            <t-icon name="upload" size="30rpx" color="#A89F8A" />点击选择 .xlsx 文件
          </block>
        </view>
      </view>
    </view>
    <view class="step">
      <span class="no">3</span>
      <view class="tx">
        <b>导入到目标题库</b>
        <p>导入后逐题生成 AI 解析，期间可正常刷题</p>
        <view class="imp-row">
          <!-- 自绘题库选择下拉（题库数不受 ActionSheet 6 项上限约束） -->
          <view class="bank-sel {{bankDropOpen ? 'open' : ''}} {{impBankId ? '' : 'ph'}}"
                hover-class="hover-opacity" bindtap="onBankDropTap">
            <text class="bs-t">{{impBankName || '选择题库'}}</text>
            <text class="bs-arr">▾</text>
          </view>
          <view class="btn-orange-sm {{!impFile || !impBankId || importing ? 'disabled' : ''}}"
                hover-class="hover-opacity" bindtap="onImpStart">
            {{importing ? '导入中…' : '导入'}}
          </view>
        </view>
        <scroll-view class="bank-drop" scroll-y wx:if="{{bankDropOpen}}">
          <view class="bd-opt {{impBankId === item.id ? 'on' : ''}}" wx:for="{{banks}}" wx:key="id"
                hover-class="hover-bg-warm" bindtap="onBankPick" data-id="{{item.id}}" data-name="{{item.name}}">
            <text>{{item.name}}</text>
            <text class="ck" wx:if="{{impBankId === item.id}}">✓</text>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 新建题库（虚线占位按钮，弹层输入名称 + 描述） -->
  <view class="new-bank" hover-class="hover-opacity" bindtap="onOpenCreate">
    <t-icon name="add" size="32rpx" color="#F26D21" />新建题库
  </view>

  <!-- 题库管理列表 -->
  <view class="sec-row">
    <view class="section-title">题库列表</view>
    <view class="cnt">{{banks.length ? banks.length + ' 个题库' : ''}}</view>
  </view>

  <block wx:if="{{banks.length}}">
    <view class="card mg-item" wx:for="{{banks}}" wx:key="id">
      <view class="hd">
        <b>{{item.name}}</b>
        <span class="tag tag-orange" wx:if="{{item.scope === 'all'}}">全部池</span>
        <span class="tag tag-navy" wx:else>{{item.teamName || '班组池'}}</span>
        <span class="ops">
          <text class="op" hover-class="hover-opacity" catchtap="onOpenEdit"
                data-id="{{item.id}}" data-name="{{item.name}}" data-description="{{item.description}}"
                data-scope="{{item.scope}}">
            <t-icon name="edit" size="32rpx" color="#A89F8A" />
          </text>
          <text class="op" hover-class="hover-opacity" catchtap="onDeleteBank"
                data-id="{{item.id}}" data-name="{{item.name}}">
            <t-icon name="delete" size="32rpx" color="#A89F8A" />
          </text>
        </span>
      </view>
      <view class="sub">
        <span>{{item.questionCount}} 题</span>
        <span class="tag tag-green" wx:if="{{item.anFinished}}">解析完成</span>
        <span class="tag tag-red" wx:if="{{item.anFailed > 0}}">{{item.anFailed}} 题解析失败</span>
      </view>
      <!-- AI 解析中：橙色进度条 -->
      <view class="ai-line" wx:if="{{item.analyzing}}">
        <t-icon name="lightbulb" size="26rpx" color="#F26D21" />
        <text>AI 解析中</text>
        <view class="progress"><view class="progress-in" style="width: {{item.anPct}}%;"></view></view>
        <text>{{item.anDone}} / {{item.anTotal}}</text>
      </view>
      <!-- 失败重试 -->
      <view class="ai-line" wx:if="{{item.anFailed > 0}}">
        <span class="retry" hover-class="hover-opacity" catchtap="onRetryAnalyze"
              data-id="{{item.id}}" data-name="{{item.name}}">
          <t-icon name="refresh" size="26rpx" color="#F26D21" />重试失败解析
        </span>
      </view>
    </view>
  </block>
  <view wx:elif="{{loading}}" class="empty-box">题库加载中…</view>
  <view wx:else class="empty-box">暂无题库，点上方「新建题库」或 Excel 导入</view>
</view>

<!-- 导入校验失败明细弹层（逐行列出行号与原因） -->
<t-popup visible="{{impErrOpen}}" placement="center" bind:visible-change="onImpErrVisibleChange">
  <view class="err-pop">
    <view class="err-title">导入校验未通过</view>
    <view class="err-sub">{{impErrMsg}}</view>
    <scroll-view scroll-y class="err-list">
      <view wx:for="{{impErrors}}" wx:key="row" class="err-item">
        <text class="err-row">第 {{item.row}} 行</text>{{item.message}}
      </view>
    </scroll-view>
    <view class="btn-accent err-btn" hover-class="hover-opacity" bindtap="onImpErrClose">知道了</view>
  </view>
</t-popup>

<!-- 新建 / 编辑题库弹层（底部弹层，同 safeday 名称弹层族；键盘弹起时动态抬高底部 padding） -->
<t-popup visible="{{bankOpen}}" placement="bottom" bind:visible-change="onBankVisibleChange">
  <view class="sheet" style="padding-bottom: {{keyboardHeight ? keyboardHeight + 'px' : 'calc(40rpx + env(safe-area-inset-bottom))'}};">
    <view class="sheet-title">{{bankMode === 'edit' ? '编辑题库' : '新建题库'}}</view>
    <view class="sheet-sub">{{bankMode === 'edit' ? '修改题库名称与简介' : '新建后可经 Excel 导入题目'}}</view>
    <input
      class="name-input"
      value="{{bankName}}"
      bindinput="onBankNameInput"
      adjust-position="{{false}}"
      bindkeyboardheightchange="onKeyboardHeight"
      hold-keyboard
      maxlength="50"
      placeholder="题库名称（必填）"
      placeholder-class="ph"
    />
    <input
      class="name-input"
      value="{{bankDesc}}"
      bindinput="onBankDescInput"
      adjust-position="{{false}}"
      bindkeyboardheightchange="onKeyboardHeight"
      hold-keyboard
      maxlength="200"
      placeholder="题库简介（选填）"
      placeholder-class="ph"
    />
    <!-- 上传至（仅超管可见；team_admin 固定班组池不传 scope） -->
    <block wx:if="{{isAdmin}}">
      <view class="scope-label">上传至</view>
      <view class="scope-row">
        <view class="scope-opt {{bankScope === 'team' ? 'on' : ''}}" hover-class="hover-opacity"
              bindtap="onScopePick" data-scope="team">班组池（{{teamName || '当前班组'}}）</view>
        <view class="scope-opt {{bankScope === 'all' ? 'on' : ''}}" hover-class="hover-opacity"
              bindtap="onScopePick" data-scope="all">全部池（所有班组可拉取）</view>
      </view>
    </block>
    <view class="sheet-ops">
      <view class="btn-ghost {{bankSaving ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onBankCancel">取消</view>
      <view class="btn-accent {{bankSaving ? 'disabled' : ''}}" hover-class="hover-opacity" bindtap="onBankSave">
        {{bankSaving ? '保存中…' : '保存'}}
      </view>
    </view>
  </view>
</t-popup>

<t-dialog id="t-dialog" />
<t-toast id="t-toast" />
