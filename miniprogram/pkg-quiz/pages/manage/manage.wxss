/* 题库刷题 · 题库管理（设计稿 design/quiz.html 屏 05；设计 token 见 AGENTS.md 第四节，
   弹层同 safeday 名称弹层族；Excel 批量导入已移至网页端，导入卡样式一并移除） */

/* ---------- 新建题库（虚线占位按钮） ---------- */
.new-bank {
  margin-top: 24rpx;
  height: 88rpx;
  border: 3rpx dashed rgba(29,33,41,.35);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #0E3DA8;
  letter-spacing: 2rpx;
}

/* ---------- 题库管理列表（屏 05 .mg-item） ---------- */
.sec-row {
  margin-top: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.cnt {
  margin-left: auto;
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
  letter-spacing: 1rpx;
}

.mg-item {
  padding: 26rpx 28rpx;
}

.mg-item + .mg-item {
  margin-top: 20rpx;
}

.mg-item .hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mg-item .hd b {
  font-size: 28rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mg-item .hd .ops {
  display: flex;
  gap: 24rpx;
  flex: none;
}

.mg-item .hd .ops .op {
  display: flex;
  padding: 4rpx;
}

.mg-item .sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #4E5969;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 解析状态行：解析中进度 / 失败重试 */
.an-line {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 22rpx;
  color: #4E5969;
}

.an-line .progress {
  flex: 1;
  height: 12rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
  overflow: hidden;
}

.an-line .progress-in {
  height: 100%;
  border-radius: 12rpx;
  background: #0E3DA8;
}

.an-line .retry {
  color: #0E3DA8;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.tag-green {
  background: #E8FFEA;
  color: #00B42A;
}

.tag-orange {
  background: #E8F0FF;
  color: #0E3DA8;
}

.tag-navy {
  background: #E8F0FF;
  color: #1D2129;
}

/* 题库卡头部范围 tag 不压缩 */
.mg-item .hd .tag {
  flex: none;
}

/* ---------- 弹层「上传至」选择（仅超管可见） ---------- */
.scope-label {
  margin-top: 24rpx;
  font-size: 23rpx;
  color: #4E5969;
  letter-spacing: 2rpx;
}

.scope-row {
  margin-top: 12rpx;
  display: flex;
  gap: 16rpx;
}

.scope-opt {
  flex: 1;
  min-width: 0;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  padding: 18rpx 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #4E5969;
  text-align: center;
  line-height: 1.5;
  box-sizing: border-box;
}

.scope-opt.on {
  border-color: #0E3DA8;
  background: #E8F0FF;
  color: #0E3DA8;
}

.tag-red {
  background: #FFECE8;
  color: #F53F3F;
}

/* ---------- 空态/加载（同出工日志 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed rgba(29,33,41,.35);
  border-radius: 12rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(29,33,41,.4);
  letter-spacing: 2rpx;
}

/* ---------- 新建/编辑题库弹层（底部弹层，同 safeday 名称弹层族） ---------- */
.sheet {
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-bottom: none;
  border-radius: 12rpx;
  box-shadow: 0 -8rpx 0 rgba(29, 33, 41, 0.9);
  padding: 36rpx 32rpx 40rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.sheet-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #4E5969;
  line-height: 1.7;
}

.name-input {
  margin-top: 24rpx;
  height: 80rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  font-size: 27rpx;
  color: #1D2129;
}

.ph {
  color: rgba(29,33,41,.4);
}

.sheet-ops {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.btn-ghost {
  flex: 1;
  height: 84rpx;
  border-radius: 12rpx;
  border: 2rpx solid #E5E6EB;
  background: #ffffff;
  color: #1D2129;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-accent {
  flex: 2;
  height: 84rpx;
  border-radius: 12rpx;
  background: #0E3DA8;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost.disabled,
.btn-accent.disabled {
  opacity: 0.5;
}

/* ---------- 页底提示（Excel 批量导入在网页端） ---------- */
.web-hint {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
  letter-spacing: 2rpx;
}
