/* 题库刷题 · 题库管理（功能口径见《开发指南》第十四节；设计 token 见 AGENTS.md 第四节，
   弹层同 safeday 名称弹层族；Excel 批量导入已移至网页端，导入卡样式一并移除） */

/* ---------- 新建题库（虚线占位按钮） ---------- */
.new-bank {
  margin-top: 24rpx;
  height: 88rpx;
  border: 3rpx dashed var(--app-text-tertiary);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--app-brand);
  letter-spacing: 2rpx;
  transition: opacity 0.15s ease;
}

/* ---------- 题库管理列表 ---------- */
.sec-row {
  margin-top: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.cnt {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 1rpx;
}

.mg-item {
  padding: 26rpx 28rpx;
}

.mg-item + .mg-item {
  margin-top: 20rpx;
}

.mg-item .hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mg-item .hd b {
  font-size: 28rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mg-item .hd .ops {
  display: flex;
  gap: 24rpx;
  flex: none;
  color: var(--app-text-tertiary);
}

.mg-item .hd .ops .op {
  display: flex;
  padding: 4rpx;
  transition: opacity 0.15s ease;
}

.mg-item .sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--app-text-secondary);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 解析状态行：解析中进度 / 失败重试 */
.an-line {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
}

.an-line .progress {
  flex: 1;
  height: 12rpx;
  border-radius: 12rpx;
  background: var(--app-bg-nested);
  overflow: hidden;
}

.an-line .progress-in {
  height: 100%;
  border-radius: 12rpx;
  background: var(--app-brand);
}

.an-line .retry {
  color: var(--app-brand);
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ico-brand {
  color: var(--app-brand);
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.tag-green {
  background: var(--app-success-bg);
  color: var(--app-success-text);
}

.tag-orange {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.tag-navy {
  background: var(--app-brand-light);
  color: var(--app-text-primary);
}

/* 题库卡头部范围 tag 不压缩 */
.mg-item .hd .tag {
  flex: none;
}

/* ---------- 弹层「上传至」选择（仅超管可见） ---------- */
.scope-label {
  margin-top: 24rpx;
  font-size: 23rpx;
  color: var(--app-text-secondary);
  letter-spacing: 2rpx;
}

.scope-row {
  margin-top: 12rpx;
  display: flex;
  gap: 16rpx;
}

.scope-opt {
  flex: 1;
  min-width: 0;
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 18rpx 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--app-text-secondary);
  text-align: center;
  line-height: 1.5;
  box-sizing: border-box;
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease,
    color 0.15s ease;
}

.scope-opt.on {
  border-color: var(--app-brand);
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.tag-red {
  background: var(--app-danger-bg);
  color: var(--app-danger-text);
}

/* ---------- 空态/加载（同出工日志 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed var(--app-text-tertiary);
  border-radius: 12rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

/* ---------- 新建/编辑题库弹层（底部弹层，同 safeday 名称弹层族；头/体/脚三段 flex，
   整体限高 + overflow:hidden，内容体 flex:1 1 auto 独立滚动） ---------- */
.sheet {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-bottom: none;
  border-radius: 12rpx;
  box-shadow: 0 -8rpx 32rpx var(--app-mask);
  padding: 36rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

.sheet-title {
  flex: none;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.sheet-sub {
  flex: none;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--app-text-secondary);
  line-height: 1.7;
}

/* 弹层内容体（flex-basis 用 auto：0 基准会把自适应高度弹层内容压没） */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* 弹层内非体块默认不参与收缩（头/说明/控件/脚），体块（scroll-view 或 .sheet-body）独占剩余空间并滚动 */
.sheet > view {
  flex: none;
}

.sheet > scroll-view,
.sheet > .sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角隐形关闭热区（closeBtn 未启用仍可点）：置空防误关 */
.t-popup__close {
  display: none;
}

.name-input {
  margin-top: 24rpx;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  font-size: 27rpx;
  color: var(--app-text-primary);
}

.ph {
  color: var(--app-text-tertiary);
}

.sheet-ops {
  flex: none;
  margin-top: 32rpx;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
  display: flex;
  gap: 20rpx;
}

.btn-ghost {
  flex: 1;
  height: 84rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.btn-accent {
  flex: 2;
  height: 84rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.btn-ghost.disabled,
.btn-accent.disabled {
  opacity: 0.5;
}

/* ---------- 页底提示（Excel 批量导入在网页端） ---------- */
.web-hint {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

/* ---------- t-icon 数值字阶（t-class 外部类） ---------- */
.ico-26 {
  font-size: 26rpx;
}
.ico-32 {
  font-size: 32rpx;
}
