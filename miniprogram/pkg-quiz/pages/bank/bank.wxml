<!-- 题库刷题 · 题库主页（参考考试宝科目页：练习入口与错题/收藏都跟着题库走）
     信息卡（卡顶警示斜纹条为全局 hazard-top；题数/已练/正确率 + 进度条 + AI 解析状态）；
     宫格四入口：顺序练习（本地断点进度）/ 随机练习 / 我的错题（本题库口径，进错题本页）/ 我的收藏（进刷题）；
     底部「移出题库」红色文字按钮（记录与错题保留，可从题库池重新添加） -->
<navbar back title="{{navTitle}}" />

<view class="page-body" wx:if="{{bank}}">
  <!-- 题库信息卡 -->
  <view class="card hazard-top bank-card">
    <view class="nm">
      {{bank.name}}
      <span class="tag tag-orange" wx:if="{{bank.scope === 'all'}}">全部池</span>
      <span class="tag tag-navy" wx:elif="{{bank.teamName}}">{{bank.teamName}}</span>
      <span class="badge-outline" wx:if="{{bank.aiReady}}">AI 解析</span>
    </view>
    <view class="desc" wx:if="{{bank.description}}">{{bank.description}}</view>
    <view class="stat-row">
      <view class="cell"><b>{{bank.questionCount}}</b><span>总题数</span></view>
      <view class="cell"><b>{{bank.answeredCount}}</b><span>已练题数</span></view>
      <view class="cell"><b><em>{{bank.rightRateText}}</em></b><span>正确率</span></view>
    </view>
    <view class="pg">
      <view class="progress"><view class="progress-in" style="width: {{bank.pct}}%;"></view></view>
      <span>{{bank.pct}}%</span>
    </view>
    <view class="an-tip" wx:if="{{bank.analyzing}}">
      <t-icon name="time" size="24rpx" color="#A89F8A" />{{bank.analyzingText}}
    </view>
  </view>

  <!-- 练习入口宫格（错题/收藏数为本题库个人口径） -->
  <view class="grid">
    <view class="g-item" style="animation-delay: 0ms;" hover-class="hover-bg-warm" bindtap="onSeqTap">
      <view class="icon-box"><t-icon name="view-list" size="40rpx" color="#F26D21" /></view>
      <b>顺序练习</b>
      <p>{{seqText}}</p>
    </view>
    <view class="g-item" style="animation-delay: 40ms;" hover-class="hover-bg-warm" bindtap="onRandTap">
      <view class="icon-box"><t-icon name="swap" size="40rpx" color="#F26D21" /></view>
      <b>随机练习</b>
      <p>打乱顺序巩固</p>
    </view>
    <view class="g-item" style="animation-delay: 80ms;" hover-class="hover-bg-warm" bindtap="onWrongTap">
      <view class="icon-box red"><t-icon name="close-circle" size="40rpx" color="#CF4444" /></view>
      <b>我的错题<span class="cnt red" wx:if="{{bank.wrongCount}}">{{bank.wrongCount}}</span></b>
      <p>答错自动收录</p>
    </view>
    <view class="g-item" style="animation-delay: 120ms;" hover-class="hover-bg-warm" bindtap="onFavTap">
      <view class="icon-box"><t-icon name="star" size="40rpx" color="#F26D21" /></view>
      <b>我的收藏<span class="cnt" wx:if="{{bank.favCount}}">{{bank.favCount}}</span></b>
      <p>刷题时点星标收藏</p>
    </view>
  </view>

  <!-- 移出题库 -->
  <view class="leave-wrap">
    <view class="leave" hover-class="hover-opacity" bindtap="onLeave">
      <t-icon name="delete" size="28rpx" color="#CF4444" />移出题库
    </view>
  </view>
</view>

<!-- 加载中 / 失败空态 -->
<view class="page-body" wx:else>
  <view class="empty-box" wx:if="{{loading}}">题库加载中…</view>
  <view class="empty-box" wx:else>{{emptyText || '题库不存在或已停用'}}</view>
</view>

<t-dialog id="t-dialog" />
<t-toast id="t-toast" />
