/* 题库刷题 · 题库主页（设计 token 见 AGENTS.md 第四节；卡片/宫格/标签写法同 index 页） */

/* ---------- 题库信息卡（顶部留出警示斜纹条高度） ---------- */
.bank-card {
  padding: 44rpx 28rpx 28rpx;
}

.bank-card .nm {
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.bank-card .desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #6b7690;
  line-height: 1.7;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.tag-orange {
  background: #fdeee2;
  color: #f26d21;
}

.tag-navy {
  background: #edf0f6;
  color: #22314e;
}

/* 三格统计（正确率橙色；格间发丝分隔线） */
.stat-row {
  margin-top: 28rpx;
  display: flex;
}

.stat-row .cell {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-row .cell + .cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 2rpx;
  background: #e8e0cd;
}

.stat-row b {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.stat-row b em {
  font-style: normal;
  color: #f26d21;
}

.stat-row span {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #6b7690;
  letter-spacing: 2rpx;
}

.pg {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.pg .progress {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: #efe9da;
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 6rpx;
  background: #f26d21;
  transition: width 0.3s ease;
}

.pg > span {
  font-size: 20rpx;
  color: #a89f8a;
  white-space: nowrap;
}

.an-tip {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #a89f8a;
}

/* ---------- 练习入口宫格（2×2 白卡） ---------- */
.grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.g-item {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  /* 宫格入场 fadeUp，逐项 stagger 由行内 animation-delay 控制 */
  animation: fadeUp 0.25s ease both;
}

.icon-box {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #fdeee2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-box.red {
  background: #fae9e9;
}

.g-item b {
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.g-item p {
  font-size: 22rpx;
  color: #6b7690;
}

/* 错题/收藏计数小圆标（跟着题库走） */
.cnt {
  min-width: 36rpx;
  height: 36rpx;
  box-sizing: border-box;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #fdeee2;
  color: #f26d21;
  font-size: 20rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.cnt.red {
  background: #fae9e9;
  color: #cf4444;
}

/* ---------- 移出题库（危险操作红色文字按钮，居中） ---------- */
.leave-wrap {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.leave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #cf4444;
  letter-spacing: 2rpx;
}

/* ---------- 空态/加载（同 index 页 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed #d9cfba;
  border-radius: 20rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #a89f8a;
  letter-spacing: 2rpx;
}
