/* 题库刷题 · 题库主页（设计 token 见 AGENTS.md 第四节；卡片/宫格/标签写法同 index 页） */

/* ---------- 题库信息卡 ---------- */
.bank-card {
  padding: 44rpx 28rpx 28rpx;
}

.bank-card .nm {
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.bank-card .desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--app-text-secondary);
  line-height: 1.7;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 700;
  white-space: nowrap;
}

.tag-orange {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.tag-navy {
  background: var(--app-brand-light);
  color: var(--app-text-primary);
}

/* 三格统计（正确率蓝色；格间发丝分隔线） */
.stat-row {
  margin-top: 28rpx;
  display: flex;
}

.stat-row .cell {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-row .cell + .cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 2rpx;
  background: var(--app-border);
}

.stat-row b {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.stat-row b em {
  font-style: normal;
  color: var(--app-brand);
}

.stat-row span {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--app-text-secondary);
  letter-spacing: 2rpx;
}

.pg {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.pg .progress {
  flex: 1;
  height: 12rpx;
  border-radius: 12rpx;
  background: var(--app-bg-nested);
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 12rpx;
  background: var(--app-brand);
  transition: width 0.3s ease;
}

.pg > span {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  white-space: nowrap;
}

.an-tip {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

/* ---------- 练习入口宫格（2×2 白卡） ---------- */
.grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.g-item {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  box-shadow: var(--app-shadow-card); /* 次卡：轻影 */
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  /* 宫格入场 fadeUp，逐项 stagger 由行内 animation-delay 控制 */
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.icon-box {
  width: 84rpx;
  height: 84rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-box.red {
  background: var(--app-danger-bg);
  color: var(--app-danger-text);
}

.g-item b {
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.g-item p {
  font-size: 22rpx;
  color: var(--app-text-secondary);
}

/* 错题/收藏计数小圆标（跟着题库走） */
.cnt {
  min-width: 36rpx;
  height: 36rpx;
  box-sizing: border-box;
  padding: 0 10rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 20rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.cnt.red {
  background: var(--app-danger-bg);
  color: var(--app-danger-text);
}

/* ---------- 移出题库（危险操作红色文字按钮，居中） ---------- */
.leave-wrap {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.leave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--app-danger-text);
  letter-spacing: 2rpx;
}

/* ---------- 空态/加载（同 index 页 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed var(--app-text-tertiary);
  border-radius: 12rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

/* ---------- t-icon 数值字阶（t-class 外部类） ---------- */
.ico-24 {
  font-size: 24rpx;
}
.ico-28 {
  font-size: 28rpx;
}
.ico-40 {
  font-size: 40rpx;
}
