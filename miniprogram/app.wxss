/* ============================================================
   全局样式 —— 「政企蓝白 Enterprise Blue」× TDesign 定制主题
   设计稿基准：design/小程序-首页.html
              design/小程序-出工日志.html
   核心色板：品牌蓝 #0E3DA8 ｜ 深蓝 #0A3592 ｜ 浅蓝底 #E8F0FF
            成功 #00B42A ｜ 警告 #FF7D00 ｜ 危险 #F53F3F
            页面底 #F5F7FA ｜ 正文 #1D2129
   形态语言：白卡 12px 圆角（24rpx）+ 极轻阴影，无描边无渐变；
            按钮/输入 8px（16rpx），标签 4px（8rpx）小胶囊。
   变量名沿用旧主题（--yellow/--red-b/--blue-b/--ink/--paper-b/--hard），
   仅换值，各页面 var() 引用不变。
   ============================================================ */

page {
  /* TDesign 主题变量覆盖（注入政企蓝白色板） */
  --td-brand-color: #0E3DA8;
  --td-brand-color-active: #0A3592;
  --td-brand-color-light: #E8F0FF;
  --td-brand-color-focus: #E8F0FF;
  --td-error-color: #F53F3F;
  --td-success-color: #00B42A;
  --td-warning-color: #FF7D00;
  --td-tab-bar-active-color: #0E3DA8;
  --td-tab-bar-bg-color: #FFFFFF;
  --td-tab-bar-border-color: #E5E6EB;
  /* 圆角统一：按钮 16rpx / 弹层对话框 24rpx / 轻提示 8rpx */
  --td-button-border-radius: 16rpx;
  --td-dialog-border-radius: 24rpx;
  --td-popup-border-radius: 24rpx;
  --td-toast-radius: 8rpx;

  /* 主题变量（供各页面引用；-b 后缀避免与 --td 变量冲突）
     语义迁移：--yellow 现为警告橙（信号/备注语义），--ink 现为正文深色 */
  --yellow: #FF7D00;
  --red-b: #F53F3F;
  --blue-b: #0E3DA8;
  --ink: #1D2129;
  --paper-b: #F5F7FA;
  --hard: 0 4rpx 16rpx rgba(0, 0, 0, .05); /* 卡片轻阴影（签名硬影已取消） */

  background: #F5F7FA;
  color: #1D2129;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

/* ---------- 通用元素 ---------- */

/* 白色卡片（24rpx 圆角 + 轻阴影，无描边） */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .05);
}

/* 旧彩色硬影变体类名保留（不再轮转彩色，统一轻阴影），既有引用无需改动 */
.card.shadow-red,
.card.shadow-yellow {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .05);
}

/* 卡片定位壳（保留定位/裁切供浮层对齐） */
.hazard-top {
  position: relative;
  overflow: hidden;
}

/* 板块标题（无几何记号，600 字重） */
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

/* 徽章（身份标签）：浅蓝底 + 蓝字小胶囊 */
.badge-outline {
  display: inline-block;
  padding: 2rpx 14rpx;
  background: #E8F0FF;
  color: #0E3DA8;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.6;
}

/* 状态小标签（全端统一：浅底 + 同色深字 + 圆点；配合 .st-ok/.st-fail/.st-warn/.st-info） */
.st-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}
.st-tag::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}
.st-ok { background: #E8FFEA; color: #0B8A37; }
.st-fail { background: #FFECE8; color: #F53F3F; }
.st-warn { background: #FFF7E8; color: #D25F00; }
.st-info { background: #E8F0FF; color: #0E3DA8; }

/* 页面内容容器（为自定义 tabbar 预留底部空间） */
.page-body {
  padding: 24rpx 28rpx 160rpx;
}

/* ---------- 交互动效（克制的按压反馈与过渡） ---------- */

/* 按压反馈类（配合 hover-class 使用；!important 保证覆盖页面基础样式） */
.hover-scale {
  transform: scale(0.94) !important;
  opacity: 0.85 !important;
}

.hover-bg-warm {
  background-color: #E8F0FF !important;
}

.hover-opacity {
  opacity: 0.6 !important;
}

/* 入场动画（缓动统一 cubic-bezier(.22,1,.36,1)，在各页面 animation 声明处使用） */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 降级：系统开启减弱动态效果时关闭一切动画与过渡（WXSS 不支持 * 选择器，枚举常用组件） */
@media (prefers-reduced-motion: reduce) {
  page, view, text, image, button, input, textarea, scroll-view, swiper, swiper-item, navigator,
  page::before, page::after, view::before, view::after, text::before, text::after,
  image::before, image::after, button::before, button::after, input::before, input::after,
  textarea::before, textarea::after, scroll-view::before, scroll-view::after,
  swiper::before, swiper::after, swiper-item::before, swiper-item::after,
  navigator::before, navigator::after {
    animation: none !important;
    transition: none !important;
  }
}

/* ---------- 后台管理共用（admin users / perms / teams 页；原各页逐行重复，上移共用） ---------- */

/* 班组筛选 tab（横向滚动 chips，选中态蓝底白字；.ttabs-scroll 下外边距各页自留） */
.ttabs {
  display: flex;
  gap: 16rpx;
}

.ttab {
  flex: none;
  padding: 10rpx 26rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #4E5969;
  background: #FFFFFF;
  border: 1rpx solid #E5E6EB;
}

.ttab.on {
  background: #0E3DA8;
  border-color: #0E3DA8;
  color: #FFFFFF;
}

/* 分组标题（蓝条 + 班组名 + 人数） */
.grp-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #1D2129;
  margin: 16rpx 0 14rpx;
}

.grp-title::before {
  content: '';
  width: 8rpx;
  height: 24rpx;
  background: #0E3DA8;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.grp-cnt {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #86909C;
}

/* 员工行（padding 各页自留：users 24rpx 28rpx / perms 20rpx 28rpx） */
.u-item {
  display: flex;
  align-items: center;
  transition: background-color 0.15s ease;
}

.u-item + .u-item {
  border-top: 1rpx solid #E5E6EB;
}

/* 弹层头部与表单字段（users / teams 弹层共用；.sheet/.f-item/.sh-foot/.btn-primary 与其他分包
   同名类取值或声明覆盖范围不一，留在各页 wxss，不上移，避免串样式） */
.sh-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.sh-title {
  font-size: 30rpx;
  font-weight: 700;
}

.sh-sub {
  margin-left: 14rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #86909C;
}

.sh-close {
  margin-left: auto;
  padding: 6rpx;
}

.f-label {
  font-size: 22rpx;
  color: #4E5969;
  margin-bottom: 10rpx;
}

.f-field {
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 0 16rpx;
}

.sh-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #86909C;
  line-height: 1.8;
}

.btn-disabled {
  opacity: 0.6;
}
