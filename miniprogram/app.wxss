/* ============================================================
   全局样式 —— 方案十二「包豪斯几何 Bauhaus Geometric」× TDesign 定制主题
   设计稿基准：design/redesign/12-包豪斯几何-小程序首页.html
              design/redesign/12-包豪斯几何-小程序出工日志.html
   核心色板：纸底 #F8F6F1 ｜ 红 #D22730 ｜ 蓝 #1D4ED8 ｜ 黄 #F2B705 ｜ 墨 #111111
   ============================================================ */

page {
  /* TDesign 主题变量覆盖（注入包豪斯色板） */
  --td-brand-color: #1D4ED8;
  --td-brand-color-active: #1740B8;
  --td-brand-color-light: #EDF2FE;
  --td-brand-color-focus: #EDF2FE;
  --td-error-color: #D22730;
  --td-success-color: #1E9E50;
  --td-warning-color: #F2B705;
  --td-tab-bar-active-color: #D22730;
  --td-tab-bar-bg-color: #FFFFFF;
  --td-tab-bar-border-color: #111111;
  /* 方角统一：按钮 / 弹层 / 对话框 / 轻提示直角（t-button 等默认 12~24rpx 圆角清零） */
  --td-button-border-radius: 0;
  --td-dialog-border-radius: 0;
  --td-popup-border-radius: 0;
  --td-toast-radius: 0;

  /* 包豪斯主题变量（供各页面引用；-b 后缀避免与 --td 变量冲突） */
  --yellow: #F2B705;
  --red-b: #D22730;
  --blue-b: #1D4ED8;
  --ink: #111111;
  --paper-b: #F8F6F1;
  --hard: 6rpx 6rpx 0 #1D4ED8; /* 签名硬阴影（蓝）；红/黄轮转见 .card.shadow-* 变体 */

  background: #F8F6F1; /* 暖纸底 */
  color: #111111; /* 墨黑主文字 */
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

/* ---------- 通用元素 ---------- */

/* 白色卡片（直角 + 墨线描边 + 蓝色硬阴影，首页稿签名特征；稿中 2px 边按 1px=2rpx 换算为 4rpx） */
.card {
  background: #FFFFFF;
  border: 4rpx solid #111111;
  box-shadow: 6rpx 6rpx 0 #1D4ED8;
}

/* 硬阴影红/黄轮转变体（蓝为 .card 默认） */
.card.shadow-red {
  box-shadow: 6rpx 6rpx 0 #D22730;
}

.card.shadow-yellow {
  box-shadow: 6rpx 6rpx 0 #F2B705;
}

/* 卡片定位壳（原顶部红黄蓝三色带已取消，仅保留定位/裁切供浮层对齐） */
.hazard-top {
  position: relative;
  overflow: hidden;
}

/* 板块标题（前置红方块） */
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}
.section-title::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  background: #D22730;
  margin-right: 12rpx;
}

/* 描边徽章（身份标签）：黄底 + 墨边 + 墨字（直角） */
.badge-outline {
  display: inline-block;
  padding: 2rpx 14rpx;
  border: 2rpx solid #111111;
  background: #F2B705;
  color: #111111;
  border-radius: 0;
  font-size: 20rpx;
  line-height: 1.6;
}

/* 页面内容容器（为自定义 tabbar 预留底部空间） */
.page-body {
  padding: 24rpx 28rpx 160rpx;
}

/* ---------- 交互动效（克制的按压反馈与过渡） ---------- */

/* 按压反馈类（配合 hover-class 使用；!important 保证覆盖页面基础样式） */
.hover-scale {
  transform: scale(0.94) !important;
  opacity: 0.85 !important;
}

.hover-bg-warm {
  background-color: #EDF2FE !important;
}

.hover-opacity {
  opacity: 0.6 !important;
}

/* 入场动画（缓动统一 cubic-bezier(.22,1,.36,1)，在各页面 animation 声明处使用） */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 降级：系统开启减弱动态效果时关闭一切动画与过渡（WXSS 不支持 * 选择器，枚举常用组件） */
@media (prefers-reduced-motion: reduce) {
  page, view, text, image, button, input, textarea, scroll-view, swiper, swiper-item, navigator,
  page::before, page::after, view::before, view::after, text::before, text::after,
  image::before, image::after, button::before, button::after, input::before, input::after,
  textarea::before, textarea::after, scroll-view::before, scroll-view::after,
  swiper::before, swiper::after, swiper-item::before, swiper-item::after,
  navigator::before, navigator::after {
    animation: none !important;
    transition: none !important;
  }
}

/* ---------- 后台管理共用（admin users / perms / teams 页；原各页逐行重复，上移共用） ---------- */

/* 班组筛选 tab（横向滚动 chips，选中态墨底白字；.ttabs-scroll 下外边距各页自留） */
.ttabs {
  display: flex;
  gap: 16rpx;
}

.ttab {
  flex: none;
  padding: 10rpx 26rpx;
  border-radius: 0; /* 胶囊改直角 */
  font-size: 24rpx;
  font-weight: 500;
  color: #6B7690;
  background: #FFFFFF;
  border: 1rpx solid #E7E1D2;
}

.ttab.on {
  background: #111111;
  border-color: #111111;
  color: #FFFFFF;
}

/* 分组标题（蓝条 + 班组名 + 人数） */
.grp-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #111111;
  margin: 16rpx 0 14rpx;
}

.grp-title::before {
  content: '';
  width: 8rpx;
  height: 24rpx;
  background: #1D4ED8;
  border-radius: 0;
  margin-right: 12rpx;
}

.grp-cnt {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #A89F8A;
}

/* 员工行（padding 各页自留：users 24rpx 28rpx / perms 20rpx 28rpx） */
.u-item {
  display: flex;
  align-items: center;
  transition: background-color 0.15s ease;
}

.u-item + .u-item {
  border-top: 1rpx solid #E7E1D2;
}

/* 弹层头部与表单字段（users / teams 弹层共用；.sheet/.f-item/.sh-foot/.btn-primary 与其他分包
   同名类取值或声明覆盖范围不一，留在各页 wxss，不上移，避免串样式） */
.sh-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.sh-title {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.sh-sub {
  margin-left: 14rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #A89F8A;
}

.sh-close {
  margin-left: auto;
  padding: 6rpx;
}

.f-label {
  font-size: 22rpx;
  color: #6B7690;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.f-field {
  background: #F8F6F1;
  border-radius: 0;
  padding: 0 16rpx;
}

.sh-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #A89F8A;
  line-height: 1.8;
}

.btn-disabled {
  opacity: 0.6;
}
