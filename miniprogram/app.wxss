/* ============================================================
   全局样式 —— 「政企蓝白 Enterprise Blue」× TDesign 定制主题
   设计稿基准：design/小程序-首页.html
              design/小程序-出工日志.html
   核心色板：品牌蓝 #0E3DA8 ｜ 深蓝 #0A3592 ｜ 浅蓝底 #E8F0FF
            成功 #00B42A ｜ 警告 #FF7D00 ｜ 危险 #F53F3F
            页面底 #F5F7FA ｜ 正文 #1D2129
   形态语言：白卡 12px 圆角（24rpx）+ 极轻阴影，无描边无渐变；
            按钮/输入 8px（16rpx），标签 4px（8rpx）小胶囊。
   深浅色契约：公共类一律引 --app-* 语义变量。浅色取值见 page 基座块
            （与上表一致、保持现状）；@media (prefers-color-scheme: dark)
            整体覆盖。品牌深蓝页首 --app-brand-deep #0A3592 不随系统深色
            变化。TDesign 品牌注入（--td-*）按亮/暗分域声明，避免亮色值
            压住 tdesign 自带暗色。
   ============================================================ */

page {
  /* ---------- 语义变量 · 浅色基座（页面/卡片/嵌套底、三级文字、边框、
     品牌及浅底、成功/警告/危险、阴影、遮罩） ---------- */
  --app-bg-page: #f5f7fa;
  --app-bg-card: #ffffff;
  --app-bg-nested: #f7f8fa;
  --app-text-primary: #1d2129;
  --app-text-secondary: #4e5969;
  --app-text-tertiary: #86909c;
  --app-border: #e5e6eb;
  --app-brand: #0e3da8;
  --app-brand-deep: #0a3592;
  --app-brand-light: #e8f0ff;
  --app-on-brand: #ffffff;
  --app-success: #00b42a;
  --app-success-bg: #e8ffea;
  --app-success-text: #0b8a37;
  --app-warning: #ff7d00;
  --app-warning-bg: #fff7e8;
  --app-warning-text: #d25f00;
  --app-danger: #f53f3f;
  --app-danger-bg: #ffece8;
  --app-danger-text: #f53f3f;
  --app-shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  --app-mask: rgba(0, 0, 0, 0.5);

  /* 圆角统一（主题无关）：按钮 16rpx / 弹层对话框 24rpx / 轻提示 8rpx */
  --td-button-border-radius: 16rpx;
  --td-dialog-border-radius: 24rpx;
  --td-popup-border-radius: 24rpx;
  --td-toast-radius: 8rpx;

  background: var(--app-bg-page);
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei',
    sans-serif;
}

/* TDesign 品牌注入 · 浅色基座（媒体查询不可用时仍保持原主题；深色在下方覆盖） */
page {
  --td-brand-color: var(--app-brand);
  --td-brand-color-active: var(--app-brand-deep);
  --td-brand-color-light: var(--app-brand-light);
  --td-brand-color-focus: var(--app-brand-light);
  --td-error-color: var(--app-danger);
  --td-success-color: var(--app-success);
  --td-warning-color: var(--app-warning);
  --td-bg-color-page: var(--app-bg-page);
  --td-bg-color-container: var(--app-bg-card);
  --td-bg-color-secondarycontainer: var(--app-bg-nested);
  --td-bg-color-component: var(--app-bg-nested);
  --td-bg-color-component-active: var(--app-border);
  --td-bg-color-component-disabled: var(--app-bg-nested);
  --td-bg-color-container-active: var(--app-bg-nested);
  --td-text-color-primary: var(--app-text-primary);
  --td-text-color-secondary: var(--app-text-secondary);
  --td-text-color-placeholder: var(--app-text-tertiary);
  --td-text-color-disabled: var(--app-text-tertiary);
  --td-border-level-1-color: var(--app-border);
  --td-component-stroke: var(--app-border);
  --td-component-border: var(--app-border);
  --td-tab-bar-active-color: var(--app-brand);
  --td-tab-bar-bg-color: var(--app-bg-card);
  --td-tab-bar-border-color: var(--app-border);
  --td-button-primary-color: var(--app-on-brand);
  --td-button-danger-color: var(--app-on-brand);
  --td-button-primary-disabled-color: var(--app-brand);
  --td-button-primary-disabled-bg: var(--app-brand-light);
  --td-button-primary-disabled-border-color: var(--app-brand-light);
  --td-button-danger-disabled-color: var(--app-danger-text);
  --td-button-danger-disabled-bg: var(--app-danger-bg);
  --td-button-danger-disabled-border-color: var(--app-danger-bg);
}

/* 语义变量 · 深色覆盖 + TDesign 暗色注入（暗阶取值与 tdesign 暗色板对齐） */
@media (prefers-color-scheme: dark) {
  page {
    --app-bg-page: #181818;
    --app-bg-card: #242424;
    --app-bg-nested: #2c2c2c;
    --app-text-primary: rgba(255, 255, 255, 0.9);
    --app-text-secondary: rgba(255, 255, 255, 0.55);
    --app-text-tertiary: rgba(255, 255, 255, 0.48);
    --app-border: #383838;
    --app-brand: #78a6ff;
    --app-brand-light: #1b2f51;
    --app-on-brand: #101820;
    /* --app-brand-deep 品牌深蓝页首，双主题一致，不在此覆盖 */
    --app-success: #059465;
    --app-success-bg: #193a2a;
    --app-success-text: #80d2b6;
    --app-warning: #cf6e2d;
    --app-warning-bg: #4f2a1d;
    --app-warning-text: #ecbf91;
    --app-danger: #c64751;
    --app-danger-bg: #472324;
    --app-danger-text: #ec888e;
    --app-shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
    --app-mask: rgba(0, 0, 0, 0.65);

    /* TDesign 品牌/语义色注入（暗值；亮色值不在本域出现） */
    --td-brand-color: var(--app-brand);
    --td-brand-color-active: #699ef5;
    --td-brand-color-light: var(--app-brand-light);
    --td-brand-color-focus: var(--app-brand-light);
    --td-error-color: var(--app-danger);
    --td-success-color: var(--app-success);
    --td-warning-color: var(--app-warning);
    --td-tab-bar-active-color: var(--app-brand);
    --td-tab-bar-bg-color: var(--app-bg-card);
    --td-tab-bar-border-color: var(--app-border);
    /* 深色基座：同步常用语义 token，供 tdesign 组件暗色取值 */
    --td-bg-color-page: var(--app-bg-page);
    --td-bg-color-container: var(--app-bg-card);
    --td-bg-color-secondarycontainer: var(--app-bg-nested);
    --td-text-color-primary: var(--app-text-primary);
    --td-text-color-secondary: var(--app-text-secondary);
    --td-text-color-placeholder: var(--app-text-tertiary);
    --td-border-level-1-color: var(--app-border);
    --td-component-stroke: var(--app-border);
    --td-mask-active: rgba(0, 0, 0, 0.65);
    --td-mask-background: rgba(36, 36, 36, 0.96);
  }
}

/* ---------- 通用元素 ---------- */

/* 白色卡片（24rpx 圆角 + 轻阴影，无描边） */
.card {
  background: var(--app-bg-card);
  border-radius: 24rpx;
  box-shadow: var(--app-shadow-card);
}

/* 卡片定位壳（保留定位/裁切供浮层对齐） */
.hazard-top {
  position: relative;
  overflow: hidden;
}

/* 板块标题（无几何记号，600 字重） */
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--app-text-primary);
}

/* 徽章（身份标签）：浅蓝底 + 蓝字小胶囊 */
.badge-outline {
  display: inline-block;
  padding: 2rpx 14rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.6;
}

/* 状态小标签（全端统一：浅底 + 同色深字 + 圆点；配合 .st-ok/.st-fail/.st-warn/.st-info） */
.st-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}
.st-tag::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}
.st-ok {
  background: var(--app-success-bg);
  color: var(--app-success-text);
}
.st-fail {
  background: var(--app-danger-bg);
  color: var(--app-danger-text);
}
.st-warn {
  background: var(--app-warning-bg);
  color: var(--app-warning-text);
}
.st-info {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

/* 页面内容容器（为自定义 tabbar 预留底部空间） */
.page-body {
  padding: 24rpx 28rpx 160rpx;
}

/* ---------- 交互动效（克制的按压反馈与过渡） ---------- */

/* 按压反馈类（配合 hover-class 使用；!important 保证覆盖页面基础样式） */
.hover-scale {
  transform: scale(0.98) !important;
  opacity: 0.9 !important;
}

.hover-bg-warm {
  background-color: var(--app-brand-light) !important;
}

.hover-opacity {
  opacity: 0.75 !important;
}

/* 入场动画（缓动统一 cubic-bezier(.22,1,.36,1)，在各页面 animation 声明处使用） */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 班组切换器下拉浮层/遮罩（worklog/quiz/filetransfer/safeday 共用，原四包逐字重复上收） */
@keyframes ts-drop-in {
  from {
    opacity: 0;
    transform: translateY(-6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ts-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 降级：系统开启减弱动态效果时关闭一切动画与过渡（WXSS 不支持 * 选择器，枚举常用组件） */
@media (prefers-reduced-motion: reduce) {
  page,
  view,
  text,
  image,
  button,
  input,
  textarea,
  scroll-view,
  swiper,
  swiper-item,
  navigator,
  page::before,
  page::after,
  view::before,
  view::after,
  text::before,
  text::after,
  image::before,
  image::after,
  button::before,
  button::after,
  input::before,
  input::after,
  textarea::before,
  textarea::after,
  scroll-view::before,
  scroll-view::after,
  swiper::before,
  swiper::after,
  swiper-item::before,
  swiper-item::after,
  navigator::before,
  navigator::after {
    animation: none !important;
    transition: none !important;
  }
}

/* ---------- 后台管理共用（admin users / perms / teams 页；原各页逐行重复，上移共用） ---------- */

/* 班组筛选 tab（横向滚动 chips，选中态蓝底白字；.ttabs-scroll 下外边距各页自留） */
.ttabs {
  display: flex;
  gap: 16rpx;
}

.ttab {
  flex: none;
  padding: 10rpx 26rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--app-text-secondary);
  background: var(--app-bg-card);
  border: 1rpx solid var(--app-border);
}

.ttab.on {
  background: var(--app-brand);
  border-color: var(--app-brand);
  color: var(--app-on-brand);
}

/* 分组标题（蓝条 + 班组名 + 人数） */
.grp-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  margin: 16rpx 0 14rpx;
}

.grp-title::before {
  content: '';
  width: 8rpx;
  height: 24rpx;
  background: var(--app-brand);
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.grp-cnt {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--app-text-tertiary);
}

/* 员工行（padding 各页自留：users 24rpx 28rpx / perms 20rpx 28rpx） */
.u-item {
  display: flex;
  align-items: center;
  transition: background-color 0.15s ease;
}

.u-item + .u-item {
  border-top: 1rpx solid var(--app-border);
}

/* 弹层头部与表单字段（users / teams 弹层共用；.sheet/.f-item/.sh-foot/.btn-primary 与其他分包
   同名类取值或声明覆盖范围不一，留在各页 wxss，不上移，避免串样式） */
.sh-head {
  flex: none;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.sh-title {
  font-size: 30rpx;
  font-weight: 700;
}

.sh-sub {
  margin-left: 14rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: var(--app-text-tertiary);
}

.sh-close {
  margin-left: auto;
  padding: 6rpx;
}

.f-label {
  font-size: 22rpx;
  color: var(--app-text-secondary);
  margin-bottom: 10rpx;
}

.f-field {
  background: var(--app-bg-nested);
  border-radius: 16rpx;
  padding: 0 16rpx;
}

.sh-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  line-height: 1.8;
}

.btn-disabled {
  opacity: 0.6;
}
