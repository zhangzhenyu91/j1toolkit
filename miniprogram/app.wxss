/* ============================================================
   全局样式 —— 方案五「安全橙 · 浅色工业风」× TDesign 定制主题
   设计 token 见 AGENTS.md 第四节
   ============================================================ */

page {
  /* TDesign 主题变量覆盖（注入方案五色板） */
  --td-brand-color: #F26D21;
  --td-brand-color-active: #D85A12;
  --td-brand-color-light: #FDEEE2;
  --td-brand-color-focus: #FDEEE2;
  --td-error-color: #CF4444;
  --td-tab-bar-active-color: #F26D21;
  --td-tab-bar-bg-color: #FFFFFF;
  --td-tab-bar-border-color: #E8E0CD;

  background: #F4F1EA; /* 暖纸底 */
  color: #22314E; /* 藏青主文字 */
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

/* ---------- 通用元素 ---------- */

/* 白色卡片（圆角 10px） */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
}

/* 卡片顶部橙青警示斜纹条（特征元素，配合 padding-top 使用） */
.hazard-top {
  position: relative;
  overflow: hidden;
}
.hazard-top::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 16rpx;
  background: repeating-linear-gradient(
    45deg,
    #F26D21 0,
    #F26D21 20rpx,
    #22314E 20rpx,
    #22314E 40rpx
  );
}

/* 板块标题（左侧 4px 橙色竖条） */
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #22314E;
}
.section-title::before {
  content: '';
  width: 8rpx;
  height: 26rpx;
  background: #F26D21;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

/* 描边徽章（身份标签） */
.badge-outline {
  display: inline-block;
  padding: 2rpx 14rpx;
  border: 1rpx solid #F26D21;
  color: #F26D21;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
}

/* 页面内容容器（为自定义 tabbar 预留底部空间） */
.page-body {
  padding: 24rpx 28rpx 160rpx;
}

/* ---------- 交互动效（克制的按压反馈与过渡） ---------- */

/* 按压反馈类（配合 hover-class 使用；!important 保证覆盖页面基础样式） */
.hover-scale {
  transform: scale(0.94) !important;
  opacity: 0.85 !important;
}

.hover-bg-warm {
  background-color: #F7F3EA !important;
}

.hover-opacity {
  opacity: 0.6 !important;
}

/* 入场动画 */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* ---------- 后台管理共用（admin users / perms / teams 页；原各页逐行重复，上移共用） ---------- */

/* 班组筛选 tab（横向滚动 chips，选中态藏青底白字；.ttabs-scroll 下外边距各页自留） */
.ttabs {
  display: flex;
  gap: 16rpx;
}

.ttab {
  flex: none;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #6B7690;
  background: #FFFFFF;
  border: 1rpx solid #E3DCCB;
}

.ttab.on {
  background: #22314E;
  border-color: #22314E;
  color: #FFFFFF;
}

/* 分组标题（橙条 + 班组名 + 人数） */
.grp-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #22314E;
  margin: 16rpx 0 14rpx;
}

.grp-title::before {
  content: '';
  width: 8rpx;
  height: 24rpx;
  background: #F26D21;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.grp-cnt {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #A89F8A;
}

/* 员工行（padding 各页自留：users 24rpx 28rpx / perms 20rpx 28rpx） */
.u-item {
  display: flex;
  align-items: center;
  transition: background-color 0.15s ease;
}

.u-item + .u-item {
  border-top: 1rpx solid #F0EBDD;
}

/* 弹层头部与表单字段（users / teams 弹层共用；.sheet/.f-item/.sh-foot/.btn-primary 与其他分包
   同名类取值或声明覆盖范围不一，留在各页 wxss，不上移，避免串样式） */
.sh-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.sh-title {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.sh-sub {
  margin-left: 14rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #A89F8A;
}

.sh-close {
  margin-left: auto;
  padding: 6rpx;
}

.f-label {
  font-size: 22rpx;
  color: #6B7690;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.f-field {
  background: #F4F1EA;
  border-radius: 12rpx;
  padding: 0 16rpx;
}

.sh-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #A89F8A;
  line-height: 1.8;
}

.btn-disabled {
  opacity: 0.6;
}
