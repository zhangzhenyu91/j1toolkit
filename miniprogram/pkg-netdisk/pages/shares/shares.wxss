/* 团队网盘 · 分享管理（设计稿 design/小程序-团队网盘.html 屏④；
   颜色一律走 app.wxss --app-* 语义变量，深色随系统；弱化占位 #C9CDD4 无对应 token，
   浅色保持定稿值、深色单独覆盖） */

.page-body {
  padding-bottom: 60rpx;
}

/* 入场：编排式上浮（keyframes fadeUp 在全局 app.wxss） */
.a {
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  animation-delay: var(--d, 0s);
}

/* ---------- 分段（我创建的 / 全部（班管）） ---------- */
.seg2 {
  display: flex;
  height: 64rpx;
  padding: 4rpx;
  background: var(--app-border);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.seg2 .seg {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: var(--app-text-secondary);
  transition:
    background-color 0.15s ease,
    color 0.15s ease;
}

.seg2 .seg.on {
  background: var(--app-bg-card);
  color: var(--app-brand);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

/* ---------- 班管提示条（浅蓝底 + 左色条，直角） ---------- */
.notice {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--app-brand-light);
  border-left: 6rpx solid var(--app-brand);
  padding: 16rpx 20rpx;
  font-size: 23rpx;
  color: var(--app-text-secondary);
  margin-bottom: 20rpx;
}

/* ---------- 分享卡片 ---------- */
.shcard {
  overflow: hidden;
  margin-bottom: 24rpx;
}

.sc-body {
  padding: 24rpx 28rpx 0;
}

.sc-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 图标块：文件夹线性图标 / 类型字母块（浅蓝底 + 品牌色字/图标，随主题） */
.ficon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 20rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fletter {
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--app-brand);
}

/* 真实文件类型 PNG 图标（无底块直落；加载失败回退 .ficon 线性文件夹/字母块） */
.ficon-img {
  width: 80rpx;
  height: 80rpx;
  flex: none;
}

.sc-name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sc-top .st-tag {
  margin-left: auto;
  flex: none;
}

.sc-sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  line-height: 1.7;
  font-variant-numeric: tabular-nums;
}

/* 卡底操作行（复制链接蓝 / 停用 / 重新启用蓝 / 删除红） */
.sc-ops {
  margin-top: 20rpx;
  display: flex;
  border-top: 1rpx solid var(--app-border);
}

.sc-ops .op {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 0 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--app-text-secondary);
  transition: opacity 0.15s ease;
}

.sc-ops .op + .op {
  border-left: 1rpx solid var(--app-border);
}

.sc-ops .op.blue {
  color: var(--app-brand);
}

.sc-ops .op.danger {
  color: var(--app-danger);
}

/* ---------- 空态（虚线占位） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed #c9cdd4;
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
}

/* ---------- t-icon 外部样式类（size 属性写内联 rpx 会随屏宽膨胀，改由 t-class 控制字号；
   操作图标色经 .op/.blue/.danger 父级颜色继承，不在 color 属性传值） ---------- */
.ico-26 {
  font-size: 26rpx;
}

.ico-28 {
  font-size: 28rpx;
}

.ico-38 {
  font-size: 38rpx;
}

.ico-brand {
  color: var(--app-brand);
}

/* 弱化占位（#C9CDD4 无 --app-* 对应 token：浅色保持定稿值，深色随系统） */
@media (prefers-color-scheme: dark) {
  .empty-box {
    border-color: #626d7d;
  }
}
