<!-- 团队网盘 · 空间浏览主页（app_key netdisk；设计稿 design/小程序-团队网盘.html 屏①②③）
     空间分段 + ⋯ 菜单（胶囊占位落在分段行右端）+ 搜索（当前空间）+ 面包屑 + 单卡多行文件列表 + FAB 分片上传；
     文件 ⋯ 唤起底部操作面板；分享走底部弹层（有效期分段 + 提取码自动生成） -->
<wide-shell active="netdisk">
  <navbar back title="团队网盘" />

  <view class="page-body">
    <!-- 空间分段（有公共区时显示，公共区带班组名；无公共区隐藏只用我的空间）+ ⋯ 菜单（分享管理 / 新建文件夹） -->
    <view class="seg-row a" style="--d: 0.04s">
      <view class="seg2" wx:if="{{hasPublic}}">
        <view
          wx:for="{{spaces}}"
          wx:key="key"
          class="seg {{space === item.key ? 'on' : ''}}"
          data-key="{{item.key}}"
          hover-class="hover-opacity"
          bindtap="onSpaceTap"
          ><text class="seg-t">{{item.label}}</text></view
        >
      </view>
      <view class="more-btn" hover-class="hover-opacity" bindtap="onMenuTap">
        <t-icon t-class="ico-40 ico-sub" name="more" />
      </view>
      <view class="menu-drop" wx:if="{{menuOpen}}">
        <view class="menu-opt" hover-class="hover-bg-warm" bindtap="onMenuShares">
          <t-icon t-class="ico-32 ico-sub" name="link" />分享管理
        </view>
        <view class="menu-opt" hover-class="hover-bg-warm" bindtap="onMenuMkdir">
          <t-icon t-class="ico-32 ico-sub" name="folder-add" />新建文件夹
        </view>
      </view>
    </view>
    <view class="menu-mask" wx:if="{{menuOpen}}" bindtap="onMenuClose"></view>

    <!-- 搜索框（常置浅灰底；点击展开搜索态） -->
    <view
      class="search a"
      style="--d: 0.1s"
      wx:if="{{!searching}}"
      hover-class="hover-opacity"
      bindtap="onSearchTap"
    >
      <t-icon t-class="ico-30 ico-weak" name="search" />
      <text class="s-ph">搜索{{spaceName}}文件名</text>
    </view>
    <view class="search a" style="--d: 0.1s" wx:else>
      <t-icon t-class="ico-30 ico-weak" name="search" />
      <input
        class="s-input"
        value="{{kw}}"
        focus
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
        placeholder="输入文件名关键词"
        placeholder-class="ph"
      />
      <text class="s-cancel" hover-class="hover-opacity" bindtap="onSearchCancel">取消</text>
    </view>

    <!-- 浏览态：面包屑 + 文件列表 -->
    <block wx:if="{{!searching}}">
      <view class="crumb a" style="--d: 0.16s">
        <block wx:for="{{crumbs}}" wx:key="path">
          <text
            wx:if="{{!item.last}}"
            class="cr-link"
            data-path="{{item.path}}"
            hover-class="hover-opacity"
            bindtap="onCrumbTap"
            >{{item.name}}</text
          >
          <text wx:else class="cr-cur">{{item.name}}</text>
          <text wx:if="{{!item.last}}" class="cr-sep">/</text>
        </block>
        <text class="cr-cnt">{{items.length}} 项</text>
      </view>

      <!-- 骨架屏（首屏加载） -->
      <view wx:if="{{loading}}" class="card flist a" style="--d: 0.22s">
        <view class="fl" wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this">
          <view class="sk-ic"></view>
          <view class="fmain">
            <view class="sk-l" style="width: 62%"></view>
            <view class="sk-l sm" style="width: 36%"></view>
          </view>
        </view>
      </view>

      <!-- 错误重试态 -->
      <view wx:elif="{{error}}" class="empty-box a" style="--d: 0.22s">
        <view>{{error}}</view>
        <view class="retry" hover-class="hover-opacity" bindtap="onRetry">重新加载</view>
      </view>

      <!-- 文件列表（单卡多行：上传行置顶 + 文件夹/字母块/图片缩略图行） -->
      <view wx:elif="{{items.length || uploads.length}}" class="card flist a" style="--d: 0.22s">
        <!-- 内联上传行（细进度条 + 已传/总量 + 上传中标签 + × 取消） -->
        <view class="fl" wx:for="{{uploads}}" wx:key="id">
          <view class="ficon"><t-icon t-class="ico-34" name="upload" /></view>
          <view class="fmain">
            <text class="fname">{{item.name}}</text>
            <view class="fprog"><view class="fprog-in" style="width: {{item.pct}}%;"></view></view>
            <text class="fsub"
              ><text class="em">{{item.sentText}} / {{item.sizeText}} · {{item.pct}}%</text> ·
              {{item.merging ? '合并中' : '分片上传中'}}</text
            >
          </view>
          <view class="st-tag st-info">{{item.merging ? '合并中' : '上传中'}}</view>
          <view
            class="fx"
            hover-class="hover-opacity"
            catchtap="onCancelUpload"
            data-id="{{item.id}}"
          >
            <t-icon t-class="ico-28 ico-weak" name="close" />
          </view>
        </view>
        <!-- 文件/文件夹行（真实类型图标，加载失败回退线性文件夹/字母块；图片保持缩略图直引） -->
        <view
          class="fl"
          wx:for="{{items}}"
          wx:key="name"
          data-item="{{item}}"
          hover-class="hover-bg-warm"
          bindtap="onRowTap"
        >
          <block wx:if="{{item.isDir}}">
            <image
              wx:if="{{!item.iconFail}}"
              class="ficon-img"
              src="{{item.icon}}"
              data-list="items"
              data-index="{{index}}"
              binderror="onIconErr"
            />
            <view wx:else class="ficon"><t-icon t-class="ico-38" name="folder" /></view>
          </block>
          <image
            wx:elif="{{item.isImg && !item.thumbFail}}"
            class="fthumb"
            src="{{item.thumb}}"
            mode="aspectFill"
            lazy-load
            data-list="items"
            data-index="{{index}}"
            binderror="onThumbErr"
          />
          <block wx:else>
            <image
              wx:if="{{!item.iconFail}}"
              class="ficon-img"
              src="{{item.icon}}"
              data-list="items"
              data-index="{{index}}"
              binderror="onIconErr"
            />
            <view wx:else class="ficon"><text class="fletter">{{item.letter}}</text></view>
          </block>
          <view class="fmain">
            <text class="fname">{{item.name}}</text>
            <text class="fsub">{{item.sub}}</text>
          </view>
          <view class="fmore" hover-class="hover-opacity" catchtap="onRowMore" data-item="{{item}}">
            <t-icon t-class="ico-34 ico-weak" name="more" />
          </view>
        </view>
      </view>

      <!-- 空态 -->
      <view wx:else class="empty-box a" style="--d: 0.22s">文件夹为空，点右下角上传文件</view>
    </block>

    <!-- 搜索态：结果列表 + 所在目录 -->
    <block wx:else>
      <view class="s-hint" wx:if="{{searchState === 'idle'}}"
        >按文件名搜索，范围：{{spaceName}}</view
      >
      <view class="s-hint" wx:elif="{{searchState === 'loading'}}">搜索中…</view>
      <block wx:else>
        <view class="s-hint" wx:if="{{searchItems.length}}"
          >共 {{searchTotal}} 个结果{{searchTotal > searchItems.length ? '，仅显示前 ' +
          searchItems.length + ' 条' : ''}}</view
        >
        <view class="card flist" wx:if="{{searchItems.length}}">
          <view
            class="fl"
            wx:for="{{searchItems}}"
            wx:key="fullPath"
            data-item="{{item}}"
            hover-class="hover-bg-warm"
            bindtap="onSearchRowTap"
          >
            <block wx:if="{{item.isDir}}">
              <image
                wx:if="{{!item.iconFail}}"
                class="ficon-img"
                src="{{item.icon}}"
                data-list="searchItems"
                data-index="{{index}}"
                binderror="onIconErr"
              />
              <view wx:else class="ficon"><t-icon t-class="ico-38" name="folder" /></view>
            </block>
            <image
              wx:elif="{{item.isImg && !item.thumbFail}}"
              class="fthumb"
              src="{{item.thumb}}"
              mode="aspectFill"
              lazy-load
              data-list="searchItems"
              data-index="{{index}}"
              binderror="onThumbErr"
            />
            <block wx:else>
              <image
                wx:if="{{!item.iconFail}}"
                class="ficon-img"
                src="{{item.icon}}"
                data-list="searchItems"
                data-index="{{index}}"
                binderror="onIconErr"
              />
              <view wx:else class="ficon"><text class="fletter">{{item.letter}}</text></view>
            </block>
            <view class="fmain">
              <text class="fname">{{item.name}}</text>
              <text class="fsub">{{item.sub}}</text>
            </view>
          </view>
        </view>
        <view class="empty-box" wx:else>未找到匹配「{{kw}}」的文件</view>
      </block>
    </block>
  </view>

  <!-- FAB（上传） -->
  <view class="fab" wx:if="{{!searching}}" hover-class="hover-opacity" bindtap="onPickFiles">
    <t-icon t-class="ico-46" name="cloud-upload" />
  </view>

  <!-- 上传来源选择（相册 / 聊天文件；自绘弹层不用 t-action-sheet——仅分包使用会触发主包冗余 JS 审计警告，同出工日志口径） -->
  <t-popup
    visible="{{pickOpen}}"
    placement="{{isWide ? 'center' : 'bottom'}}"
    bind:visible-change="onPickVisibleChange"
  >
    <view class="sheet">
      <view class="grab"></view>
      <view class="sheet-title">上传文件</view>
      <view class="picksrc" hover-class="hover-bg-warm" bindtap="onPickMedia">
        <t-icon t-class="ico-44 ico-brand" name="file-image" />
        <view class="ps-c">
          <view class="ps-t">从相册选择</view>
          <view class="ps-n">图片 / 视频</view>
        </view>
      </view>
      <view class="picksrc" hover-class="hover-bg-warm" bindtap="onPickChat">
        <t-icon t-class="ico-44 ico-brand" name="chat" />
        <view class="ps-c">
          <view class="ps-t">从聊天选取</view>
          <view class="ps-n">任意类型文件</view>
        </view>
      </view>
      <view class="picksrc-cancel" hover-class="hover-opacity" bindtap="onPickSheetClose"
        >取 消</view
      >
    </view>
  </t-popup>

  <!-- 文件操作面板（屏②：底部弹层；重命名/删除按 manageable 显隐） -->
  <t-popup
    visible="{{sheet.open}}"
    placement="{{isWide ? 'center' : 'bottom'}}"
    bind:visible-change="onSheetVisibleChange"
  >
    <view class="sheet" wx:if="{{sheet.item}}">
      <view class="grab"></view>
      <view class="ash-head">
        <view class="ficon" wx:if="{{sheet.item.isDir}}">
          <t-icon t-class="ico-38" name="folder" />
        </view>
        <view class="ficon" wx:else><text class="fletter">{{sheet.item.letter}}</text></view>
        <view class="fmain">
          <text class="fname">{{sheet.item.name}}</text>
          <text class="fsub">{{sheet.item.sub}}</text>
        </view>
      </view>
      <scroll-view scroll-y class="sheet-body" enhanced show-scrollbar="{{false}}">
        <view
          class="ac"
          wx:if="{{!sheet.item.isDir}}"
          hover-class="hover-bg-warm"
          bindtap="onOpPreview"
        >
          <t-icon t-class="ico-36 ico-sub" name="browse" />预览（微信内打开）
        </view>
        <view
          class="ac"
          wx:if="{{!sheet.item.isDir}}"
          hover-class="hover-bg-warm"
          bindtap="onOpDownload"
        >
          <t-icon t-class="ico-36 ico-sub" name="download" />下载
        </view>
        <!-- 压缩包专属：查看包内内容 / 解压到当前目录 -->
        <view
          class="ac"
          wx:if="{{!sheet.item.isDir && sheet.item.isArchive}}"
          hover-class="hover-bg-warm"
          bindtap="onOpArchiveView"
        >
          <t-icon t-class="ico-36 ico-sub" name="folder-zip" />查看压缩包
        </view>
        <view
          class="ac"
          wx:if="{{!sheet.item.isDir && sheet.item.isArchive}}"
          hover-class="hover-bg-warm"
          bindtap="onOpDecompress"
        >
          <t-icon t-class="ico-36 ico-sub" name="folder-export" />解压到当前目录
        </view>
        <view class="ac blue" hover-class="hover-bg-warm" bindtap="onOpShare">
          <t-icon t-class="ico-36" name="share" />分享
        </view>
        <view class="ac" wx:if="{{manageable}}" hover-class="hover-bg-warm" bindtap="onOpMove">
          <t-icon t-class="ico-36 ico-sub" name="folder-move" />移动
        </view>
        <view class="ac" hover-class="hover-bg-warm" bindtap="onOpCopy">
          <t-icon t-class="ico-36 ico-sub" name="file-copy" />复制
        </view>
        <view class="ac" wx:if="{{manageable}}" hover-class="hover-bg-warm" bindtap="onOpRename">
          <t-icon t-class="ico-36 ico-sub" name="edit" />重命名
        </view>
        <view
          class="ac danger"
          wx:if="{{manageable}}"
          hover-class="hover-bg-warm"
          bindtap="onOpDelete"
        >
          <t-icon t-class="ico-36" name="delete" />删除
        </view>
      </scroll-view>
      <view class="sh-cancel" hover-class="hover-opacity" bindtap="closeSheet">取消</view>
    </view>
  </t-popup>

  <!-- 名称输入弹层（新建文件夹 / 重命名共用；键盘弹起时动态抬高底部 padding，同 safeday 弹层族） -->
  <t-popup
    visible="{{nameSheet.open}}"
    placement="{{isWide ? 'center' : 'bottom'}}"
    bind:visible-change="onNameVisibleChange"
  >
    <view
      class="sheet"
      style="padding-bottom: {{keyboardHeight ? keyboardHeight + 'px' : (isTablet ? 'calc(20px + env(safe-area-inset-bottom))' : 'calc(40rpx + env(safe-area-inset-bottom))')}};"
    >
      <view class="grab"></view>
      <view class="sheet-title">{{nameSheet.mode === 'mkdir' ? '新建文件夹' : '重命名'}}</view>
      <view class="sheet-sub"
        >{{nameSheet.mode === 'mkdir' ? '在当前目录下新建文件夹' : '输入新的名称'}}</view
      >
      <input
        class="name-input"
        value="{{nameSheet.value}}"
        bindinput="onNameInput"
        adjust-position="{{false}}"
        bindkeyboardheightchange="onKeyboardHeight"
        hold-keyboard
        maxlength="200"
        placeholder="名称"
        placeholder-class="ph"
      />
      <view class="sheet-ops">
        <view
          class="btn-ghost {{nameSheet.saving ? 'disabled' : ''}}"
          hover-class="hover-opacity"
          bindtap="onNameCancel"
          >取消</view
        >
        <view
          class="btn-accent {{nameSheet.saving ? 'disabled' : ''}}"
          hover-class="hover-opacity"
          bindtap="onNameSave"
        >
          {{nameSheet.saving ? '保存中…' : '确定'}}
        </view>
      </view>
    </view>
  </t-popup>

  <!-- 创建分享弹层（屏③：文件摘要 + 有效期分段 + 提取码自动生成可刷新 + 说明条 + 主按钮） -->
  <t-popup
    visible="{{shareSheet.open}}"
    placement="{{isWide ? 'center' : 'bottom'}}"
    bind:visible-change="onShareVisibleChange"
  >
    <view class="sheet" wx:if="{{shareSheet.item}}">
      <view class="grab"></view>
      <view class="sh-title">
        <text class="sh-title-t">创建分享</text>
        <view class="sh-close" hover-class="hover-opacity" bindtap="onShareCancel">
          <t-icon t-class="ico-32 ico-weak" name="close" />
        </view>
      </view>
      <view class="sh-body">
        <view class="fl sum">
          <image
            wx:if="{{!shareSheet.item.iconFail}}"
            class="ficon-img"
            src="{{shareSheet.item.icon}}"
            data-list="shareSheet.item"
            binderror="onIconErr"
          />
          <view wx:elif="{{shareSheet.item.isDir}}" class="ficon">
            <t-icon t-class="ico-38" name="folder" />
          </view>
          <view wx:else class="ficon"><text class="fletter">{{shareSheet.item.letter}}</text></view>
          <view class="fmain">
            <text class="fname">{{shareSheet.item.name}}</text>
            <text class="fsub">已选 1 项 · {{shareSheet.item.sizeText}}</text>
          </view>
        </view>
        <view class="kv">
          <view class="kv-lab">有效期</view>
          <view class="mini-seg">
            <view
              wx:for="{{expireOpts}}"
              wx:key="days"
              class="seg {{shareSheet.days === item.days ? 'on' : ''}}"
              data-days="{{item.days}}"
              hover-class="hover-opacity"
              bindtap="onShareDaysTap"
              >{{item.text}}</view
            >
          </view>
        </view>
        <view class="kv">
          <view class="kv-lab">提取码（自动生成，可刷新）</view>
          <view class="codebox">
            <view class="cd">{{shareSheet.code}}</view>
            <view class="rf" hover-class="hover-opacity" bindtap="onShareCodeRefresh">
              <t-icon t-class="ico-32 ico-sub" name="refresh" />
            </view>
          </view>
        </view>
        <view class="sh-note"
          >外部人员凭链接 + 提取码访问；链接经 Shade 中转，对方无需登录、无需安装。</view
        >
        <view
          class="btn-primary {{shareSheet.saving ? 'disabled' : ''}}"
          hover-class="hover-opacity"
          bindtap="onShareCreate"
        >
          {{shareSheet.saving ? '正在创建…' : '生成分享链接'}}
        </view>
      </view>
    </view>
  </t-popup>

  <!-- 目标位置选择弹层（移动 / 复制：空间分段 + 面包屑 + 仅文件夹列表 + 主按钮） -->
  <t-popup
    visible="{{picker.open}}"
    placement="{{isWide ? 'center' : 'bottom'}}"
    bind:visible-change="onPickerVisibleChange"
  >
    <view class="sheet" wx:if="{{picker.item}}">
      <view class="grab"></view>
      <view class="sheet-title">{{picker.mode === 'move' ? '移动到…' : '复制到…'}}</view>
      <view class="sheet-sub">为「{{picker.item.name}}」选择目标位置</view>
      <view class="pk-body">
        <view class="seg2 pk-seg" wx:if="{{hasPublic}}">
          <view
            wx:for="{{spaces}}"
            wx:key="key"
            class="seg {{picker.space === item.key ? 'on' : ''}}"
            data-key="{{item.key}}"
            hover-class="hover-opacity"
            bindtap="onPickerSpaceTap"
            ><text class="seg-t">{{item.label}}</text></view
          >
        </view>
        <view class="crumb pk-crumb">
          <block wx:for="{{pickerCrumbs}}" wx:key="path">
            <text
              wx:if="{{!item.last}}"
              class="cr-link"
              data-path="{{item.path}}"
              hover-class="hover-opacity"
              bindtap="onPickerCrumbTap"
              >{{item.name}}</text
            >
            <text wx:else class="cr-cur">{{item.name}}</text>
            <text wx:if="{{!item.last}}" class="cr-sep">/</text>
          </block>
        </view>
        <scroll-view scroll-y class="pk-list">
          <view wx:if="{{picker.loading}}" class="pk-empty">目录加载中…</view>
          <view wx:elif="{{picker.error}}" class="pk-empty">{{picker.error}}</view>
          <view wx:elif="{{!picker.dirs.length}}" class="pk-empty">该目录下没有子文件夹</view>
          <block wx:else>
            <view
              class="pk-dir"
              wx:for="{{picker.dirs}}"
              wx:key="name"
              data-name="{{item.name}}"
              hover-class="hover-bg-warm"
              bindtap="onPickerDirTap"
            >
              <image
                wx:if="{{!item.iconFail}}"
                class="ficon-img pk-icon"
                src="{{item.icon}}"
                data-list="picker.dirs"
                data-index="{{index}}"
                binderror="onIconErr"
              />
              <t-icon wx:else t-class="ico-36 ico-brand" name="folder" />
              <text class="pk-name">{{item.name}}</text>
              <t-icon t-class="ico-30" name="chevron-right" color="#C9CDD4" />
            </view>
          </block>
        </scroll-view>
        <view
          class="btn-primary {{(picker.saving || picker.loading || picker.error) ? 'disabled' : ''}}"
          hover-class="hover-opacity"
          bindtap="onPickerConfirm"
        >
          {{picker.saving ? '处理中…' : (picker.mode === 'move' ? '移动到此处' : '复制到此处')}}
        </view>
      </view>
    </view>
  </t-popup>

  <t-dialog id="t-dialog" />
  <t-toast id="t-toast" />
</wide-shell>
