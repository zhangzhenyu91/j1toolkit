/* 团队网盘 · 空间浏览主页（设计稿 design/小程序-团队网盘.html 屏①②③；
   颜色一律走 app.wxss --app-* 语义变量（深色随系统）；警示提示块一律直角；
   弱化占位灰 var(--app-text-placeholder) 无对应 token，浅色保持定稿值、深色单独覆盖 */

.page-body {
  padding-bottom: 200rpx;
}

/* 入场：编排式上浮（时延链 ≤0.9s，缓动与设计稿一致；keyframes fadeUp 在全局 app.wxss） */
.a {
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  animation-delay: var(--d, 0s);
}

/* ---------- 空间分段 + ⋯ 菜单 ---------- */
.seg-row {
  position: relative;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.seg2,
.mini-seg {
  display: flex;
  height: 64rpx;
  padding: 4rpx;
  background: var(--app-border);
  border-radius: 16rpx;
}

.seg2 {
  flex: 1;
}

.seg2 .seg,
.mini-seg .seg {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: var(--app-text-secondary);
  transition:
    background-color 0.15s ease,
    color 0.15s ease;
}

/* 分段文案内层节点：承载长班组名省略（按钮本体保持 flex 水平+垂直居中） */
.seg2 .seg-t {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seg2 .seg.on,
.mini-seg .seg.on {
  background: var(--app-bg-card);
  color: var(--app-brand);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.more-btn {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  margin-left: auto; /* 无公共区分段隐藏时，⋯ 按钮仍靠右 */
  border-radius: 16rpx;
  background: var(--app-bg-card);
  box-shadow: var(--app-shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ⋯ 下拉菜单（锚在分段行右端下方；遮罩点空白收起） */
@keyframes menu-in {
  from {
    opacity: 0;
    transform: translateY(-6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.menu-drop {
  position: absolute;
  top: 76rpx;
  right: 0;
  z-index: 31;
  min-width: 280rpx;
  background: var(--app-bg-card);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  padding: 12rpx;
  animation: menu-in 0.2s ease-out;
}

.menu-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  transition: background-color 0.15s ease;
}

.menu-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}

/* ---------- 搜索框（常置浅灰底） ---------- */
.search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--app-bg-nested);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.s-ph {
  font-size: 25rpx;
  color: var(--app-text-tertiary);
}

.s-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  color: var(--app-text-primary);
}

.s-cancel {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--app-brand);
  padding-left: 16rpx;
  transition: opacity 0.15s ease;
}

.ph {
  color: var(--app-text-placeholder);
}

.s-hint {
  margin: 8rpx 4rpx 20rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

/* ---------- 面包屑（父级蓝字可点，末级当前加粗） ---------- */
.crumb {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  padding: 0 4rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.cr-link {
  flex: none;
  color: var(--app-brand);
  font-weight: 600;
  transition: opacity 0.15s ease;
}

.cr-sep {
  flex: none;
  color: var(--app-text-tertiary);
}

.cr-cur {
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr-cnt {
  margin-left: auto;
  flex: none;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  font-variant-numeric: tabular-nums;
}

/* ---------- 文件列表（单卡多行） ---------- */
.flist {
  overflow: hidden;
}

.fl {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.fl + .fl {
  border-top: 1rpx solid var(--app-border);
}

/* 图标块：文件夹线性图标 / 类型字母块（浅蓝底 + 品牌色字/图标，随主题） */
.ficon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 20rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fletter {
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--app-brand);
}

/* 真实文件类型 PNG 图标（无底块直落；加载失败回退 .ficon 线性文件夹/字母块） */
.ficon-img {
  width: 80rpx;
  height: 80rpx;
  flex: none;
}

.fthumb {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 16rpx;
  background: var(--app-brand-light);
}

.fmain {
  flex: 1;
  min-width: 0;
}

.fname {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fsub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fsub .em {
  color: var(--app-brand);
  font-weight: 600;
}

.fmore,
.fx {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 上传中内联行：细进度条 */
.fprog {
  margin-top: 12rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--app-border);
  overflow: hidden;
}

.fprog-in {
  height: 100%;
  border-radius: 4rpx;
  background: var(--app-brand);
  transition: width 0.3s ease;
}

/* ---------- 骨架屏 ---------- */
.sk-ic {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 20rpx;
  background: var(--app-bg-nested);
}

.sk-l {
  height: 26rpx;
  border-radius: 8rpx;
  background: var(--app-bg-nested);
}

.sk-l.sm {
  margin-top: 14rpx;
  height: 20rpx;
}

@keyframes sk-pulse {
  from {
    opacity: 0.45;
  }
  to {
    opacity: 1;
  }
}

.sk-ic,
.sk-l {
  animation: sk-pulse 1.1s ease-in-out infinite alternate;
}

/* ---------- FAB（上传，每页主按钮至多一枚；品牌底前景走 --app-on-brand，图标继承） ---------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  z-index: 25;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(14, 61, 168, 0.35);
}

/* ---------- 底部弹层（顶部圆角 + 抓手；头/体/脚三段 flex，整体限高 + overflow:hidden，
   内容体 flex:1 1 auto 独立滚动，头脚 flex:none 不收缩） ---------- */
.sheet {
  background: var(--app-bg-card);
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

/* 弹层内非体块默认不参与收缩（抓手/头部/操作/脚），体块（scroll-view 或 .sheet-body）独占剩余空间并滚动 */
.sheet > view {
  flex: none;
}

.sheet > scroll-view,
.sheet > .sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* 弹层内容体（flex-basis 用 auto：0 基准会把自适应高度弹层内容压没） */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角隐形关闭热区（closeBtn 未启用仍可点）：置空防误关 */
.t-popup__close {
  display: none;
}

.grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--app-border);
  margin: 16rpx auto 8rpx;
}

/* 操作面板头部（文件摘要） */
.ash-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx 24rpx;
  border-bottom: 1rpx solid var(--app-border);
}

/* 操作行 */
.ac {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 0 32rpx;
  height: 96rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--app-text-primary);
  transition: background-color 0.15s ease;
}

.ac + .ac {
  border-top: 1rpx solid var(--app-bg-nested);
}

.ac.blue {
  color: var(--app-brand);
  font-weight: 600;
}

.ac.danger {
  color: var(--app-danger);
}

.sh-cancel {
  margin: 24rpx 24rpx 0;
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--app-bg-nested);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--app-text-secondary);
  transition: opacity 0.15s ease;
}

/* 名称输入弹层 */
.sheet-title {
  padding: 24rpx 32rpx 0;
  font-size: 31rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

/* ---------- 上传来源选择层（相册 / 聊天文件，同出工日志 addsheet 口径） ---------- */
.picksrc {
  margin: 24rpx 32rpx 0;
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 26rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: background-color 0.15s ease;
}

.ps-c {
  flex: 1;
  min-width: 0;
}

.ps-t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.ps-n {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 1rpx;
}

.picksrc-cancel {
  margin-top: 24rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--app-text-secondary);
  transition: opacity 0.15s ease;
}

.sheet-sub {
  padding: 0 32rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--app-text-tertiary);
}

.name-input {
  margin: 28rpx 32rpx 0;
  height: 84rpx;
  padding: 0 24rpx;
  background: var(--app-bg-nested);
  border-radius: 16rpx;
  font-size: 27rpx;
  color: var(--app-text-primary);
}

.sheet-ops {
  flex: none;
  margin: 32rpx 32rpx 0;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
  display: flex;
  gap: 20rpx;
}

.btn-ghost {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  background: var(--app-bg-nested);
  color: var(--app-text-secondary);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

.btn-accent {
  flex: 2;
  height: 84rpx;
  border-radius: 16rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

.btn-ghost.disabled,
.btn-accent.disabled,
.btn-primary.disabled {
  opacity: 0.5;
}

/* ---------- 创建分享弹层（屏③） ---------- */
.sh-title {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 20rpx;
}

.sh-title-t {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.sh-close {
  margin-left: auto;
  /* 可靠关闭钮：88rpx 触达区（图标居中） */
  width: 88rpx;
  height: 88rpx;
  margin: -20rpx -20rpx -20rpx auto;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

.sh-body {
  padding: 0 32rpx;
}

.fl.sum {
  padding: 8rpx 0 4rpx;
}

.kv {
  margin-top: 24rpx;
}

.kv-lab {
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  margin-bottom: 14rpx;
}

.codebox {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.codebox .cd {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  border-radius: 16rpx;
  background: var(--app-bg-nested);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: var(--app-text-primary);
  font-variant-numeric: tabular-nums;
}

.codebox .rf {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 16rpx;
  background: var(--app-bg-nested);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

/* 说明条：浅蓝底 + 左色条，直角 */
.sh-note {
  margin-top: 24rpx;
  background: var(--app-brand-light);
  border-left: 6rpx solid var(--app-brand);
  padding: 16rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--app-text-secondary);
}

.btn-primary {
  margin: 28rpx 0 0;
  height: 84rpx;
  border-radius: 16rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: opacity 0.15s ease;
}

/* ---------- 空态 / 错误重试（虚线占位） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed var(--app-text-placeholder);
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
}

.empty-box .retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 10rpx 40rpx;
  border-radius: 12rpx;
  background: var(--app-text-primary);
  color: var(--app-bg-card);
  font-size: 24rpx;
  transition: opacity 0.15s ease;
}

/* ---------- 目标位置选择弹层（移动 / 复制） ---------- */
/* pk-body 即弹层内容体：内部纵列，文件夹列表占剩余空间独立滚动，主按钮固定在体底部 */
.sheet > .pk-body {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-height: 0;
  padding: 24rpx 32rpx 0;
  overflow: hidden;
}

.pk-seg {
  margin-bottom: 20rpx;
}

.pk-crumb {
  padding: 0;
  margin-bottom: 12rpx;
}

.pk-list {
  flex: 1 1 auto;
  min-height: 200rpx;
  overflow-y: auto;
  overflow-x: hidden;
}

.pk-body .btn-primary {
  flex: none;
  margin-top: 20rpx;
}

.pk-dir {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-top: 1rpx solid var(--app-bg-nested);
  transition: background-color 0.15s ease;
}

.pk-icon {
  width: 48rpx;
  height: 48rpx;
}

.pk-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pk-empty {
  padding: 64rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--app-text-tertiary);
}

/* ---------- t-icon 外部样式类（size 属性写内联 rpx 会随屏宽膨胀，改由 t-class 控制字号；
   图标色不经 color 属性传 var()，经 t-class/父级颜色继承，随 --app-* 深浅） ---------- */
.ico-28 {
  font-size: 28rpx;
}

.ico-30 {
  font-size: 30rpx;
}

.ico-32 {
  font-size: 32rpx;
}

.ico-34 {
  font-size: 34rpx;
}

.ico-36 {
  font-size: 36rpx;
}

.ico-38 {
  font-size: 38rpx;
}

.ico-40 {
  font-size: 40rpx;
}

.ico-44 {
  font-size: 44rpx;
}

.ico-46 {
  font-size: 46rpx;
}

.ico-brand {
  color: var(--app-brand);
}

.ico-sub {
  color: var(--app-text-secondary);
}

.ico-weak {
  color: var(--app-text-tertiary);
}

/* 弱化占位（var(--app-text-placeholder) 无 --app-* 对应 token：浅色保持定稿值，深色随系统） */
@media (prefers-color-scheme: dark) {

  .empty-box {
    border-color: #626d7d;
  }
}
