/* 团队网盘 · 空间浏览主页（设计稿 design/小程序-团队网盘.html 屏①②③；
   token 硬编码：蓝 #0E3DA8 / 深蓝 #0A3592 / 浅蓝底 #E8F0FF / 底 #F5F7FA /
   文字 #1D2129 / #4E5969 / #86909C / 边 #E5E6EB；警示提示块一律直角） */

.page-body {
  padding-bottom: 200rpx;
}

/* 入场：编排式上浮（时延链 ≤0.9s，缓动与设计稿一致；keyframes fadeUp 在全局 app.wxss） */
.a {
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  animation-delay: var(--d, 0s);
}

/* ---------- 空间分段 + ⋯ 菜单 ---------- */
.seg-row {
  position: relative;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.seg2,
.mini-seg {
  display: flex;
  height: 64rpx;
  padding: 4rpx;
  background: #E5E6EB;
  border-radius: 16rpx;
}

.seg2 {
  flex: 1;
}

.seg2 .seg,
.mini-seg .seg {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: #4E5969;
}

/* 分段文案内层节点：承载长班组名省略（按钮本体保持 flex 水平+垂直居中） */
.seg2 .seg-t {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seg2 .seg.on,
.mini-seg .seg.on {
  background: #FFFFFF;
  color: #0E3DA8;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.more-btn {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  margin-left: auto; /* 无公共区分段隐藏时，⋯ 按钮仍靠右 */
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ⋯ 下拉菜单（锚在分段行右端下方；遮罩点空白收起） */
@keyframes menu-in {
  from {
    opacity: 0;
    transform: translateY(-6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.menu-drop {
  position: absolute;
  top: 76rpx;
  right: 0;
  z-index: 31;
  min-width: 280rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  padding: 12rpx;
  animation: menu-in 0.2s ease-out;
}

.menu-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #1D2129;
}

.menu-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}

/* ---------- 搜索框（常置浅灰底） ---------- */
.search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.s-ph {
  font-size: 25rpx;
  color: #86909C;
}

.s-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  color: #1D2129;
}

.s-cancel {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: #0E3DA8;
  padding-left: 16rpx;
}

.ph {
  color: #C9CDD4;
}

.s-hint {
  margin: 8rpx 4rpx 20rpx;
  font-size: 22rpx;
  color: #86909C;
}

/* ---------- 面包屑（父级蓝字可点，末级当前加粗） ---------- */
.crumb {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  padding: 0 4rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.cr-link {
  flex: none;
  color: #0E3DA8;
  font-weight: 600;
}

.cr-sep {
  flex: none;
  color: #86909C;
}

.cr-cur {
  font-weight: 600;
  color: #1D2129;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr-cnt {
  margin-left: auto;
  flex: none;
  font-size: 22rpx;
  color: #86909C;
  font-variant-numeric: tabular-nums;
}

/* ---------- 文件列表（单卡多行） ---------- */
.flist {
  overflow: hidden;
}

.fl {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.fl + .fl {
  border-top: 1rpx solid #E5E6EB;
}

/* 图标块：文件夹线性图标 / 类型字母块（浅蓝底深蓝字） */
.ficon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 20rpx;
  background: #E8F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fletter {
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #0A3592;
}

/* 真实文件类型 PNG 图标（无底块直落；加载失败回退 .ficon 线性文件夹/字母块） */
.ficon-img {
  width: 80rpx;
  height: 80rpx;
  flex: none;
}

.fthumb {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 16rpx;
  background: #E8F0FF;
}

.fmain {
  flex: 1;
  min-width: 0;
}

.fname {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #1D2129;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fsub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #86909C;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fsub .em {
  color: #0E3DA8;
  font-weight: 600;
}

.fmore,
.fx {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 上传中内联行：细进度条 */
.fprog {
  margin-top: 12rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #EBEDF1;
  overflow: hidden;
}

.fprog-in {
  height: 100%;
  border-radius: 4rpx;
  background: #0E3DA8;
  transition: width 0.3s ease;
}

/* ---------- 骨架屏 ---------- */
.sk-ic {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 20rpx;
  background: #F2F3F5;
}

.sk-l {
  height: 26rpx;
  border-radius: 8rpx;
  background: #F2F3F5;
}

.sk-l.sm {
  margin-top: 14rpx;
  height: 20rpx;
}

@keyframes sk-pulse {
  from {
    opacity: 0.45;
  }
  to {
    opacity: 1;
  }
}

.sk-ic,
.sk-l {
  animation: sk-pulse 1.1s ease-in-out infinite alternate;
}

/* ---------- FAB（上传，每页主按钮至多一枚） ---------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  z-index: 25;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #0E3DA8;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(14, 61, 168, 0.35);
}

/* ---------- 底部弹层（顶部圆角 + 抓手） ---------- */
.sheet {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E5E6EB;
  margin: 16rpx auto 8rpx;
}

/* 操作面板头部（文件摘要） */
.ash-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx 24rpx;
  border-bottom: 1rpx solid #E5E6EB;
}

/* 操作行 */
.ac {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 0 32rpx;
  height: 96rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1D2129;
}

.ac + .ac {
  border-top: 1rpx solid #F7F8FA;
}

.ac.blue {
  color: #0E3DA8;
  font-weight: 600;
}

.ac.danger {
  color: #F53F3F;
}

.sh-cancel {
  margin: 24rpx 24rpx 0;
  height: 88rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #4E5969;
}

/* 名称输入弹层 */
.sheet-title {
  padding: 24rpx 32rpx 0;
  font-size: 31rpx;
  font-weight: 700;
  color: #1D2129;
}

.sheet-sub {
  padding: 0 32rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #86909C;
}

.name-input {
  margin: 28rpx 32rpx 0;
  height: 84rpx;
  padding: 0 24rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  font-size: 27rpx;
  color: #1D2129;
}

.sheet-ops {
  margin: 32rpx 32rpx 0;
  display: flex;
  gap: 20rpx;
}

.btn-ghost {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
  color: #4E5969;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-accent {
  flex: 2;
  height: 84rpx;
  border-radius: 16rpx;
  background: #0E3DA8;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost.disabled,
.btn-accent.disabled,
.btn-primary.disabled {
  opacity: 0.5;
}

/* ---------- 创建分享弹层（屏③） ---------- */
.sh-title {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 20rpx;
}

.sh-title-t {
  font-size: 31rpx;
  font-weight: 700;
  color: #1D2129;
}

.sh-close {
  margin-left: auto;
  padding: 6rpx;
}

.sh-body {
  padding: 0 32rpx;
}

.fl.sum {
  padding: 8rpx 0 4rpx;
}

.kv {
  margin-top: 24rpx;
}

.kv-lab {
  font-size: 22rpx;
  color: #86909C;
  margin-bottom: 14rpx;
}

.codebox {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.codebox .cd {
  flex: 1;
  height: 76rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: #1D2129;
  font-variant-numeric: tabular-nums;
}

.codebox .rf {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 16rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 说明条：浅蓝底 + 左色条，直角 */
.sh-note {
  margin-top: 24rpx;
  background: #E8F0FF;
  border-left: 6rpx solid #0E3DA8;
  padding: 16rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #4E5969;
}

.btn-primary {
  margin: 28rpx 0 0;
  height: 84rpx;
  border-radius: 16rpx;
  background: #0E3DA8;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 空态 / 错误重试（虚线占位） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed #C9CDD4;
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #86909C;
}

.empty-box .retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 10rpx 40rpx;
  border-radius: 12rpx;
  background: #1D2129;
  color: #FFFFFF;
  font-size: 24rpx;
}

/* ---------- 目标位置选择弹层（移动 / 复制） ---------- */
.pk-body {
  padding: 24rpx 32rpx 0;
}

.pk-seg {
  margin-bottom: 20rpx;
}

.pk-crumb {
  padding: 0;
  margin-bottom: 12rpx;
}

.pk-list {
  max-height: 44vh;
  min-height: 200rpx;
}

.pk-dir {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-top: 1rpx solid #F7F8FA;
}

.pk-icon {
  width: 48rpx;
  height: 48rpx;
}

.pk-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1D2129;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pk-empty {
  padding: 64rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #86909C;
}
