/* 团队网盘 · 压缩包预览 / 包内浏览（与主页同族：面包屑 + 单卡多行文件行 + 底部弹层密码输入；
   颜色一律走 app.wxss --app-* 语义变量，深色随系统；弱化占位 var(--app-text-placeholder) 无对应 token，
   浅色保持定稿值、深色单独覆盖） */

.page-body {
  padding-bottom: 60rpx;
}

/* 入场：编排式上浮（keyframes fadeUp 在全局 app.wxss） */
.a {
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  animation-delay: var(--d, 0s);
}

/* ---------- 面包屑（父级蓝字可点，末级当前加粗） ---------- */
.crumb {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  padding: 0 4rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.cr-link {
  flex: none;
  color: var(--app-brand);
  font-weight: 600;
  transition: opacity 0.15s ease;
}

.cr-sep {
  flex: none;
  color: var(--app-text-tertiary);
}

.cr-cur {
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr-cnt {
  margin-left: auto;
  flex: none;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  font-variant-numeric: tabular-nums;
}

/* ---------- 包内文件列表（单卡多行） ---------- */
.flist {
  overflow: hidden;
}

.fl {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.fl + .fl {
  border-top: 1rpx solid var(--app-border);
}

/* 图标块：文件夹线性图标 / 类型字母块（浅蓝底 + 品牌色字/图标，随主题） */
.ficon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 20rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fletter {
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--app-brand);
}

/* 真实文件类型 PNG 图标（无底块直落；加载失败回退 .ficon 线性文件夹/字母块） */
.ficon-img {
  width: 80rpx;
  height: 80rpx;
  flex: none;
}

.fmain {
  flex: 1;
  min-width: 0;
}

.fname {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fsub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 骨架屏 ---------- */
.sk-ic {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 20rpx;
  background: var(--app-bg-nested);
}

.sk-l {
  height: 26rpx;
  border-radius: 8rpx;
  background: var(--app-bg-nested);
}

.sk-l.sm {
  margin-top: 14rpx;
  height: 20rpx;
}

@keyframes sk-pulse {
  from {
    opacity: 0.45;
  }
  to {
    opacity: 1;
  }
}

.sk-ic,
.sk-l {
  animation: sk-pulse 1.1s ease-in-out infinite alternate;
}

/* ---------- 空态 / 错误重试（虚线占位） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed var(--app-text-placeholder);
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
}

.empty-box .retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 10rpx 40rpx;
  border-radius: 12rpx;
  background: var(--app-text-primary);
  color: var(--app-bg-card);
  font-size: 24rpx;
  transition: opacity 0.15s ease;
}

/* ---------- 底部弹层（压缩包密码输入；顶部圆角 + 抓手；头/体/脚三段 flex，
   整体限高 + overflow:hidden，内容体 flex:1 1 auto 独立滚动） ---------- */
.sheet {
  background: var(--app-bg-card);
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

/* 弹层内非体块默认不参与收缩（头/说明/控件/脚），体块（scroll-view 或 .sheet-body）独占剩余空间并滚动 */
.sheet > view {
  flex: none;
}

.sheet > scroll-view,
.sheet > .sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角隐形关闭热区（closeBtn 未启用仍可点）：置空防误关 */
.t-popup__close {
  display: none;
}

.grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--app-border);
  margin: 16rpx auto 8rpx;
}

.sheet-title {
  padding: 24rpx 32rpx 0;
  font-size: 31rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.sheet-sub {
  padding: 0 32rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--app-text-tertiary);
  line-height: 1.7;
  word-break: break-all;
}

.name-input {
  margin: 28rpx 32rpx 0;
  height: 84rpx;
  padding: 0 24rpx;
  background: var(--app-bg-nested);
  border-radius: 16rpx;
  font-size: 27rpx;
  color: var(--app-text-primary);
}

.ph {
  color: var(--app-text-placeholder);
}

.sheet-ops {
  flex: none;
  margin: 32rpx 32rpx 0;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
  display: flex;
  gap: 20rpx;
}

.btn-ghost {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  background: var(--app-bg-nested);
  color: var(--app-text-secondary);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

.btn-accent {
  flex: 2;
  height: 84rpx;
  border-radius: 16rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

.btn-ghost.disabled,
.btn-accent.disabled {
  opacity: 0.5;
}

/* ---------- t-icon 外部样式类（size 属性写内联 rpx 会随屏宽膨胀，改由 t-class 控制字号） ---------- */
.ico-30 {
  font-size: 30rpx;
}

.ico-38 {
  font-size: 38rpx;
}

/* 弱化占位（var(--app-text-placeholder) 无 --app-* 对应 token：浅色保持定稿值，深色随系统） */
@media (prefers-color-scheme: dark) {

  .empty-box {
    border-color: #626d7d;
  }
}
