{
  "pages": [
    "pages/home/home",
    "pages/login/login",
    "pages/notice/list/list",
    "pages/admin/users/users",
    "pages/admin/perms/perms",
    "pages/admin/teams/teams",
    "pages/admin/push/push"
  ],
  "subPackages": [
    {
      "root": "pkg-callme",
      "name": "callme",
      "pages": ["pages/sessions/sessions", "pages/chat/chat"]
    },
    {
      "root": "pkg-worklog",
      "name": "worklog",
      "pages": [
        "pages/index/index",
        "pages/manage/manage",
        "pages/sheet/sheet",
        "pages/sgccbind/sgccbind",
        "pages/sgccweb/sgccweb",
        "pages/dispatch/dispatch"
      ]
    },
    {
      "root": "pkg-filetransfer",
      "name": "filetransfer",
      "pages": ["pages/index/index"]
    },
    {
      "root": "pkg-safeday",
      "name": "safeday",
      "pages": ["pages/index/index"]
    },
    {
      "root": "pkg-wmadd",
      "name": "wmadd",
      "pages": ["pages/index/index"]
    },
    {
      "root": "pkg-quiz",
      "name": "quiz",
      "pages": [
        "pages/index/index",
        "pages/bank/bank",
        "pages/practice/practice",
        "pages/wrong/wrong",
        "pages/manage/manage",
        "pages/pool/pool"
      ]
    },
    {
      "root": "pkg-netdisk",
      "name": "netdisk",
      "pages": ["pages/index/index", "pages/shares/shares", "pages/archive/archive"]
    },
    {
      "root": "pkg-treehazard",
      "name": "treehazard",
      "pages": ["pages/index/index"]
    },
    {
      "root": "pkg-crossing",
      "name": "crossing",
      "pages": ["pages/index/index"]
    },
    {
      "root": "pkg-teamdata",
      "name": "teamdata",
      "pages": ["pages/index/index"]
    }
  ],
  "window": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "@navTxtStyle",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle"
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "resizable": true,
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.userLocation": {
      "desc": "出工日志添加水印照片时，用于自动填写当前位置与天气"
    }
  },
  "requiredPrivateInfos": ["getLocation"],
  "sitemapLocation": "sitemap.json"
}
