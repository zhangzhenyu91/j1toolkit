/* 安全日活动记录 · 小程序端（布局/观感同网页端 safeday.html；
   设计 token 见 AGENTS.md 第四节，卡片/弹层写法同 pkg-filetransfer） */

/* ---------- 班组切换器（屏八：超管可点 chip 下拉切换；其余角色静态班组名标签） ---------- */
.tswitch {
  position: relative;
  z-index: 20;
  margin-bottom: 20rpx;
}

.ts-cur {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  box-shadow: var(--app-shadow-card);
}

.ts-cur .arr {
  color: var(--app-brand);
  font-size: 18rpx;
}

/* 下拉入场：chip 下方轻微上浮 + 淡入（克制，同全局 fadeUp/fadeIn 风格）；收起直消不加动画 */
.ts-drop {
  position: absolute;
  top: 76rpx;
  left: 0;
  z-index: 21;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  box-shadow: var(--app-shadow-card);
  padding: 12rpx;
  min-width: 300rpx;
  max-width: 600rpx; /* 上限兜底：超长班组名由 .ts-opt 内文案省略，浮层不撑出屏外 */
  animation: ts-drop-in 0.2s ease-out;
}

.ts-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
}

/* 主文案左对齐 + 超长省略（.ck 勾选由 margin-left:auto 右置） */
.ts-opt > text:first-of-type {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

.ts-opt.on {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.ts-opt .ck {
  margin-left: auto;
  font-size: 22rpx;
}

/* 点空白处收起下拉（层级低于切换器本体）；遮罩淡入 */
.ts-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  animation: ts-mask-in 0.15s ease-out;
}

/* 记录行班组徽章（屏八 .team-pill，仅「全部班组」混排视图展示；
   字号/内边距/行高与状态标签 .tag 一致，两 pill 等高、行内垂直居中对齐） */
.team-pill {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  line-height: 1.5;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 4rpx 16rpx;
  background: var(--app-brand-light);
  color: var(--app-text-primary);
  flex: none;
}

/* ---------- 未分配班组空态（屏十） ---------- */
.team-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.team-empty .te-ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-empty .te-t {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.team-empty .te-p {
  font-size: 23rpx;
  color: var(--app-text-secondary);
  line-height: 1.8;
  text-align: center;
}

/* ---------- 上传活动文件卡 ---------- */
.up-card {
  margin-top: 20rpx;
  padding: 40rpx 32rpx 32rpx;
}

/* 选取入口（虚线区，同网页端 upzone） */
.upzone {
  border: 3rpx dashed var(--app-text-tertiary);
  border-radius: 12rpx;
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.up-ic {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.up-t {
  font-size: 28rpx;
  font-weight: 700;
}

.up-t .accent {
  color: var(--app-brand);
}

.up-p {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  line-height: 1.8;
  text-align: center;
}

/* 已选文件条（同网页端 ftag） */
.ftag {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--app-bg-nested);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}

.ftag .fn {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ftag .fs {
  flex: none;
  font-size: 21rpx;
  color: var(--app-text-tertiary);
}

.ftag .fx {
  flex: none;
  padding: 4rpx;
  color: var(--app-text-tertiary);
}

/* 活动日期行 */
.date-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}

.date-lab {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--app-text-secondary);
}

.date-val {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx; /* 日期文字与日历图标的最小间距 */
  font-size: 26rpx;
  font-weight: 600;
}

/* 生成按钮（主按钮品牌蓝底，同 filetransfer btn-primary） */
.btn-primary {
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.btn-primary.disabled {
  opacity: 0.5;
}

/* ---------- 生成进度卡 ---------- */
.prog {
  margin-top: 24rpx;
  padding: 32rpx;
}

.prog.idle {
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: var(--app-text-tertiary);
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.prog .fh {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.file-ic {
  width: 68rpx;
  height: 68rpx;
  flex: none;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.prog .fh-r {
  flex: 1;
  min-width: 0;
}

.prog .fn {
  font-size: 26rpx;
  font-weight: 700;
  word-break: break-all;
}

.prog .fs {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--app-text-tertiary);
}

/* 步骤条（同网页端 steps/step，圆点间竖线连接） */
.steps {
  margin-top: 28rpx;
}

.step {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding-bottom: 28rpx;
}

.step:last-child {
  padding-bottom: 0;
}

.step::before {
  content: '';
  position: absolute;
  left: 19rpx;
  top: 44rpx;
  bottom: 0;
  width: 4rpx;
  background: var(--app-border);
}

.step:last-child::before {
  display: none;
}

.sd-ic {
  position: relative;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--app-bg-card);
}

.step.done .sd-ic {
  background: var(--app-brand);
  color: var(--app-on-brand);
}

.step.done::before {
  background: var(--app-brand);
}

.step.doing .sd-ic {
  border: 4rpx solid var(--app-brand);
}

.step.todo .sd-ic {
  border: 4rpx solid var(--app-text-tertiary);
}

.step.fail .sd-ic {
  background: var(--app-danger);
  color: var(--app-on-brand);
}

.dot-ing {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--app-brand);
  animation: breath 1.2s ease-in-out infinite; /* 进行中指示（功能性） */
}

.step .st {
  font-size: 25rpx;
  font-weight: 700;
}

.step.todo .st {
  color: var(--app-text-tertiary);
}

.step.fail .st {
  color: var(--app-danger-text);
}

.step .ss {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--app-text-tertiary);
  line-height: 1.6;
}

/* 进度条（同网页端 pbar；宽度过渡按全局动效口径；渐变仅进度条功能性填充，非大面积装饰） */
.pbar {
  height: 12rpx;
  margin-top: 28rpx;
  border-radius: 12rpx;
  background: var(--app-border);
  overflow: hidden;
}

.pbar-in {
  position: relative;
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, var(--app-brand), #f59a5e);
  overflow: hidden;
  transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}

.pbar.fail .pbar-in {
  background: linear-gradient(90deg, var(--app-danger), #e28080);
}

.pnum {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 21rpx;
  color: var(--app-text-secondary);
}

.pnum .pct {
  font-weight: 700;
  color: var(--app-brand);
}

.pnum.fail .pct {
  color: var(--app-danger-text);
}

/* ---------- 记录列表 ---------- */
.sec-row {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
}

.cnt {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 1rpx;
}

.rec {
  margin-top: 20rpx;
  padding: 28rpx 28rpx 24rpx;
}

.rec-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.rec-head .rn {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  word-break: break-all;
}

/* 状态标签（同网页端 tag-orange / tag-navy / tag-red） */
.tag {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.5; /* 与班组徽章 .team-pill 同度量，两 pill 等高对齐 */
  font-weight: 600;
  white-space: nowrap;
}

.tag-done {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.tag-processing {
  background: var(--app-brand-light);
  color: var(--app-text-primary);
}

.tag-failed {
  background: var(--app-danger-bg);
  color: var(--app-danger-text);
}

/* 副行：源文件名 */
.rf {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: var(--app-text-tertiary);
  word-break: break-all;
}

.rmeta {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--app-text-secondary);
}

.rerr {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--app-danger-text);
  line-height: 1.6;
  word-break: break-all;
}

/* 生成失败原因前置红三角感叹号（t-icon 由 wxml 提供，三角=失败/警示语义） */
.rerr-x {
  margin-right: 6rpx;
  vertical-align: -3rpx;
  color: var(--app-danger-text);
}

/* 操作行（打开未生成置灰；删除危险色悬停态省略，保持描边徽章风） */
.ops {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--app-border);
  display: flex;
  gap: 20rpx;
}

.opb {
  flex: 1;
  height: 68rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  transition: opacity 0.15s ease;
}

.opb.off {
  border: none;
  background: var(--app-bg-page);
  color: var(--app-text-tertiary);
}

.opb .opb-ing {
  font-size: 24rpx;
  color: var(--app-text-tertiary);
}

.opb.del text {
  color: var(--app-text-secondary);
}

/* ---------- 空态/加载（同出工日志 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed var(--app-text-tertiary);
  border-radius: 12rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

/* ---------- 记录名称确认弹层（底部弹层，同出工日志弹层族；头/体/脚三段 flex，
   整体限高 + overflow:hidden，内容体 flex:1 1 auto 独立滚动） ---------- */
.sheet {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-bottom: none;
  border-radius: 12rpx;
  box-shadow: 0 -8rpx 32rpx var(--app-mask);
  padding: 36rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

.sheet-title {
  flex: none;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.sheet-sub {
  flex: none;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--app-text-secondary);
  line-height: 1.7;
}

/* 弹层内容体（flex-basis 用 auto：0 基准会把自适应高度弹层内容压没） */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* 弹层内非体块默认不参与收缩（头/说明/控件/脚），体块（scroll-view 或 .sheet-body）独占剩余空间并滚动 */
.sheet > view {
  flex: none;
}

.sheet > scroll-view,
.sheet > .sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角隐形关闭热区（closeBtn 未启用仍可点）：置空防误关 */
.t-popup__close {
  display: none;
}

.name-input {
  margin-top: 24rpx;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  font-size: 27rpx;
  color: var(--app-text-primary);
}

/* 学习内容多行编辑框（textarea）：拉高至可容纳 5 行文本（27rpx × 1.6 行高 × 5 行 ≈ 216rpx + 上下 padding） */
.name-input.name-area {
  height: 260rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.ph {
  color: var(--app-text-tertiary);
}

.sheet-ops {
  flex: none;
  margin-top: 32rpx;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
  display: flex;
  gap: 20rpx;
}

.btn-ghost {
  flex: 1;
  height: 84rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.btn-accent {
  flex: 2;
  height: 84rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.btn-ghost.disabled,
.btn-accent.disabled {
  opacity: 0.5;
}

/* ---------- 生成表单扩展字段（成员点亮 chips 互斥镜像；下拉选择行） ---------- */
.form-scroll {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.f-lab {
  margin-top: 26rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  letter-spacing: 1rpx;
}

.f-lab-sub {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--app-text-tertiary);
  letter-spacing: 0;
}

.f-2col {
  display: flex;
  gap: 20rpx;
}

.f-2col > view {
  flex: 1;
  min-width: 0;
}

/* 参会人员模式切换（名单点亮 / 自定义输入）：分段胶囊，选中蓝底 */
.mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mswitch {
  display: flex;
  padding: 4rpx;
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  background: var(--app-bg-page);
}

.ms-opt {
  padding: 6rpx 22rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--app-text-secondary);
  transition:
    background-color 0.15s ease,
    color 0.15s ease;
}

.ms-opt.on {
  background: var(--app-brand);
  color: var(--app-on-brand);
}

/* 自定义模式主持人输入框：与成员下拉（.pick-val margin-top:14rpx）对齐 */
.host-input {
  margin-top: 14rpx;
}

.pick-val {
  margin-top: 14rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  font-size: 27rpx;
  color: var(--app-text-primary);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mchips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.mchip {
  padding: 8rpx 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  font-size: 24rpx;
  color: var(--app-text-secondary);
  font-weight: 600;
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease,
    color 0.15s ease;
}

.mchip.on {
  border-color: var(--app-brand);
  background: var(--app-brand);
  color: var(--app-on-brand);
}

.mchips.absent .mchip.on {
  border-color: var(--app-danger);
  background: var(--app-danger);
}

/* ---------- 动画 ---------- */
/* 进行中单点脉冲（功能性反馈，仅 .dot-ing 一处使用） */
@keyframes breath {
  0%,
  100% {
    transform: scale(0.7);
    opacity: 0.55;
  }
  50% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 图标状态色（t-icon 不传 color，经宿主 CSS color 继承） */
.ico-brand {
  color: var(--app-brand);
}

.ico-mute {
  color: var(--app-text-tertiary);
}

.ico-danger {
  color: var(--app-danger-text);
}

/* ---------- t-icon 数值字阶（t-class 外部类；600px 起折半 px） ---------- */
.ico-20 {
  font-size: 20rpx;
}
.ico-22 {
  font-size: 22rpx;
}
.ico-26 {
  font-size: 26rpx;
}
.ico-30 {
  font-size: 30rpx;
}
.ico-34 {
  font-size: 34rpx;
}
.ico-44 {
  font-size: 44rpx;
}
.ico-48 {
  font-size: 48rpx;
}

/* ---------- iPad / 宽屏适配（CSS 媒体查询；普通手机竖屏不受影响） ----------
   600px 起限宽居中、关键字阶/控件改固定 px、表单不横溢；900px 起记录卡网格增列、弹层限宽 */
@media (min-width: 600px) {
  .page-body {
    box-sizing: border-box;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .ts-cur {
    font-size: 12.5px;
    padding: 6px 14px;
    border-radius: 6px;
    border-width: 1px;
  }

  .ts-drop {
    top: 38px;
    border-width: 1px;
    border-radius: 6px;
    padding: 6px;
  }

  .ts-opt {
    font-size: 12.5px;
    padding: 9px 12px;
    border-radius: 6px;
  }

  .team-empty .te-t {
    font-size: 15px;
  }

  .team-empty .te-p {
    font-size: 11.5px;
  }

  .up-t {
    font-size: 14px;
  }

  .up-p {
    font-size: 11px;
  }

  .ftag .fn {
    font-size: 12.5px;
  }

  .ftag .fs {
    font-size: 10.5px;
  }

  .date-lab {
    font-size: 12px;
  }

  .date-val {
    height: 36px;
    font-size: 13px;
    border-width: 1px;
    border-radius: 6px;
    padding: 0 10px;
  }

  .btn-primary {
    height: 44px;
    font-size: 15px;
    border-radius: 6px;
  }

  .prog.idle {
    font-size: 12.5px;
  }

  .prog .fn {
    font-size: 13px;
  }

  .prog .fs,
  .step .ss,
  .rf,
  .rmeta,
  .rerr,
  .cnt {
    font-size: 10.5px;
  }

  .step .st {
    font-size: 12.5px;
  }

  .rec-head .rn {
    font-size: 14px;
  }

  .opb {
    height: 34px;
    font-size: 12.5px;
    border-width: 1px;
    border-radius: 6px;
  }

  .opb .opb-ing {
    font-size: 12px;
  }

  .empty-box {
    font-size: 13px;
    border-width: 1.5px;
    border-radius: 6px;
  }

  .sheet {
    border-width: 1px;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 -4px 16px var(--app-mask);
    padding: 18px 20px 24px;
  }

  .sheet-title {
    font-size: 16px;
  }

  .sheet-sub {
    font-size: 11.5px;
  }

  .name-input {
    height: 40px;
    padding: 0 12px;
    font-size: 13.5px;
    border-width: 1px;
    border-radius: 6px;
  }

  .name-input.name-area {
    height: 130px;
    padding: 10px 12px;
  }

  .btn-ghost,
  .btn-accent {
    height: 42px;
    font-size: 14px;
    border-radius: 6px;
  }

  .f-lab {
    font-size: 12px;
  }

  .f-lab-sub {
    font-size: 10px;
  }

  .ms-opt {
    font-size: 11px;
  }

  .pick-val {
    height: 40px;
    font-size: 13.5px;
    border-width: 1px;
    border-radius: 6px;
    padding: 0 12px;
    margin-top: 7px;
  }

  .mchip {
    font-size: 12px;
    border-width: 1px;
    border-radius: 6px;
    padding: 4px 12px;
  }
  .ico-20 {
    font-size: 10px;
  }
  .ico-22 {
    font-size: 11px;
  }
  .ico-26 {
    font-size: 13px;
  }
  .ico-30 {
    font-size: 15px;
  }
  .ico-34 {
    font-size: 17px;
  }
  .ico-44 {
    font-size: 22px;
  }
  .ico-48 {
    font-size: 24px;
  }
}

@media (min-width: 900px) {
  .page-body {
    max-width: 960px;
  }

  /* 弹层限宽居中 */
  .sheet {
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
  }

  /* 记录卡两列网格 */
  .rec-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20rpx;
  }

  .rec {
    margin-top: 0;
  }
}

@media (min-width: 1200px) {
  .page-body {
    max-width: 1120px;
  }

  .sheet {
    max-width: 720px;
  }

  .rec-list {
    grid-template-columns: 1fr 1fr 1fr;
  }
}
