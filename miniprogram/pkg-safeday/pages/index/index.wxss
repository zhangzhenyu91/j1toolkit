/* 安全日活动记录 · 引导页（token 与通用类见 app.wxss） */

/* 主提示卡（警示斜纹顶条为全局 hazard-top） */
.hero {
  padding: 64rpx 32rpx 48rpx;
  text-align: center;
  animation: fadeUp 0.3s ease both;
}
.hero-icon {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto;
  border-radius: 32rpx;
  background: #FDEEE2; /* 图标浅底 */
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
}
.hero-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

/* 信息面板 */
.panel {
  margin-top: 24rpx;
  padding: 32rpx;
  animation: fadeUp 0.3s ease 0.08s both;
}
.url-box {
  margin: 24rpx 0;
  padding: 24rpx;
  background: #F7F3EA;
  border: 1rpx dashed #D9CFBA; /* 虚线占位 token */
  border-radius: 16rpx;
  text-align: center;
}
.url-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #F26D21;
  word-break: break-all;
}
.panel-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  text-align: center;
}
.note {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
}
