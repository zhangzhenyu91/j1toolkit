/* 安全日活动记录 · 小程序端（布局/观感同网页端 safeday.html；
   设计 token 见 AGENTS.md 第四节，卡片/弹层写法同 pkg-filetransfer） */

/* ---------- 班组切换器（屏八：超管可点 chip 下拉切换；其余角色静态班组名标签） ---------- */
.tswitch {
  position: relative;
  z-index: 20;
  margin-bottom: 20rpx;
}

.ts-cur {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 0;
  padding: 12rpx 28rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #111111;
  box-shadow: 6rpx 6rpx 0 #111111;
}

.ts-cur .arr {
  color: #1d4ed8;
  font-size: 18rpx;
}

/* 下拉入场：chip 下方轻微上浮 + 淡入（克制，同全局 fadeUp/fadeIn 风格）；收起直消不加动画 */
@keyframes ts-drop-in {
  from {
    opacity: 0;
    transform: translateY(-6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ts-drop {
  position: absolute;
  top: 76rpx;
  left: 0;
  z-index: 21;
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 0;
  box-shadow: 8rpx 8rpx 0 rgba(17, 17, 17, 0.9);
  padding: 12rpx;
  min-width: 300rpx;
  max-width: 600rpx; /* 上限兜底：超长班组名由 .ts-opt 内文案省略，浮层不撑出屏外 */
  animation: ts-drop-in 0.2s ease-out;
}

.ts-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 0;
  font-size: 25rpx;
  font-weight: 600;
}

/* 主文案左对齐 + 超长省略（.ck 勾选由 margin-left:auto 右置） */
.ts-opt > text:first-of-type {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

.ts-opt.on {
  background: #edf2fe;
  color: #1d4ed8;
}

.ts-opt .ck {
  margin-left: auto;
  font-size: 22rpx;
}

/* 点空白处收起下拉（层级低于切换器本体）；遮罩淡入 */
@keyframes ts-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.ts-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  animation: ts-mask-in 0.15s ease-out;
}

/* 记录行班组徽章（屏八 .team-pill，仅「全部班组」混排视图展示；
   字号/内边距/行高与状态标签 .tag 一致，两 pill 等高、行内垂直居中对齐） */
.team-pill {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  line-height: 1.5;
  font-weight: 600;
  border-radius: 0;
  padding: 4rpx 16rpx;
  background: #edf2fe;
  color: #111111;
  flex: none;
}

/* ---------- 未分配班组空态（屏十） ---------- */
.team-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.team-empty .te-ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 0;
  background: #edf2fe;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-empty .te-t {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.team-empty .te-p {
  font-size: 23rpx;
  color: #5c5748;
  line-height: 1.8;
  text-align: center;
}

/* ---------- 上传活动文件卡 ---------- */
.up-card {
  margin-top: 20rpx;
  padding: 40rpx 32rpx 32rpx;
}

/* 选取入口（虚线区，同网页端 upzone） */
.upzone {
  border: 3rpx dashed rgba(17,17,17,.35);
  border-radius: 0;
  padding: 36rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.up-ic {
  width: 96rpx;
  height: 96rpx;
  border-radius: 0;
  background: #edf2fe;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.up-t {
  font-size: 28rpx;
  font-weight: 800;
}

.up-t .accent {
  color: #1d4ed8;
}

.up-p {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(17,17,17,.4);
  line-height: 1.8;
  text-align: center;
}

/* 已选文件条（同网页端 ftag） */
.ftag {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fbf9f2;
  border: 2rpx solid #e7e1d2;
  border-radius: 0;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}

.ftag .fn {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ftag .fs {
  flex: none;
  font-size: 21rpx;
  color: rgba(17,17,17,.4);
}

.ftag .fx {
  flex: none;
  padding: 4rpx;
}

/* 活动日期行 */
.date-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}

.date-lab {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #5c5748;
}

.date-val {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx; /* 日期文字与日历图标的最小间距 */
  font-size: 26rpx;
  font-weight: 600;
}

/* 生成按钮（主按钮墨黑底，同 filetransfer btn-primary） */
.btn-primary {
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 0;
  background: #111111;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary.disabled {
  opacity: 0.5;
}

/* ---------- 生成进度卡 ---------- */
.prog {
  margin-top: 24rpx;
  padding: 32rpx;
}

.prog.idle {
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: rgba(17,17,17,.4);
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.prog .fh {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.file-ic {
  width: 68rpx;
  height: 68rpx;
  flex: none;
  border-radius: 0;
  background: #edf2fe;
  display: flex;
  align-items: center;
  justify-content: center;
}

.prog .fh-r {
  flex: 1;
  min-width: 0;
}

.prog .fn {
  font-size: 26rpx;
  font-weight: 700;
  word-break: break-all;
}

.prog .fs {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: rgba(17,17,17,.4);
}

/* 步骤条（同网页端 steps/step，圆点间竖线连接） */
.steps {
  margin-top: 28rpx;
}

.step {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding-bottom: 28rpx;
}

.step:last-child {
  padding-bottom: 0;
}

.step::before {
  content: '';
  position: absolute;
  left: 19rpx;
  top: 44rpx;
  bottom: 0;
  width: 4rpx;
  background: #e7e1d2;
}

.step:last-child::before {
  display: none;
}

.sd-ic {
  position: relative;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.step.done .sd-ic {
  background: #1d4ed8;
}

.step.done::before {
  background: #1d4ed8;
}

.step.doing .sd-ic {
  border: 4rpx solid #1d4ed8;
}

.step.todo .sd-ic {
  border: 4rpx solid rgba(17,17,17,.35);
}

.step.fail .sd-ic {
  background: #d22730;
}

.dot-ing {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1d4ed8;
  animation: breath 1.2s ease-in-out infinite;
}

.step .st {
  font-size: 25rpx;
  font-weight: 700;
}

.step.todo .st {
  color: rgba(17,17,17,.4);
}

.step.fail .st {
  color: #d22730;
}

.step .ss {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: rgba(17,17,17,.4);
  line-height: 1.6;
}

/* 进度条（流光同网页端 pbar） */
.pbar {
  height: 12rpx;
  margin-top: 28rpx;
  border-radius: 0;
  background: #e7e1d2;
  overflow: hidden;
}

.pbar-in {
  position: relative;
  height: 100%;
  border-radius: 0;
  background: linear-gradient(90deg, #1d4ed8, #f59a5e);
  overflow: hidden;
  transition: width 0.9s cubic-bezier(0.16, 1, 0.3, 1);
}

.pbar-in::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(100deg, transparent 25%, rgba(255, 255, 255, 0.55), transparent 75%);
  transform: translateX(-100%);
  animation: shimmer 1.8s ease-in-out infinite;
}

.pbar.fail .pbar-in {
  background: linear-gradient(90deg, #d22730, #e28080);
}

.pbar.fail .pbar-in::after {
  display: none;
}

.pnum {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 21rpx;
  color: #5c5748;
}

.pnum .pct {
  font-weight: 700;
  color: #1d4ed8;
}

.pnum.fail .pct {
  color: #d22730;
}

/* ---------- 记录列表 ---------- */
.sec-row {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
}

.cnt {
  margin-left: auto;
  font-size: 22rpx;
  color: rgba(17,17,17,.4);
  letter-spacing: 1rpx;
}

.rec {
  margin-top: 20rpx;
  padding: 28rpx 28rpx 24rpx;
}

.rec-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.rec-head .rn {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  word-break: break-all;
}

/* 状态标签（同网页端 tag-orange / tag-navy / tag-red） */
.tag {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 0;
  font-size: 20rpx;
  line-height: 1.5; /* 与班组徽章 .team-pill 同度量，两 pill 等高对齐 */
  font-weight: 600;
  white-space: nowrap;
}

.tag-done {
  background: #edf2fe;
  color: #1d4ed8;
}

.tag-processing {
  background: #edf2fe;
  color: #111111;
}

.tag-failed {
  background: #fbe9e9;
  color: #d22730;
}

.pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #111111;
  animation: breath 1.2s ease-in-out infinite;
}

/* 副行：源文件名 */
.rf {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: rgba(17,17,17,.4);
  word-break: break-all;
}

.rmeta {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #5c5748;
}

.rerr {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #d22730;
  line-height: 1.6;
  word-break: break-all;
}

/* 操作行（打开未生成置灰；删除危险色悬停态省略，保持描边徽章风） */
.ops {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #e7e1d2;
  display: flex;
  gap: 20rpx;
}

.opb {
  flex: 1;
  height: 68rpx;
  border-radius: 0;
  border: 4rpx solid #111111;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #111111;
}

.opb.off {
  border: none;
  background: #f8f6f1;
  color: rgba(17,17,17,.35);
}

.opb .opb-ing {
  font-size: 24rpx;
  color: rgba(17,17,17,.4);
}

.opb.del text {
  color: #5c5748;
}

/* ---------- 空态/加载（同出工日志 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed rgba(17,17,17,.35);
  border-radius: 0;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(17,17,17,.4);
  letter-spacing: 2rpx;
}

/* ---------- 记录名称确认弹层（底部弹层，同出工日志弹层族） ---------- */
.sheet {
  background: #ffffff;
  border: 4rpx solid #111111;
  border-bottom: none;
  border-radius: 0;
  box-shadow: 0 -8rpx 0 rgba(17, 17, 17, 0.9);
  padding: 36rpx 32rpx 40rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.sheet-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #5c5748;
  line-height: 1.7;
}

.name-input {
  margin-top: 24rpx;
  height: 80rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 0;
  font-size: 27rpx;
  color: #111111;
}

/* 学习内容多行编辑框（textarea）：拉高至可容纳 5 行文本（27rpx × 1.6 行高 × 5 行 ≈ 216rpx + 上下 padding） */
.name-input.name-area {
  height: 260rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.ph {
  color: rgba(17,17,17,.4);
}

.sheet-ops {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.btn-ghost {
  flex: 1;
  height: 84rpx;
  border-radius: 0;
  border: 4rpx solid #111111;
  background: #ffffff;
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-accent {
  flex: 2;
  height: 84rpx;
  border-radius: 0;
  background: #1d4ed8;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost.disabled,
.btn-accent.disabled {
  opacity: 0.5;
}

/* ---------- 生成表单扩展字段（成员点亮 chips 互斥镜像；下拉选择行） ---------- */
.form-scroll {
  max-height: 58vh;
}

.f-lab {
  margin-top: 26rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #111111;
  letter-spacing: 1rpx;
}

.f-lab-sub {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(17,17,17,.4);
  letter-spacing: 0;
}

.f-2col {
  display: flex;
  gap: 20rpx;
}

.f-2col > view {
  flex: 1;
  min-width: 0;
}

/* 参会人员模式切换（名单点亮 / 自定义输入）：分段胶囊，选中蓝底 */
.mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mswitch {
  display: flex;
  padding: 4rpx;
  border: 4rpx solid #111111;
  border-radius: 0;
  background: #f8f6f1;
}

.ms-opt {
  padding: 6rpx 22rpx;
  border-radius: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #5c5748;
}

.ms-opt.on {
  background: #1d4ed8;
  color: #ffffff;
}

/* 自定义模式主持人输入框：与成员下拉（.pick-val margin-top:14rpx）对齐 */
.host-input {
  margin-top: 14rpx;
}

.pick-val {
  margin-top: 14rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border: 4rpx solid #111111;
  border-radius: 0;
  font-size: 27rpx;
  color: #111111;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mchips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.mchip {
  padding: 8rpx 24rpx;
  border-radius: 0;
  border: 4rpx solid #111111;
  background: #ffffff;
  font-size: 24rpx;
  color: #5c5748;
  font-weight: 600;
}

.mchip.on {
  border-color: #1d4ed8;
  background: #1d4ed8;
  color: #ffffff;
}

.mchips.absent .mchip.on {
  border-color: #d22730;
  background: #d22730;
}

/* ---------- 动画 ---------- */
@keyframes breath {
  0%, 100% {
    transform: scale(0.7);
    opacity: 0.55;
  }
  50% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}
