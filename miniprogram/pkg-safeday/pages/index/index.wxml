<!-- 安全日活动记录 · 引导页（网页端应用，引导电脑浏览器访问） -->
<navbar back title="安全日活动记录" />

<view class="page-body" wx:if="{{gate}}">
  <!-- 主提示卡 -->
  <view class="card hazard-top hero">
    <view class="hero-icon">
      <t-icon name="file-safety" size="72rpx" color="#F26D21" />
    </view>
    <view class="hero-title">网页端应用</view>
    <view class="hero-desc text-sub">本应用请在电脑浏览器中访问使用，小程序内不直接打开</view>
  </view>

  <!-- 访问地址 -->
  <view class="card panel">
    <view class="section-title">访问地址</view>
    <view class="url-box">
      <text class="url-text" selectable>{{url}}</text>
    </view>
    <t-button theme="primary" block size="large" bindtap="onCopy">复制链接</t-button>
    <view class="panel-tip text-sub">复制后在电脑浏览器地址栏粘贴打开</view>
  </view>

  <!-- 登录说明 -->
  <view class="card panel">
    <view class="section-title">登录说明</view>
    <view class="note text-sub">登录账号密码与本小程序一致</view>
    <view class="note text-sub">仅限拥有「安全日活动记录」应用权限的用户登录</view>
    <view class="note text-sub">权限由管理员在「我的 → 权限管理」中开通</view>
  </view>
</view>
