/* 交跨记录（政企蓝白 token；看板/卡片/弹层口径同树障页） */

/* tdesign 组件变量 */
page {
  --td-popup-border-radius: 24rpx;
  --td-dialog-border-radius: 24rpx;
  --td-toast-radius: 8rpx;
  --td-tag-round-border-radius: 12rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* ---------- 看板四格卡（仿树障页 stats-card；本页无深蓝页首，不负边距浮层） ---------- */
.stats-card {
  display: flex;
  padding: 30rpx 0;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.08s backwards;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.stat + .stat {
  border-left: 1rpx solid #e5e6eb;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1d2129;
  font-variant-numeric: tabular-nums;
}

/* 待确认线路数：>0 警告橙 */
.stat-num-warn {
  color: #ff7d00;
}

/* 存在隐患数：>0 危险红 */
.stat-num-bad {
  color: #f53f3f;
}

/* 隐患/待确认类计数为 0：不标色，弱化为辅助灰（仅 >0 才显色） */
.stat-num-mut {
  color: #86909c;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #86909c;
}

/* ---------- 搜索框（常置浅灰底，同树障页口径） ---------- */
.search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  margin-top: 28rpx;
}

.s-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  color: #1d2129;
}

.ph {
  color: #c9cdd4;
}

/* ---------- 线路大卡片（标题恒正文黑；计数着色：隐患>0 红字、=0 灰字 / 有记录品牌蓝 / 0 记录置灰；stagger 入场，delay 内联递增） ---------- */
.lcard {
  padding: 28rpx;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

.lcard.s-ok .lc-st {
  color: #86909c;
  font-weight: 400;
}

.lcard + .lcard {
  margin-top: 24rpx;
}

.lc-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lc-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2129;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lc-stats {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  margin-top: 14rpx;
}

.lc-st {
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.lc-warn {
  color: #0e3da8;
  font-weight: 600;
}

.lc-bad {
  color: #f53f3f;
  font-weight: 600;
}

.lc-total {
  color: #86909c;
}

/* ---------- 台账视图：返回行 + 线路标题 ---------- */
.backrow {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 64rpx;
  margin-left: -8rpx;
}

.backrow-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #0e3da8;
}

.ledger-head {
  margin-top: 8rpx;
}

.lh-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d2129;
}

.lh-sub {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.lh-bad {
  color: #f53f3f;
}

.lh-total {
  color: #86909c;
}

/* ---------- FAB（导出，每页主按钮至多一枚；形态同树障页） ---------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  z-index: 25;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #0e3da8;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(14, 61, 168, 0.35);
}

.fab-spacer {
  height: 160rpx;
}

/* ---------- 分组容器 ---------- */
.lgroup {
  margin-top: 8rpx;
}

/* ---------- 记录卡片 ---------- */
.crcard {
  position: relative;
  padding: 28rpx;
}

.crcard + .crcard {
  margin-top: 24rpx;
}

/* 首行：区段定宽块 + 垂距大字块（各卡竖向对齐）+ 隐患标签（有值才渲染）+ 折叠/展开开关（右推） */
.cr-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 区段定宽块（首行第一块：固定宽度保证后随的垂距块各卡左缘竖向对齐），过长时省略 */
.cr-section {
  flex: 0 0 220rpx;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2129;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 首行垂距大字块（首行第二块：紧跟定宽区段块、各卡左缘竖向对齐；突出大字） */
.cr-vbig {
  flex: none;
  font-size: 32rpx;
  font-weight: 700;
  color: #1d2129;
  font-variant-numeric: tabular-nums;
}

/* 隐患标签（状态语义「圆点 + 文字」小胶囊：警告橙浅底 #FFF7E8 + 橙点，同警示条一族色系） */
.haz-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  background: #fff7e8;
  color: #d25f00;
  font-size: 20rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.haz-tag::before {
  content: '';
  flex: none;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ff7d00;
}

/* 折叠/展开开关（首行右端，每卡一枚；点卡同效）：图标固定 chevron-down，展开态旋转 180° */
.cr-fold {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.cr-fold.cr-fold-open {
  transform: rotate(180deg);
}

/* 卡片字段块（折叠次行 跨越类型 / 交叉角；展开区全字段同款两列） */
.cr-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.cr-f {
  width: 50%;
  min-width: 0;
  padding: 10rpx 8rpx 10rpx 0;
  box-sizing: border-box;
}

.cr-l {
  font-size: 20rpx;
  color: #86909c;
}

.cr-v {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #1d2129;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 展开区：全字段 + 删除按钮（grid-rows 折叠动画：常驻渲染、class 开关；旧 WebView 不支持 grid-rows 动画时退化为直切） */
.cr-more {
  margin-top: 8rpx;
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition:
    grid-template-rows 0.28s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.22s ease;
}

.cr-more.cr-more-open {
  grid-template-rows: 1fr;
  opacity: 1;
}

.cr-more-in {
  min-height: 0;
  overflow: hidden;
}

/* ---------- 空态 ---------- */
.empty-box {
  margin-top: 28rpx;
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(29, 33, 41, 0.4);
}

/* ---------- 底部弹层（sheet 族同树障页口径） ---------- */
.sheet {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #1d2129;
}

/* 筛选项列表（限高滚动；导出弹层范围/线路单选复用） */
.flt-list {
  margin-top: 24rpx;
  max-height: 60vh;
}

.flt-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 16rpx;
  font-size: 28rpx;
  color: #1d2129;
}

.flt-item + .flt-item {
  border-top: 1rpx solid #e5e6eb;
}

.flt-item.on {
  color: #0e3da8;
  font-weight: 600;
}

/* 导出弹层：范围单选组与按线路分表开关行 */
.exp-scope {
  margin-top: 12rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.exp-scope .flt-item + .flt-item {
  border-top-color: #ffffff;
}

.exp-split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.exp-split-l {
  flex: 1;
  min-width: 0;
}

.exp-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #86909c;
  line-height: 1.6;
}

/* 表单字段（.f-label/.f-field 用 app.wxss 全局类） */
.f-item {
  margin-top: 24rpx;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e5e6eb;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #4e5969;
  letter-spacing: 6rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 12rpx;
  background: #0e3da8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-ghost.disabled,
.btn-dark.disabled {
  opacity: 0.5;
}

/* ---------- 台账卡展开区：操作行（删除） ---------- */
.cr-foot {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

/* 删除记录：描边红字（危险操作弱化为次按钮形态） */
.btn-act.btn-del {
  color: #f53f3f;
  border-color: #f53f3f;
  background: #ffece8;
}

.btn-act {
  padding: 10rpx 36rpx;
  border: 2rpx solid #0e3da8;
  border-radius: 12rpx;
  background: #e8f0ff;
  color: #0e3da8;
  font-size: 24rpx;
  font-weight: 700;
}

/* ---------- 动效（复用全局 fadeUp 上浮入场；全局 prefers-reduced-motion 已兜底） ---------- */
/* 记录卡 stagger 入场（delay 内联递增） */
.crcard-in {
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

/* 线路 ↔ 台账视图切换：整块淡入过渡（wx:if 重建即重播） */
.view-pane {
  animation: fadeUp 0.45s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}
