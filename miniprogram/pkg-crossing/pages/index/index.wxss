/* 交跨记录（政企蓝白 token；看板/卡片/弹层口径同树障页；
   颜色走 app.wxss --app-* 语义变量，深色随系统；弱化占位 #C9CDD4 / rgba(29,33,41,.4) 无对应
   token，浅色保持定稿值、深色单独覆盖） */

/* tdesign 组件变量 */
page {
  --td-popup-border-radius: 24rpx;
  --td-dialog-border-radius: 24rpx;
  --td-toast-radius: 8rpx;
  --td-tag-round-border-radius: 12rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* ---------- 看板四格卡（仿树障页 stats-card；本页无深蓝页首，不负边距浮层） ---------- */
.stats-card {
  display: flex;
  padding: 30rpx 0;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.08s backwards;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.stat + .stat {
  border-left: 1rpx solid var(--app-border);
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--app-text-primary);
  font-variant-numeric: tabular-nums;
}

/* 待确认线路数：>0 警告橙 */
.stat-num-warn {
  color: var(--app-warning);
}

/* 存在隐患数：>0 危险红 */
.stat-num-bad {
  color: var(--app-danger);
}

/* 隐患/待确认类计数为 0：不标色，弱化为辅助灰（仅 >0 才显色） */
.stat-num-mut {
  color: var(--app-text-tertiary);
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

/* ---------- 搜索框（常置浅灰底，同树障页口径） ---------- */
.search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--app-bg-nested);
  border-radius: 16rpx;
  margin-top: 28rpx;
}

.s-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  color: var(--app-text-primary);
}

.ph {
  color: #c9cdd4;
}

/* ---------- 线路大卡片（标题恒正文黑；计数着色：隐患>0 红字、=0 灰字 / 有记录品牌蓝 / 0 记录置灰；stagger 入场，delay 内联递增） ---------- */
.lcard {
  padding: 28rpx;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

.lcard.s-ok .lc-st {
  color: var(--app-text-tertiary);
  font-weight: 400;
}

.search + .lcard {
  margin-top: 24rpx;
}

.lcard + .lcard {
  margin-top: 24rpx;
}

.lc-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lc-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lc-stats {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  margin-top: 14rpx;
}

.lc-st {
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.lc-warn {
  color: var(--app-brand);
  font-weight: 600;
}

.lc-bad {
  color: var(--app-danger);
  font-weight: 600;
}

.lc-total {
  color: var(--app-text-tertiary);
}

/* ---------- 台账视图：返回行 + 线路标题 ---------- */
.backrow {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 64rpx;
  margin-left: -8rpx;
  transition: opacity 0.15s ease;
}

.backrow-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--app-brand);
}

.ledger-head {
  margin-top: 8rpx;
}

.lh-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.lh-sub {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.lh-bad {
  color: var(--app-danger);
}

.lh-total {
  color: var(--app-text-tertiary);
}

/* ---------- FAB（导出，每页主按钮至多一枚；形态同树障页；前景 --app-on-brand 图标继承） ---------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  z-index: 25;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(14, 61, 168, 0.35);
}

.fab-spacer {
  height: 160rpx;
}

/* ---------- 分组容器 ---------- */
.lgroup {
  margin-top: 8rpx;
}

/* ---------- 记录卡片 ---------- */
.crcard {
  position: relative;
  padding: 28rpx;
}

.crcard + .crcard {
  margin-top: 24rpx;
}

/* 首行：区段定宽块 + 垂距大字块（各卡竖向对齐）+ 隐患标签（有值才渲染）+ 折叠/展开开关（右推） */
.cr-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 区段定宽块（首行第一块：固定宽度保证后随的垂距块各卡左缘竖向对齐），过长时省略 */
.cr-section {
  flex: 0 0 220rpx;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 首行垂距大字块（首行第二块：紧跟定宽区段块、各卡左缘竖向对齐；突出大字） */
.cr-vbig {
  flex: none;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  font-variant-numeric: tabular-nums;
}

/* 隐患标签（状态语义「圆点 + 文字」小胶囊：警告橙浅底 + 橙点，同警示条一族色系） */
.haz-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  background: var(--app-warning-bg);
  color: var(--app-warning-text);
  font-size: 20rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.haz-tag::before {
  content: '';
  flex: none;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--app-warning);
}

/* 折叠/展开开关（首行右端，每卡一枚；点卡同效）：图标固定 chevron-down，展开态旋转 180° */
.cr-fold {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.cr-fold.cr-fold-open {
  transform: rotate(180deg);
}

/* 卡片字段块（折叠次行 跨越类型 / 交叉角；展开区全字段同款两列） */
.cr-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.cr-f {
  width: 50%;
  min-width: 0;
  padding: 10rpx 8rpx 10rpx 0;
  box-sizing: border-box;
}

.cr-l {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
}

.cr-v {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--app-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 展开区：全字段 + 删除按钮（grid-rows 折叠动画：常驻渲染、class 开关；旧 WebView 不支持 grid-rows 动画时退化为直切） */
.cr-more {
  margin-top: 8rpx;
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition:
    grid-template-rows 0.28s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.22s ease;
}

.cr-more.cr-more-open {
  grid-template-rows: 1fr;
  opacity: 1;
}

.cr-more-in {
  min-height: 0;
  overflow: hidden;
}

/* ---------- 空态 ---------- */
.empty-box {
  margin-top: 28rpx;
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(29, 33, 41, 0.4);
}

/* ---------- 底部弹层（sheet 族同树障页口径；头/体/脚三段 flex，整体限高 + overflow:hidden，
   内容体 flex:1 1 auto 独立滚动，头脚 flex:none 不收缩） ---------- */
.sheet {
  position: relative;
  background: var(--app-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

.sheet-title {
  flex: none;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--app-text-primary);
}

/* 弹层内容体（flex-basis 用 auto：0 基准会把自适应高度弹层内容压没） */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角隐形关闭热区（closeBtn 未启用仍可点）：置空防误关 */
.t-popup__close {
  display: none;
}

/* 筛选项列表（限高滚动；导出弹层范围/线路单选复用） */
.flt-list {
  margin-top: 24rpx;
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.flt-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 16rpx;
  font-size: 28rpx;
  color: var(--app-text-primary);
  transition: color 0.15s ease;
}

.flt-item + .flt-item {
  border-top: 1rpx solid var(--app-border);
}

.flt-item.on {
  color: var(--app-brand);
  font-weight: 600;
}

/* 导出弹层：范围单选组与按线路分表开关行 */
.exp-scope {
  margin-top: 12rpx;
  background: var(--app-bg-nested);
  border-radius: 12rpx;
}

.exp-scope .flt-item + .flt-item {
  border-top-color: var(--app-bg-card);
}

.exp-split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.exp-split-l {
  flex: 1;
  min-width: 0;
}

.exp-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  line-height: 1.6;
}

/* 表单字段（.f-label/.f-field 用 app.wxss 全局类） */
.f-item {
  margin-top: 24rpx;
}

/* ---------- 手动新增/编辑统一表单弹层（13 业务列，与 Web RecordForm 同口径） ---------- */
/* 新增入口行（线路视图搜索下 / 台账标题行，居右；班管/超管） */
.add-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

/* 必填星标 */
.f-req {
  margin-left: 6rpx;
  color: var(--app-danger);
}

/* 表单体块：13 列内滚动，标题与操作脚常驻可见 */
.form-body {
  max-height: 56vh;
}

/* 表单输入（含日期选择器的文本行）：嵌套浅灰底 16rpx 圆角，同 .f-field 形态 */
.form-in {
  height: 76rpx;
  padding: 0 20rpx;
  background: var(--app-bg-nested);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--app-text-primary);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.form-ph {
  color: var(--app-text-tertiary);
}

/* 弹层内非体块默认不参与收缩（头/说明/控件/脚），体块（scroll-view 或 .sheet-body）独占剩余空间并滚动 */
.sheet > view {
  flex: none;
}

.sheet > scroll-view,
.sheet > .sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.sheet-actions {
  flex: none;
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text-secondary);
  letter-spacing: 6rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: opacity 0.15s ease;
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: opacity 0.15s ease;
}

.btn-ghost.disabled,
.btn-dark.disabled {
  opacity: 0.5;
}

/* ---------- 台账卡展开区：操作行（删除） ---------- */
.cr-foot {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

/* 删除记录：描边红字（危险操作弱化为次按钮形态） */
.btn-act.btn-del {
  color: var(--app-danger);
  border-color: var(--app-danger);
  background: var(--app-danger-bg);
}

.btn-act {
  padding: 10rpx 36rpx;
  border: 2rpx solid var(--app-brand);
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 24rpx;
  font-weight: 700;
  transition: opacity 0.15s ease;
}

/* ---------- 动效（复用全局 fadeUp 上浮入场；全局 prefers-reduced-motion 已兜底） ---------- */
/* 记录卡 stagger 入场（delay 内联递增） */
.crcard-in {
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

/* 线路 ↔ 台账视图切换：整块淡入过渡（wx:if 重建即重播） */
.view-pane {
  animation: fadeUp 0.45s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

/* ---------- t-icon 外部样式类（size 属性写内联 rpx 会随屏宽膨胀，改由 t-class 控制字号；
   图标色不经 color 属性传 var()，经 t-class/父级颜色继承，随 --app-* 深浅） ---------- */
.ico-30 {
  font-size: 30rpx;
}

.ico-32 {
  font-size: 32rpx;
}

.ico-44 {
  font-size: 44rpx;
}

.ico-brand {
  color: var(--app-brand);
}

.ico-weak {
  color: var(--app-text-tertiary);
}

/* 弱化占位（#C9CDD4 / rgba(29,33,41,.4) 无 --app-* 对应 token：浅色保持定稿值，深色随系统） */
@media (prefers-color-scheme: dark) {
  .ph,
  .empty-box {
    color: rgba(255, 255, 255, 0.4);
  }
}
