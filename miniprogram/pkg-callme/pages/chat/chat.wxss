.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F4F1EA;
}

/* ---------- 消息区 ---------- */
.chat-scroll {
  flex: 1;
  min-height: 0;
}

.msg-list {
  padding: 24rpx 28rpx 32rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
  animation: fadeUp 0.25s ease both; /* 新消息入场 */
}

.msg-right {
  justify-content: flex-end;
}

.msg-left {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.user-bubble {
  background: #F26D21;
  color: #FFFFFF;
  border-bottom-right-radius: 6rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-side {
  max-width: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* AI 回答不用气泡（对齐官方前端）：纯文本流式内容，仅用户问题保留气泡 */
.ai-bubble {
  background: transparent;
  color: #22314E;
  border-radius: 0;
  max-width: 100%;
  padding: 0;
  white-space: pre-wrap;
}

.ai-error {
  background: transparent;
  color: #CF4444;
}

.thinking {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #A89F8A;
  line-height: 1.5;
}

/* ---------- 步骤树（思考过程） ---------- */
.think-box {
  margin-bottom: 8rpx;
}

.think-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
  transition: opacity 0.15s ease;
}

.think-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #A89F8A;
}

.think-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D9CFBA;
}

.think-dot-on {
  background: #F26D21;
  animation: blink 1s infinite;
}

.think-arrow {
  transition: transform 0.2s;
}

.think-arrow-open {
  transform: rotate(180deg);
}

.step-scroll {
  /* 限高滚动盒（与网页端 240px 相当）：盒内跟随最新消息，页面不被长思考拉长 */
  max-height: 480rpx;
}

.step-list {
  padding: 8rpx 0 4rpx;
  animation: fadeIn 0.2s ease; /* 展开时淡入 */
}

.step-end {
  height: 1rpx;
}

.step {
  display: flex;
  align-items: stretch;
}

.step-rail {
  width: 44rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-icon {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 正在执行的步骤：图标呼吸脉冲 + 标题明暗动效 */
.step-icon-run {
  animation: stepPulse 1.2s ease-in-out infinite;
}

.step-line {
  width: 2rpx;
  flex: 1;
  min-height: 8rpx;
  background: #EDE5D2;
}

.step-main {
  flex: 1;
  min-width: 0;
  padding: 6rpx 0 18rpx 12rpx;
}

.step:last-child .step-main {
  padding-bottom: 4rpx;
}

.step-title {
  font-size: 24rpx;
  color: #22314E;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-word;
}

.step-title-run {
  color: #F26D21;
  animation: stepBreath 1.6s ease-in-out infinite;
}

.step-title-err {
  color: #CF4444;
}

.step-summary {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A89F8A;
  line-height: 1.5;
}

.step-text {
  font-size: 22rpx;
  color: #A89F8A;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

@keyframes stepPulse {
  0%, 100% { opacity: 0.45; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.12); }
}

@keyframes stepBreath {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.cursor {
  color: #F26D21;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.msg-img {
  width: 320rpx;
  border-radius: 12rpx;
}

/* ---------- 回答操作条（复制/时间） ---------- */
.msg-actions {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
  transition: opacity 0.15s ease;
}

.msg-time {
  font-size: 24rpx;
  color: #A89F8A;
}

/* ---------- 引用来源 ---------- */
.ref-box {
  margin-top: 8rpx;
  padding: 12rpx 20rpx;
  background: #F7F3EA;
  border: 1rpx solid #EDE5D2;
  border-radius: 14rpx;
}

.ref-title {
  font-size: 20rpx;
  color: #A89F8A;
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.ref-item {
  font-size: 22rpx;
  color: #6B7690;
  line-height: 1.7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 加载更早消息 ---------- */
.load-earlier {
  align-self: center;
  margin: 0 auto 20rpx;
  padding: 8rpx 28rpx;
  font-size: 22rpx;
  color: #A89F8A;
  background: #FFFFFF;
  border: 1rpx solid #E3DCCB;
  border-radius: 28rpx;
  width: fit-content;
}

.bottom-anchor {
  height: 1rpx;
}

/* ---------- 输入栏 ---------- */
.input-bar {
  background: #FFFFFF;
  border-top: 1rpx solid #E8E0CD;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
}

.img-chip {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 12rpx;
}

.img-chip image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
}

.chip-close {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #22314E;
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.tool-btn {
  padding: 12rpx 4rpx;
  flex: none;
}

.chat-input {
  flex: 1;
  background: #F4F1EA;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  max-height: 180rpx;
  color: #22314E;
}

.input-ph {
  color: #A89F8A;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F26D21;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.tool-btn {
  transition: opacity 0.15s ease;
}

.send-disabled {
  opacity: 0.4;
}
