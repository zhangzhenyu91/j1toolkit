.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F4F1EA;
}

/* ---------- 消息区 ---------- */
.chat-scroll {
  flex: 1;
  min-height: 0;
}

.msg-list {
  padding: 24rpx 28rpx 32rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
  animation: fadeUp 0.25s ease both; /* 新消息入场 */
}

.msg-right {
  justify-content: flex-end;
}

.msg-left {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.user-bubble {
  background: #F26D21;
  color: #FFFFFF;
  border-bottom-right-radius: 6rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-side {
  max-width: 85%;
  display: flex;
  flex-direction: column;
}

.ai-bubble {
  background: #FFFFFF;
  color: #22314E;
  border-bottom-left-radius: 6rpx;
  max-width: 100%;
  white-space: pre-wrap;
}

.ai-error {
  background: #FBEDEB;
  color: #CF4444;
}

.thinking {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #A89F8A;
  line-height: 1.5;
}

/* ---------- 思考内容折叠盒 ---------- */
.think-box {
  margin-bottom: 8rpx;
  background: #F7F3EA;
  border: 1rpx solid #EDE5D2;
  border-radius: 14rpx;
  overflow: hidden;
}

.think-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
}

.think-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #A89F8A;
}

.think-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D9CFBA;
}

.think-dot-on {
  background: #F26D21;
  animation: blink 1s infinite;
}

.think-content {
  padding: 0 20rpx 16rpx;
  font-size: 22rpx;
  color: #A89F8A;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  animation: fadeIn 0.2s ease; /* 展开时淡入 */
}

.think-head {
  transition: opacity 0.15s ease;
}

.think-arrow {
  transition: transform 0.2s;
}

.think-arrow-open {
  transform: rotate(180deg);
}

.cursor {
  color: #F26D21;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.msg-img {
  width: 320rpx;
  border-radius: 12rpx;
}

/* ---------- 回答操作条（复制/时间） ---------- */
.msg-actions {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
  transition: opacity 0.15s ease;
}

.msg-time {
  font-size: 24rpx;
  color: #A89F8A;
}

.bottom-anchor {
  height: 1rpx;
}

/* ---------- 输入栏 ---------- */
.input-bar {
  background: #FFFFFF;
  border-top: 1rpx solid #E8E0CD;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
}

.img-chip {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 12rpx;
}

.img-chip image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
}

.chip-close {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #22314E;
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.tool-btn {
  padding: 12rpx 4rpx;
  flex: none;
}

.chat-input {
  flex: 1;
  background: #F4F1EA;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  max-height: 180rpx;
  color: #22314E;
}

.input-ph {
  color: #A89F8A;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F26D21;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.tool-btn {
  transition: opacity 0.15s ease;
}

.send-disabled {
  opacity: 0.4;
}
