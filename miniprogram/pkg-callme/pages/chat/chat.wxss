.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F7FA;
}

/* ---------- 消息区 ---------- */
.chat-scroll {
  flex: 1;
  min-height: 0;
}

.msg-list {
  padding: 24rpx 28rpx 32rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
  animation: fadeUp 0.25s ease both; /* 新消息入场 */
}

.msg-right {
  justify-content: flex-end;
}

.msg-left {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.user-bubble {
  background: #0E3DA8;
  color: #FFFFFF;
  border-bottom-right-radius: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reply-side {
  max-width: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* 回答不用气泡（对齐官方前端）：纯文本流式内容，仅用户问题保留气泡 */
.reply-bubble {
  background: transparent;
  color: #1D2129;
  border-radius: 12rpx;
  max-width: 100%;
  padding: 0;
  white-space: pre-wrap;
}

.reply-error {
  background: transparent;
  color: #F53F3F;
}

.thinking {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
  line-height: 1.5;
}

/* ---------- 步骤树（思考过程） ---------- */
.think-box {
  margin-bottom: 8rpx;
}

.think-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
  transition: opacity 0.15s ease;
}

.think-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
}

.think-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(29,33,41,.35);
}

.think-dot-on {
  background: #0E3DA8;
  animation: blink 1s infinite;
}

.think-arrow {
  transition: transform 0.2s;
}

.think-arrow-open {
  transform: rotate(180deg);
}

.step-scroll {
  /* 限高滚动盒（与网页端 240px 相当）：盒内跟随最新消息，页面不被长思考拉长 */
  max-height: 480rpx;
}

.step-list {
  padding: 8rpx 0 4rpx;
  animation: fadeIn 0.2s ease; /* 展开时淡入 */
}

.step-end {
  height: 1rpx;
}

.step {
  display: flex;
  align-items: stretch;
}

.step-rail {
  width: 44rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-icon {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 正在执行的步骤：图标呼吸脉冲 + 标题明暗动效 */
.step-icon-run {
  animation: stepPulse 1.2s ease-in-out infinite;
}

.step-line {
  width: 2rpx;
  flex: 1;
  min-height: 8rpx;
  background: #EDE5D2;
}

.step-main {
  flex: 1;
  min-width: 0;
  padding: 6rpx 0 18rpx 12rpx;
}

.step:last-child .step-main {
  padding-bottom: 4rpx;
}

.step-title {
  font-size: 24rpx;
  color: #1D2129;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-word;
}

.step-title-run {
  color: #0E3DA8;
  animation: stepBreath 1.6s ease-in-out infinite;
}

.step-title-err {
  color: #F53F3F;
  display: flex;
  align-items: flex-start;
}

/* 失败步骤前置红三角感叹号（t-icon 为自定义组件宿主，vertical-align 对其不生效；
   按 worklog .lc-fail-x 同款口径：flex 布局 + 首行文字中线对齐，24rpx×1.5=36rpx 行高，(36-22)/2≈7rpx） */
.step-err-x {
  flex: none;
  margin-right: 6rpx;
  margin-top: 7rpx;
}

.step-summary {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
  line-height: 1.5;
}

.step-text {
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

@keyframes stepPulse {
  0%, 100% { opacity: 0.45; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.12); }
}

@keyframes stepBreath {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.cursor {
  color: #0E3DA8;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.msg-img {
  width: 320rpx;
  border-radius: 12rpx;
}

/* ---------- 回答操作条（复制/时间） ---------- */
.msg-actions {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
  transition: opacity 0.15s ease;
}

.msg-time {
  font-size: 24rpx;
  color: rgba(29,33,41,.4);
}

/* ---------- 引用来源 ---------- */
.ref-box {
  margin-top: 8rpx;
  padding: 12rpx 20rpx;
  background: #E8F0FF;
  border: 1rpx solid #EDE5D2;
  border-radius: 12rpx;
}

.ref-title {
  font-size: 20rpx;
  color: rgba(29,33,41,.4);
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.ref-item {
  font-size: 22rpx;
  color: #4E5969;
  line-height: 1.7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 加载更早消息 ---------- */
.load-earlier {
  align-self: center;
  margin: 0 auto 20rpx;
  padding: 8rpx 28rpx;
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
  background: #FFFFFF;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  width: fit-content;
}

.bottom-anchor {
  height: 1rpx;
}

/* ---------- 输入栏 ---------- */
.input-bar {
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
}

/* 输入卡片：白卡收拢附件芯片/图片/输入框/工具栏（同全局 .card 卡族形态） */
.input-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .05);
  padding: 20rpx;
}

.img-chip {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 12rpx;
}

.img-chip image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
}

.chip-close {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 12rpx;
  background: rgba(29, 33, 41, 0.72);
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 能力胶囊（联网搜索 / 思考强度 / 当前模型） ---------- */
.cap-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.cap-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #F5F7FA;
  color: #4E5969;
  font-size: 22rpx;
  line-height: 1.5;
  transition: opacity 0.15s ease;
}

/* 模型名限宽省略（长模型名防胶囊组换行拥挤） */
.model-name {
  max-width: 220rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cap-pill-on {
  background: #0E3DA8;
  color: #FFFFFF;
}

/* 仅 1 个可用模型时的禁用态 */
.cap-pill-off {
  opacity: 0.6;
}

/* ---------- 选项弹层（思考强度/模型选择共用）：底部弹层 + 遮罩 ---------- */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(29, 33, 41, 0.45);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 8rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  animation: sheetUp 0.25s ease both;
}

@keyframes sheetUp {
  from {
    transform: translateY(30%);
    opacity: 0.6;
  }
  to {
    transform: none;
    opacity: 1;
  }
}

.sheet-title {
  text-align: center;
  font-size: 26rpx;
  color: #86909c;
  padding: 18rpx 0;
}

.sheet-opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  font-size: 28rpx;
  color: #1d2129;
  border-top: 1rpx solid #e5e6eb;
}

.sheet-opt-on {
  color: #0e3da8;
  font-weight: 600;
}

.sheet-cancel {
  margin-top: 12rpx;
  text-align: center;
  padding: 24rpx 0;
  background: #f5f7fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #4e5969;
}

/* ---------- 附件芯片 ---------- */
.attach-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.attach-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F7F8FA;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.attach-chip-err {
  background: #FFECE8;
}

.attach-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.attach-name {
  font-size: 24rpx;
  color: #1D2129;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attach-meta {
  font-size: 20rpx;
  color: #86909C;
}

.attach-chip-err .attach-meta {
  color: #F53F3F;
}

.attach-progress {
  margin-top: 8rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #E5E6EB;
  overflow: hidden;
}

.attach-progress-bar {
  height: 100%;
  background: #0E3DA8;
}

.attach-close {
  flex: none;
  padding: 8rpx;
  color: rgba(29,33,41,.4);
  font-size: 24rpx;
  line-height: 1;
}

/* ---------- 底行工具栏（能力胶囊 + 添加 + 发送） ---------- */
.input-toolbar {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.toolbar-btns {
  margin-left: auto;
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F5F7FA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  transition: opacity 0.15s ease;
}

.chat-input {
  width: 100%;
  box-sizing: border-box;
  background: transparent;
  padding: 12rpx 4rpx;
  font-size: 28rpx;
  line-height: 1.5;
  max-height: 180rpx;
  color: #1D2129;
}

.input-ph {
  color: rgba(29,33,41,.4);
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #0E3DA8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.send-disabled {
  opacity: 0.4;
}
