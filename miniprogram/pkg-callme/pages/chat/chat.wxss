.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--app-bg-page);
}

/* ---------- 消息区 ---------- */
.chat-scroll {
  flex: 1;
  min-height: 0;
}

.msg-list {
  padding: 24rpx 28rpx 32rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; /* 新消息入场 */
}

.msg-right {
  justify-content: flex-end;
}

.msg-left {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.user-bubble {
  background: var(--app-brand);
  color: var(--app-on-brand);
  border-bottom-right-radius: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reply-side {
  max-width: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* 回答不用气泡（对齐官方前端）：纯文本流式内容，仅用户问题保留气泡 */
.reply-bubble {
  background: transparent;
  color: var(--app-text-primary);
  border-radius: 12rpx;
  max-width: 100%;
  padding: 0;
  white-space: pre-wrap;
}

.reply-error {
  background: transparent;
  color: var(--app-danger-text);
}

.thinking {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  line-height: 1.5;
}

/* ---------- 步骤树（思考过程） ---------- */
.think-box {
  margin-bottom: 8rpx;
}

.think-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
  transition: opacity 0.15s ease;
}

.think-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

.think-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--app-border);
}

.think-dot-on {
  background: var(--app-brand);
  animation: blink 1s infinite; /* 流式进行中指示（功能性） */
}

.think-arrow {
  color: var(--app-text-tertiary);
  transition: transform 0.2s;
}

.think-arrow-open {
  transform: rotate(180deg);
}

.step-scroll {
  /* 限高滚动盒（与网页端 240px 相当）：盒内跟随最新消息，页面不被长思考拉长 */
  max-height: 480rpx;
}

.step-list {
  padding: 8rpx 0 4rpx;
  animation: fadeIn 0.2s ease; /* 展开时淡入 */
}

.step-end {
  height: 1rpx;
}

.step {
  display: flex;
  align-items: stretch;
}

.step-rail {
  width: 44rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-icon {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 步骤图标状态色（t-icon 不传 color，经宿主 CSS color 继承） */
.ico-brand {
  color: var(--app-brand);
}

.ico-danger {
  color: var(--app-danger-text);
}

.ico-mute {
  color: var(--app-text-tertiary);
}

/* 正在执行的步骤：图标单点脉冲（功能性反馈；标题明暗呼吸按动效规范删除） */
.step-icon-run {
  animation: stepPulse 1.2s ease-in-out infinite;
}

.step-line {
  width: 2rpx;
  flex: 1;
  min-height: 8rpx;
  background: var(--app-border);
}

.step-main {
  flex: 1;
  min-width: 0;
  padding: 6rpx 0 18rpx 12rpx;
}

.step:last-child .step-main {
  padding-bottom: 4rpx;
}

.step-title {
  font-size: 24rpx;
  color: var(--app-text-primary);
  font-weight: 500;
  line-height: 1.5;
  word-break: break-word;
}

.step-title-run {
  color: var(--app-brand);
}

.step-title-err {
  color: var(--app-danger-text);
  display: flex;
  align-items: flex-start;
}

/* 失败步骤前置红三角感叹号（t-icon 为自定义组件宿主，vertical-align 对其不生效；
   按 worklog .lc-fail-x 同款口径：flex 布局 + 首行文字中线对齐，24rpx×1.5=36rpx 行高，(36-22)/2≈7rpx） */
.step-err-x {
  flex: none;
  margin-right: 6rpx;
  margin-top: 7rpx;
}

.step-summary {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  line-height: 1.5;
}

.step-text {
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

@keyframes stepPulse {
  0%,
  100% {
    opacity: 0.45;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1.12);
  }
}

.cursor {
  color: var(--app-brand);
  animation: blink 1s infinite; /* 流式光标指示（功能性） */
}

@keyframes blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}

.msg-img {
  width: 320rpx;
  border-radius: 12rpx;
}

/* ---------- 回答操作条（复制/时间） ---------- */
.msg-actions {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
  color: var(--app-text-tertiary);
  transition: opacity 0.15s ease;
}

.msg-time {
  font-size: 24rpx;
  color: var(--app-text-tertiary);
}

/* ---------- 引用来源 ---------- */
.ref-box {
  margin-top: 8rpx;
  padding: 12rpx 20rpx;
  background: var(--app-brand-light);
  border: 1rpx solid var(--app-border);
  border-radius: 12rpx;
}

.ref-title {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.ref-item {
  font-size: 22rpx;
  color: var(--app-text-secondary);
  line-height: 1.7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 加载更早消息 ---------- */
.load-earlier {
  align-self: center;
  margin: 0 auto 20rpx;
  padding: 8rpx 28rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  width: fit-content;
  transition: opacity 0.15s ease;
}

.bottom-anchor {
  height: 1rpx;
}

/* ---------- 输入栏 ---------- */
.input-bar {
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
}

/* 输入卡片：白卡收拢附件芯片/图片/输入框/工具栏（同全局 .card 卡族形态） */
.input-card {
  background: var(--app-bg-card);
  border-radius: 24rpx;
  box-shadow: var(--app-shadow-card);
  padding: 20rpx;
}

.img-chip {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 12rpx;
}

.img-chip image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
}

/* 图片角标关闭钮：浮于照片上的深色半透明胶囊，双主题同值（非表面色） */
.chip-close {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 12rpx;
  background: rgba(29, 33, 41, 0.72);
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 能力胶囊（联网搜索 / 思考强度 / 当前模型） ---------- */
.cap-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.cap-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--app-bg-nested);
  color: var(--app-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
  transition: opacity 0.15s ease;
}

/* 模型名限宽省略（长模型名防胶囊组换行拥挤） */
.model-name {
  max-width: 220rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cap-pill-on {
  background: var(--app-brand);
  color: var(--app-on-brand);
}

/* 仅 1 个可用模型时的禁用态 */
.cap-pill-off {
  opacity: 0.6;
}

/* ---------- 选项弹层（思考强度/模型选择共用）：底部弹层 + 遮罩 ----------
   头/体/脚三段 flex：整体限高 + overflow:hidden，选项区 flex:1 1 auto 独立滚动（模型多时不顶掉标题与取消） */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: var(--app-mask);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--app-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 8rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  animation: sheetUp 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

@keyframes sheetUp {
  from {
    transform: translateY(16px) scale(0.98);
    opacity: 0.6;
  }
  to {
    transform: none;
    opacity: 1;
  }
}

.sheet-title {
  flex: none;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
  padding: 18rpx 0;
}

/* 弹层内容体（flex-basis 用 auto：0 基准会把自适应高度弹层内容压没） */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.sheet-opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  font-size: 28rpx;
  color: var(--app-text-primary);
  border-top: 1rpx solid var(--app-border);
}

.sheet-opt-on {
  color: var(--app-brand);
  font-weight: 600;
}

.sheet-cancel {
  flex: none;
  margin-top: 12rpx;
  text-align: center;
  padding: 24rpx 0;
  background: var(--app-bg-nested);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--app-text-secondary);
}

/* ---------- 附件芯片 ---------- */
.attach-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.attach-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--app-bg-nested);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.attach-chip-err {
  background: var(--app-danger-bg);
}

.attach-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.attach-name {
  font-size: 24rpx;
  color: var(--app-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attach-meta {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
}

.attach-chip-err .attach-meta {
  color: var(--app-danger-text);
}

.attach-progress {
  margin-top: 8rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--app-border);
  overflow: hidden;
}

.attach-progress-bar {
  height: 100%;
  background: var(--app-brand);
}

.attach-close {
  flex: none;
  padding: 8rpx;
  color: var(--app-text-tertiary);
  font-size: 24rpx;
  line-height: 1;
}

/* ---------- 底行工具栏（能力胶囊 + 添加 + 发送） ---------- */
.input-toolbar {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.toolbar-btns {
  margin-left: auto;
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--app-bg-nested);
  color: var(--app-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  transition: opacity 0.15s ease;
}

.chat-input {
  width: 100%;
  box-sizing: border-box;
  background: transparent;
  padding: 12rpx 4rpx;
  font-size: 28rpx;
  line-height: 1.5;
  max-height: 180rpx;
  color: var(--app-text-primary);
}

.input-ph {
  color: var(--app-text-tertiary);
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  transition:
    transform 0.15s ease,
    opacity 0.15s ease;
}

.send-disabled {
  opacity: 0.4;
}

/* ---------- t-icon 数值字阶（t-class 外部类） ---------- */
.ico-20 {
  font-size: 20rpx;
}
.ico-22 {
  font-size: 22rpx;
}
.ico-24 {
  font-size: 24rpx;
}
.ico-28 {
  font-size: 28rpx;
}
.ico-32 {
  font-size: 32rpx;
}
.ico-36 {
  font-size: 36rpx;
}
.ico-40 {
  font-size: 40rpx;
}
