<!-- Call Me · 对话页（SSE 流式，「政企蓝白」气泡） -->
<view class="page">
  <navbar back title="{{title}}" />

  <!-- 消息列表 -->
  <scroll-view
    class="chat-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-into-view="{{toView}}"
    scroll-with-animation
  >
    <view class="msg-list">
      <!-- 更早消息分页入口 -->
      <view
        wx:if="{{hasMore}}"
        class="load-earlier"
        hover-class="hover-opacity"
        bindtap="loadEarlier"
      >
        加载更早消息
      </view>
      <view
        wx:for="{{messages}}"
        wx:key="key"
        id="m-{{item.key}}"
        class="msg-row {{item.role === 'user' ? 'msg-right' : 'msg-left'}}"
      >
        <!-- 用户消息：右侧蓝气泡 -->
        <view wx:if="{{item.role === 'user'}}" class="bubble user-bubble">
          <image
            wx:if="{{item.image}}"
            src="{{item.image}}"
            class="msg-img"
            mode="widthFix"
            data-src="{{item.image}}"
            bindtap="previewImage"
          />
          <text wx:if="{{item.content}}" user-select>{{item.content}}</text>
        </view>

        <!-- 回复消息：无气泡，步骤树 + 纯文本回答（对齐官方前端） -->
        <view wx:else class="reply-side">
          <!-- 步骤树：流式期间展开，回答完毕自动折叠为摘要行，可点击再展开 -->
          <view wx:if="{{item.steps.length}}" class="think-box">
            <view
              class="think-head"
              hover-class="hover-opacity"
              data-index="{{index}}"
              bindtap="toggleThinking"
            >
              <view class="think-title">
                <view class="think-dot {{item.streaming ? 'think-dot-on' : ''}}"></view>
                <text>{{item.thinkLabel || (item.streaming ? '正在思考…' : '思考过程')}}</text>
              </view>
              <t-icon
                name="chevron-down"
                t-class="ico-32"
                class="think-arrow {{item.streaming || item.thinkingExpanded ? 'think-arrow-open' : ''}}"
              />
            </view>
            <!-- 限高滚动盒（与网页端一致）：流式期间 scroll-into-view 跟随最新消息，
                 完结后的展开态为静态内滚，避免长思考把页面拉得过长 -->
            <scroll-view
              wx:if="{{item.streaming || item.thinkingExpanded}}"
              class="step-scroll"
              scroll-y
              enhanced
              show-scrollbar="{{false}}"
              scroll-into-view="{{item.stepToView}}"
            >
              <view class="step-list">
                <view wx:for="{{item.steps}}" wx:for-item="step" wx:key="sid" class="step">
                  <view class="step-rail">
                    <view class="step-icon {{step.status === 'running' ? 'step-icon-run' : ''}}">
                      <t-icon
                        name="{{step.icon}}"
                        t-class="ico-28"
                        class="{{step.status === 'running' ? 'ico-brand' : (step.status === 'error' ? 'ico-danger' : 'ico-mute')}}"
                      />
                    </view>
                    <view wx:if="{{index < item.steps.length - 1}}" class="step-line"></view>
                  </view>
                  <view class="step-main">
                    <view
                      wx:if="{{step.kind === 'tool'}}"
                      class="step-title {{step.status === 'running' ? 'step-title-run' : ''}} {{step.status === 'error' ? 'step-title-err' : ''}}"
                    >
                      <t-icon
                        wx:if="{{step.status === 'error'}}"
                        class="step-err-x"
                        name="error-triangle"
                        t-class="ico-22"
                      />
                      {{step.title}}
                    </view>
                    <view wx:if="{{step.summary}}" class="step-summary">{{step.summary}}</view>
                    <view wx:if="{{step.kind === 'thought'}}" class="step-text">{{step.text}}</view>
                  </view>
                </view>
              </view>
              <view id="se-{{item.key}}" class="step-end"></view>
            </scroll-view>
          </view>

          <view class="bubble reply-bubble {{item.error ? 'reply-error' : ''}}">
            <mp-html
              wx:if="{{item.html}}"
              content="{{item.html}}"
              container-style="{{mdContainerStyle}}"
              tag-style="{{mdTagStyle}}"
              selectable="{{true}}"
            />
            <text wx:elif="{{item.content}}" user-select>{{item.content}}</text>
            <text wx:if="{{item.streaming}}" class="cursor">▍</text>
            <view
              wx:if="{{item.streaming && !item.content && !item.steps.length}}"
              class="thinking"
            >
              正在思考…
            </view>
          </view>

          <!-- 引用来源（回答完成后随气泡展示） -->
          <view wx:if="{{item.references && item.references.length}}" class="ref-box">
            <view class="ref-title">参考来源</view>
            <view wx:for="{{item.references}}" wx:for-item="ref" wx:key="id" class="ref-item">
              {{ref.title}}
            </view>
          </view>

          <!-- 操作条：复制 / 删除图标 + 时间（回答完成后显示） -->
          <view wx:if="{{!item.streaming && !item.error}}" class="msg-actions">
            <view
              class="action-btn"
              hover-class="hover-opacity"
              data-index="{{index}}"
              bindtap="onCopy"
            >
              <t-icon
                name="{{item.copied ? 'check' : 'copy'}}"
                t-class="ico-28"
                class="{{item.copied ? 'ico-brand' : ''}}"
              />
            </view>
            <view
              class="action-btn"
              hover-class="hover-opacity"
              data-index="{{index}}"
              bindtap="onDelete"
            >
              <t-icon name="delete" t-class="ico-28" />
            </view>
            <text class="msg-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
          </view>
        </view>
      </view>
      <view id="msg-bottom" class="bottom-anchor"></view>
    </view>
  </scroll-view>

  <!-- 输入栏（键盘弹出时整体上移、底边与键盘顶齐平；弹起期间去掉刘海屏安全区底留白） -->
  <view
    class="input-bar"
    style="margin-bottom: {{keyboardHeight}}px; {{keyboardHeight > 0 ? 'padding-bottom: 16rpx;' : ''}}"
  >
    <!-- 输入卡片：附件芯片 → 图片缩略图 → 输入框 → 底行工具栏 -->
    <view class="input-card">
      <!-- 附件芯片列表（图片走下方缩略图，文件在此展示） -->
      <view wx:if="{{attachments.length}}" class="attach-list">
        <view
          wx:for="{{attachments}}"
          wx:key="key"
          class="attach-chip {{item.status === 'failed' ? 'attach-chip-err' : ''}}"
        >
          <t-icon
            name="{{item.icon}}"
            t-class="ico-36"
            class="{{item.status === 'failed' ? 'ico-danger' : 'ico-brand'}}"
          />
          <view class="attach-info">
            <text class="attach-name">{{item.name}}</text>
            <text class="attach-meta"
              >{{item.sizeText}} · {{item.status === 'uploading' ? '上传中 ' + item.progress + '%' :
              item.status === 'parsing' ? '解析中…' : item.status === 'ready' ? '已就绪' :
              (item.error || '解析失败')}}</text
            >
            <view wx:if="{{item.status === 'uploading'}}" class="attach-progress">
              <view class="attach-progress-bar" style="width: {{item.progress}}%;"></view>
            </view>
          </view>
          <view
            class="attach-close"
            hover-class="hover-opacity"
            data-key="{{item.key}}"
            bindtap="removeAttachment"
            >✕</view
          >
        </view>
      </view>

      <view wx:if="{{pendingImage}}" class="img-chip">
        <image src="{{pendingImage.path}}" mode="aspectFill" />
        <view class="chip-close" hover-class="hover-scale" bindtap="removeImage">✕</view>
      </view>

      <textarea
        class="chat-input"
        auto-height
        maxlength="2000"
        placeholder="请输入问题…"
        placeholder-class="input-ph"
        value="{{inputValue}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
        adjust-position="{{false}}"
        bindkeyboardheightchange="onKeyboardHeight"
        show-confirm-bar="{{false}}"
      />

      <!-- 底行工具栏：左侧能力胶囊组（可换行防挤），右侧「+」与发送钮 -->
      <view class="input-toolbar">
        <!-- 能力胶囊：联网搜索开关（后端不支持时隐藏）+ 思考强度（当前模型无清单时隐藏）+ 当前模型（多个可切换） -->
        <view class="cap-group">
          <view
            wx:if="{{webSearchSupported}}"
            class="cap-pill {{webSearchOn ? 'cap-pill-on' : ''}}"
            hover-class="hover-opacity"
            bindtap="toggleWebSearch"
          >
            <t-icon name="internet" t-class="ico-24" />
            <text>联网搜索</text>
          </view>
          <view
            wx:if="{{thinkingLevels.length}}"
            class="cap-pill"
            hover-class="hover-opacity"
            bindtap="chooseReasoning"
          >
            <text>{{reasoningLabel}}</text>
            <t-icon name="chevron-down" t-class="ico-20" />
          </view>
          <view
            wx:if="{{models.length}}"
            class="cap-pill {{models.length > 1 ? '' : 'cap-pill-off'}}"
            hover-class="hover-opacity"
            bindtap="chooseModel"
          >
            <text class="model-name">{{modelName || '默认'}}</text>
            <t-icon
              wx:if="{{models.length > 1}}"
              name="chevron-down"
              t-class="ico-20"
            />
          </view>
        </view>
        <view class="toolbar-btns">
          <view class="add-btn" hover-class="hover-opacity" bindtap="onAddTap">
            <t-icon name="add" t-class="ico-40" />
          </view>
          <view
            class="send-btn {{canSend ? '' : 'send-disabled'}}"
            hover-class="hover-scale"
            bindtap="onSend"
          >
            <t-icon name="send" t-class="ico-40" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 选项弹层（思考强度/模型选择共用）：自绘底部弹层（wx.showActionSheet 限 6 项，思考档位 7 项会静默失败） -->
  <view wx:if="{{sheetShow}}" class="sheet-mask" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{sheetTitle}}</view>
      <scroll-view scroll-y class="sheet-body" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{sheetOptions}}"
          wx:key="index"
          class="sheet-opt {{item.value === sheetValue ? 'sheet-opt-on' : ''}}"
          data-value="{{item.value}}"
          hover-class="hover-opacity"
          bindtap="onSheetPick"
        >
          <text>{{item.label}}</text>
          <t-icon wx:if="{{item.value === sheetValue}}" name="check" t-class="ico-32" />
        </view>
      </scroll-view>
      <view class="sheet-cancel" hover-class="hover-opacity" bindtap="closeSheet">取消</view>
    </view>
  </view>

  <t-toast id="t-toast" />
</view>
