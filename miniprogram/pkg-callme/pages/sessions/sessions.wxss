.tip-bar {
  margin-bottom: 24rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  text-align: center;
}

.s-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: var(--app-bg-card);
  transition: background-color 0.15s ease;
}

.s-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.s-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.s-title {
  font-size: 28rpx;
  color: var(--app-text-primary);
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.s-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

.s-chev {
  color: var(--app-text-tertiary);
}

.list-card {
  overflow: hidden;
}

.swipe-actions {
  display: flex;
  height: 100%;
}

.s-action {
  width: 128rpx;
  height: 100%;
  color: var(--app-on-brand);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.s-rename {
  background: var(--app-brand);
}

.s-delete {
  background: var(--app-danger);
}

/* 新建对话按钮（固定底部） */
.create-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--app-bg-page);
}

/* ---------- t-icon 数值字阶（t-class 外部类） ---------- */
.ico-36 {
  font-size: 36rpx;
}
.ico-40 {
  font-size: 40rpx;
}
