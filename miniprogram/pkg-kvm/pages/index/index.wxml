<!-- KVM 远程管理 · 设备状态列表（小程序仅展示状态，无终端/远程控制入口；卡片与网页端 kvm.html 同口径，无动效） -->
<navbar back title="KVM 远程管理" />

<view class="page-body">
  <view class="section-title">设备列表</view>
  <view class="cnt">{{list.length ? '共 ' + list.length + ' 台设备 · ' : ''}}数据实时取自 GLKVM 平台</view>

  <!-- 设备卡片（卡顶警示斜纹条为全局 hazard-top） -->
  <block wx:if="{{list.length}}">
    <view class="card hazard-top dev" wx:for="{{list}}" wx:key="id">
      <view class="dv-in">
        <view class="dv-top">
          <view class="st st-{{item.statusKey}}">
            <view class="dot"></view>
            <text>{{item.statusText}}</text>
          </view>
          <view wx:if="{{item.group}}" class="dv-tag">{{item.group}}</view>
        </view>
        <view class="dv-name">{{item.name}}</view>
        <view class="dv-ddns" wx:if="{{item.ddns}}">{{item.ddns}}</view>
        <view class="dv-info">
          <view class="row">
            <text class="lab">IP 地址</text>
            <text class="val mono">{{item.ip}}</text>
          </view>
          <view class="row">
            <text class="lab">MAC</text>
            <text class="val mono">{{item.mac}}</text>
          </view>
          <view class="row">
            <text class="lab">最近在线</text>
            <text class="val">{{item.last}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 首屏加载中 -->
  <view wx:elif="{{loading}}" class="empty-box">设备列表加载中…</view>

  <!-- 首屏加载失败（如平台账号未接入/开启 2FA/密码不一致，按后端返回文案展示） -->
  <view wx:elif="{{error}}" class="empty-box">
    <view>{{error}}</view>
    <view class="retry" hover-class="hover-opacity" bindtap="onRetry">重新加载</view>
  </view>

  <!-- 空态 -->
  <view wx:else class="empty-box">暂无设备，或联系管理员开通平台设备权限</view>
</view>

<t-toast id="t-toast" />
