<!-- 登录页：深蓝品牌横幅 + 账号密码 / 微信登录（「政企蓝白」） -->
<view class="page">
  <!-- 深蓝横幅 -->
  <view class="banner" style="padding-top: {{statusBarHeight}}px;">
    <image class="logo" src="/assets/logo-on-dark.png" mode="aspectFit" />
    <view class="app-name">Shade 壹匣</view>
    <view class="app-slogan">班组数字化工具平台</view>
  </view>

  <!-- 登录表单 -->
  <view class="form">
    <view class="field">
      <t-input
        borderless
        clearable
        placeholder="请输入账号"
        prefix-icon="user"
        value="{{username}}"
        bind:change="onUsername"
      />
    </view>
    <view class="field">
      <t-input
        borderless
        type="password"
        placeholder="请输入密码"
        prefix-icon="lock-on"
        value="{{password}}"
        bind:change="onPassword"
      />
    </view>

    <t-button
      block
      size="large"
      loading="{{loading}}"
      custom-style="background: #1D2129; color: #FFFFFF; border: none; border-radius: 0; font-weight: 600; letter-spacing: 8rpx;"
      bind:tap="onAccountLogin"
    >登 录</t-button>

    <view class="divider">
      <view class="line"></view>
      <text>其他登录方式</text>
      <view class="line"></view>
    </view>

    <t-button
      block
      size="large"
      variant="outline"
      custom-style="background: #FFFFFF; border: 1rpx solid #E5E6EB; color: #1D2129; border-radius: 0;"
      bind:tap="onWxLogin"
    >
      <view class="wx-inner">
        <t-icon name="chat" size="40rpx" color="#07C160" />
        <text>微信一键登录</text>
      </view>
    </t-button>

    <view class="version">v1.1.0</view>
  </view>

  <t-toast id="t-toast" />
</view>
