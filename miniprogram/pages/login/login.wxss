.page {
  min-height: 100vh;
  background: #F5F7FA;
  display: flex;
  flex-direction: column;
}

/* ---------- 深蓝品牌横幅 ---------- */
.banner {
  background: #0A3592;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 56rpx;
}

.logo {
  margin-top: 48rpx;
  width: 160rpx;
  height: 160rpx;
}

.app-name {
  margin-top: 28rpx;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.app-slogan {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* ---------- 表单 ---------- */
.form {
  flex: 1;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.field {
  background: #FFFFFF;
  border: 1rpx solid #E5E6EB;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  padding: 4rpx 16rpx;
}

.divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 40rpx 0 28rpx;
  color: rgba(29,33,41,.4);
  font-size: 22rpx;
}

.divider .line {
  flex: 1;
  height: 1rpx;
  background: #E5E6EB;
}

.wx-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.version {
  margin-top: auto;
  text-align: center;
  color: #C9CDD4;
  font-size: 22rpx;
  padding-top: 40rpx;
}
