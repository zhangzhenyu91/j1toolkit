.page {
  min-height: 100vh;
  background: var(--app-bg-page);
  display: flex;
  flex-direction: column;
}

/* ---------- 深蓝品牌横幅（--app-brand-deep 双主题一致，白字保留） ---------- */
.banner {
  background: var(--app-brand-deep);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 56rpx;
}

.logo {
  margin-top: 48rpx;
  width: 160rpx;
  height: 160rpx;
}

.app-name {
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.app-slogan {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* ---------- 表单 ---------- */
.form {
  flex: 1;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.field {
  background: var(--app-bg-card);
  border: 1rpx solid var(--app-border);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  padding: 4rpx 16rpx;
}

.divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 40rpx 0 28rpx;
  color: var(--app-text-tertiary);
  font-size: 22rpx;
}

.divider .line {
  flex: 1;
  height: 1rpx;
  background: var(--app-border);
}

.wx-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.version {
  margin-top: auto;
  text-align: center;
  color: var(--app-text-tertiary);
  font-size: 22rpx;
  padding-top: 40rpx;
}

/* t-icon 字号（size 属性写内联 rpx 会随屏宽膨胀，改由外部样式类控制） */
.ico-40 {
  font-size: 40rpx;
}

/* ---------- iPad / 宽屏适配（CSS 媒体查询；普通手机竖屏不受影响） ---------- */
@media (min-width: 600px) {
  .form {
    width: 100%;
    max-width: 420px;
    box-sizing: border-box;
    margin-left: auto;
    margin-right: auto;
  }

  .logo {
    width: 80px;
    height: 80px;
    margin-top: 24px;
  }

  .app-name {
    font-size: 20px;
  }

  .app-slogan {
    font-size: 12px;
  }

  .divider {
    font-size: 11px;
    margin: 20px 0 14px;
  }

  .version {
    font-size: 11px;
    padding-top: 20px;
  }

  .ico-40 {
    font-size: 20px;
  }
}
