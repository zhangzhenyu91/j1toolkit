<!-- 消息推送（仅超管）：按角色推送站内通知 -->
<navbar back title="消息推送" />

<view class="page-body">
  <view class="card form-card">
    <view class="f-item">
      <view class="f-label">通知标题</view>
      <view class="f-field">
        <t-input borderless maxlength="128" placeholder="不超过 128 字" value="{{title}}" bind:change="onTitle" />
      </view>
    </view>

    <view class="f-item">
      <view class="f-label">通知内容（支持 Markdown，可插入图片）</view>
      <view class="md-tools">
        <view class="md-tool" hover-class="hover-opacity" bindtap="onInsertImage">插入图片</view>
        <view class="md-tool" hover-class="hover-opacity" bindtap="onTogglePreview">{{preview ? '继续编辑' : '预览'}}</view>
      </view>
      <view class="f-field f-field-area" wx:if="{{!preview}}">
        <t-textarea autosize="{{contentAutosize}}" placeholder="支持 Markdown：# 标题、**加粗**、- 列表、![图片描述](图片地址) 等" value="{{content}}" style="background: transparent;" bind:change="onContent" />
      </view>
      <view class="md-preview" wx:else>
        <mp-html wx:if="{{previewHtml}}" content="{{previewHtml}}" tag-style="{{mdTagStyle}}" container-style="{{mdContainerStyle}}" />
        <view class="md-preview-empty" wx:else>暂无内容</view>
      </view>
    </view>

    <view class="f-item">
      <view class="f-label">推送对象（至少选择一项）</view>
      <t-checkbox-group value="{{targets}}" bind:change="onTargets">
        <t-checkbox value="admin" label="超级管理员" />
        <t-checkbox value="team_admin" label="班组管理员" />
        <t-checkbox value="user" label="普通成员" />
      </t-checkbox-group>
    </view>
  </view>

  <view class="hint">推送后，所选角色的用户将在「消息通知」中看到此条通知</view>
</view>

<!-- 提交（固定底部主按钮，避开右上角胶囊区域） -->
<view class="create-bar">
  <t-button block size="large" theme="primary" loading="{{pushing}}" bind:tap="onSubmit">确认推送</t-button>
</view>

<t-toast id="t-toast" />
