/* 表单卡片 */
.form-card {
  padding: 28rpx;
}

.f-item + .f-item {
  margin-top: 28rpx;
}

.f-label {
  font-size: 22rpx;
  color: #6B7690;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

/* 输入区（暖底圆角，与员工管理弹层同款） */
.f-field {
  background: #F4F1EA;
  border-radius: 12rpx;
  padding: 0 16rpx;
}

.f-field-area {
  padding: 8rpx 16rpx;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  color: #C4BBA6;
  font-size: 22rpx;
}

/* 提交按钮（固定底部，避开右上角胶囊区域） */
.create-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #F4F1EA;
}
