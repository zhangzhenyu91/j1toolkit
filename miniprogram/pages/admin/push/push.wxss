/* 表单卡片 */
.form-card {
  padding: 28rpx;
}

.f-item + .f-item {
  margin-top: 28rpx;
}

/* 标签与输入区（.f-label/.f-field 已上移 app.wxss 共用，暖底圆角与员工管理弹层同款） */

.f-field-area {
  padding: 8rpx 16rpx;
}

/* 内容编辑工具条（插入图片 / 预览） */
.md-tools {
  display: flex;
  gap: 24rpx;
  margin-bottom: 10rpx;
}

.md-tool {
  font-size: 24rpx;
  font-weight: 500;
  color: #F26D21;
  padding: 6rpx 4rpx;
}

/* Markdown 预览区（排版由 mdTagStyle / mdContainerStyle 控制） */
.md-preview {
  background: #F4F1EA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  min-height: 120rpx;
}

.md-preview-empty {
  font-size: 24rpx;
  color: #A89F8A;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  color: #C4BBA6;
  font-size: 22rpx;
}

/* 提交按钮（固定底部，避开右上角胶囊区域） */
.create-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #F4F1EA;
}
