/* 班组筛选 tab（横向滚动 chips，选中态藏青底白字） */
.ttabs-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.ttabs {
  display: flex;
  gap: 16rpx;
}

.ttab {
  flex: none;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #6B7690;
  background: #FFFFFF;
  border: 1rpx solid #E3DCCB;
}

.ttab.on {
  background: #22314E;
  border-color: #22314E;
  color: #FFFFFF;
}

/* 关键词搜索框 */
.search-field {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

/* 分组标题（橙条 + 班组名 + 人数） */
.grp-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #22314E;
  margin: 16rpx 0 14rpx;
}

.grp-title::before {
  content: '';
  width: 8rpx;
  height: 24rpx;
  background: #F26D21;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.grp-cnt {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #A89F8A;
}

.list-card {
  overflow: hidden;
  margin-bottom: 8rpx;
}

.u-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  transition: background-color 0.15s ease;
}

.u-item + .u-item {
  border-top: 1rpx solid #F0EBDD;
}

.u-item-off {
  opacity: 0.55;
}

.u-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #22314E;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.u-avatar-off {
  background: #C4BBA6;
}

.u-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.u-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #22314E;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.u-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #A89F8A;
}

/* 角色徽章（超管=藏青底 / 班组管理员=橙描边 / 普通用户=灰底） */
.role {
  flex: none;
  border-radius: 8rpx;
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.6;
}

.role-admin {
  background: #22314E;
  color: #FFFFFF;
}

.role-team_admin {
  border: 1rpx solid #F26D21;
  color: #F26D21;
}

.role-user {
  background: #EDF0F6;
  color: #6B7690;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  color: #C4BBA6;
  font-size: 22rpx;
}

/* 新建员工按钮（固定底部，避开右上角胶囊区域） */
.create-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #F4F1EA;
}

/* ---------- 新建 / 编辑员工弹层 ---------- */
.sheet {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx 48rpx;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
}

.sh-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.sh-title {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.sh-sub {
  margin-left: 14rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #A89F8A;
}

.sh-close {
  margin-left: auto;
  padding: 6rpx;
}

.sh-body {
  padding-bottom: 4rpx;
  max-height: 52vh;
}

.f-item {
  margin-bottom: 20rpx;
}

.f-label {
  font-size: 22rpx;
  color: #6B7690;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.f-field {
  background: #F4F1EA;
  border-radius: 12rpx;
  padding: 0 16rpx;
}

/* 班组下拉 */
.f-in {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F4F1EA;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  font-size: 26rpx;
  color: #22314E;
}

.f-in-ph {
  color: #A89F8A;
}

.team-opts {
  margin-top: 10rpx;
  background: #FFFFFF;
  border: 1rpx solid #E3DCCB;
  border-radius: 12rpx;
  overflow: hidden;
}

.opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #22314E;
}

.opt + .opt {
  border-top: 1rpx solid #F0EBDD;
}

.opt-on {
  color: #F26D21;
  font-weight: 600;
}

/* 角色三选分段控件 */
.seg {
  display: flex;
  gap: 16rpx;
}

.seg-off {
  opacity: 0.5;
}

.sg {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid #E3DCCB;
  background: #FFFFFF;
  font-size: 23rpx;
  font-weight: 600;
  color: #6B7690;
}

.sg-on {
  border-color: #F26D21;
  color: #F26D21;
  background: #FDEEE2;
}

.f-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fr-lab {
  font-size: 26rpx;
  font-weight: 600;
  color: #22314E;
}

.sh-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #A89F8A;
  line-height: 1.8;
}

.sh-foot {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sum {
  font-size: 22rpx;
  color: #6B7690;
}

.pwd-link {
  font-size: 24rpx;
  color: #6B7690;
}

.btn-primary {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  background: #22314E;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-disabled {
  opacity: 0.6;
}
