/* 班组筛选 tab（.ttabs/.ttab 选中态等已上移 app.wxss 共用；此处仅留本页下外边距） */
.ttabs-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

/* 关键词搜索框 */
.search-field {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

/* 分组标题（.grp-title/.grp-cnt 已上移 app.wxss 共用） */

.list-card {
  overflow: hidden;
  margin-bottom: 8rpx;
}

/* 员工行（.u-item 布局与分隔线已上移 app.wxss 共用，此处仅留本页 padding） */
.u-item {
  padding: 24rpx 28rpx;
}

.u-item-off {
  opacity: 0.55;
}

.u-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #0e3da8;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.u-avatar-off {
  background: #e5e6eb;
}

.u-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.u-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d2129;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.u-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(29, 33, 41, 0.4);
}

/* 角色徽章（超管=墨底 / 班组管理员=蓝描边 / 普通用户=灰底） */
.role {
  flex: none;
  border-radius: 12rpx;
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.6;
}

.role-admin {
  background: #0e3da8;
  color: #ffffff;
}

.role-team_admin {
  border: 1rpx solid #0e3da8;
  color: #0e3da8;
}

.role-user {
  background: #e8f0ff;
  color: #4e5969;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  color: #e5e6eb;
  font-size: 22rpx;
}

/* 新建员工按钮（固定底部，避开右上角胶囊区域） */
.create-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
}

/* ---------- 新建 / 编辑员工弹层（直角 + 顶部墨线；.sh-head/.sh-title/.sh-sub/.sh-close/.f-label/.f-field/.sh-note/.btn-disabled 已上移 app.wxss 共用） ---------- */
.sheet {
  background: #ffffff;
  border-radius: 12rpx;
  border-top: 2rpx solid #e5e6eb;
  padding: 28rpx 32rpx 48rpx;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
}

.sh-body {
  padding-bottom: 4rpx;
  max-height: 52vh;
}

.f-item {
  margin-bottom: 20rpx;
}

/* 班组下拉 */
.f-in {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  font-size: 26rpx;
  color: #1d2129;
}

.f-in-ph {
  color: rgba(29, 33, 41, 0.4);
}

.team-opts {
  margin-top: 10rpx;
  background: #ffffff;
  border: 1rpx solid #e5e6eb;
  border-radius: 12rpx;
  overflow: hidden;
}

.opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #1d2129;
}

.opt + .opt {
  border-top: 1rpx solid #e5e6eb;
}

.opt-on {
  color: #0e3da8;
  font-weight: 600;
}

/* 角色三选分段控件 */
.seg {
  display: flex;
  gap: 16rpx;
}

.seg-off {
  opacity: 0.5;
}

.sg {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid #e5e6eb;
  background: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
  color: #4e5969;
}

.sg-on {
  border-color: #0e3da8;
  color: #0e3da8;
  background: #e8f0ff;
}

.f-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fr-lab {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d2129;
}

.sh-foot {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sum {
  font-size: 22rpx;
  color: #4e5969;
}

.pwd-link {
  font-size: 24rpx;
  color: #4e5969;
}

.btn-primary {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  background: #0e3da8;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
