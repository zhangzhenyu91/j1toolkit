/* 班组筛选 tab（横向滚动 chips，选中态藏青底白字） */
.ttabs-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.ttabs {
  display: flex;
  gap: 16rpx;
}

.ttab {
  flex: none;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #6B7690;
  background: #FFFFFF;
  border: 1rpx solid #E3DCCB;
}

.ttab.on {
  background: #22314E;
  border-color: #22314E;
  color: #FFFFFF;
}

/* 分组标题（橙条 + 班组名 + 人数） */
.grp-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #22314E;
  margin: 16rpx 0 14rpx;
}

.grp-title::before {
  content: '';
  width: 8rpx;
  height: 24rpx;
  background: #F26D21;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.grp-cnt {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #A89F8A;
}

.list-card {
  overflow: hidden;
  margin-bottom: 8rpx;
}

/* ---------- 员工行 ---------- */
.u-item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  transition: background-color 0.15s ease;
}

.u-item + .u-item {
  border-top: 1rpx solid #F0EBDD;
}

.u-item-on {
  background: #FDF6EF;
}

.u-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: #22314E;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.u-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.u-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #22314E;
}

.u-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A89F8A;
}

/* ---------- 应用行 ---------- */
.app-sec {
  margin-top: 32rpx;
}

.a-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  transition: background-color 0.15s ease;
}

.a-item + .a-item {
  border-top: 1rpx solid #F0EBDD;
}

.cbx {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #D9CFBA;
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
  margin-right: 20rpx;
  flex: none;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.cbx-on {
  background: #F26D21;
  border-color: #F26D21;
}

.a-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: #FDEEE2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.a-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.a-name {
  font-size: 28rpx;
  color: #22314E;
  font-weight: 500;
}

.a-key {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A89F8A;
}

.save-bar {
  margin-top: 32rpx;
}

.hint {
  margin-top: 48rpx;
  text-align: center;
  color: #C4BBA6;
  font-size: 24rpx;
}
