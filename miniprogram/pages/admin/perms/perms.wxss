/* 班组筛选 tab（.ttabs/.ttab 选中态等已上移 app.wxss 共用；此处仅留本页下外边距） */
.ttabs-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

/* 分组标题（.grp-title/.grp-cnt 已上移 app.wxss 共用） */

.list-card {
  overflow: hidden;
  margin-bottom: 8rpx;
}

/* ---------- 员工行（.u-item 布局与分隔线已上移 app.wxss 共用，此处仅留本页 padding） ---------- */
.u-item {
  padding: 20rpx 28rpx;
}

.u-item-on {
  background: #EDF2FE;
}

.u-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 0;
  background: #111111;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.u-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.u-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #111111;
}

.u-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(17,17,17,.4);
}

/* ---------- 应用行 ---------- */
.app-sec {
  margin-top: 32rpx;
}

.a-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  transition: background-color 0.15s ease;
}

.a-item + .a-item {
  border-top: 1rpx solid #E7E1D2;
}

.cbx {
  width: 36rpx;
  height: 36rpx;
  border-radius: 0;
  border: 2rpx solid rgba(17,17,17,.35);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
  margin-right: 20rpx;
  flex: none;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.cbx-on {
  background: #1D4ED8;
  border-color: #1D4ED8;
}

.a-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 0;
  background: #EDF2FE;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.a-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.a-name {
  font-size: 28rpx;
  color: #111111;
  font-weight: 500;
}

.a-key {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(17,17,17,.4);
}

.save-bar {
  margin-top: 32rpx;
}

.hint {
  margin-top: 48rpx;
  text-align: center;
  color: #C4BBA6;
  font-size: 24rpx;
}
