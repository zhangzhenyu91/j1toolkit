/* 班组筛选 tab（.ttabs/.ttab 选中态等已上移 app.wxss 共用；此处仅留本页下外边距） */
.ttabs-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

/* 班组筛选 chip 状态切换过渡（短过渡，减弱动态效果时全局关闭） */
.ttab {
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease,
    color 0.15s ease;
}

/* 分组标题（.grp-title/.grp-cnt 已上移 app.wxss 共用） */

.list-card {
  overflow: hidden;
  margin-bottom: 8rpx;
}

/* ---------- 员工行（.u-item 布局与分隔线已上移 app.wxss 共用，此处仅留本页 padding） ---------- */
.u-item {
  padding: 20rpx 28rpx;
}

.u-item-on {
  background: var(--app-brand-light);
  transition: background-color 0.15s ease;
}

.u-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand); /* 品牌底前景色 */
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.u-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.u-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--app-text-primary);
}

.u-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

/* ---------- 应用行 ---------- */
.app-sec {
  margin-top: 32rpx;
}

.a-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  transition: background-color 0.15s ease;
}

.a-item + .a-item {
  border-top: 1rpx solid var(--app-border);
}

.cbx {
  width: 36rpx;
  height: 36rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  color: var(--app-on-brand); /* 勾选白字（品牌底前景色） */
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
  margin-right: 20rpx;
  flex: none;
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease;
}

.cbx-on {
  background: var(--app-brand);
  border-color: var(--app-brand);
}

.a-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.a-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.a-name {
  font-size: 28rpx;
  color: var(--app-text-primary);
  font-weight: 500;
}

.a-key {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

.save-bar {
  margin-top: 32rpx;
}

.hint {
  margin-top: 48rpx;
  text-align: center;
  color: var(--app-text-tertiary);
  font-size: 24rpx;
}

/* 宽屏双栏容器（手机竖屏为普通块级流，布局不变） */
.perm-cols {
  display: block;
}

.perm-main,
.perm-side {
  min-width: 0;
}

/* ---------- t-icon 字号（size 属性写内联 rpx 会随屏宽膨胀，改由外部样式类控制） ---------- */
.ico-44 {
  font-size: 44rpx;
}

.ico-40 {
  font-size: 40rpx;
}

/* ---------- iPad / 宽屏适配（CSS 媒体查询；普通手机竖屏不受影响） ----------
   600px 起限宽 + 关键字阶/控件改固定 px；900px 起员工选择与应用授权左右双栏 */
@media (min-width: 600px) {
  .page-body {
    box-sizing: border-box;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .u-name,
  .a-name {
    font-size: 14px;
  }

  .u-sub,
  .a-key {
    font-size: 11px;
  }

  .hint {
    font-size: 12px;
  }

  .u-avatar {
    width: 36px;
    height: 36px;
    font-size: 16px;
    border-radius: 8px;
  }

  .a-ico {
    width: 36px;
    height: 36px;
    border-radius: 8px;
  }

  .cbx {
    width: 18px;
    height: 18px;
    line-height: 18px;
    font-size: 12px;
    border-radius: 6px;
    border-width: 1px;
    margin-right: 10px;
  }

  .ico-44 {
    font-size: 22px;
  }

  .ico-40 {
    font-size: 20px;
  }
}

@media (min-width: 900px) {
  .page-body {
    max-width: 960px;
  }

  /* 员工选择 | 应用授权 双栏（选择员工后授权区并排展示，不把拉宽当适配） */
  .perm-cols {
    display: flex;
    align-items: flex-start;
    gap: 32px;
  }

  .perm-main {
    flex: 3;
  }

  .perm-side,
  .hint {
    flex: 2;
  }
}

@media (min-width: 1200px) {
  .page-body {
    max-width: 1120px;
  }
}
