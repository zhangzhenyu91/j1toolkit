<!-- 班组管理（仅超管）：班组列表 + 新增/编辑弹层 -->
<navbar back title="班组管理" />

<view class="page-body">
  <view class="section-title sec">班组列表<text class="sec-right">共 {{teams.length}} 个</text></view>

  <t-empty wx:if="{{!loading && teams.length === 0}}" description="暂无班组，点击下方按钮新增" />

  <view
    class="trow"
    hover-class="hover-bg-warm"
    wx:for="{{teams}}"
    wx:key="id"
    data-index="{{index}}"
    bindtap="openEdit"
  >
    <view class="trow-main">
      <view class="tn">
        {{item.name}}
        <text class="def-pill" wx:if="{{item.isDefault}}">默认班组</text>
        <text class="stop-pill" wx:if="{{item.status !== 1}}">已停用</text>
      </view>
      <view class="tm">成员 {{item.user_count}} 人</view>
    </view>
    <view class="go">编辑 ›</view>
  </view>

  <view class="tip-line">删除仅限无任何数据的班组；有数据的班组只能停用，停用后不再出现在任何选择器，历史数据保留。</view>
</view>

<!-- 新增班组（固定底部主按钮，避开右上角胶囊区域） -->
<view class="create-bar">
  <t-button block size="large" theme="primary" icon="add" bind:tap="openAdd">新增班组</t-button>
</view>

<!-- 新增 / 编辑班组弹层 -->
<t-popup visible="{{showEdit}}" placement="bottom" bind:visible-change="onVisibleChange">
  <view class="sheet">
    <view class="sh-head">
      <view class="sh-title">{{form.id ? '编辑班组' : '新增班组'}}<text class="sh-sub" wx:if="{{form.id}}">{{form.name}}</text></view>
      <view class="sh-close" hover-class="hover-opacity" bindtap="closeEdit">
        <t-icon name="close" size="36rpx" color="#4E5969" />
      </view>
    </view>

    <view class="sh-body">
      <view class="f-item">
        <view class="f-label">班组名称</view>
        <view class="f-field">
          <t-input borderless placeholder="如：运维二班" value="{{form.name}}" data-k="name" bind:change="onField" />
        </view>
      </view>
      <view class="f-item f-row" wx:if="{{form.id}}">
        <view class="fr-lab">启用状态</view>
        <t-switch value="{{form.status === 1}}" bind:change="onStatusChange" />
      </view>
    </view>

    <view class="sh-note">
      班组改名自动级联安全日记录与 docs 子目录。班组改名后，GLKVM 平台侧同名设备组需同步改名，否则本班组的远程连接 / 文件传输将回退显示默认班组设备。
    </view>

    <view class="sh-foot">
      <view class="del-link" hover-class="hover-opacity" wx:if="{{form.id}}" bindtap="onDelete">删除班组</view>
      <view class="sum" wx:else>新增班组默认启用</view>
      <view class="btn-primary {{saving ? 'btn-disabled' : ''}}" hover-class="hover-opacity" bindtap="onSave">保 存</view>
    </view>
  </view>
</t-popup>

<t-dialog id="t-dialog" />
<t-toast id="t-toast" />
