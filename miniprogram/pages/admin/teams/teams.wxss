.sec {
  margin: 8rpx 0 20rpx;
}

.sec-right {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: #A89F8A;
}

/* 班组行 */
.trow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
  transition: background-color 0.15s ease;
}

.trow-main {
  flex: 1;
  min-width: 0;
}

.tn {
  display: flex;
  align-items: center;
  font-size: 29rpx;
  font-weight: 700;
  color: #22314E;
}

.def-pill {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #FDEEE2;
  color: #F26D21;
  font-size: 20rpx;
  font-weight: 600;
}

.stop-pill {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #EDF0F6;
  color: #6B7690;
  font-size: 20rpx;
  font-weight: 600;
}

.tm {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #A89F8A;
}

.go {
  flex: none;
  font-size: 24rpx;
  color: #A89F8A;
}

.tip-line {
  margin-top: 24rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.8;
  color: #C4BBA6;
}

/* 新增班组按钮（固定底部，避开右上角胶囊区域） */
.create-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #F4F1EA;
}

/* ---------- 新增 / 编辑弹层 ---------- */
.sheet {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx 48rpx;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
}

.sh-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.sh-title {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.sh-sub {
  margin-left: 14rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #A89F8A;
}

.sh-close {
  margin-left: auto;
  padding: 6rpx;
}

.sh-body {
  padding-bottom: 4rpx;
}

.f-item {
  margin-bottom: 20rpx;
}

.f-label {
  font-size: 22rpx;
  color: #6B7690;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.f-field {
  background: #F4F1EA;
  border-radius: 12rpx;
  padding: 0 16rpx;
}

.f-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fr-lab {
  font-size: 26rpx;
  font-weight: 600;
  color: #22314E;
}

.sh-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #A89F8A;
  line-height: 1.8;
}

.sh-foot {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sum {
  font-size: 22rpx;
  color: #6B7690;
}

.del-link {
  font-size: 24rpx;
  color: #CF4444;
}

.btn-primary {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  background: #22314E;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-disabled {
  opacity: 0.6;
}
