.sec {
  margin: 8rpx 0 20rpx;
}

.sec-right {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(29,33,41,.4);
}

/* 班组行 */
.trow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
  transition: background-color 0.15s ease;
}

.trow-main {
  flex: 1;
  min-width: 0;
}

.tn {
  display: flex;
  align-items: center;
  font-size: 29rpx;
  font-weight: 700;
  color: #1D2129;
}

.def-pill {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: #E8F0FF;
  color: #0E3DA8;
  font-size: 20rpx;
  font-weight: 600;
}

.stop-pill {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: #E8F0FF;
  color: #4E5969;
  font-size: 20rpx;
  font-weight: 600;
}

.tm {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
}

.go {
  flex: none;
  font-size: 24rpx;
  color: rgba(29,33,41,.4);
}

.tip-line {
  margin-top: 24rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.8;
  color: #E5E6EB;
}

/* 新增班组按钮（固定底部，避开右上角胶囊区域） */
.create-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #F5F7FA;
}

/* ---------- 新增 / 编辑弹层（直角 + 顶部墨线；.sh-head/.sh-title/.sh-sub/.sh-close/.f-label/.f-field/.sh-note/.btn-disabled 已上移 app.wxss 共用） ---------- */
.sheet {
  background: #FFFFFF;
  border-radius: 12rpx;
  border-top: 2rpx solid #E5E6EB;
  padding: 28rpx 32rpx 48rpx;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
}

.sh-body {
  padding-bottom: 4rpx;
}

.f-item {
  margin-bottom: 20rpx;
}

.f-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fr-lab {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D2129;
}

.sh-foot {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sum {
  font-size: 22rpx;
  color: #4E5969;
}

.del-link {
  font-size: 24rpx;
  color: #F53F3F;
}

.btn-primary {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  background: #0E3DA8;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
