/* 顶部操作条（删除已读 / 全部已读入口，右对齐） */
.top-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 16rpx;
}

.read-all {
  padding: 8rpx 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #0E3DA8;
}

/* 删除已读（红色小字，与单条删除同色） */
.del-read {
  padding: 8rpx 4rpx;
  margin-right: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #F53F3F;
}

.list-card {
  overflow: hidden;
}

.n-item {
  padding: 24rpx 28rpx;
  transition: background-color 0.15s ease;
}

.n-item + .n-item {
  border-top: 1rpx solid #E5E6EB;
}

.n-head {
  display: flex;
  align-items: center;
}

/* 未读圆点（已读透明占位，保持标题对齐） */
.n-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: transparent;
  flex: none;
  margin-right: 12rpx;
}

.n-dot-on {
  background: #0E3DA8;
}

.n-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1D2129;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.n-title-unread {
  font-weight: 600;
}

.n-time {
  margin-left: 16rpx;
  flex: none;
  font-size: 22rpx;
  color: rgba(29,33,41,.4);
}

/* 内容摘要：默认 2 行省略（展开态改由 mp-html 渲染 Markdown） */
.n-content {
  margin-top: 12rpx;
  padding-left: 24rpx; /* 与标题左对齐（圆点占位宽度） */
  font-size: 24rpx;
  color: #4E5969;
  line-height: 1.7;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 展开态 Markdown 渲染容器（排版由 mdTagStyle / mdContainerStyle 控制） */
.n-content-md {
  margin-top: 12rpx;
  padding-left: 24rpx;
}

/* 删除入口（标题行右侧红色小字；全员可见，超管全局删除） */
.n-del {
  margin-left: 16rpx;
  flex: none;
  font-size: 22rpx;
  color: #F53F3F;
  padding: 4rpx 8rpx;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  color: #E5E6EB;
  font-size: 22rpx;
}
