/* 顶部操作条（删除已读 / 全部已读入口，右对齐） */
.top-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 16rpx;
}

.read-all {
  padding: 8rpx 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--app-brand);
  transition: opacity 0.15s ease;
}

/* 删除已读（红色小字，与单条删除同色） */
.del-read {
  padding: 8rpx 4rpx;
  margin-right: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--app-danger-text);
  transition: opacity 0.15s ease;
}

.list-card {
  overflow: hidden;
}

.n-item {
  padding: 24rpx 28rpx;
  transition: background-color 0.15s ease;
}

.n-item + .n-item {
  border-top: 1rpx solid var(--app-border);
}

.n-head {
  display: flex;
  align-items: center;
}

/* 未读圆点（已读透明占位，保持标题对齐） */
.n-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: transparent;
  flex: none;
  margin-right: 12rpx;
}

.n-dot-on {
  background: var(--app-brand);
}

.n-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--app-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.n-title-unread {
  font-weight: 600;
}

.n-time {
  margin-left: 16rpx;
  flex: none;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

/* 内容摘要：默认 2 行省略（展开态改由 mp-html 渲染 Markdown） */
.n-content {
  margin-top: 12rpx;
  padding-left: 24rpx; /* 与标题左对齐（圆点占位宽度） */
  font-size: 24rpx;
  color: var(--app-text-secondary);
  line-height: 1.7;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 全文展开/收起：保留已渲染内容，grid 过渡；首次展开才创建 mp-html */
.n-expand {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition:
    grid-template-rows 0.24s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.18s ease;
}

.n-expand.is-open {
  grid-template-rows: 1fr;
  opacity: 1;
}

.n-expand-in {
  min-height: 0;
  overflow: hidden;
}

/* 展开态 Markdown 渲染容器（排版由 mdTagStyle / mdContainerStyle 控制） */
.n-content-md {
  margin-top: 12rpx;
  padding-left: 24rpx;
}

/* 删除入口（标题行右侧红色小字；全员可见，超管全局删除） */
.n-del {
  margin-left: 16rpx;
  flex: none;
  font-size: 22rpx;
  color: var(--app-danger-text);
  padding: 4rpx 8rpx;
  transition: opacity 0.15s ease;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  color: var(--app-text-tertiary);
  font-size: 22rpx;
}
