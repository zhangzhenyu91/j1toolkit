<!-- 消息通知列表（点击行展开/收起全文，未读展开即标记已读） -->
<navbar back title="消息通知" />

<view class="page-body">
  <!-- 顶部操作条（删除已读常驻于有已读时；全部已读仅有未读时显示，右对齐避开右上角胶囊区） -->
  <view class="top-bar" wx:if="{{unread > 0 || hasRead}}">
    <view class="del-read" hover-class="hover-opacity" bindtap="onDelRead" wx:if="{{hasRead}}">删除已读</view>
    <view class="read-all" hover-class="hover-opacity" bindtap="onReadAll" wx:if="{{unread > 0}}">全部已读</view>
  </view>

  <t-empty wx:if="{{!loading && items.length === 0}}" description="暂无通知" />

  <view class="card list-card" wx:if="{{items.length > 0}}">
    <view
      class="n-item"
      hover-class="hover-bg-warm"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onItemTap"
    >
      <view class="n-head">
        <view class="n-dot {{item.read ? '' : 'n-dot-on'}}"></view>
        <view class="n-title {{item.read ? '' : 'n-title-unread'}}">{{item.title}}</view>
        <view class="n-time">{{item.timeText}}</view>
        <view class="n-del" data-id="{{item.id}}" catchtap="onDelete">删除</view>
      </view>
      <!-- 折叠：原文两行摘要；展开：Markdown 渲染（mp-html 支持图片点击预览） -->
      <view class="n-content" wx:if="{{!item.expanded}}">{{item.content}}</view>
      <view class="n-content-md" wx:else>
        <mp-html content="{{item.html}}" tag-style="{{mdTagStyle}}" container-style="{{mdContainerStyle}}" />
      </view>
    </view>
  </view>

  <view class="hint" wx:if="{{items.length > 0}}">点击通知可展开全文</view>
</view>

<t-toast id="t-toast" />
