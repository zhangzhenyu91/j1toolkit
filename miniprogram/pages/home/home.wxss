/* ============================================================
   首页 ·「政企蓝白 Enterprise Blue」—— 深蓝页首 / 数据浮层 / 宫格 / 通知 / 我的
   设计稿基准：design/小程序-首页.html（1px=2rpx）
   ============================================================ */

/* ---------- 主面板滑动容器（首页 / 我的 左右切换） ---------- */
.main-swiper {
  height: 100vh;
}

.panel {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.panel-scroll {
  flex: 1;
  min-height: 0;
}

/* ---------- 深蓝页首延伸区（与 navbar 同色 #0A3592；底部留白承接数据卡浮层） ---------- */
.hero {
  background: #0A3592;
  padding: 12rpx 40rpx 96rpx;
  animation: fadeIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hero-name {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #FFFFFF;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 0.5rpx;
}

/* 首页内容区：顶部不留 padding，数据卡以负边距半压深蓝页首 */
.home-body {
  padding-top: 0;
}

/* ---------- 数据概览浮层卡（注意：承载容器不可加 overflow:hidden，会裁掉浮层顶部；
   position+z-index 保证浮层压在深蓝页首之上，真机不被页首盖住） ---------- */
.stats-card {
  position: relative;
  z-index: 1;
  margin-top: -56rpx;
  margin-bottom: 32rpx;
  display: flex;
  padding: 30rpx 0;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.08s backwards;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat + .stat {
  border-left: 1rpx solid #E5E6EB;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1D2129;
  font-variant-numeric: tabular-nums;
}

/* 分级着色：全部达标绿 / ≤3 橙 / >3 红（默认值即正文深色，未加载时 — 不着色） */
.stat-num-good {
  color: #00B42A;
}

.stat-num-warn {
  color: #FF7D00;
}

.stat-num-bad {
  color: #F53F3F;
}

.stat-num-blue {
  color: #0E3DA8;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #86909C;
}

/* ---------- 消息通知卡 ---------- */
.notice-card {
  margin-bottom: 32rpx;
  padding: 26rpx 28rpx 10rpx;
  transition: background-color 0.15s ease;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.16s backwards;
}

.n-head {
  display: flex;
  align-items: center;
  padding-bottom: 18rpx;
}

/* 铃铛图标块：浅蓝底圆角方块 */
.n-ico {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #E8F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.n-title {
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
}

/* 未读计数：红点 + 红字（0 未读时不渲染） */
.n-badge {
  margin-left: auto;
  margin-right: 6rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #F53F3F;
  font-size: 22rpx;
  font-weight: 600;
}

.n-badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #F53F3F;
}

/* 通知行：未读红点 / 已读空心点 + 行间发丝线 */
.n-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #E5E6EB;
}

.n-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #F53F3F;
}

.n-dot-read {
  background: transparent;
  border: 2rpx solid #C9CDD4;
  box-sizing: border-box;
}

.n-row-title {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #4E5969;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.n-row-unread {
  color: #1D2129;
  font-weight: 600;
}

.n-row-time {
  margin-left: 16rpx;
  flex: none;
  font-size: 22rpx;
  color: #86909C;
  font-variant-numeric: tabular-nums;
}

.n-empty {
  padding: 18rpx 0 12rpx;
  border-top: 1rpx solid #E5E6EB;
  font-size: 24rpx;
  color: #86909C;
}

/* ---------- 应用宫格（无底块深蓝图标直落白卡） ---------- */
.app-sec {
  margin-bottom: 20rpx;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.22s backwards;
}

.grid-card {
  padding: 32rpx 12rpx 24rpx;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.28s backwards;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 32rpx;
}

.g-item {
  width: 25%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.g-ico {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.g-name {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #1D2129;
  text-align: center;
  line-height: 1.4;
}

.g-name-soon {
  color: #86909C;
}

.empty {
  padding: 24rpx 28rpx 32rpx;
  text-align: center;
  color: #86909C;
  font-size: 24rpx;
}

/* 底部提示（纯文字，无几何记号） */
.tip {
  margin-top: 24rpx;
  text-align: center;
  color: #86909C;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* ---------- 启动门控加载页 ---------- */
.gate-loading {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F7FA;
}

.gate-logo {
  width: 160rpx;
  height: 160rpx;
  animation: gatePulse 1.2s ease-in-out infinite;
}

@keyframes gatePulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.85;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}

/* ---------- 「我的」面板（样式作用域 .me-panel，避免与首页类名冲突） ---------- */
.me-panel .me-card {
  margin-bottom: 32rpx;
  animation: fadeUp 0.3s ease both; /* 页面入场 */
}

.me-panel .me-body {
  display: flex;
  align-items: center;
  padding: 44rpx 32rpx 36rpx;
}

.me-panel .avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #0E3DA8;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.me-panel .me-info {
  margin-left: 24rpx;
  min-width: 0;
}

.me-panel .me-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D2129;
}

.me-panel .me-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4E5969;
}

/* 功能列表 */
.me-panel .cells-card {
  overflow: hidden;
  margin-bottom: 32rpx;
}

/* 「绑定商旅」行右侧状态文案（t-cell note 外部样式类）；已过期为危险红 */
.me-panel .sgcc-note {
  color: #86909C;
}

.me-panel .sgcc-note-expired {
  color: #F53F3F;
}

/* 过期警示前置红色三角感叹号图标 */
.me-panel .sgcc-note-expired::before {
  content: '';
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  margin-right: 6rpx;
  vertical-align: -3rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.me-panel .admin-sec {
  margin-bottom: 20rpx;
}

/* 退出登录 */
.me-panel .logout {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #F53F3F;
  font-size: 30rpx;
  font-weight: 600;
  transition: background-color 0.15s ease;
}
