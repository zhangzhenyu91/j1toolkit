<!-- 首页 · 应用中心 + 我的（同页双面板，tab 切换左右滑动） -->
<block wx:if="{{gate}}">
  <swiper
    class="main-swiper"
    current="{{tab === 'me' ? 1 : 0}}"
    duration="250"
    easing-function="easeOutCubic"
    disable-touch="{{true}}"
  >
    <!-- 首页面板（方案五：警示斜纹用户卡 + 宫格入口） -->
    <swiper-item>
      <view class="panel">
        <navbar title="Shade 壹匣" />
        <scroll-view scroll-y class="panel-scroll">
          <view class="page-body">
            <!-- 用户卡片 -->
            <view class="u-card card hazard-top">
              <view class="u-body">
                <view class="avatar">{{avatarChar}}</view>
                <view class="u-info">
                  <view class="u-name">{{greeting}}，{{userInfo.nickname || '同事'}}</view>
                  <view class="u-sub">
                    <text class="u-account">{{userInfo.username}}</text>
                  </view>
                </view>
                <view class="u-side">
                  <view class="u-date">{{today}}</view>
                  <view class="u-week">{{weekday}}</view>
                </view>
              </view>
            </view>

            <!-- 消息通知（未读角标 + 最新 2 条，整卡点击进入列表） -->
            <view class="card notice-card" hover-class="hover-bg-warm" bindtap="goNotices">
              <view class="n-head">
                <view class="n-ico">
                  <t-icon name="notification" size="36rpx" color="#F26D21" />
                </view>
                <view class="n-title">消息通知</view>
                <view class="n-badge" wx:if="{{noticeUnread > 0}}">{{noticeUnread}} 条未读</view>
                <t-icon name="chevron-right" size="36rpx" color="#C4BBA6" />
              </view>
              <block wx:if="{{notices.length > 0}}">
                <view class="n-row" wx:for="{{notices}}" wx:key="id">
                  <view class="n-row-title {{item.read ? '' : 'n-row-unread'}}">{{item.title}}</view>
                  <view class="n-row-time">{{item.timeText}}</view>
                </view>
              </block>
              <view wx:else class="n-empty">暂无通知</view>
            </view>

            <!-- 应用中心 -->
            <view class="section-title app-sec">应用中心</view>
            <view class="card grid-card">
              <view class="grid">
                <view
                  class="g-item"
                  hover-class="hover-scale"
                  wx:for="{{apps}}"
                  wx:key="app_key"
                  data-path="{{item.path}}"
                  data-name="{{item.name}}"
                  bindtap="onAppTap"
                >
                  <view class="g-ico">
                    <t-icon name="{{item.icon || 'app'}}" size="48rpx" color="#F26D21" />
                  </view>
                  <text class="g-name">{{item.name}}</text>
                </view>

                <!-- 预留应用入口（占位） -->
                <view class="g-item" hover-class="hover-scale" bindtap="onSoon">
                  <view class="g-ico g-soon">
                    <t-icon name="add" size="44rpx" color="#C9BEA6" />
                  </view>
                  <text class="g-name g-name-soon">敬请期待</text>
                </view>
              </view>

              <view wx:if="{{!loading && apps.length === 0}}" class="empty">
                暂无可用应用，请联系管理员开通权限
              </view>
            </view>

            <view class="tip">更多班组应用持续接入中</view>
          </view>
        </scroll-view>
      </view>
    </swiper-item>

    <!-- 我的面板（方案五：警示斜纹大卡 + 功能列表 + 退出登录） -->
    <swiper-item>
      <view class="panel me-panel">
        <navbar title="我的" />
        <scroll-view scroll-y class="panel-scroll">
          <view class="page-body">
            <!-- 用户大卡 -->
            <view class="me-card card hazard-top">
              <view class="me-body">
                <view class="avatar">{{avatarChar}}</view>
                <view class="me-info">
                  <view class="me-name">{{userInfo.nickname || '同事'}}</view>
                  <view class="me-sub">账号：{{userInfo.username || '-'}}</view>
                </view>
              </view>
            </view>

            <!-- 功能列表 -->
            <view class="card cells-card">
              <!-- 绑定商旅（出工日志扩展，仅出工日志权限可见）：三态文案 未绑定/已绑定/登录已过期（红字） -->
              <t-cell
                wx:if="{{hasWorklog}}"
                title="绑定商旅"
                left-icon="location"
                note="{{sgccNote}}"
                t-class-note="sgcc-note{{sgccExpired ? ' sgcc-note-expired' : ''}}"
                arrow
                hover
                bind:click="goSgccBind"
              />
              <t-cell
                title="我的权限"
                left-icon="key"
                note="{{appCount}} 个应用"
                arrow
                hover
                bind:click="onPerms"
              />
              <t-cell
                title="关于 Shade 壹匣"
                left-icon="book"
                note="v3.6.0k"
                arrow
                hover
                bordered="{{false}}"
                bind:click="onAbout"
              />
            </view>

            <!-- 管理功能（仅管理员可见） -->
            <block wx:if="{{userInfo.role === 'admin'}}">
              <view class="section-title admin-sec">管理功能</view>
              <view class="card cells-card">
                <t-cell
                  title="员工管理"
                  left-icon="usergroup"
                  note="账号与状态"
                  arrow
                  hover
                  bind:click="goUsers"
                />
                <t-cell
                  title="权限管理"
                  left-icon="lock-on"
                  note="应用授权"
                  arrow
                  hover
                  bind:click="goPerms"
                />
                <t-cell
                  title="消息推送"
                  left-icon="notification"
                  note="全员通知"
                  arrow
                  hover
                  bind:click="goPush"
                />
                <t-cell
                  title="班组管理"
                  left-icon="server"
                  note="班组与设备组"
                  arrow
                  hover
                  bordered="{{false}}"
                  bind:click="goTeams"
                />
              </view>
            </block>

            <!-- 退出登录 -->
            <view class="logout card" hover-class="hover-bg-warm" bindtap="onLogout">退出登录</view>
          </view>
        </scroll-view>
      </view>
    </swiper-item>
  </swiper>

  <tabbar active="{{tab}}" bind:switch="onTabSwitch" />
</block>

<!-- 启动加载页（自动登录校验中） -->
<view wx:else class="gate-loading">
  <image class="gate-logo" src="/assets/toolbox.png" mode="aspectFit" />
</view>

<t-dialog id="t-dialog" />
<t-toast id="t-toast" />
