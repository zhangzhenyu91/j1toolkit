/* 树障隐患记录 · 详情页（政企蓝白 token；弹层/照片区样式族同 index 页口径） */

/* tdesign 组件变量 */
page {
  --td-popup-border-radius: 24rpx;
  --td-dialog-border-radius: 24rpx;
  --td-toast-radius: 8rpx;
  --td-tag-round-border-radius: 12rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* 内容区底部为固定条留位（全局 .page-body 的 160rpx 之外再补底条高度） */
.page-body {
  padding-bottom: calc(160rpx + 140rpx + env(safe-area-inset-bottom));
}

/* 按压反馈：轻度变暗 */
.hover-opacity {
  opacity: 0.75 !important;
}

/* ---------- 头部卡（区段 + 状态点标 + 位置说明） ---------- */
.dt-head {
  padding: 28rpx;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.08s backwards;
}

.dt-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dt-section {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #1D2129;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dt-pos {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #86909C;
}

/* ---------- 内容卡（隐患信息 / 处理信息 / 照片） ---------- */
.dt-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

/* 全字段网格（两列） */
.dt-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.dg-f {
  width: 50%;
  min-width: 0;
  padding: 12rpx 16rpx 12rpx 0;
  box-sizing: border-box;
}

.dg-l {
  font-size: 20rpx;
  color: #86909C;
}

.dg-v {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #1D2129;
  word-break: break-all;
}

/* 垂直距离 ≤ 阈值：红字 + 浅红底胶囊突出 */
.dg-v.dg-v-bad {
  display: inline-block;
  padding: 2rpx 12rpx;
  background: #FFECE8;
  border-radius: 8rpx;
  color: #F53F3F;
  font-weight: 700;
}

/* 已处理信息：三列 */
.dt-handled {
  display: flex;
  margin-top: 12rpx;
}

.dh-f {
  flex: 1;
  min-width: 0;
  padding: 12rpx 16rpx 12rpx 0;
  box-sizing: border-box;
}

/* ---------- 照片三区 ---------- */
.pz {
  margin-top: 20rpx;
}

.pz-t {
  font-size: 22rpx;
  font-weight: 600;
  color: #4E5969;
}

.pz-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.pz-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: #F7F8FA;
}

.pz-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  border: 2rpx dashed #C9CDD4;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 辅证区无图占位：灰字、无交互 */
.pz-none {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #C9CDD4;
}

/* ---------- 底部固定条（删除 / 处理） ---------- */
.dt-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 删除记录：描边红字（危险操作弱化为次按钮形态） */
.dt-del {
  color: #F53F3F;
  border-color: #F53F3F;
}

/* ---------- 空态 ---------- */
.empty-box {
  margin-top: 28rpx;
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(29, 33, 41, 0.4);
}

/* ---------- 底部弹层（sheet 族同 index 页口径） ---------- */
.sheet {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #1D2129;
}

/* 表单字段（.f-label/.f-field 用 app.wxss 全局类） */
.f-item {
  margin-top: 24rpx;
}

.date-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  font-size: 26rpx;
  color: #1D2129;
}

.qtags {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid #E5E6EB;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #4E5969;
  letter-spacing: 6rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 12rpx;
  background: #0E3DA8;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-ghost.disabled,
.btn-dark.disabled {
  opacity: 0.5;
}
