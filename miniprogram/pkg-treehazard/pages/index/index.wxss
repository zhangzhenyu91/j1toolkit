/* 树障隐患记录（政企蓝白 token；看板仿首页 stats-card，弹层口径同出工日志 manage 页；
   颜色走 app.wxss --app-* 语义变量，深色随系统；弱化占位 #C9CDD4 / rgba(29,33,41,.4) 无对应
   token，浅色保持定稿值、深色单独覆盖） */

/* tdesign 组件变量 */
page {
  --td-popup-border-radius: 24rpx;
  --td-dialog-border-radius: 24rpx;
  --td-toast-radius: 8rpx;
  --td-tag-round-border-radius: 12rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* ---------- 看板四格卡（仿首页 stats-card；本页无深蓝页首，不负边距浮层） ---------- */
.stats-card {
  display: flex;
  padding: 30rpx 0;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.08s backwards;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.stat + .stat {
  border-left: 1rpx solid var(--app-border);
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--app-text-primary);
  font-variant-numeric: tabular-nums;
}

.stat-num-warn {
  color: var(--app-warning);
}

.stat-num-bad {
  color: var(--app-danger);
}

/* 要紧类计数为 0 / 未设阈值：不标红，弱化为辅助灰（仅 >0 才红显） */
.stat-num-mut {
  color: var(--app-text-tertiary);
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

/* ---------- 工具行（线路视图：阈值 / 同步 图标胶囊；台账视图：批量开关） ---------- */
.toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.tool {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 24rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease;
}

.tool .tool-t {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  max-width: 260rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  transition: color 0.15s ease;
}

.tool-on {
  background: var(--app-brand);
  border-color: var(--app-brand);
}

.tool-on .tool-t {
  color: var(--app-on-brand);
}

/* 图标化胶囊（班管入口，避免拥挤） */
.tool-ic {
  width: 64rpx;
  padding: 0;
  justify-content: center;
}

/* ---------- 搜索框（常置浅灰底，同网盘页口径） ---------- */
.search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--app-bg-nested);
  border-radius: 16rpx;
  margin-top: 28rpx;
}

.s-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  color: var(--app-text-primary);
}

.ph {
  color: #c9cdd4;
}

/* ---------- 线路大卡片（标题恒正文黑；计数着色：要紧>0 红字、=0 灰字 / 未处理>0 品牌蓝 / 均为 0 置灰；stagger 入场，delay 内联递增） ---------- */
.lcard {
  padding: 28rpx;
  animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

.lcard.s-ok .lc-st {
  color: var(--app-text-tertiary);
  font-weight: 400;
}

.search + .lcard {
  margin-top: 24rpx;
}

.lcard + .lcard {
  margin-top: 24rpx;
}

.lc-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lc-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lc-stats {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  margin-top: 14rpx;
}

.lc-st {
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.lc-warn {
  color: var(--app-brand);
  font-weight: 600;
}

.lc-bad {
  color: var(--app-danger);
  font-weight: 600;
}

.lc-total {
  color: var(--app-text-tertiary);
}

/* ---------- 台账视图：返回行 + 线路标题 ---------- */
.backrow {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 64rpx;
  margin-left: -8rpx;
  transition: opacity 0.15s ease;
}

.backrow-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--app-brand);
}

.ledger-head {
  margin-top: 8rpx;
}

.lh-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.lh-sub {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.lh-warn {
  color: var(--app-brand);
}

.lh-bad {
  color: var(--app-danger);
}

.lh-total {
  color: var(--app-text-tertiary);
}

/* ---------- FAB（导出，每页主按钮至多一枚；形态同网盘页；前景 --app-on-brand 图标继承） ---------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  z-index: 25;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(14, 61, 168, 0.35);
}

.fab-spacer {
  height: 160rpx;
}

/* ---------- 分组容器 ---------- */
.lgroup {
  margin-top: 8rpx;
}

/* ---------- 记录卡片（已处理整体降饱和） ---------- */
.thcard {
  position: relative;
  padding: 28rpx;
}

.thcard + .thcard {
  margin-top: 24rpx;
}

.thcard.done {
  background: var(--app-bg-nested);
}

/* 首行：勾选圆点（批量模式）+ 区段定宽块 + 垂距大字块（各卡竖向对齐）+ 状态点标（右推）+ 折叠/展开开关 */
.th-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.th-head .st-tag {
  margin-left: auto;
}

/* 次行发现时间沿用树种/数量、水平距离的普通字段字阶 */
.th-date {
  font-variant-numeric: tabular-nums;
}

.ck-ring {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  border-radius: 50%;
  border: 2rpx solid #c9cdd4;
  background: var(--app-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease;
}

.ck-ring.on {
  background: var(--app-brand);
  border-color: var(--app-brand);
}

.ck-ring.dis {
  background: var(--app-bg-nested);
  border-style: dashed;
}

/* 区段定宽块（首行第一块：固定宽度保证后随的垂距块各卡左缘竖向对齐），过长时本字省略 */
.th-section {
  flex: 0 0 220rpx;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 卡片字段块（折叠次行 树种×数量 / 水平距离；展开区其他信息同款两列） */
.th-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.th-f {
  width: 33.3333%;
  min-width: 0;
  padding: 10rpx 8rpx 10rpx 0;
  box-sizing: border-box;
}

.th-l {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
}

.th-v {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--app-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 首行垂距大字块（首行第二块：紧跟定宽区段块、各卡左缘竖向对齐；突出大字，≤ 阈值红显） */
.th-vbig {
  flex: none;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  font-variant-numeric: tabular-nums;
}

.th-vbig-bad {
  color: var(--app-danger);
}

/* 折叠/展开开关（首行右端，每卡一枚；点卡同效）：图标固定 chevron-down，展开态旋转 180° */
.th-fold {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.th-fold.th-fold-open {
  transform: rotate(180deg);
}

/* 展开区：其他信息 / 处理信息 / 处理前后照片区 / 操作按钮（grid-rows 折叠动画：常驻渲染、class 开关；旧 WebView 不支持 grid-rows 动画时退化为直切；辅证照片条已提到折叠态常驻） */
.th-more {
  margin-top: 8rpx;
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition:
    grid-template-rows 0.28s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.22s ease;
}

.th-more.th-more-open {
  grid-template-rows: 1fr;
  opacity: 1;
}

.th-more-in {
  min-height: 0;
  overflow: hidden;
}

/* 处理信息行（浅绿底 + 绿字，同网页端 rec-handled 口径） */
.th-handled {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  background: var(--app-success-bg);
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  font-size: 22rpx;
  color: var(--app-success-text);
}

.th-handled b {
  font-weight: 700;
}

/* ---------- 批量模式底部固定条 ---------- */
.bb-spacer {
  height: 140rpx;
}

.batchbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--app-bg-card);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.bb-info {
  flex: 1;
  font-size: 26rpx;
  color: var(--app-text-secondary);
  font-variant-numeric: tabular-nums;
}

.bb-btn {
  padding: 14rpx 48rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  transition: opacity 0.15s ease;
}

.bb-btn.disabled {
  opacity: 0.5;
}

/* ---------- 空态 ---------- */
.empty-box {
  margin-top: 28rpx;
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(29, 33, 41, 0.4);
}

/* ---------- 底部弹层（sheet 族同出工日志 manage 页口径；头/体/脚三段 flex，
   整体限高 + overflow:hidden，内容体 flex:1 1 auto 独立滚动） ---------- */
.sheet {
  position: relative;
  background: var(--app-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

.sheet-title {
  flex: none;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--app-text-primary);
}

/* 弹层内容体（flex-basis 用 auto：0 基准会把自适应高度弹层内容压没） */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* 弹层内非体块默认不参与收缩（头/说明/控件/脚），体块（scroll-view 或 .sheet-body）独占剩余空间并滚动 */
.sheet > view {
  flex: none;
}

.sheet > scroll-view,
.sheet > .sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角隐形关闭热区（closeBtn 未启用仍可点）：置空防误关 */
.t-popup__close {
  display: none;
}

/* 筛选项列表（限高滚动；导出弹层范围/线路单选复用） */
.flt-list {
  margin-top: 24rpx;
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.flt-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 16rpx;
  font-size: 28rpx;
  color: var(--app-text-primary);
  transition: color 0.15s ease;
}

.flt-item + .flt-item {
  border-top: 1rpx solid var(--app-border);
}

.flt-item.on {
  color: var(--app-brand);
  font-weight: 600;
}

/* 导出弹层：范围单选组与按线路分表开关行 */
.exp-scope {
  margin-top: 12rpx;
  background: var(--app-bg-nested);
  border-radius: 12rpx;
}

.exp-scope .flt-item + .flt-item {
  border-top-color: var(--app-bg-card);
}

.exp-split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.exp-split-l {
  flex: 1;
  min-width: 0;
}

.exp-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  line-height: 1.6;
}

/* 表单字段（.f-label/.f-field 用 app.wxss 全局类） */
.f-item {
  margin-top: 24rpx;
}

.date-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  font-size: 26rpx;
  color: var(--app-text-primary);
  transition: opacity 0.15s ease;
}

.qtags {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

/* 阈值说明 */
.th-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  line-height: 1.6;
}

/* 同步状态 */
.sync-box {
  margin-top: 24rpx;
  background: var(--app-bg-nested);
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
}

.sync-row {
  display: flex;
  gap: 24rpx;
  padding: 18rpx 0;
  font-size: 26rpx;
}

.sync-row + .sync-row {
  border-top: 1rpx solid var(--app-border);
}

.sync-l {
  width: 140rpx;
  flex: none;
  color: var(--app-text-tertiary);
}

.sync-v {
  flex: 1;
  min-width: 0;
  color: var(--app-text-primary);
}

.sheet-actions {
  flex: none;
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text-secondary);
  letter-spacing: 6rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: opacity 0.15s ease;
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: opacity 0.15s ease;
}

.btn-ghost.disabled,
.btn-dark.disabled {
  opacity: 0.5;
}

/* ---------- 台账卡照片区：辅证条折叠态常驻（只读），处理前/后区在展开区（可上传可删） ---------- */
.pz {
  margin-top: 20rpx;
}

.pz-t {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--app-text-secondary);
}

.pz-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.pz-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: var(--app-bg-nested);
}

/* 「+」格：上传入口（虚线占位） */
.pz-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  border: 2rpx dashed #c9cdd4;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

/* ---------- 台账卡展开区：操作行（删除居左，处理居右） ---------- */
.th-foot {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

/* 删除记录：描边红字（危险操作弱化为次按钮形态） */
.btn-act.btn-del {
  margin-right: auto;
  color: var(--app-danger);
  border-color: var(--app-danger);
  background: var(--app-danger-bg);
}

.btn-act {
  padding: 10rpx 36rpx;
  border: 2rpx solid var(--app-brand);
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 24rpx;
  font-weight: 700;
  transition: opacity 0.15s ease;
}

/* ---------- 动效（复用全局 fadeUp 上浮入场；全局 prefers-reduced-motion 已兜底） ---------- */
/* 记录卡 stagger 入场（delay 内联递增；已处理卡降饱和不走入场，防 fadeUp 结束后 opacity 回落跳变） */
.thcard-in {
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

/* 线路 ↔ 台账视图切换：整块淡入过渡（wx:if 重建即重播） */
.view-pane {
  animation: fadeUp 0.45s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

/* 次行无发现时间时两项均分；有 found_at 时补第三项，三个字段同一行均分 */
.th-f {
  width: 50%;
}

.th-grid.has-found .th-f {
  width: 33.3333%;
}

/* ---------- t-icon 外部样式类（size 属性写内联 rpx 会随屏宽膨胀，改由 t-class 控制字号；
   图标色不经 color 属性传 var()，经 t-class/父级颜色继承，随 --app-* 深浅） ---------- */
.ico-22 {
  font-size: 22rpx;
}

.ico-28 {
  font-size: 28rpx;
}

.ico-30 {
  font-size: 30rpx;
}

.ico-32 {
  font-size: 32rpx;
}

.ico-36 {
  font-size: 36rpx;
}

.ico-44 {
  font-size: 44rpx;
}

.ico-brand {
  color: var(--app-brand);
}

.ico-weak {
  color: var(--app-text-tertiary);
}

.ico-warning {
  color: var(--app-warning);
}

.ico-on-brand {
  color: var(--app-on-brand);
}

/* 弱化占位（#C9CDD4 / rgba(29,33,41,.4) 无 --app-* 对应 token：浅色保持定稿值，深色随系统） */
@media (prefers-color-scheme: dark) {
  .ph,
  .empty-box {
    color: rgba(255, 255, 255, 0.4);
  }

  .ck-ring {
    border-color: rgba(255, 255, 255, 0.4);
  }

  .pz-add {
    border-color: #626d7d;
  }
}

/* ---------- iPad / 宽屏适配（CSS 媒体查询；普通手机竖屏不受影响） ----------
   600px 起限宽 + 关键字阶/控件改固定 px；900px 起线路卡/记录卡双列（卡宽约 460px，
   首行与次行三字段仍同排——树种×数量｜水平距离｜发现时间（仅 found_at，空值省略）） */
@media (min-width: 600px) {
  .page-body {
    box-sizing: border-box;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .batchbar {
    left: 50%;
    right: auto;
    width: 100%;
    max-width: 680px;
    box-sizing: border-box;
    transform: translateX(-50%);
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
  }

  /* 弹层限宽居中（FAB 保持贴屏右缘，避免限宽区间出现负偏移） */
  .sheet {
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .stat-num,
  .lh-title,
  .th-section,
  .th-vbig,
  .lc-title {
    font-size: 16px;
  }

  .stat-label,
  .th-l,
  .exp-tip,
  .th-tip,
  .pz-t {
    font-size: 10.5px;
  }

  .tool-t,
  .lc-st,
  .lh-sub,
  .th-v,
  .backrow-t {
    font-size: 12px;
  }

  .tool {
    height: 32px;
    padding: 0 12px;
  }

  .search {
    height: 36px;
    margin-top: 14px;
  }

  .s-input {
    height: 36px;
    font-size: 13px;
  }

  .th-section {
    flex-basis: 110px;
  }

  .th-fold {
    width: 24px;
    height: 24px;
  }

  .sheet-title {
    font-size: 16px;
  }

  .flt-item {
    font-size: 14px;
    padding: 13px 8px;
  }

  .date-field {
    height: 42px;
    font-size: 13px;
  }

  .sync-l,
  .sync-v {
    font-size: 13px;
  }

  .btn-ghost,
  .btn-dark {
    height: 44px;
    font-size: 14px;
    letter-spacing: 3px;
  }

  .bb-info {
    font-size: 13px;
  }

  .bb-btn {
    padding: 7px 24px;
    font-size: 13px;
    border-radius: 6px;
  }

  .empty-box {
    padding: 40px 0;
    font-size: 12px;
  }

  .pz-img,
  .pz-add {
    width: 80px;
    height: 80px;
    border-radius: 4px;
  }

  .btn-act {
    padding: 5px 18px;
    font-size: 12px;
    border-radius: 6px;
  }

  .ico-22 {
    font-size: 11px;
  }

  .ico-28 {
    font-size: 14px;
  }

  .ico-30 {
    font-size: 15px;
  }

  .ico-32 {
    font-size: 16px;
  }

  .ico-36 {
    font-size: 18px;
  }

  .ico-44 {
    font-size: 22px;
  }
}

@media (min-width: 900px) {
  .page-body {
    max-width: 960px;
  }

  .fab {
    right: calc(50% - 464px);
  }

  .batchbar {
    max-width: 960px;
  }

  /* 线路卡双列（标题/提示/工具行仍通栏） */
  .view-pane {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-content: flex-start;
  }

  .view-pane > .stats-card,
  .view-pane > .toolbar,
  .view-pane > .search,
  .view-pane > .backrow,
  .view-pane > .ledger-head,
  .view-pane > .empty-box,
  .view-pane > .lgroup,
  .view-pane > .bb-spacer,
  .view-pane > .fab-spacer {
    width: 100%;
    box-sizing: border-box;
  }

  .lcard {
    width: calc(50% - 9px);
    box-sizing: border-box;
  }

  .search + .lcard,
  .lcard + .lcard {
    margin-top: 0;
  }

  /* 记录卡双列（组内网格；折叠态两行布局保持不变，次行三字段仍同排） */
  .lgroup {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .thcard {
    width: calc(50% - 9px);
    box-sizing: border-box;
  }

  .thcard + .thcard {
    margin-top: 0;
  }
}

@media (min-width: 1200px) {
  .page-body {
    max-width: 1120px;
  }

  .fab {
    right: calc(50% - 544px);
  }

  .batchbar {
    max-width: 1120px;
  }
}
