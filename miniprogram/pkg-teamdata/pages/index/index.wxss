/* 班组数据（政企蓝白 token；样式口径同出工日志 manage 页；
   颜色走 app.wxss --app-* 语义变量，深色随系统；弱化停用灰 rgba(29,33,41,.4) 无对应 token，
   浅色保持定稿值、深色单独覆盖；表格/表单/弹层横不溢出） */

/* tdesign 组件变量（本页未引用分包 common.wxss，变量块自留） */
page {
  --td-toast-radius: 8rpx;
  --td-tag-round-border-radius: 12rpx;
  --td-tag-square-border-radius: 12rpx;
}

/* ---------- 分段（激活态白底蓝字，政企蓝白分段控件口径） ---------- */
.seg-wrap {
  /* CSS 变量穿透组件（apply-shared），覆盖 t-segmented 主题 */
  --td-segmented-bg-color: var(--app-border);
  --td-segmented-item-active-bg: var(--app-bg-card);
  --td-segmented-item-active-color: var(--app-brand);
  --td-segmented-item-color: var(--app-text-secondary);
}

.seg-wrap .t-segmented {
  border: none;
  border-radius: 16rpx;
  box-shadow: none;
}

.seg-wrap .t-segmented__thumb {
  border-radius: 12rpx;
}

/* ---------- 添加栏 ---------- */
.addbar {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.inp {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.inp-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--app-text-primary);
}

.ph {
  color: rgba(29, 33, 41, 0.4);
}

.btn-add {
  width: 172rpx;
  height: 84rpx;
  flex: none;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-brand);
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: opacity 0.15s ease;
}

/* ---------- 字典 / 线路列表 ---------- */
.mlist {
  margin-top: 28rpx;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.mrow + .mrow {
  border-top: 2rpx solid var(--app-border);
}

.mrow .mi {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mrow .mt {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mrow.off .mt {
  color: rgba(29, 33, 41, 0.4);
  font-weight: 400;
}

.moff-tip {
  flex: none;
  font-size: 20rpx;
  color: rgba(29, 33, 41, 0.4);
  border: 2rpx solid rgba(29, 33, 41, 0.35);
  border-radius: 12rpx;
  padding: 0 10rpx;
  line-height: 30rpx;
}

.mrow .ops {
  margin-left: auto;
  display: flex;
  gap: 28rpx;
  font-size: 24rpx;
  font-weight: 700;
  flex: none;
}

.mrow .ops .edit {
  color: var(--app-brand);
  transition: opacity 0.15s ease;
}

.mrow .ops .off {
  color: rgba(29, 33, 41, 0.4);
  transition: opacity 0.15s ease;
}

.mrow .ops .del {
  color: var(--app-danger);
  transition: opacity 0.15s ease;
}

.mempty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(29, 33, 41, 0.4);
}

/* ---------- 人员来源标（直角小签） ---------- */
.sync-pill {
  flex: none;
  font-size: 19rpx;
  color: var(--app-success-text);
  background: var(--app-success-bg);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

.hand-pill {
  flex: none;
  font-size: 19rpx;
  color: var(--app-text-secondary);
  background: var(--app-brand-light);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

/* ---------- 运维线路信息段 ---------- */
.line-tower {
  margin-left: auto;
  flex: none;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  font-variant-numeric: tabular-nums;
}

.tower-bar {
  margin-top: 28rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.tower-bar .tb-l {
  flex: 1;
  min-width: 0;
}

.tower-bar .tb-n {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.tower-bar .tb-s {
  font-size: 20rpx;
  color: rgba(29, 33, 41, 0.4);
  margin-top: 4rpx;
}

.tb-btn {
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  white-space: nowrap;
  transition: opacity 0.15s ease;
}

.tb-btn.tpl {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  color: var(--app-text-primary);
}

.tb-btn.imp {
  background: var(--app-brand-light);
  border: 3rpx solid var(--app-brand);
  color: var(--app-brand);
}

.tb-btn.disabled {
  opacity: 0.5;
}

.tower-bar .tb-btns {
  margin-left: auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
  flex: none;
}

.lines-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
}

/* ---------- 目的地费用标记胶囊（直角小签，口径同人员来源标） ---------- */
.oc-pill {
  flex: none;
  font-size: 19rpx;
  color: var(--app-warning-text);
  background: var(--app-warning-bg);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

.st2-pill {
  flex: none;
  font-size: 19rpx;
  color: var(--app-brand);
  background: var(--app-brand-light);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

/* ---------- 运维线路段：电压等级输入框窄栏 ---------- */
.inp-volt {
  flex: none;
  width: 190rpx;
  padding: 0 20rpx;
}

/* ---------- 底部弹层（sheet 族，口径同树障隐患 / 出工日志弹层；头/体/脚三段 flex，
   整体限高 + overflow:hidden，内容体 flex:1 1 auto 独立滚动） ---------- */
.sheet {
  position: relative;
  background: var(--app-bg-card);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  max-height: 86vh;
  overflow: hidden;
  box-sizing: border-box;
}

.sheet-title {
  flex: none;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--app-text-primary);
}

/* 弹层内容体（flex-basis 用 auto：0 基准会把自适应高度弹层内容压没） */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* 弹层内非体块默认不参与收缩（头/说明/控件/脚），体块（scroll-view 或 .sheet-body）独占剩余空间并滚动 */
.sheet > view {
  flex: none;
}

.sheet > scroll-view,
.sheet > .sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角隐形关闭热区（closeBtn 未启用仍可点）：置空防误关 */
.t-popup__close {
  display: none;
}

/* 表单字段（.f-label/.f-field 用 app.wxss 全局类） */
.f-item {
  margin-top: 24rpx;
}

.qtags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.sheet-actions {
  flex: none;
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
}

.btn-ghost {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text-secondary);
  letter-spacing: 6rpx;
  transition: opacity 0.15s ease;
}

.btn-dark {
  flex: 2;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  transition: opacity 0.15s ease;
}

.btn-ghost.disabled,
.btn-dark.disabled {
  opacity: 0.5;
}

/* ---------- 动效（复用全局 fadeUp 上浮入场；全局 prefers-reduced-motion 已兜底） ---------- */
/* 分段切换：内容块淡入过渡（wx:if 重建即重播） */
.pane-in {
  animation: fadeUp 0.45s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

/* 列表项 stagger 入场（delay 内联递增） */
.row-in {
  animation: fadeUp 0.45s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

/* ---------- t-icon 外部样式类（size 属性写内联 rpx 会随屏宽膨胀，改由 t-class 控制字号；
   图标色不经 color 属性传 var()，经 t-class/父级颜色继承，随 --app-* 深浅） ---------- */
.ico-30 {
  font-size: 30rpx;
}

.ico-32 {
  font-size: 32rpx;
}

/* 弱化停用灰（rgba(29,33,41,.4/.35) 无 --app-* 对应 token：浅色保持定稿值，深色随系统） */
@media (prefers-color-scheme: dark) {
  .ph,
  .mrow.off .mt,
  .mrow .ops .off,
  .tower-bar .tb-s,
  .mempty {
    color: rgba(255, 255, 255, 0.4);
  }

  .moff-tip {
    color: rgba(255, 255, 255, 0.4);
    border-color: rgba(255, 255, 255, 0.35);
  }
}
