<!-- 班组数据（超管 / 班组管理员）：车牌号 / 目的地 / 人员 / 杆塔信息 / 运维线路 五分段 -->
<navbar back title="班组数据" />

<view class="page-body" wx:if="{{isAdmin}}">
  <!-- 五分段：车牌号 / 目的地 / 人员 / 杆塔信息 / 运维线路 -->
  <view class="seg-wrap">
    <t-segmented block options="{{segOptions}}" value="{{seg}}" bind:change="onSegChange" />
  </view>

  <!-- 字典段（车牌号 / 目的地 / 人员）：顶部输入即添加 + 列表维护（pane-in：分段切换淡入过渡，wx:if 重建即重播） -->
  <block wx:if="{{seg !== 'lines' && seg !== 'oplines'}}">
    <view class="addbar pane-in">
      <view class="inp">
        <input
          class="inp-input"
          value="{{keyword}}"
          bindinput="onKeywordInput"
          bindconfirm="onAdd"
          placeholder="{{placeholder}}"
          placeholder-class="ph"
        />
      </view>
      <view class="btn-add" hover-class="hover-opacity" bindtap="onAdd">
        <t-icon t-class="ico-30" name="add" />
        添加
      </view>
    </view>

    <!-- 字典列表（编辑 / 停用 / 删除；删除仅限无引用记录，被引用时后端拒绝并提示改停用；row-in：列表项 stagger 入场） -->
    <view class="card mlist pane-in">
      <view
        class="mrow row-in {{item.status === 1 ? '' : 'off'}}"
        wx:for="{{list}}"
        wx:key="id"
        style="animation-delay: {{(index > 12 ? 12 : index) * 0.04}}s"
      >
        <view class="mi">
          <t-icon t-class="ico-32" name="{{icon}}" />
        </view>
        <text class="mt">{{item.name}}</text>
        <!-- 目的地费用标记：市外（橙）/ 驻地（浅蓝），互斥 -->
        <text wx:if="{{seg === 'destinations' && item.out_of_city === 1}}" class="oc-pill"
          >市外</text
        >
        <text wx:if="{{seg === 'destinations' && item.stationed === 1}}" class="st2-pill"
          >驻地</text
        >
        <!-- 人员来源标：user_id 非空=账号同步（绿），空=手动添加（灰） -->
        <text wx:if="{{seg === 'members'}}" class="{{item.user_id ? 'sync-pill' : 'hand-pill'}}"
          >{{item.user_id ? '账号同步' : '手动添加'}}</text
        >
        <text class="moff-tip" wx:if="{{item.status !== 1}}">已停用</text>
        <view class="ops">
          <!-- 成员排序（仅人员分段） -->
          <text
            wx:if="{{seg === 'members' && index > 0}}"
            class="edit"
            hover-class="hover-opacity"
            bindtap="onMemberMove"
            data-id="{{item.id}}"
            data-dir="up"
            >上移</text
          >
          <text
            wx:if="{{seg === 'members' && index < list.length - 1}}"
            class="edit"
            hover-class="hover-opacity"
            bindtap="onMemberMove"
            data-id="{{item.id}}"
            data-dir="down"
            >下移</text
          >
          <text
            class="edit"
            hover-class="hover-opacity"
            bindtap="onEdit"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            >编辑</text
          >
          <text
            class="off"
            hover-class="hover-opacity"
            bindtap="onToggle"
            data-id="{{item.id}}"
            data-status="{{item.status}}"
            >{{item.status === 1 ? '停用' : '启用'}}</text
          >
          <text
            class="del"
            hover-class="hover-opacity"
            bindtap="onDelete"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            >删除</text
          >
        </view>
      </view>
      <view class="mempty" wx:if="{{!loading && list.length === 0}}">暂无数据，可在上方添加</view>
    </view>
  </block>

  <!-- 杆塔信息段：线路清单（树障隐患记录分组依据）+ 杆塔坐标模板下载 / Excel 导入全量替换（pane-in / row-in 动效同字典段） -->
  <block wx:if="{{seg === 'lines'}}">
    <view class="card mlist pane-in">
      <view
        class="mrow row-in"
        wx:for="{{lines}}"
        wx:key="line_name"
        style="animation-delay: {{(index > 12 ? 12 : index) * 0.04}}s"
      >
        <view class="mi">
          <t-icon t-class="ico-32" name="forest" />
        </view>
        <text class="mt">{{item.voltage_level}} {{item.line_name}}</text>
        <text class="line-tower">杆塔 {{item.tower_count}}</text>
      </view>
      <view class="mempty" wx:if="{{!linesLoading && lines.length === 0}}"
        >暂无线路信息，可下载模板填写后导入</view
      >
    </view>

    <!-- 杆塔坐标导入（按当前生效班组全量替换，不影响其他班组） -->
    <view class="tower-bar pane-in">
      <view class="tb-l">
        <view class="tb-n">杆塔坐标</view>
        <view class="tb-s">导入即全量替换，仅作用于当前班组</view>
      </view>
      <view class="tb-btns">
        <view class="tb-btn tpl" hover-class="hover-opacity" bindtap="onTplDownload"
          >下载导入模板</view
        >
        <view
          class="tb-btn imp {{importing ? 'disabled' : ''}}"
          hover-class="hover-opacity"
          bindtap="onImpPick"
          >{{importing ? '正在导入…' : '导入 Excel'}}</view
        >
      </view>
    </view>
    <view class="lines-note pane-in">线路信息供树障隐患记录分组使用</view>
  </block>

  <!-- 运维线路段（文案/操作按 design/小程序-运维线路.html）：双输入添加 + 本班线路列表
       （行内 上移/下移/编辑/删除）+ 模板下载 / Excel 导入全量替换 + 微信应答共用说明 -->
  <block wx:if="{{seg === 'oplines'}}">
    <view class="op-add-title pane-in"
      >新增运维线路<text class="op-add-tag">班内名称唯一</text></view
    >
    <view class="addbar pane-in">
      <view class="inp inp-volt">
        <input
          class="inp-input"
          value="{{opVolt}}"
          bindinput="onOpVoltInput"
          placeholder="电压等级"
          placeholder-class="ph"
        />
      </view>
      <view class="inp">
        <input
          class="inp-input"
          value="{{opName}}"
          bindinput="onOpNameInput"
          bindconfirm="onOpAdd"
          placeholder="线路名称"
          placeholder-class="ph"
        />
      </view>
      <view class="btn-add" hover-class="hover-opacity" bindtap="onOpAdd">
        <t-icon t-class="ico-30" name="add" />
        添加
      </view>
    </view>

    <view class="op-head pane-in"
      >本班线路<text class="op-count">共 {{oplines.length}} 条</text></view
    >

    <!-- 运维线路列表（树障/交跨分组与微信智能应答线路匹配共用此清单；无停用，删除不拦截） -->
    <view class="card mlist pane-in">
      <view
        class="mrow row-in"
        wx:for="{{oplines}}"
        wx:key="id"
        style="animation-delay: {{(index > 12 ? 12 : index) * 0.04}}s"
      >
        <view class="mi">
          <t-icon t-class="ico-32" name="thunder" />
        </view>
        <text class="mt op-name">{{item.line_name}}</text>
        <text class="volt-pill">{{item.voltageText}}</text>
        <view class="ops">
          <text
            wx:if="{{index > 0}}"
            class="edit"
            hover-class="hover-opacity"
            bindtap="onOpMove"
            data-id="{{item.id}}"
            data-dir="up"
            >上移</text
          >
          <text
            wx:if="{{index < oplines.length - 1}}"
            class="edit"
            hover-class="hover-opacity"
            bindtap="onOpMove"
            data-id="{{item.id}}"
            data-dir="down"
            >下移</text
          >
          <text
            class="edit"
            hover-class="hover-opacity"
            bindtap="onOpEdit"
            data-id="{{item.id}}"
            data-volt="{{item.voltage_level}}"
            data-name="{{item.line_name}}"
            >编辑</text
          >
          <text
            class="del"
            hover-class="hover-opacity"
            bindtap="onOpDelete"
            data-id="{{item.id}}"
            data-name="{{item.line_name}}"
            >删除</text
          >
        </view>
      </view>
      <!-- 空态（设计稿口径：图标 + 标题 + 逐条添加/批量导入与微信应答说明） -->
      <view class="op-empty" wx:if="{{!opLoading && oplines.length === 0}}">
        <t-icon t-class="ico-64" name="thunder" />
        <text class="op-empty-t">暂无运维线路</text>
        <text class="op-empty-d">可在上方逐条添加，或下载模板后批量导入。</text>
        <text class="op-empty-d">微信应答在线路匹配前会读取这份清单。</text>
      </view>
    </view>

    <!-- 批量导入（按当前生效班组全量替换，不影响其他班组） -->
    <view class="tower-bar pane-in">
      <view class="tb-l">
        <view class="tb-n">批量导入</view>
        <view class="tb-s">模板下载与 Excel 导入；导入按当前班组全量替换。</view>
      </view>
      <view class="tb-btns">
        <view class="tb-btn tpl" hover-class="hover-opacity" bindtap="onOpTplDownload"
          >下载导入模板</view
        >
        <view
          class="tb-btn imp {{importing ? 'disabled' : ''}}"
          hover-class="hover-opacity"
          bindtap="onOpImpPick"
          >{{importing ? '正在导入…' : '导入 Excel'}}</view
        >
      </view>
    </view>
    <!-- 共用来源说明（设计稿 source-note：浅底 + 左蓝条直角提示块） -->
    <view class="op-note pane-in"
      >供树障、交跨分组及微信智能应答线路匹配共用。所有读取都限定当前班组，不使用
      crane-answer 独立线路表。</view
    >
  </block>
</view>

<!-- 目的地编辑弹层（名称 + 市外/驻地互斥标记：点亮一个即清另一个，再点取消） -->
<t-popup
  visible="{{destEditVisible}}"
  placement="bottom"
  bind:visible-change="onDestEditVisibleChange"
>
  <view class="sheet">
    <view class="sheet-title">编辑目的地</view>
    <scroll-view scroll-y class="sheet-body" enhanced show-scrollbar="{{false}}">
      <view class="f-item">
        <view class="f-label">目的地名称</view>
        <view class="f-field">
          <t-input
            borderless
            placeholder="请输入目的地名称"
            value="{{destEditName}}"
            bind:change="onDestNameInput"
          />
        </view>
      </view>
      <view class="f-item">
        <view class="f-label">费用标记（市外与驻地互斥）</view>
        <view class="qtags">
          <t-check-tag
            checked="{{destOutOfCity === 1}}"
            content=""
            data-k="ooc"
            bind:change="onDestTag"
            shape="round"
            variant="outline"
            size="medium"
            >市外</t-check-tag
          >
          <t-check-tag
            checked="{{destStationed === 1}}"
            content=""
            data-k="sta"
            bind:change="onDestTag"
            shape="round"
            variant="outline"
            size="medium"
            >驻地</t-check-tag
          >
        </view>
      </view>
    </scroll-view>
    <view class="sheet-actions">
      <view
        class="btn-ghost {{destSaving ? 'disabled' : ''}}"
        hover-class="hover-opacity"
        bindtap="onCloseDestEdit"
        >取 消</view
      >
      <view
        class="btn-dark {{destSaving ? 'disabled' : ''}}"
        hover-class="hover-opacity"
        bindtap="onDestEditSave"
        >{{destSaving ? '正在保存…' : '保 存'}}</view
      >
    </view>
  </view>
</t-popup>

<!-- 运维线路编辑弹层（电压等级 + 线路名称双字段，design/小程序-运维线路.html 口径） -->
<t-popup
  visible="{{opEditVisible}}"
  placement="bottom"
  bind:visible-change="onOpEditVisibleChange"
>
  <view class="sheet">
    <view class="sheet-title">编辑运维线路</view>
    <scroll-view scroll-y class="sheet-body" enhanced show-scrollbar="{{false}}">
      <view class="f-item">
        <view class="f-label">电压等级<text class="f-req">*</text></view>
        <view class="f-field">
          <t-input
            borderless
            placeholder="请输入电压等级"
            value="{{opEditVolt}}"
            bind:change="onOpEditVoltInput"
          />
        </view>
        <view class="f-hint">纯数字展示时自动补 kV，已含单位则原样显示。</view>
      </view>
      <view class="f-item">
        <view class="f-label">线路名称<text class="f-req">*</text></view>
        <view class="f-field">
          <t-input
            borderless
            placeholder="请输入线路名称"
            value="{{opEditName}}"
            bind:change="onOpEditNameInput"
          />
        </view>
        <view class="f-hint">微信报送原文按此名称归一匹配，班内不可重复。</view>
      </view>
    </scroll-view>
    <view class="sheet-actions">
      <view
        class="btn-ghost {{opEditSaving ? 'disabled' : ''}}"
        hover-class="hover-opacity"
        bindtap="onCloseOpEdit"
        >取 消</view
      >
      <view
        class="btn-dark {{opEditSaving ? 'disabled' : ''}}"
        hover-class="hover-opacity"
        bindtap="onOpEditSave"
        >{{opEditSaving ? '正在保存…' : '保 存'}}</view
      >
    </view>
  </view>
</t-popup>

<!-- 运维线路全量导入确认弹层（设计稿口径：先清空再写入的影响提示） -->
<t-popup visible="{{impVisible}}" placement="bottom" bind:visible-change="onImpVisibleChange">
  <view class="sheet">
    <view class="sheet-title">确认全量导入</view>
    <scroll-view scroll-y class="sheet-body" enhanced show-scrollbar="{{false}}">
      <view class="op-file">
        <t-icon t-class="ico-40 ico-op-file" name="file-excel" />
        <view class="op-file-txt">
          <text class="op-file-n">{{impFileName}}</text>
          <text class="op-file-s">{{impFileText}}</text>
        </view>
      </view>
      <view class="op-warn"
        >导入后将先清空{{impTeamLabel}}现有运维线路，再写入文件内容。其他班组不受影响，历史树障与交跨正式记录不会删除。</view
      >
      <view class="op-confirm-txt"
        >全量替换可能影响后续记录分组和微信报送线路匹配，请确认文件来自本班最新线路表。</view
      >
    </scroll-view>
    <view class="sheet-actions">
      <view class="btn-ghost" hover-class="hover-opacity" bindtap="onCloseImp">取 消</view>
      <view class="btn-danger" hover-class="hover-opacity" bindtap="onImpConfirm">确认全量替换</view>
    </view>
  </view>
</t-popup>

<!-- 运维线路删除确认弹层（设计稿口径：删除只影响之后的分组和匹配） -->
<t-popup
  visible="{{opDelVisible}}"
  placement="bottom"
  bind:visible-change="onOpDelVisibleChange"
>
  <view class="sheet">
    <view class="sheet-title">删除运维线路</view>
    <scroll-view scroll-y class="sheet-body" enhanced show-scrollbar="{{false}}">
      <view class="op-confirm-txt">确认删除「{{opDelName}}」吗？</view>
      <view class="op-warn"
        >删除只影响之后的分组和匹配，已有正式记录保留；既有记录若找不到同名线路，将进入「未匹配线路」。</view
      >
    </scroll-view>
    <view class="sheet-actions">
      <view class="btn-ghost" hover-class="hover-opacity" bindtap="onCloseOpDelete">取 消</view>
      <view class="btn-danger" hover-class="hover-opacity" bindtap="onOpConfirmDelete">确认删除</view>
    </view>
  </view>
</t-popup>

<t-toast id="t-toast" />
