<!-- 文件传输 · 设备列表 + 虚拟 U 盘上传/下载（移动端应用，app_key file-transfer）
     设备卡片与网页端 kvm.html 同口径；上传/下载弹层与出工日志批量下载同为 t-popup 底部弹层 -->
<navbar back title="文件传输" />

<view class="page-body" wx:if="{{!noTeam}}">
  <!-- 班组切换器（超管可点 chip 下拉切换生效班组；其余角色为静态班组名标签） -->
  <view class="tswitch">
    <view class="ts-cur" hover-class="{{isAdmin ? 'hover-opacity' : ''}}" bindtap="onTeamChipTap">
      <text>{{teamName}}</text>
      <text class="arr" wx:if="{{isAdmin}}">▾</text>
    </view>
    <view class="ts-drop" wx:if="{{teamDropOpen}}">
      <view
        class="ts-opt {{item.on ? 'on' : ''}}"
        wx:for="{{teamOptions}}"
        wx:key="id"
        hover-class="hover-bg-warm"
        bindtap="onTeamPick"
        data-id="{{item.id}}"
      >
        <text>{{item.name}}</text>
        <text class="ck" wx:if="{{item.on}}">✓</text>
      </view>
    </view>
  </view>
  <view class="ts-mask" wx:if="{{teamDropOpen}}" bindtap="onTeamDropClose"></view>

  <view class="section-title">设备列表</view>
  <view class="cnt">{{list.length ? '共 ' + list.length + ' 台设备 · ' : ''}}数据实时取自 GLKVM 平台</view>

  <!-- 班组设备回退提示（屏九 .fbanner：本班组暂未接入设备，回退展示默认班组设备） -->
  <view class="fbanner" wx:if="{{fallback}}">
    <text class="ic">⚠</text>
    <text class="fb-p">本班组暂未接入设备，当前展示「{{fallbackTeam}}」的设备；本班组设备组接入后自动切换、此提示消失。</text>
  </view>

  <!-- 设备卡片 -->
  <block wx:if="{{list.length}}">
    <view class="card hazard-top dev" wx:for="{{list}}" wx:key="id">
      <view class="dv-in">
        <view class="dv-top">
          <view class="st st-{{item.statusKey}}">
            <view class="dot"></view>
            <text>{{item.statusText}}</text>
          </view>
          <view wx:if="{{item.group}}" class="dv-tag">{{item.group}}</view>
          <view wx:if="{{item.maintaining}}" class="dv-tag-maint">维护中</view>
        </view>
        <view class="dv-name">{{item.name}}</view>
        <view class="dv-ddns" wx:if="{{item.ddns}}">{{item.ddns}}</view>
        <view class="dv-info">
          <view class="row">
            <text class="lab">IP 地址</text>
            <text class="val mono">{{item.ip}}</text>
          </view>
          <view class="row">
            <text class="lab">MAC</text>
            <text class="val mono">{{item.mac}}</text>
          </view>
          <view class="row">
            <text class="lab">最近在线</text>
            <text class="val">{{item.last}}</text>
          </view>
        </view>
        <!-- 卡底按钮行：左上传右下载；离线/维护中置灰 -->
        <view class="dv-ops">
          <view class="dv-btn up {{(item.statusKey !== 'online' || item.maintaining) ? 'off' : ''}}" hover-class="hover-opacity"
                data-item="{{item}}" bindtap="onOpenUpload">
            <t-icon name="upload" size="30rpx" color="{{(item.statusKey === 'online' && !item.maintaining) ? '#0E3DA8' : 'rgba(29,33,41,.35)'}}" />上传文件
          </view>
          <view class="dv-btn dl {{(item.statusKey !== 'online' || item.maintaining) ? 'off' : ''}}" hover-class="hover-opacity"
                data-item="{{item}}" bindtap="onOpenDownload">
            <t-icon name="download" size="30rpx" color="{{(item.statusKey === 'online' && !item.maintaining) ? '#1D2129' : 'rgba(29,33,41,.35)'}}" />下载文件
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 首屏加载中 -->
  <view wx:elif="{{loading}}" class="empty-box">设备列表加载中…</view>

  <!-- 首屏加载失败（如平台账号未接入/开启 2FA/密码不一致，按后端返回文案展示） -->
  <view wx:elif="{{error}}" class="empty-box">
    <view>{{error}}</view>
    <view class="retry" hover-class="hover-opacity" bindtap="onRetry">重新加载</view>
  </view>

  <!-- 空态 -->
  <view wx:else class="empty-box">暂无设备，或联系管理员开通平台设备权限</view>
</view>

<!-- 未分配班组空态（屏十：非超管且未加入任何班组；整页替代，不发业务请求） -->
<view class="page-body" wx:if="{{noTeam}}">
  <view class="team-empty">
    <view class="te-ic">👷</view>
    <view class="te-t">未分配班组</view>
    <view class="te-p">你的账号尚未加入任何班组，暂无可查看的数据。</view>
    <view class="te-p">请联系超级管理员分配班组后再使用。</view>
  </view>
</view>

<!-- 上传文件弹层（t-popup 底部弹层，同出工日志批量下载结构） -->
<t-popup visible="{{upOpen}}" placement="bottom" bind:visible-change="onUpVisibleChange">
  <view class="sheet">
    <view class="sh-head">
      <view class="sh-title">上传文件<text class="sh-sub">{{upDevice.name}}</text></view>
      <view class="sh-close" hover-class="hover-opacity" bindtap="onCloseUpload">
        <t-icon name="close" size="36rpx" color="#4E5969" />
      </view>
    </view>

    <!-- 两种添加方式 + 网盘入口（网盘可用时显示） -->
    <view class="pick-row">
      <view class="pick" hover-class="hover-opacity" bindtap="onPickMedia">
        <t-icon name="file-image" size="48rpx" color="#0E3DA8" />
        <view class="pick-name">从手机选择</view>
        <view class="pick-note">图片 / 视频</view>
      </view>
      <view class="pick" hover-class="hover-opacity" bindtap="onPickChat">
        <t-icon name="chat" size="48rpx" color="#0E3DA8" />
        <view class="pick-name">从聊天选取</view>
        <view class="pick-note">任意类型文件</view>
      </view>
      <view class="pick" wx:if="{{ndOk}}" hover-class="hover-opacity" bindtap="onOpenNdPicker">
        <t-icon name="folder-import" size="48rpx" color="#0E3DA8" />
        <view class="pick-name">从网盘选择</view>
        <view class="pick-note">推送到设备</view>
      </view>
    </view>

    <!-- 已添加文件列表 -->
    <view class="fl-head">
      <text>已添加（{{upFiles.length}}）</text>
      <text class="fl-sum">合计 {{upTotalText}}</text>
    </view>
    <scroll-view scroll-y class="fl-list">
      <view class="frow" wx:for="{{upFiles}}" wx:key="path">
        <t-icon name="{{item.icon}}" size="34rpx" color="#0E3DA8" />
        <view class="fn">{{item.name}}</view>
        <view class="fs">{{item.sizeText}}</view>
        <view class="fx" hover-class="hover-opacity" data-index="{{index}}" catchtap="onRemoveUpFile">
          <t-icon name="close" size="30rpx" color="rgba(29,33,41,.4)" />
        </view>
      </view>
      <view wx:if="{{!upFiles.length}}" class="fl-empty">尚未添加文件，点上方入口添加</view>
    </scroll-view>

    <view class="sh-note">逐文件依次推送，全部成功后统一挂载到被控机；同名文件覆盖，单文件 ≤200MB。</view>
    <view class="sh-foot">
      <view class="btn-primary {{(!upFiles.length || uploading) ? 'disabled' : ''}}" hover-class="hover-opacity"
            bindtap="onUploadStart">
        {{uploading ? '正在上传 ' + upIndex + '/' + upFiles.length + '…' : '开始上传'}}
      </view>
    </view>
  </view>
</t-popup>

<!-- 下载文件弹层（按挂载状态分流：checking 查询中 / shared 已挂载到目标计算机 / local 展示盘内文件） -->
<t-popup visible="{{dlOpen}}" placement="bottom" bind:visible-change="onDlVisibleChange">
  <view class="sheet">
    <view class="sh-head">
      <view class="sh-title">下载文件<text class="sh-sub">{{dlDevice.name}} · 虚拟 U 盘</text></view>
      <view class="sh-close" hover-class="hover-opacity" bindtap="onCloseDownload">
        <t-icon name="close" size="36rpx" color="#4E5969" />
      </view>
    </view>

    <!-- 查询挂载状态中 -->
    <view wx:if="{{dlState === 'checking'}}" class="fl-empty">正在查询 U 盘挂载状态…</view>

    <!-- 已挂载到目标计算机（共享中）：读取盘内文件会先断开共享，由用户确认触发 -->
    <block wx:elif="{{dlState === 'shared'}}">
      <view class="dl-state">
        <t-icon name="usb" size="64rpx" color="#0E3DA8" />
        <view class="dl-state-t">U 盘已挂载到目标计算机</view>
        <view class="dl-state-n">可在该机向 U 盘放入文件；读取盘内文件需先断开共享（挂载回 KVM）</view>
      </view>
      <view class="sh-foot">
        <view class="btn-primary {{dlLoading ? 'disabled' : ''}}" hover-class="hover-opacity"
              bindtap="loadDlFiles">
          {{dlLoading ? '正在获取…' : '获取文件列表'}}
        </view>
      </view>
    </block>

    <!-- 挂载在 KVM 本机：直接展示盘内文件 -->
    <block wx:else>
      <scroll-view scroll-y class="fl-list">
        <view wx:if="{{!dlFiles.length}}" class="fl-empty">盘内暂无文件</view>
        <view class="frow" wx:for="{{dlFiles}}" wx:key="name" data-file="{{item}}"
              hover-class="hover-opacity" bindtap="onDlFileTap">
          <t-icon name="{{item.icon}}" size="34rpx" color="#0E3DA8" />
          <view class="fn">{{item.name}}</view>
          <view wx:if="{{downloading === item.name}}" class="doing">下载中…</view>
          <view wx:else class="fs">{{item.sizeText}}</view>
          <!-- 存网盘（网盘可用时显示；catchtap 拦截不触发下载） -->
          <view wx:if="{{ndOk}}" class="fsave" hover-class="hover-opacity" data-name="{{item.name}}"
                catchtap="onSaveToNetdisk">
            <t-icon name="folder-import" size="32rpx" color="{{savingNd === item.name ? 'rgba(29,33,41,.35)' : '#0E3DA8'}}" />
          </view>
          <!-- 删除小标（catchtap 拦截，不触发下载） -->
          <view class="fdel" hover-class="hover-opacity" data-name="{{item.name}}" data-index="{{index}}"
                catchtap="onDeleteFile">
            <t-icon name="delete" size="32rpx" color="#F53F3F" />
          </view>
          <t-icon name="chevron-right" size="30rpx" color="rgba(29,33,41,.4)" />
        </view>
      </scroll-view>

      <view class="sh-note">图片 / 视频下载后保存至相册；其他类型经微信打开（可另存 / 转发）。列出与下载期间 U 盘保持断开共享；需从目标计算机向盘内放入文件时先点下方挂载，放好后点「获取文件列表」读取。</view>
      <view class="sh-foot">
        <view class="btn-primary {{(mounting || downloading) ? 'disabled' : ''}}" hover-class="hover-opacity"
              bindtap="onMount">
          {{mounting ? '正在挂载…' : '挂载 U 盘至目标计算机'}}
        </view>
      </view>
    </block>
  </view>
</t-popup>

<!-- 网盘文件选择弹层（从网盘拉取到设备：空间分段（有公共区才显示，默认公共区）+ 面包屑 + 文件列表；文件夹进入、文件选中） -->
<t-popup visible="{{ndPicker.open}}" placement="bottom" bind:visible-change="onNdVisibleChange">
  <view class="sheet">
    <view class="sh-head">
      <view class="sh-title">从网盘选择<text class="sh-sub">{{upDevice.name}}</text></view>
      <view class="sh-close" hover-class="hover-opacity" bindtap="onNdCancel">
        <t-icon name="close" size="36rpx" color="#4E5969" />
      </view>
    </view>

    <view class="seg2" wx:if="{{ndHasPublic}}">
      <view
        wx:for="{{ndSpaces}}"
        wx:key="key"
        class="seg {{ndPicker.space === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        hover-class="hover-opacity"
        bindtap="onNdSpaceTap"
      ><text class="seg-t">{{item.label}}</text></view>
    </view>

    <view class="nd-crumb">
      <block wx:for="{{ndCrumbs}}" wx:key="path">
        <text wx:if="{{!item.last}}" class="nd-link" data-path="{{item.path}}" hover-class="hover-opacity" bindtap="onNdCrumbTap">{{item.name}}</text>
        <text wx:else class="nd-cur">{{item.name}}</text>
        <text wx:if="{{!item.last}}" class="nd-sep">/</text>
      </block>
    </view>

    <scroll-view scroll-y class="fl-list nd-list">
      <view wx:if="{{ndPicker.loading}}" class="fl-empty">目录加载中…</view>
      <view wx:elif="{{ndPicker.error}}" class="fl-empty">{{ndPicker.error}}</view>
      <view wx:elif="{{!ndPicker.items.length}}" class="fl-empty">该目录为空</view>
      <view
        wx:else
        wx:for="{{ndPicker.items}}"
        wx:key="fullPath"
        class="frow nd-row {{ndPicker.selected === item.fullPath ? 'sel' : ''}}"
        data-item="{{item}}"
        hover-class="hover-opacity"
        bindtap="onNdRowTap"
      >
        <t-icon name="{{item.icon}}" size="34rpx" color="#0E3DA8" />
        <view class="fn">{{item.name}}</view>
        <view wx:if="{{!item.isDir}}" class="fs">{{item.sizeText}}</view>
        <t-icon wx:if="{{!item.isDir && ndPicker.selected === item.fullPath}}" name="check-circle-filled" size="32rpx" color="#0E3DA8" />
        <t-icon wx:if="{{item.isDir}}" name="chevron-right" size="30rpx" color="rgba(29,33,41,.4)" />
      </view>
    </scroll-view>

    <view class="sh-foot">
      <view class="btn-primary {{(!ndPicker.selected || ndPicker.saving) ? 'disabled' : ''}}" hover-class="hover-opacity"
            bindtap="onNdConfirm">
        {{ndPicker.saving ? '正在拉取…' : '推送到设备'}}
      </view>
    </view>
  </view>
</t-popup>

<t-toast id="t-toast" />
<t-dialog id="t-dialog" />
