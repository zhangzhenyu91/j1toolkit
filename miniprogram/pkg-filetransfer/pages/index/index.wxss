/* 文件传输 · 设备列表 + 上传/下载弹层（卡片结构与网页端 kvm.html 同口径；弹层与出工日志批量下载同族；
   设计 token 见 AGENTS.md 第四节，功能口径见《开发指南》第十二节） */

.page-body {
  padding-bottom: 60rpx;
}

/* ---------- 班组切换器（超管可点 chip 下拉切换；其余角色静态班组名标签） ---------- */
.tswitch {
  position: relative;
  z-index: 20;
  margin-bottom: 20rpx;
}

.ts-cur {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  box-shadow: var(--app-shadow-card);
}

.ts-cur .arr {
  color: var(--app-brand);
  font-size: 18rpx;
}

/* 下拉入场：chip 下方轻微上浮 + 淡入（克制，同全局 fadeUp/fadeIn 风格）；收起直消不加动画 */
.ts-drop {
  position: absolute;
  top: 76rpx;
  left: 0;
  z-index: 21;
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  box-shadow: var(--app-shadow-card);
  padding: 12rpx;
  min-width: 300rpx;
  max-width: 600rpx; /* 上限兜底：超长班组名由 .ts-opt 内文案省略，浮层不撑出屏外 */
  animation: ts-drop-in 0.2s ease-out;
}

.ts-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
}

/* 主文案左对齐 + 超长省略（.ck 勾选由 margin-left:auto 右置） */
.ts-opt > text:first-of-type {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

.ts-opt.on {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.ts-opt .ck {
  margin-left: auto;
  font-size: 22rpx;
}

/* 点空白处收起下拉（层级低于切换器本体）；遮罩淡入 */
.ts-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  animation: ts-mask-in 0.15s ease-out;
}

/* ---------- 班组设备回退提示横幅（屏九 .fbanner：黄底黄字） ---------- */
.fbanner {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  background: var(--app-warning-bg);
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
}

.fbanner .ic {
  color: var(--app-warning-text);
  font-size: 26rpx;
  line-height: 1.5;
  flex: none;
}

.fbanner .fb-p {
  flex: 1;
  font-size: 22rpx;
  color: var(--app-warning-text);
  line-height: 1.6;
  font-weight: 600;
}

/* ---------- 未分配班组空态（屏十） ---------- */
.team-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.team-empty .te-ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-empty .te-t {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.team-empty .te-p {
  font-size: 23rpx;
  color: var(--app-text-secondary);
  line-height: 1.8;
  text-align: center;
}

/* 板块副标题（设备数量 + 数据来源说明） */
.cnt {
  margin: 10rpx 0 20rpx 20rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 1rpx;
}

/* ---------- 设备卡片 ---------- */
.dev {
  margin-bottom: 24rpx;
}

.dv-in {
  padding: 36rpx 32rpx 30rpx;
}

.dv-top {
  display: flex;
  align-items: center;
}

/* 状态点 + 文案（同网页端 .st：在线绿 / 离线灰 / 禁用红） */
.st {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
}

.st .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.st-online {
  color: var(--app-success-text);
}
.st-online .dot {
  background: var(--app-success);
  box-shadow: 0 0 0 6rpx rgba(0, 180, 42, 0.15);
}

.st-offline {
  color: var(--app-text-tertiary);
}
.st-offline .dot {
  background: var(--app-text-tertiary);
}

.st-disabled {
  color: var(--app-danger-text);
}
.st-disabled .dot {
  background: var(--app-danger);
}

/* 设备组标签（同网页端 tag-navy） */
.dv-tag {
  margin-left: auto;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-text-primary);
  font-size: 20rpx;
}

/* 维护中标签（维护锁期间展示；蓝色浅底，与身份标签同族） */
.dv-tag-maint {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  background: var(--app-brand-light);
  color: var(--app-brand);
  font-size: 20rpx;
}

.dv-name {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  word-break: break-all;
}

.dv-ddns {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  word-break: break-all;
}

.mono {
  font-family: ui-monospace, 'SF Mono', Consolas, monospace;
}

/* 信息行：标签左、值右 */
.dv-info {
  margin-top: 24rpx;
}

.dv-info .row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.dv-info .row:first-child {
  margin-top: 0;
}

.dv-info .lab {
  flex: none;
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

.dv-info .val {
  margin-left: 24rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--app-text-primary);
  text-align: right;
  word-break: break-all;
}

/* ---------- 卡底按钮行：单按钮「打开 U 盘」（浅蓝底蓝字）；离线置灰 ---------- */
.dv-ops {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--app-border);
  display: flex;
  gap: 20rpx;
}

.dv-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  transition: opacity 0.15s ease;
}

.dv-btn.up {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.dv-btn.off {
  background: var(--app-bg-page);
  border: none;
  color: var(--app-text-tertiary);
}

/* ---------- 底部弹层（t-popup 内容容器，同出工日志批量下载面板；头/体/脚三段 flex，
   整体限高 + overflow:hidden，内容体 flex:1 1 auto 独立滚动） ---------- */
.sheet {
  background: var(--app-bg-card);
  border: 2rpx solid var(--app-border);
  border-bottom: none;
  border-radius: 12rpx;
  box-shadow: 0 -8rpx 32rpx var(--app-mask);
  padding: 28rpx 32rpx 48rpx;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/* 弹层内非体块默认不参与收缩（头/操作/脚），体块（scroll-view 或 .sheet-body）独占剩余空间并滚动 */
.sheet > view {
  flex: none;
}

.sheet > scroll-view,
.sheet > .sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* t-popup 自带右上角隐形关闭热区（closeBtn 未启用仍可点）：置空防误关 */
.t-popup__close {
  display: none;
}

.sh-head {
  flex: none;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.sh-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.sh-sub {
  margin-left: 14rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: var(--app-text-tertiary);
}

.sh-close {
  margin-left: auto;
  /* 可靠关闭钮：88rpx 触达区（图标居中） */
  width: 88rpx;
  height: 88rpx;
  margin: -20rpx -20rpx -20rpx auto;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-text-secondary);
  transition: opacity 0.15s ease;
}

/* 上传：两种添加方式入口（虚线卡） */
.pick-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.pick {
  flex: 1;
  border: 3rpx dashed var(--app-text-tertiary);
  border-radius: 12rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: var(--app-brand);
  transition: opacity 0.15s ease;
}

.pick-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--app-text-primary);
}

.pick-note {
  font-size: 20rpx;
  color: var(--app-text-tertiary);
}

/* 文件列表 */
.fl-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.fl-sum {
  margin-left: auto;
  font-size: 21rpx;
  font-weight: 400;
  color: var(--app-text-tertiary);
}

.fl-list {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.frow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--app-bg-nested);
  border: 2rpx solid var(--app-border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}

.frow .fn {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.frow .fs {
  flex: none;
  font-size: 21rpx;
  color: var(--app-text-tertiary);
}

.frow .doing {
  flex: none;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--app-brand);
}

/* 行内删除小标（下载弹层文件行，红色 delete 图标） */
.fdel {
  flex: none;
  padding: 6rpx;
  color: var(--app-danger-text);
  transition: opacity 0.15s ease;
}

/* 行内下载小标（文件名右侧，蓝色 download 图标，与 .fdel/.fsave 同位口径） */
.fdl {
  flex: none;
  padding: 6rpx;
  color: var(--app-brand);
  transition: opacity 0.15s ease;
}

.frow .fx {
  flex: none;
  padding: 4rpx;
  color: var(--app-text-tertiary);
}

.fl-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

/* 已挂载到目标计算机状态块（shared 态，读取盘内文件需先断开共享） */
.dl-state {
  padding: 40rpx 32rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  text-align: center;
}

.dl-state-t {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  letter-spacing: 1rpx;
}

.dl-state-n {
  font-size: 22rpx;
  color: var(--app-text-tertiary);
  line-height: 1.8;
}

/* 弹层说明与底部操作（脚部 flex:none + 背景顶线，与滚动内容隔开） */
.sh-note {
  flex: none;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--app-text-tertiary);
  line-height: 1.8;
}

.sh-foot {
  flex: none;
  margin-top: 20rpx;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
}

/* 底部双按钮行（上传 / 插入 U 盘） */
.sh-foot2 {
  flex: none;
  margin-top: 20rpx;
  padding-top: 20rpx;
  background: var(--app-bg-card);
  border-top: 2rpx solid var(--app-border);
  display: flex;
  gap: 20rpx;
}

.sh-foot2 .btn-primary,
.sh-foot2 .btn-outline {
  flex: 1;
}

.btn-outline {
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--app-border);
  background: var(--app-bg-card);
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.btn-outline.disabled {
  opacity: 0.5;
}

.btn-primary {
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.btn-primary.disabled {
  opacity: 0.5;
}

/* ---------- 空态/加载/错误虚线占位（同出工日志 empty-box 口径） ---------- */
.empty-box {
  margin-top: 24rpx;
  border: 3rpx dashed var(--app-text-tertiary);
  border-radius: 12rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-tertiary);
  letter-spacing: 2rpx;
}

.empty-box .retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 10rpx 40rpx;
  border-radius: 12rpx;
  background: var(--app-text-primary);
  color: var(--app-bg-card);
  font-size: 24rpx;
  transition: opacity 0.15s ease;
}

/* ---------- 网盘联动（从网盘选择弹层 / 行内存网盘小标） ---------- */

/* 空间分段（公共区带班组名；按钮 flex 居中，长文案由 .seg-t 内层省略） */
.seg2 {
  display: flex;
  height: 64rpx;
  padding: 4rpx;
  background: var(--app-border);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.seg2 .seg {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: var(--app-text-secondary);
}

.seg2 .seg.on {
  background: var(--app-bg-card);
  color: var(--app-brand);
  font-weight: 600;
  box-shadow: var(--app-shadow-card);
}

.seg-t {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 面包屑（父级蓝字可点，末级当前加粗） */
.nd-crumb {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
}

.nd-link {
  flex: none;
  color: var(--app-brand);
  font-weight: 600;
  transition: opacity 0.15s ease;
}

.nd-sep {
  flex: none;
  color: var(--app-text-tertiary);
}

.nd-cur {
  font-weight: 600;
  color: var(--app-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nd-list {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

/* 文件行选中态（浅蓝底 + 对勾；文件夹行右侧为进入箭头） */
.nd-row.sel {
  background: var(--app-brand-light);
  border-color: var(--app-brand);
}

/* 行内存网盘小标（与 .fdel 同位） */
.fsave {
  flex: none;
  padding: 6rpx;
  color: var(--app-brand);
  transition: opacity 0.15s ease;
}

/* 圆形勾选标（网盘选择弹层文件行 / 下载弹层多选态行首；选中填品牌蓝） */
.ck-dot {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  border-radius: 50%;
  border: 2rpx solid var(--app-text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-on-brand);
}

.ck-dot.on {
  background: var(--app-brand);
  border-color: var(--app-brand);
}

/* 下载弹层标题行「多选」开关（小胶囊；开启态浅蓝底蓝字） */
.sh-multi {
  margin-left: auto;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: var(--app-bg-nested);
  border: 2rpx solid var(--app-border);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--app-text-secondary);
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease,
    color 0.15s ease;
}

.sh-multi.on {
  background: var(--app-brand-light);
  border-color: var(--app-brand);
  color: var(--app-brand);
}

/* 多选钮占据右推位后，关闭钮改为固定间距（其余弹层 .sh-close 维持 margin-left:auto） */
.sh-multi + .sh-close {
  margin-left: 12rpx;
}

/* 下载弹层多选操作条：全选 / 下载所选 / 存网盘 */
.dl-mbar {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.dl-mall {
  flex: none;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: var(--app-bg-nested);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--app-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

.dl-mbtn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--app-brand);
  color: var(--app-on-brand);
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.dl-mbtn.nd {
  background: var(--app-brand-light);
  color: var(--app-brand);
}

.dl-mall.disabled,
.dl-mbtn.disabled {
  opacity: 0.5;
}

/* 图标状态色（t-icon 不传 color，经宿主 CSS color 继承） */
.ico-brand {
  color: var(--app-brand);
}

.ico-danger {
  color: var(--app-danger-text);
}

.ico-mute {
  color: var(--app-text-tertiary);
}

.ico-off {
  color: var(--app-text-tertiary);
  opacity: 0.75;
}

/* ---------- t-icon 数值字阶（t-class 外部类） ---------- */
.ico-22 {
  font-size: 22rpx;
}
.ico-30 {
  font-size: 30rpx;
}
.ico-32 {
  font-size: 32rpx;
}
.ico-34 {
  font-size: 34rpx;
}
.ico-36 {
  font-size: 36rpx;
}
.ico-48 {
  font-size: 48rpx;
}
.ico-64 {
  font-size: 64rpx;
}
