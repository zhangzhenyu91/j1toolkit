# 行尾约定：麒麟用的 shell/systemd 文件永远 LF（Windows 中转 CRLF 会炸 bash，已踩坑）
*.sh       text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.desktop  text eol=lf
packaging/debian/postinst text eol=lf
packaging/debian/prerm    text eol=lf
packaging/debian/postrm   text eol=lf
# Windows 批处理用 CRLF
*.bat      text eol=crlf
# OCR 字典参与跨平台 SHA256 校验，必须固定 LF（CRLF/LF 内容相同但哈希不同）
desktop/electron/quizsearch/models/ppocr_keys.txt text eol=lf
# 其余文本文件交给 autocrlf
