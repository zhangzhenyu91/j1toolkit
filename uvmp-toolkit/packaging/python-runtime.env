# 内置 Python 独立运行时的单一来源（构建脚本 source 本文件，禁止各处另写版本号）
#
# 版本：astral-sh/python-build-standalone 20261110 发布的 CPython 3.15.2。
# 三个平台都用同一发布；SHA256 取自该 release 的资产 digest，download 后必须校验，
# **校验失败一律中止构建，不回退 latest**（回退会让同一 tag 在不同时间产出不同解释器）。
#
# 用法（bash）：
#   . packaging/python-runtime.env
#   sha=$(python_runtime_sha "$PYARCH")   # x86_64 / aarch64 / win-x86_64 / win-aarch64
#   name=$(python_runtime_asset "$PYARCH")
PYVER=3.15.2
PYREL=20261110
PY_TAG="${PYVER}+${PYREL}"

# linux gnu install_only_stripped
PY_SHA_LINUX_X86_64=ad23d1b73fac26440b0306ae06911031344c49a90ec19716c8362e7fa40cae43
PY_SHA_LINUX_AARCH64=d1367a6c3cd86a9e35712072841f1376859f3b47a2a54e224421a0f9fd169047
# windows msvc install_only_stripped
PY_SHA_WIN_X86_64=ecd90d78accb906e3d47f6cdb409a610da10475f94d15ebdd8cb2e0561b71df6
PY_SHA_WIN_AARCH64=f53641fd0bc1d0b0946069647a5c2c44b5acb33aed53be2855e9a674b8585b20

python_runtime_asset() {
  case "$1" in
    x86_64) echo "cpython-${PY_TAG}-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz" ;;
    aarch64) echo "cpython-${PY_TAG}-aarch64-unknown-linux-gnu-install_only_stripped.tar.gz" ;;
    win-x86_64) echo "cpython-${PY_TAG}-x86_64-pc-windows-msvc-install_only_stripped.tar.gz" ;;
    win-aarch64) echo "cpython-${PY_TAG}-aarch64-pc-windows-msvc-install_only_stripped.tar.gz" ;;
    *) echo "不支持的平台: $1" >&2; return 1 ;;
  esac
}

python_runtime_sha() {
  case "$1" in
    x86_64) echo "$PY_SHA_LINUX_X86_64" ;;
    aarch64) echo "$PY_SHA_LINUX_AARCH64" ;;
    win-x86_64) echo "$PY_SHA_WIN_X86_64" ;;
    win-aarch64) echo "$PY_SHA_WIN_AARCH64" ;;
    *) echo "不支持的平台: $1" >&2; return 1 ;;
  esac
}
