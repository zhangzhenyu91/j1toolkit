[Unit]
Description=内网工具箱 - U 盘单监听 agent（服务端指令消费）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 运行期统一用桌面用户：U 盘由该用户经 udisks 挂载，避免 root 挂载后 GUI/agent 无权读取。
User=@APP_USER@
Environment=HOME=@APP_HOME@
Environment=UVMP_TOOLKIT_CONFIG=@CONFIG_PATH@
Environment=UVMP_TOOLKIT_MIRROR_STATE=@MIRROR_STATE@
Environment=PYTHONIOENCODING=utf-8
# 常驻单实例：udev 事件 + 60s 兜底轮询；flock 保证 GUI/手工检查不会起第二个。
ExecStart=@RUN_CMD@ usb-agent --quiet
# 单实例 flock 抢不到时 agent 正常退出（code 0），不要用 always 反复拉起。
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
