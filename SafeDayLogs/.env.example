# Dify API 地址，如 https://api.dify.ai 或自建地址
DIFY_BASE_URL=

# Dify 工作流 API Key
DIFY_API_KEY=

# 传给 Dify 的 user 标识
DIFY_USER=safeday-web

# 服务监听端口
PORT=3000

# 可选；设置后 /api/callback 必须带 ?token= 匹配才生效
CALLBACK_TOKEN=

# 主平台「检修一班工具箱」API 根地址（登录与权限校验走主平台 /auth/app-login）
# 推荐填主平台直连地址（与 1Panel 反代 upstream 一致），如 http://10.2.24.13:8005 —— 不绕公网域名，避开服务器访问自身公网域名的 hairpin 问题；
# 两容器在同一用户自定义 Docker 网络时，也可用容器名互访，如 http://j1toolkit:3000（注意：填容器内部监听端口，不是宿主机发布端口 8005）；
# 主平台对不带 /j1toolkit 前缀的直连请求也能正常处理。也可填公网地址 https://j1net.com/j1toolkit（需确认服务器访问自身域名可达）
J1TOOLKIT_API_URL=

# 登录会话 JWT 签名密钥；不配置则使用随机密钥（服务重启后所有登录会话失效）
SESSION_SECRET=

# 登录会话有效期（jsonwebtoken 格式，默认 7d）
SESSION_EXPIRES=7d

# 反代路径前缀（如 /sdl；1Panel 不剥前缀转发时配置，剥前缀或直连则留空）
PROXY_PREFIX=

# 生产环境（HTTPS）置 true，会话 cookie 加 Secure 标记
COOKIE_SECURE=false
