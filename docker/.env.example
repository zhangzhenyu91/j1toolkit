# ===== Shade 壹匣 · 启动必需配置（全仓唯一环境变量示例）=====
# 部署：cp .env.example .env，填写后 docker compose up -d。
# .env 不入仓；真实密码、密钥不得提交到公开仓库。
#
# Dify、COS、微信、WeKnora、OpenList、ONLYOFFICE、GLKVM、商旅等业务配置，
# 部署后统一在「管理-应用配置」（/admin/config）维护，保存即生效，无需重启。
# 这些业务配置也可选做首次 env 补缺导入，但不属于启动必需项（下方仅保留两个商旅并发示例），
# 其余不在此重复列出。
# 运行配置加密缺省从 JWT_SECRET 派生；轮换 JWT_SECRET 前请先阅读开发指南的配置迁移说明。
# 可写数据由 compose 持久化在 ./data（容器内 /app/server/data），其中包括应用日志目录
# ./data/logs（容器内 /app/server/data/logs）；请为该卷预留容量并监控磁盘。
#
# 启动项与运行配置：本文件出现（未注释）的变量属于启动参数，改后需重启容器；
# APP_LOG_RETENTION_DAYS / APP_LOG_ARCHIVE_RETENTION_DAYS / OO_SAVE_TEMP_DIR 等运行配置
# 也可在此做首次缺值导入，但日常应改「管理-应用配置」，保存即时生效；
# 例外：JWT 有效期与 APP_LOG_RETENTION_DAYS / APP_LOG_ARCHIVE_RETENTION_DAYS 启动时读取，修改后需重启服务。

# 应用日志文件持久层（启动项，默认值见括号；一般无需修改）。
# 每条日志先同步追加 NDJSON 段文件，数据库恢复后按游标补录；文件与数据库均默认永久保留。
# APP_LOG_DIR=./data/logs
# APP_LOG_BATCH_SIZE=100     # 单次补录批量（1-10000）
# APP_LOG_FSYNC=batch        # batch=按批 fsync（warn/error/audit 仍逐条）；always=每条 fsync

# 日志保留（运行配置，首次缺值导入；0=永久，正数 1-3650 天）。
# 默认 0/0：数据库与文件归档都永久保留。只有明确配置正数才清理，且数据库清理要求
# 待删日期在文件归档中都有副本；归档保留期短于数据库保留期时数据库清理自动停用。
# APP_LOG_RETENTION_DAYS=0
# APP_LOG_ARCHIVE_RETENTION_DAYS=0

# ONLYOFFICE 保存回调 staging 目录。留空时走运行配置「团队网盘」分组，默认
# ./data/office-staging（位于数据卷内，janitor 周期清理）；在此显式填写会成为启动覆盖
# （每次启动读取，优先于运行配置，改后需重启）。
# OO_SAVE_TEMP_DIR=

# 商旅并发上限（可选；首次缺值导入运行配置）。
# 旧 SGCC_SYNC_INTERVAL_MS 固定间隔已废弃、不再读取，库内残留值无效果。
# SGCC_SYNC_CONCURRENCY=4
# SGCC_PHOTO_CONCURRENCY=2

# 镜像完整地址，版本号与发版 tag 去掉前缀 v / release-v 后一致。
IMAGE=ccr.ccs.tencentyun.com/<命名空间>/j1toolkit:<版本号>

# 网页端与 API 共用端口；反代指向 127.0.0.1:PORT。
PORT=3000

# JWT 签名密钥：必须替换为足够长的随机字符串。
# 同时用于缺省派生运行配置加密密钥，部署后不要直接轮换。
JWT_SECRET=please-change-me-to-a-long-random-string

# 初始管理员：仅在账号不存在时创建，首次登录后请立即修改密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# MySQL：请预先创建空数据库。
# 容器内不能用 127.0.0.1 指向宿主机；请填宿主机内网地址或实际数据库容器名。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=j1toolkit
# 可选：直接提供完整 DSN（直填原样，不追加参数）。留空则由上面的 MYSQL_* 自动拼装，
# 自动拼装自带 parseTime/charset/loc 与 timeout=5s、interpolateParams=true。
# MYSQL_DSN=
# 连接池上限（可选；默认 32/16，空闲连接 5 分钟回收）。
# MYSQL_MAX_OPEN_CONNS=32
# MYSQL_MAX_IDLE_CONNS=16

# Redis：用于 JWT 黑名单与缓存；网络填写规则同 MySQL。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
