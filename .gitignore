# 依赖目录
node_modules/

# 小程序 npm 构建产物（开发者工具「构建 npm」生成，可重建）
miniprogram_npm/

# 环境变量（真实配置绝不入仓）
.env

# 系统文件
.DS_Store

# 微信开发者工具个人本地配置（每人本机自动生成，不入仓）
project.private.config.json

# 会话数据（mcp.json 为项目级 MCP 配置，需入仓随仓库分发，其余内容仍忽略）
.kimi-code/*
!.kimi-code/mcp.json

# 商旅打卡逆向分析仓（esgcc/sgcc/）：仓库已转私有，tools/（含协议密钥）入仓供后续开发；
# base.apk 107MB 超 GitHub 单文件 100MB 上限，不入仓（本地留存）
esgcc/sgcc/base.apk
