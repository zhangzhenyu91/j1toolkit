# 服务端口（监听 0.0.0.0:PORT）
PORT=3000

# 主平台「检修一班工具箱」API 根地址（必填；缺失时登录与业务代理不可用）
J1TOOLKIT_API_URL=https://j1net.com/j1toolkit

# 登录会话 JWT 签名密钥（生产必填；缺失时随机兜底，重启后所有会话失效）
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-me

# 会话名义有效期（实际与主平台 JWT 同寿命，主平台默认 7d）
SESSION_EXPIRES=7d

# HTTPS 部署时置 true（cookie 仅经 HTTPS 传输）
COOKIE_SECURE=false

# 反代路径前缀（1Panel 保留前缀转发时配置，如 /wl；与主平台同口径，不需要时留空）
PROXY_PREFIX=
